---
// src/components/Hero.astro
// Full-screen cinematic hero: autoplay video -> slideshow fallback, audio toggle,
// editorial headline with coordinates micro-label.
import { Image, getImage } from "astro:assets";
import { useTranslations, type Locale } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import { siteSettings } from "../data/settings";

import slide1 from "../assets/hotel/hero-slide-patio.jpg";
import slide2 from "../assets/hotel/hero-slide-recepcion.jpg";
import slide3 from "../assets/hotel/hero-slide-matrimonial.jpg";
import slide4 from "../assets/hotel/hero-slide-cusco.jpg";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const optimizedPoster = await getImage({
  src: slide1,
  width: 1280,
  quality: 80,
  format: "avif",
});

const heroCoordinates = `${Math.abs(siteSettings.latitude).toFixed(4)} ${siteSettings.latitude >= 0 ? 'N' : 'S'} / ${Math.abs(siteSettings.longitude).toFixed(4)} ${siteSettings.longitude >= 0 ? 'E' : 'W'} / ${siteSettings.city}, ${siteSettings.region}`;

const slides = [slide1, slide2, slide3, slide4];
---

<link rel="preload" href={optimizedPoster.src} as="image" type="image/avif" />

<section
  class="relative h-dvh min-h-[500px] sm:min-h-[600px] flex items-center justify-center overflow-hidden"
  id="hero"
>
  <!-- Video Background (3 segmentos encadenados: cada parte arranca al terminar la anterior) -->
  <video
    autoplay
    muted
    playsinline
    preload="metadata"
    class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 z-0 opacity-100"
    poster={optimizedPoster.src}
    id="hero-video"
    data-video-parts={JSON.stringify({
      desktop: ["/videos/hero-1.mp4", "/videos/hero-2.mp4"],
      mobile: ["/videos/hero-mobile-1.mp4", "/videos/hero-mobile-2.mp4"],
    })}
  >
  </video>

  <!-- Slideshow Background (Initially hidden) -->
  <div
    id="hero-slideshow"
    class="absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-1000 z-0"
  >
    {slides.map((slide, i) => (
      <div class="absolute inset-0 transition-opacity duration-1000 opacity-0" data-slide={i}>
        <Image
          src={slide}
          alt={`${t('hero.slideAlt')} ${i + 1}`}
          width={1600}
          height={900}
          layout="none"
          format="avif"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    ))}
  </div>

  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/60">
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center text-white px-4 max-w-4xl mx-auto">
    <p class="micro-label shiny-text-gold font-mono mb-4 sm:mb-6">{heroCoordinates}</p>
    <h1 id="hero-title-reveal" class="font-display fluid-h1 mb-4 sm:mb-6 drop-shadow-lg leading-tight">
      {t("hero.title")}
    </h1>
    <p class="text-base sm:text-xl lg:text-2xl font-light tracking-wide opacity-90 mb-6 sm:mb-8">
      {t("hero.subtitle")}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={getRelativeLocaleUrl(lang, "book")}
        class="btn-primary btn-shimmer font-semibold px-9 py-4 rounded-full text-lg shadow-2xl"
      >
        {t("hero.cta")}
      </a>
      <a
        href="#rooms"
        class="border border-white/40 hover:border-white/80 text-white px-8 py-3.5 rounded-full transition-[border-color,background-color,color] duration-300 hover:bg-white/10 text-lg"
      >
        {t("hero.ctaSecondary")}
      </a>
    </div>
  </div>

  <!-- Video Audio Toggle -->
  <button
    id="video-audio-toggle"
    class="absolute bottom-28 right-6 z-10 w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center hover:bg-white/30 transition-[background-color] duration-300"
    aria-label={t('hero.toggleAudio')}
    aria-pressed="false"
  >
    <!-- Muted icon -->
    <svg id="muted-icon" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
    </svg>
    <!-- Unmuted icon (hidden by default) -->
    <svg id="unmuted-icon" class="w-5 h-5 text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
    </svg>
  </button>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg class="w-6 h-6 text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<script>
  let activeSlideshowInterval: ReturnType<typeof setInterval> | null = null;

  function initHeroVideo() {
    const video = document.getElementById("hero-video") as HTMLVideoElement;
    const toggleBtn = document.getElementById("video-audio-toggle") as HTMLElement;
    const mutedIcon = document.getElementById("muted-icon") as HTMLElement;
    const unmutedIcon = document.getElementById("unmuted-icon") as HTMLElement;
    const slideshow = document.getElementById("hero-slideshow") as HTMLElement;

    if (!video || !toggleBtn || !mutedIcon || !unmutedIcon || !slideshow) return;

    if (activeSlideshowInterval) {
      clearInterval(activeSlideshowInterval);
      activeSlideshowInterval = null;
    }

    const slides = slideshow.querySelectorAll("[data-slide]");

    // 1. Force reset DOM visibility state for fresh page view
    video.classList.remove("opacity-0");
    video.classList.add("opacity-100");

    slideshow.classList.remove("opacity-100");
    slideshow.classList.add("opacity-0");

    slides.forEach((slide) => {
      slide.classList.remove("opacity-100");
      slide.classList.add("opacity-0");
    });

    toggleBtn.classList.remove("opacity-0", "pointer-events-none");
    toggleBtn.classList.add("opacity-100");

    // 2. Sync audio button state with video
    video.muted = true;
    toggleBtn.setAttribute("aria-pressed", "false");
    mutedIcon.classList.remove("hidden");
    unmutedIcon.classList.add("hidden");

    // 3. Reset and play media source (deferred attach)
    // Hero video = 3 segmentos encadenados; la lista depende del viewport
    const parts: string[] = JSON.parse(
      video.dataset.videoParts || '{"desktop":[],"mobile":[]}',
    )[window.matchMedia("(max-width: 767px)").matches ? "mobile" : "desktop"];
    let partIndex = 0;

    function playPart(index: number) {
      const src = parts[index];
      if (!src) return;
      video.src = src;
      video.load();
      video.play().catch((err) => {
        console.log("Hero video autoplay notice:", err);
      });
    }

    if (parts.length > 0) {
      playPart(0);
    } else if (video.dataset.src) {
      video.src = video.dataset.src;
      try {
        video.load();
      } catch (e) {
        // Ignore load errors
      }
      requestAnimationFrame(() => {
        video.play().catch((err) => {
          console.log("Hero video autoplay notice:", err);
        });
      });
    }

    // 4. Toggle sound handler (clean direct assignment)
    toggleBtn.onclick = () => {
      video.muted = !video.muted;
      toggleBtn.setAttribute("aria-pressed", String(!video.muted));
      mutedIcon.classList.toggle("hidden", !video.muted);
      unmutedIcon.classList.toggle("hidden", video.muted);
    };

    function startSlideshow() {
      slideshow.classList.remove("opacity-0");
      slideshow.classList.add("opacity-100");

      toggleBtn.classList.add("opacity-0", "pointer-events-none");

      let currentSlide = 0;
      if (slides[0]) {
        slides[0].classList.remove("opacity-0");
        slides[0].classList.add("opacity-100");
      }

      if (activeSlideshowInterval) clearInterval(activeSlideshowInterval);

      activeSlideshowInterval = setInterval(() => {
        if (slides[currentSlide]) {
          slides[currentSlide].classList.remove("opacity-100");
          slides[currentSlide].classList.add("opacity-0");
        }

        currentSlide++;

        if (currentSlide < slides.length) {
          if (slides[currentSlide]) {
            slides[currentSlide].classList.remove("opacity-0");
            slides[currentSlide].classList.add("opacity-100");
          }
        } else {
          if (activeSlideshowInterval) clearInterval(activeSlideshowInterval);
          activeSlideshowInterval = null;

          slideshow.classList.remove("opacity-100");
          slideshow.classList.add("opacity-0");

          slides.forEach((slide) => {
            slide.classList.remove("opacity-100");
            slide.classList.add("opacity-0");
          });

          video.classList.remove("opacity-0");
          video.classList.add("opacity-100");

          toggleBtn.classList.remove("opacity-0", "pointer-events-none");

          video.currentTime = 0;
          video.play().catch((err) => console.log("Replay error:", err));
        }
      }, 4000);
    }

    // 5. Video ended handler: avanza al siguiente segmento (loop infinito);
    // si no hay segmentos (fallback), inicia la secuencia de slideshow
    video.onended = () => {
      if (parts.length > 0) {
        partIndex = (partIndex + 1) % parts.length;
        playPart(partIndex);
      } else {
        video.classList.remove("opacity-100");
        video.classList.add("opacity-0");
        startSlideshow();
      }
    };

    // Cleanup interval on page transition before swap
    document.addEventListener(
      "astro:before-swap",
      () => {
        if (activeSlideshowInterval) {
          clearInterval(activeSlideshowInterval);
          activeSlideshowInterval = null;
        }
      },
      { once: true },
    );
  }

  // Init on initial load & after View Transitions navigation
  document.addEventListener("astro:page-load", initHeroVideo);
</script>
