---
// src/components/Hero.astro
// Full-screen cinematic hero: autoplay video -> slideshow fallback, audio toggle,
// editorial headline with hero micro-label.
import { Image, getImage } from "astro:assets";
import { useTranslations, type Locale } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";
import BookingWidget from "../components/BookingWidget.astro";

import slide1 from "../assets/hotel/hero-slide-patio.jpg";
import slide2 from "../assets/hotel/hero-frame-1.jpg";
import slide3 from "../assets/hotel/hero-frame-2.jpg";
import slide4 from "../assets/hotel/hero-frame-3.jpg";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const optimizedPoster = await getImage({
  src: slide1,
  width: 1280,
  quality: 80,
  format: "avif",
});

const slides = [slide1, slide2, slide3, slide4];
---

<link rel="preload" href={optimizedPoster.src} as="image" type="image/avif" />

<section
  class="relative h-dvh min-h-[500px] sm:min-h-[600px] flex items-center justify-center"
  id="hero"
>
  <!-- Poster AVIF como capa de fondo: candidato LCP inmediato (el video
       arranca retrasado post-preloader; este img garantiza un LCP de imagen
       128KB en vez del primer frame del MP4) y fallback visual nítido
       mientras el video bufferiza. El video queda por encima (z-0 tras él). -->
  <img
    src={optimizedPoster.src}
    alt=""
    aria-hidden="true"
    width="1280"
    height="720"
    fetchpriority="high"
    class="absolute inset-0 w-full h-full object-cover z-0"
  />
  <!-- Video Background (3 segmentos encadenados: cada parte arranca al terminar la anterior) -->
  <video
    autoplay
    muted
    playsinline
    preload="metadata"
    class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 z-0 opacity-100"
    poster={optimizedPoster.src}
    id="hero-video"
    data-video-parts={JSON.stringify({
      desktop: ["/videos/hero-2.mp4", "/videos/hero-1.mp4", "/videos/hero-3.mp4"],
      mobile: ["/videos/hero-mobile-2.mp4", "/videos/hero-mobile-1.mp4", "/videos/hero-mobile-3.mp4"],
    })}
  >
  </video>

  <!-- Slideshow Background (solo fallback del video; hidden inicial para que
         Chrome NO descargue las imagenes (opacity-0 no basta — se descargaban
         ~800KB invisibles en cada visita). startSlideshow() lo muestra y
         forceEager activa las imagenes bajo demanda. -->
    <div
      id="hero-slideshow"
      class="hidden absolute inset-0 w-full h-full opacity-0 pointer-events-none transition-opacity duration-1000 z-0"
    >
    {slides.map((slide, i) => (
      <div class="absolute inset-0 transition-opacity duration-1000 opacity-0" data-slide={i}>
        <Image
          src={slide}
          alt={`${t('hero.slideAlt')} ${i + 1}`}
          width={1600}
          height={900}
          layout="none"
          format="avif"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    ))}
  </div>

  <!-- Dark Overlay (permanente: el hero es sticky, el contenido sube por encima
       y el fondo debe mantenerse oscuro — "periodico" del dueño, 2026-08-15) -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/30 to-black/60">
  </div>
  <div class="absolute inset-0 bg-black/[0.05] pointer-events-none" aria-hidden="true"></div>

  <!-- Wipe de transicion entre segmentos de video (GSAP: clip-path + borde dorado) -->
  <div
    id="hero-wipe"
    class="absolute inset-0 z-[5] pointer-events-none opacity-0"
    style="clip-path: inset(0 0 100% 0); background: linear-gradient(to bottom, rgba(212,175,55,0.95) 0px, rgba(212,175,55,0.95) 3px, rgba(8,8,10,0.97) 3px, rgba(8,8,10,0.97) 100%);"
    aria-hidden="true"
  ></div>

  <!-- Overlay "cargando video" (patrón YouTube, 2026-08-16): visible mientras
         el MP4 bufferiza antes del primer frame reproducible. En red lenta el
         usuario ve el poster + "Cargando video…" (sensacion de carga a proposito,
         no pantalla muerta); desaparece con fade en 'playing'. Timeout 12s de
         seguridad: si el autoplay esta bloqueado, el poster queda y el texto se va. -->
    <div
      id="hero-video-loading"
      class="absolute inset-0 z-[3] flex items-center justify-center opacity-0 transition-opacity duration-500 pointer-events-none"
      aria-hidden="true"
    >
      <div class="flex flex-col items-center gap-3">
        <svg class="w-9 h-9 text-gold animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" stroke-opacity="0.25" />
          <path d="M21 12a9 9 0 0 0-9-9" stroke-linecap="round" />
        </svg>
        <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-white/80">{t('hero.loadingVideo')}</span>
      </div>
    </div>

    <!-- Content (estructura de produccion -- revert 2026-08-15: el dueño pidio
         "que se vea como prod"; prod = centrado + h1 puro, el wrap del titulo en
         dos lineas lo da el fluid-h1 segun el viewport) -->
  <div class="relative z-10 text-center text-white px-4 max-w-4xl mx-auto">
    <h1 id="hero-title-reveal" class="font-display fluid-h1 mb-4 sm:mb-6 drop-shadow-lg leading-tight">
      {t("hero.title")}
    </h1>
    <p class="text-base sm:text-xl lg:text-2xl font-light tracking-wide opacity-90 mb-6 sm:mb-8">
      {t("hero.subtitle")}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={getRelativeLocaleUrl(lang, "book")}
        class="btn-primary btn-shimmer font-semibold px-9 py-4 rounded-full text-lg shadow-2xl"
      >
        {t("hero.cta")}
      </a>
      <a
              href="#rooms"
              class="border border-white/60 hover:border-white/90 bg-white/5 hover:bg-white/10 text-white px-8 py-3.5 rounded-full transition-[border-color,background-color,color] duration-300 text-lg"
            >
              {t("hero.ctaSecondary")}
            </a>
    </div>
  </div>

  <!-- Booking widget integrado al hero (barra inferior, sm+) -->
  <BookingWidget />

  <!-- Video Audio Toggle (solo desktop: en movil el video siempre va muted y
         el boton congestionaba la esquina con WhatsApp + barra sticky) -->
    <button
      id="video-audio-toggle"
      class="hidden sm:flex absolute bottom-36 right-6 z-10 w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm items-center justify-center hover:bg-white/30 transition-[background-color] duration-300"
    aria-label={t('hero.toggleAudio')}
    aria-pressed="false"
  >
    <!-- Muted icon -->
    <svg id="muted-icon" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
    </svg>
    <!-- Unmuted icon (hidden by default) -->
    <svg id="unmuted-icon" class="w-5 h-5 text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path>
    </svg>
  </button>

</section>

<script>
  import { initHeroVideo } from "../features/animations/modules/heroVideo";

  // Init en carga inicial y tras navegación View Transitions (patrón del repo:
  // los módulos del engine escuchan astro:page-load y limpian en before-swap).
  document.addEventListener("astro:page-load", () => {
    const cleanup = initHeroVideo();
    document.addEventListener("astro:before-swap", () => cleanup(), { once: true });
  });
</script>
