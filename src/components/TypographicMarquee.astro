---
// src/components/TypographicMarquee.astro
// Divisor tipográfico editorial — Animación nativa CSS en GPU (0% CPU main thread).
interface Props {
  items: string[];
  reverse?: boolean;
}

const { items, reverse = false } = Astro.props;
---

<div class="marquee-tipographic overflow-hidden relative select-none py-6 sm:py-10" aria-hidden="true">
  <div class={reverse ? "marquee-css-track-reverse" : "marquee-css-track"}>
    {[0, 1].map(() => (
      <span class="marquee-tipographic-text">
        {items.map((item) => (
          <>
            <span class="whitespace-nowrap">{item}</span>
            <span class="text-secondary marquee-tipographic-star" aria-hidden="true">✦</span>
          </>
        ))}
      </span>
    ))}
  </div>
</div>

