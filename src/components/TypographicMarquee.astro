---
// src/components/TypographicMarquee.astro
// Editorial typographic marquee divider — CSS track animation, GSAP-driven speed via initTypographicMarquee.
interface Props {
  items: string[];
  reverse?: boolean;
}

const { items, reverse = false } = Astro.props;
---

<div class="marquee-tipographic overflow-hidden relative select-none py-6 sm:py-10" aria-hidden="true" data-reverse={reverse ? 'true' : 'false'}>
  <div class="flex w-max marquee-tipographic-track">
    {[0, 1].map(() => (
      <span class="marquee-tipographic-text">
        {items.map((item) => (
          <>
            <span class="whitespace-nowrap">{item}</span>
            <span class="text-secondary marquee-tipographic-star" aria-hidden="true">✦</span>
          </>
        ))}
      </span>
    ))}
  </div>
</div>

<script>
  import { initTypographicMarquee } from '../features/animations/modules/typographicMarquee';
  import { register } from '../features/animations/animationLifecycle';

  function initMarquees() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const containers = document.querySelectorAll<HTMLElement>('.marquee-tipographic');
    containers.forEach((container, i) => {
      const reverse = container.dataset.reverse === 'true';
      register(`typographic-${i}`, initTypographicMarquee(container, reverse));
    });
  }

  document.addEventListener('astro:page-load', initMarquees);
</script>
