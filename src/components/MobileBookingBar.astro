---
import { rooms } from '../data/rooms';
import { useTranslations, type Locale } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const roomTypes = rooms.map(r => ({ value: r.slug, label: r.name[lang] }));
const bookUrl = getRelativeLocaleUrl(lang, 'book');
---

<!-- Fixed Mobile Bottom Booking Bar (Option 1: Always Visible on Mobile) -->
<div
  id="mobile-bottom-bar"
  class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-surface-card-light/95 dark:bg-surface-card-dark/95 backdrop-blur-md border-t border-black/10 dark:border-white/10 shadow-[0_-4px_20px_rgba(0,0,0,0.15)] transition-transform duration-300 pb-safe"
>
  <div class="px-4 py-2.5 flex items-center justify-between gap-3">
    <!-- Left Info / Price indication -->
    <div class="flex flex-col">
      <span class="text-[10px] font-bold uppercase tracking-wider text-secondary-dark dark:text-secondary flex items-center gap-1">
        <svg class="w-3 h-3 text-secondary-dark dark:text-secondary" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
        </svg>
        {t('booking.title')}
      </span>
      <span class="text-xs font-semibold text-text-primary-light dark:text-text-primary-dark">
        {t('booking.bestRateGuaranteed')}
      </span>
    </div>

    <!-- Right Action Button -->
    <button
      id="open-mobile-booking-sheet"
      type="button"
      class="bg-gold-vibrant hover:bg-gold-vibrant-hover active:scale-[0.98] text-stone-900 font-extrabold text-sm px-5 py-2.5 rounded-xl transition-[transform,background-color] shadow-md shadow-gold-vibrant/30 flex items-center gap-2 touch-target"
      aria-expanded="false"
      aria-controls="mobile-booking-sheet"
    >
      <svg class="w-4 h-4 text-stone-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span>{t('nav.bookNow')}</span>
    </button>
  </div>
</div>

<!-- Mobile Bottom Sheet Drawer for Booking Form -->
<div
  id="mobile-booking-sheet"
  class="fixed inset-0 z-50 hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-booking-sheet-title"
>
  <!-- Backdrop -->
  <div id="mobile-sheet-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 hidden"></div>

  <!-- Modal Sheet Panel -->
  <div
    id="mobile-sheet-panel"
    class="absolute bottom-0 left-0 right-0 max-h-[90dvh] bg-surface-card-light dark:bg-surface-card-dark rounded-t-3xl shadow-2xl flex flex-col pb-safe overflow-y-auto"
    style="transform: translateY(100%);"
  >
    <!-- Handle indicator & Header -->
    <div class="sticky top-0 z-10 bg-surface-card-light dark:bg-surface-card-dark pt-3 pb-2 px-6 border-b border-black/10 dark:border-white/10 flex flex-col items-center">
      <div class="w-12 h-1.5 rounded-full bg-black/20 dark:bg-white/20 mb-3"></div>
      <div class="w-full flex items-center justify-between">
        <h3 id="mobile-booking-sheet-title" class="text-base font-bold text-text-primary-light dark:text-text-primary-dark flex items-center gap-2">
          <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {t('booking.title')}
        </h3>
        <button
          id="close-mobile-booking-sheet"
          type="button"
          class="touch-target p-2 rounded-full text-text-secondary-light hover:text-text-primary-light dark:text-text-secondary-dark dark:hover:text-text-primary-dark"
          aria-label={t('global.close')}
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Form Body -->
    <form id="mobile-sheet-booking-form" action={bookUrl} method="GET" class="p-6 flex flex-col gap-4">
      <!-- Check-in & Check-out in 2 columns -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="mb-checkin" class="block text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
            {t('booking.checkin')}
          </label>
          <input
            type="date"
            id="mb-checkin"
            name="checkin"
            class="w-full px-3 py-3 rounded-xl bg-surface-light dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm font-medium text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none"
            required
          />
        </div>

        <div>
          <label for="mb-checkout" class="block text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
            {t('booking.checkout')}
          </label>
          <input
            type="date"
            id="mb-checkout"
            name="checkout"
            class="w-full px-3 py-3 rounded-xl bg-surface-light dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm font-medium text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none"
            required
          />
        </div>
      </div>

      <!-- Guests -->
      <div>
        <label for="mb-guests" class="block text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
          {t('booking.guests')}
        </label>
        <select
          id="mb-guests"
          name="guests"
          class="w-full px-4 py-3 rounded-xl bg-surface-light dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm font-medium text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none appearance-none"
        >
          <option value="1">1 {t('booking.guest')}</option>
          <option value="2" selected>2 {t('booking.guests_plural')}</option>
          <option value="3">3 {t('booking.guests_plural')}</option>
          <option value="4">4 {t('booking.guests_plural')}</option>
          <option value="5">5 {t('booking.guests_plural')}</option>
        </select>
      </div>

      <!-- Room Type -->
      <div>
        <label for="mb-room-type" class="block text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
          {t('booking.roomType')}
        </label>
        <select
          id="mb-room-type"
          name="room-type"
          class="w-full px-4 py-3 rounded-xl bg-surface-light dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm font-medium text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none appearance-none"
        >
          <option value="">{t('booking.anyRoom')}</option>
          {roomTypes.map(rt => (
            <option value={rt.value}>{rt.label}</option>
          ))}
        </select>
      </div>

      <!-- Submit Button -->
      <button
        type="submit"
        class="w-full mt-2 bg-secondary hover:bg-secondary-dark active:scale-[0.98] text-text-primary-light font-bold py-3.5 px-6 rounded-xl transition-[transform,background-color] shadow-lg shadow-secondary/25 text-center text-sm uppercase tracking-wider cursor-pointer"
      >
        {t('booking.search')}
      </button>
    </form>
  </div>
</div>

<script>
  import gsap from 'gsap';

  let ctx: gsap.Context;

  function initMobileBookingBar() {
    if (ctx) ctx.revert();
    
    const abortController = new AbortController();
    const signal = abortController.signal;

    const openBtn = document.getElementById('open-mobile-booking-sheet');
    const closeBtn = document.getElementById('close-mobile-booking-sheet');
    const sheet = document.getElementById('mobile-booking-sheet');
    const backdrop = document.getElementById('mobile-sheet-backdrop');
    const panel = document.getElementById('mobile-sheet-panel');
    const checkin = document.getElementById('mb-checkin') as HTMLInputElement;
    const checkout = document.getElementById('mb-checkout') as HTMLInputElement;

    // Set default dates if empty
    if (checkin && !checkin.value) {
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(today.getDate() + 1);
      checkin.value = tomorrow.toISOString().split('T')[0];
      checkin.min = today.toISOString().split('T')[0];
    }
    if (checkout && !checkout.value && checkin) {
      const checkinDate = new Date(checkin.value);
      const dayAfter = new Date(checkinDate);
      dayAfter.setDate(checkinDate.getDate() + 1);
      checkout.value = dayAfter.toISOString().split('T')[0];
      checkout.min = checkin.value;
    }

    if (checkin && checkout) {
      checkin.addEventListener('change', () => {
        if (checkin.value) {
          const inDate = new Date(checkin.value);
          const nextDay = new Date(inDate);
          nextDay.setDate(inDate.getDate() + 1);
          const minCheckoutStr = nextDay.toISOString().split('T')[0];
          checkout.min = minCheckoutStr;
          if (checkout.value < minCheckoutStr) {
            checkout.value = minCheckoutStr;
          }
        }
      }, { signal });
    }

    // Hide bottom bar on /book page
    const isBookPage = window.location.pathname.includes('/book');
    const bottomBar = document.getElementById('mobile-bottom-bar');
    if (isBookPage && bottomBar) {
      bottomBar.classList.add('hidden');
    }

    ctx = gsap.context(() => {
      let isSheetOpen = false;
      let tl = gsap.timeline({ paused: true });
      const mm = gsap.matchMedia();

      if (sheet && backdrop && panel) {
        mm.add("(prefers-reduced-motion: no-preference)", () => {
          tl.clear();
          tl.set(sheet, { display: 'block' })
            .set(backdrop, { autoAlpha: 0, display: 'block' })
            .to(backdrop, { autoAlpha: 1, duration: 0.3, ease: 'power2.out' })
            .to(panel, { y: '0%', duration: 0.5, ease: 'power4.out' }, '<0.1');
        });

        mm.add("(prefers-reduced-motion: reduce)", () => {
          tl.clear();
          tl.set(sheet, { display: 'block' })
            .set(backdrop, { autoAlpha: 0, display: 'block' })
            .to(backdrop, { autoAlpha: 1, duration: 0.1 })
            .to(panel, { y: '0%', duration: 0.1 }, '<');
        });
      }

      function openSheet() {
        if (!sheet) return;
        isSheetOpen = true;
        document.body.style.overflow = 'hidden';
        if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
        tl.timeScale(1).play();
      }

      function closeSheet() {
        if (!sheet) return;
        isSheetOpen = false;
        document.body.style.overflow = '';
        if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
        tl.timeScale(2).reverse();
      }

      function forceCloseInstant() {
        if (isSheetOpen) {
          isSheetOpen = false;
          document.body.style.overflow = '';
          if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
          tl.progress(0).pause();
        }
      }

      openBtn?.addEventListener('click', openSheet, { signal });
      closeBtn?.addEventListener('click', closeSheet, { signal });
      backdrop?.addEventListener('click', closeSheet, { signal });

      // Clean up smoothly on Astro ViewTransitions. Registered with the per-init
      // signal: abort() below removes this listener itself, so it never
      // accumulates across SPA navigations ({ once: true } is only a safety net).
      document.addEventListener('astro:before-preparation', () => {
        forceCloseInstant();
        abortController.abort();
        if (ctx) ctx.revert();
      }, { signal, once: true });
    });
  }

  document.addEventListener('astro:page-load', initMobileBookingBar);
</script>
