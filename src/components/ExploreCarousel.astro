---
// src/components/ExploreCarousel.astro
// Horizontal magazine carousel of Cusco destinations: continuous autoplay,
// drag with inertia, scroll-boosted (shares the autoMotion engine).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeader from './ui/SectionHeader.astro';
import { attractions } from '../data/attractions';
import { useTranslations, type Locale } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import fallbackImg from '../assets/hotel/hero-slide-cusco.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const exploreImages = import.meta.glob<{ default: ImageMetadata }>('../assets/explore/*.jpg', { eager: true });

const items = attractions.map((attraction) => {
  const img = exploreImages[`../assets/explore/${attraction.id}.jpg`]?.default || fallbackImg;
  return { ...attraction, img };
});

const categoryLabels: Record<string, string> = {
  historical: t('explore.popularDestinations'),
  nature: t('explore.popularDestinations'),
  cultural: t('explore.popularDestinations'),
  adventure: t('explore.popularDestinations'),
};
---

<section class="py-12 sm:py-20 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500 overflow-hidden relative">
  <div class="max-w-[1400px] mx-auto">
    <SectionHeader
      number="08"
      eyebrow={t('explore.sectionLabel')}
      title={t('explore.title')}
      subtitle={t('explore.description')}
    />
  </div>

  <!-- Seamless magazine track (two identical copies for the loop) -->
  <div id="explore-magazine" class="magazine-container relative select-none cursor-grab active:cursor-grabbing touch-pan-y" data-reverse="false">
    <div class="absolute inset-y-0 left-0 w-20 sm:w-32 bg-gradient-to-r from-surface-light dark:from-surface-dark to-transparent z-20 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-20 sm:w-32 bg-gradient-to-l from-surface-light dark:from-surface-dark to-transparent z-20 pointer-events-none"></div>

    <div class="magazine-track flex gap-5 sm:gap-7 w-max pl-6 sm:pl-[max(1.5rem,calc((100vw-1400px)/2))] will-change-transform py-4">
      {[0, 1].map(() =>
        items.map((attraction, i) => (
          <a
            href={getRelativeLocaleUrl(lang, `explore/${attraction.id}`)}
            data-astro-prefetch="tap"
            class="magazine-card group relative w-[280px] sm:w-[360px] aspect-[4/5] rounded-3xl overflow-hidden shadow-xl border border-black/5 dark:border-white/10 flex-shrink-0 block bg-surface-card-dark"
            aria-label={attraction.name[lang]}
          >
            <Image
              src={attraction.img}
              alt={attraction.name[lang]}
              width={720}
              height={900}
              format="webp"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>

            <div class="absolute top-4 left-4">
              <span class="px-3 py-1.5 rounded-full bg-black/35 backdrop-blur-md border border-white/15 text-[10px] font-mono uppercase tracking-[0.2em] text-white/90">
                {categoryLabels[attraction.category] || attraction.category}
              </span>
            </div>

            <div class="absolute bottom-0 inset-x-0 p-5 sm:p-6">
              <h3 class="font-display text-2xl sm:text-3xl text-white leading-tight mb-2 group-hover:text-secondary transition-colors duration-300">
                {attraction.name[lang]}
              </h3>
              <div class="flex items-center gap-4 text-[11px] font-mono uppercase tracking-widest text-white/75">
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {attraction.distance}
                </span>
                <span class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {attraction.travelTime}
                </span>
              </div>
              <span class="inline-flex items-center gap-2 mt-4 text-xs font-bold uppercase tracking-widest text-secondary">
                {t('explore.viewGuide')}
                <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </a>
        ))
      )}
    </div>
  </div>

  <!-- View All -->
  <div class="text-center mt-8">
    <a
      href={getRelativeLocaleUrl(lang, "explore")}
      data-astro-prefetch="tap"
      class="inline-flex items-center gap-3 btn-primary font-semibold px-8 py-4 rounded-xl text-sm uppercase tracking-wider group"
    >
      <span>{t("explore.viewAll")}</span>
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</section>

<script>
  import { initMagazineCarousel } from '../features/animations/modules/magazineCarousel';

  let cleanup: (() => void) | null = null;

  function initCarousel() {
    const container = document.getElementById('explore-magazine') as HTMLElement | null;
    if (!container) return;

    cleanup?.();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const reverse = container.dataset.reverse === 'true';
    cleanup = initMagazineCarousel(container, reverse);
  }

  document.addEventListener('astro:page-load', initCarousel);
  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
    cleanup = null;
  }, { once: true });
</script>
