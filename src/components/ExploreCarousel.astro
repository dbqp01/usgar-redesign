---
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeader from './ui/SectionHeader.astro';
import { attractions } from '../data/attractions';
import { useTranslations, type Locale } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import fallbackImg from '../assets/hotel/hero-slide-cusco.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const exploreImages = import.meta.glob<{ default: ImageMetadata }>('../assets/explore/*.jpg', { eager: true });

const items = await Promise.all(attractions.map(async (attraction) => {
  const image = exploreImages[`../assets/explore/${attraction.id}.jpg`]?.default || fallbackImg;
  const preview = await getImage({
    src: image,
    format: 'avif',
    width: 1200,
    quality: 'high',
  });

  return { ...attraction, image, previewSrc: preview.src };
}));

const categoryLabels: Record<string, string> = {
  historical: t('explore.popularDestinations'),
  nature: t('explore.popularDestinations'),
  cultural: t('explore.popularDestinations'),
  adventure: t('explore.popularDestinations'),
};
---

<section class="relative overflow-hidden bg-surface-light px-4 py-16 transition-colors duration-500 dark:bg-surface-dark sm:py-24">
  <div class="mx-auto max-w-[1400px]">
    <SectionHeader
      number="06"
      eyebrow={t('explore.sectionLabel')}
      title={t('explore.title')}
      subtitle={t('explore.description')}
    />

    <div id="explore-atlas" data-explore-atlas class="grid gap-5 sm:gap-7 lg:grid-cols-[minmax(0,1.2fr)_minmax(360px,0.8fr)] lg:items-stretch">
      <div data-atlas-preview class="relative isolate min-h-[440px] overflow-hidden rounded-[1.75rem] border border-black/10 bg-surface-card-dark shadow-xl sm:min-h-[620px]">
        <div data-atlas-preview-media class="absolute inset-0 overflow-hidden">
          {items.map((item, index) => (
            <div
              data-atlas-slide={index}
              class={`absolute inset-0 block h-full w-full transition-opacity duration-500 ease-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
            >
              <Picture
                src={item.image}
                alt={item.name[lang]}
                formats={['webp']}
                fallbackFormat="webp"
                quality="medium"
                widths={[800, 1200]}
                sizes="(max-width: 768px) 100vw, 800px"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/20 to-transparent"></div>
        <div class="absolute left-5 top-5 z-10 flex items-center gap-3 text-[10px] font-mono uppercase tracking-[0.25em] text-white/80 sm:left-7 sm:top-7">
          <span class="text-secondary">{categoryLabels[items[0].category]}</span>
          <span class="h-px w-8 bg-secondary"></span>
          <span data-atlas-position>01 / {String(items.length).padStart(2, '0')}</span>
        </div>
        <div class="absolute inset-x-5 bottom-5 z-10 sm:inset-x-8 sm:bottom-8">
          <p class="mb-3 text-[10px] font-mono uppercase tracking-[0.25em] text-secondary">{t('explore.sectionLabel')}</p>
          <h3 data-atlas-name aria-live="polite" class="max-w-[12ch] font-display text-4xl leading-[0.92] text-white sm:text-7xl">{items[0].name[lang]}</h3>
          <p data-atlas-meta class="mt-5 text-xs font-mono uppercase tracking-[0.18em] text-white/75">{items[0].distance} / {items[0].travelTime}</p>
        </div>
      </div>

      <nav aria-label={t('explore.title')} class="rounded-[1.75rem] border border-black/10 bg-surface-card-light p-3 dark:border-white/10 dark:bg-surface-card-dark sm:p-5">
        <div class="flex h-full flex-col divide-y divide-black/10 dark:divide-white/10">
          {items.map((attraction, index) => (
            <a
              href={getRelativeLocaleUrl(lang, `explore/${attraction.id}`)}
              data-astro-prefetch="viewport"
              data-atlas-item
              data-preview-src={attraction.previewSrc}
              data-preview-name={attraction.name[lang]}
              data-preview-meta={`${attraction.distance} / ${attraction.travelTime}`}
              data-preview-category={categoryLabels[attraction.category]}
              data-preview-position={`${String(index + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`}
              data-cursor-label="EXPLORAR"
              aria-current={index === 0 ? 'true' : 'false'}
              class:list={[
                'group flex min-h-[58px] flex-1 items-center gap-3 px-3 py-3 outline-none transition-colors sm:min-h-0 sm:px-4 sm:py-3.5',
                index === 0 ? 'is-active' : '',
              ]}
            >
              <span class="w-8 flex-shrink-0 font-mono text-[10px] text-secondary">{String(index + 1).padStart(2, '0')}</span>
              <span class="min-w-0 flex-1">
                <span class="block truncate font-display text-lg leading-none text-text-primary-light transition-colors group-hover:text-secondary dark:text-white sm:text-xl">{attraction.name[lang]}</span>
                <span class="mt-1 block text-[9px] font-mono uppercase tracking-[0.16em] text-text-secondary-light dark:text-text-secondary-dark">{attraction.distance} / {attraction.travelTime}</span>
              </span>
              <svg class="h-4 w-4 flex-shrink-0 -translate-x-1 text-secondary opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          ))}
        </div>
      </nav>
    </div>

    <div class="mt-10 text-center sm:mt-12">
      <a
        href={getRelativeLocaleUrl(lang, 'explore')}
        data-astro-prefetch="tap"
        class="group inline-flex items-center gap-3 rounded-xl px-8 py-4 text-sm font-semibold uppercase tracking-wider btn-primary"
      >
        <span>{t('explore.viewAll')}</span>
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { initExploreAtlas } from '../features/animations/modules/exploreAtlas';

  let cleanup: (() => void) | null = null;

  function init() {
    const root = document.querySelector('[data-explore-atlas]') as HTMLElement | null;
    if (!root) return;
    cleanup?.();
    cleanup = initExploreAtlas(root);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  [data-atlas-item].is-active {
    background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
  }

  [data-atlas-item].is-active > span:first-child {
    color: var(--color-secondary);
  }
</style>
