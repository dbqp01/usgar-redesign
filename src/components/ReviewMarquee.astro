---
import { reviews } from '../data/reviews';
import { useTranslations, type Locale } from '../i18n/utils';
import PlatformLogo from './icons/PlatformLogos.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const platforms = [
  { id: 'tripadvisor', name: 'TRIPADVISOR', text: 'text-emerald-500', label: 'VERIFIED TRIPADVISOR REVIEW' },
  { id: 'booking', name: 'BOOKING.COM', text: 'text-blue-600', label: 'VERIFIED BOOKING.COM GUEST' },
  { id: 'google', name: 'GOOGLE', text: 'text-google-blue', label: 'VERIFIED GOOGLE LOCAL GUIDE' },
  { id: 'expedia', name: 'EXPEDIA', text: 'text-amber-500', label: 'VERIFIED EXPEDIA TRAVELER' },
] as const;

// URLs públicas de reseñas del hotel (scores reales extraídos 2026-08-15).
// El ribbon y las tarjetas enlazan a las plataformas (target _blank).
const platformUrls = {
  booking: 'https://www.booking.com/hotel/pe/chavin-imperio-del-sol.html',
  kayak: 'https://www.kayak.com/Cusco-Hotels-Hotel-Chavin-Imperio-del-Sol.2938418.ksp',
  expedia: 'https://www.expedia.com/Cusco-Hotels-Hotel-Chavin-Imperio-Del-Sol.h22328886.Hotel-Information',
};
---

<section id="velocity-marquee-section" class="scroll-mt-28 sm:scroll-mt-32 py-8 sm:py-12 bg-surface-light dark:bg-surface-dark transition-colors duration-500 overflow-hidden relative z-10">
  <div class="max-w-7xl mx-auto px-4 mb-12 text-center relative z-10">
    <div class="inline-flex items-center gap-3 text-secondary text-xs font-mono tracking-[0.3em] uppercase mb-3">
      <span class="w-8 h-px bg-secondary"></span>
      {t('reviews.sectionLabel')}
      <span class="w-8 h-px bg-secondary"></span>
    </div>
    
    <h2 class="font-display text-4xl sm:text-6xl text-text-primary-light dark:text-white tracking-tight">
      {t('reviews.title')}
    </h2>
    <p class="text-text-secondary-light dark:text-text-secondary-dark max-w-xl mx-auto mt-4 text-base sm:text-lg font-light font-body leading-relaxed">
      {t('reviews.description')}
    </p>

    <!-- Editorial Reputation Metrics Header Bar (scores reales extraidos 2026-08-15:
         Booking.com 8.7/414, KAYAK 8.7/683, Expedia 8.6) -->
    <div class="flex flex-wrap items-center justify-center gap-8 mt-10 pt-8 border-t border-black/10 dark:border-white/10 text-xs font-mono uppercase tracking-widest text-text-secondary-light dark:text-text-secondary-dark">
      <a href={platformUrls.booking} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:opacity-75 transition-opacity" aria-label="Ver reviews en Booking.com (nueva pestaña)">
        <PlatformLogo platform="booking" class="w-4 h-4 text-blue-600" />
        <span data-score="booking" class="text-text-primary-light dark:text-white font-bold">8.7 / 10</span>
        <span data-count="booking" class="text-slate-400">(414 REVIEWS)</span>
      </a>
      <div class="hidden sm:block text-slate-300 dark:text-slate-700">|</div>
      <a href={platformUrls.kayak} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:opacity-75 transition-opacity" aria-label="Ver reviews en KAYAK (nueva pestaña)">
        <PlatformLogo platform="kayak" class="w-4 h-4 text-rose-500" />
        <span data-score="kayak" class="text-text-primary-light dark:text-white font-bold">8.7 / 10</span>
        <span data-count="kayak" class="text-slate-400">(683 REVIEWS)</span>
      </a>
      <div class="hidden sm:block text-slate-300 dark:text-slate-700">|</div>
      <a href={platformUrls.expedia} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:opacity-75 transition-opacity" aria-label="Ver reviews en Expedia (nueva pestaña)">
        <PlatformLogo platform="expedia" class="w-4 h-4 text-amber-500" />
        <span data-score="expedia" class="text-text-primary-light dark:text-white font-bold">8.6 / 10</span>
        <span data-count="expedia" class="text-slate-400">(EXCELLENT)</span>
      </a>
    </div>
  </div>

  <!-- Marquee Track Container (CSS GPU Accelerated) -->
  <div id="marquee-track-container" class="overflow-hidden relative w-full py-4 select-none z-10">
    <!-- Gradient Edge Vignettes matching theme -->
    <div class="absolute inset-y-0 left-0 w-28 bg-gradient-to-r from-surface-light dark:from-surface-dark to-transparent z-20 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-28 bg-gradient-to-l from-surface-light dark:from-surface-dark to-transparent z-20 pointer-events-none"></div>

    <!-- GPU CSS Marquee Track -->
    <div id="velocity-marquee-track" class="marquee-css-track gap-8">
      {
        [...reviews, ...reviews].map((review) => {
          // Todas las reseñas mostradas son de Booking.com (extraidas 2026-08-15)
          const platform = platforms[1];

          return (
            <a
              href={platformUrls.booking}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-shrink-0 w-[300px] sm:w-[380px] bg-white dark:bg-surface-card-dark p-8 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] dark:shadow-none dark:border dark:border-white/10 space-y-6 group flex flex-col justify-between hover:shadow-[0_12px_40px_rgb(0,0,0,0.1)] transition-shadow"
            >
              <div>
                <!-- Top Header: Quote Mark & Platform Logo -->
                <div class="flex items-start justify-between mb-4">
                  <div class="text-cream-lavender dark:text-secondary font-serif text-6xl leading-none mt-2 select-none">
                    &rdquo;
                  </div>
                  <div class="flex flex-col items-end gap-1">
                    <PlatformLogo platform={platform.id} class={`w-7 h-7 ${platform.text}`} />
                    <span class="px-2 py-1 bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/10 rounded uppercase text-[8px] font-bold tracking-widest text-slate-500 dark:text-slate-400">
                      {platform.name}
                    </span>
                  </div>
                </div>

                <!-- Golden Stars (filled: outline read as broken next to the scores) -->
                <div class="flex gap-1 text-secondary mb-6" aria-label={`Rating: ${review.rating || 5} out of 5 stars`}>
                  {Array.from({ length: review.rating || 5 }).map(() => (
                    <svg class="w-4 h-4 fill-current" aria-hidden="true" viewBox="0 0 24 24">
                      <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385c.114.481-.433.879-.861.644l-4.66-2.533a.562.562 0 00-.542 0l-4.66 2.533c-.428.235-.975-.163-.861-.644l1.285-5.385a.563.563 0 00-.182-.557l-4.204-3.602a.563.563 0 00.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                    </svg>
                  ))}
                </div>
                
                <!-- Card Body Quote -->
                <p class="text-xl text-text-primary-light dark:text-slate-100 font-serif italic leading-relaxed">
                  "{review.text[lang] || review.text.en || review.text.es}"
                </p>
              </div>
              
              <!-- Divider & Footer Info -->
              <div>
                <hr class="my-6 border-slate-100 dark:border-white/10" />
                <div class="flex items-center gap-4">
                  <!-- Avatar Circle -->
                  <div class="w-12 h-12 rounded-full bg-primary-dark dark:bg-black/50 border border-primary/20 dark:border-white/10 flex items-center justify-center text-white font-body font-semibold tracking-wider text-sm flex-shrink-0">
                    {review.name.split(' ').map((n: string) => n[0]).join('').substring(0, 2).toUpperCase()}
                  </div>
                  <!-- Name & Country -->
                  <div>
                    <span class="block text-sm font-bold text-text-primary-light dark:text-white">
                      {review.name}
                    </span>
                    <span class="block text-[10px] uppercase tracking-widest text-text-secondary-light dark:text-slate-400 mt-1 font-medium">
                      {review.country && `${review.country} / `}{review.date[lang] || review.date.en}
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Ribbon de scores: actualiza los números desde /api/reviews-score (cron
  // refresh-reviews, ver docs/API.md). Fallback: si el endpoint falla o no
  // hay datos, se conservan los valores del build.
  document.addEventListener("astro:page-load", () => {
    const scoreEls: Record<string, Element | null> = {
      booking: document.querySelector('[data-score="booking"]'),
      kayak: document.querySelector('[data-score="kayak"]'),
      expedia: document.querySelector('[data-score="expedia"]'),
    };
    const countEls: Record<string, Element | null> = {
      booking: document.querySelector('[data-count="booking"]'),
      kayak: document.querySelector('[data-count="kayak"]'),
      expedia: document.querySelector('[data-count="expedia"]'),
    };
    fetch("/api/reviews-score", { headers: { Accept: "application/json" } })
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data || !data.scores) return;
        (["booking", "kayak", "expedia"] as const).forEach((key) => {
          const s = data.scores[key];
          if (!s) return;
          if (scoreEls[key] && s.score) scoreEls[key]!.textContent = `${s.score} / 10`;
          if (countEls[key] && s.count) countEls[key]!.textContent = `(${s.count} REVIEWS)`;
        });
      })
      .catch(() => {});
  });
</script>
