---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import { siteSettings } from '../data/settings';
import { locationCopy, locationRoutes, type LocationSlug } from '../i18n/location';
import type { Locale } from '../i18n/utils';
import marketImage from '../assets/explore/san-pedro-market.jpg';
import hotelImage from '../assets/home/about/patio.jpg';
import { socialImage } from '../utils/ogImage';

interface Props { slug: LocationSlug }
const { slug } = Astro.props;
const lang = (Astro.currentLocale || 'en') as Locale;
const text = locationCopy[lang];
const key = locationRoutes[slug];
const page = text[key];
const otherSlug = key === 'market' ? 'near-san-pedro-station' : 'near-san-pedro-market';
const other = text[locationRoutes[otherSlug]];
const image = key === 'market' ? marketImage : hotelImage;
---

<Layout title={page.title} description={page.description} lang={lang} ogImage={await socialImage(image)}>
  <section class="relative overflow-hidden bg-stone-950 text-white">
    <Image src={image} alt="" layout="full-width" format="avif" loading="eager" decoding="async" class="absolute inset-0 h-full w-full object-cover opacity-40" />
    <div class="absolute inset-0 bg-gradient-to-r from-stone-950/90 via-stone-950/65 to-stone-950/30"></div>
    <div class="relative mx-auto max-w-[1400px] px-6 pb-20 pt-36 sm:px-10 sm:pb-28 sm:pt-44">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.25em] text-secondary">{text.eyebrow}</p>
      <h1 class="mt-5 max-w-4xl font-display text-4xl leading-[1.08] sm:text-6xl lg:text-7xl">{page.heading}</h1>
      <p class="mt-6 max-w-2xl font-body text-base leading-relaxed text-white/85 sm:text-lg">{page.lead}</p>
      <a href={getRelativeLocaleUrl(lang, 'book')} class="btn-primary mt-8 inline-flex rounded-full px-7 py-3.5 text-sm font-semibold">{text.bookLink}</a>
    </div>
  </section>

  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 sm:px-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-20 lg:py-24">
    <article class="space-y-12">
      {page.sections.map((section) => (
        <section class="space-y-4">
          <h2 class="font-display text-3xl text-text-primary-light dark:text-white sm:text-4xl">{section.heading}</h2>
          <p class="max-w-3xl font-body text-base leading-8 text-text-secondary-light dark:text-text-secondary-dark sm:text-lg">{section.body}</p>
        </section>
      ))}
      <div class="flex flex-wrap gap-x-7 gap-y-4 border-t border-black/10 pt-8 dark:border-white/10">
        <a href={getRelativeLocaleUrl(lang, 'rooms')} class="font-semibold text-primary underline underline-offset-4 dark:text-secondary">{text.roomsLink}</a>
        <a href={getRelativeLocaleUrl(lang, 'explore/san-pedro-market')} class="font-semibold text-primary underline underline-offset-4 dark:text-secondary">{text.marketGuide}</a>
        <a href={getRelativeLocaleUrl(lang, 'contact')} class="font-semibold text-primary underline underline-offset-4 dark:text-secondary">{text.contactLink}</a>
      </div>
    </article>

    <aside class="h-fit rounded-3xl border border-black/10 bg-surface-card-light p-7 dark:border-white/10 dark:bg-surface-card-dark lg:sticky lg:top-28">
      <p class="font-mono text-xs font-semibold uppercase tracking-widest text-secondary">{text.addressLabel}</p>
      <p class="mt-3 font-display text-2xl text-text-primary-light dark:text-white">{siteSettings.hotelName}</p>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">{siteSettings.address[lang]}</p>
      <p class="mt-6 text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark">{text.bookingNote}</p>
      <a href={getRelativeLocaleUrl(lang, 'book')} class="btn-primary mt-6 flex justify-center rounded-full px-5 py-3 text-sm font-semibold">{text.bookLink}</a>
      <div class="mt-8 border-t border-black/10 pt-6 dark:border-white/10">
        <p class="text-xs uppercase tracking-widest text-text-secondary-light dark:text-text-secondary-dark">{text.relatedLabel}</p>
        <a href={getRelativeLocaleUrl(lang, `stay/${otherSlug}`)} class="mt-3 inline-block font-semibold text-primary underline underline-offset-4 dark:text-secondary">{other.link}</a>
      </div>
    </aside>
  </div>
</Layout>
