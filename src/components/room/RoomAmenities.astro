---
// src/components/room/RoomAmenities.astro
// Servicios COMPLETOS del hotel (fuente: lista oficial del cliente): secciones
// "Servicios del hotel" + "Servicios en la habitacion". Son globales del hotel,
// identicas para todas las habitaciones (src/data/hotelServices.ts).
import { hotelServices, roomServices } from "../../data/hotelServices";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

function label(item: { label: Record<string, string> }, locale: Locale): string {
  return item.label[locale] || item.label.en || item.label.es;
}
---

<div class="space-y-10">
  <!-- Servicios del hotel -->
  <section>
    <h2 class="font-display text-2xl md:text-3xl mb-6">
      {t('room.hotelServices')}
    </h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
      {
        hotelServices.map((item) => (
          <li class="flex items-start gap-3 text-sm text-text-secondary-light dark:text-text-secondary-dark">
            <svg class="w-4 h-4 text-teal-brand mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{label(item, lang)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="border-black/5 dark:border-white/5" />

  <!-- Servicios en la habitacion -->
  <section>
    <h2 class="font-display text-2xl md:text-3xl mb-6">
      {t('room.inRoomServices')}
    </h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
      {
        roomServices.map((item) => (
          <li class="flex items-start gap-3 text-sm text-text-secondary-light dark:text-text-secondary-dark">
            <svg class="w-4 h-4 text-teal-brand mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{label(item, lang)}</span>
          </li>
        ))
      }
    </ul>
  </section>
</div>
