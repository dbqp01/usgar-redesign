---
// src/components/room/RoomGallery.astro
// Interactive room slider (large image + thumbnails) + premium lightbox.
// All IDs match the RoomDetail script contract (unchanged behavior).
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Room } from "../../data/rooms";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  images: ImageMetadata[];
  room: Room;
  lang: Locale;
}

const { images, room, lang } = Astro.props;
const t = useTranslations(lang);

// URLs optimizadas para el swap del slider (evita servir el original full-res)
const sliderSrcs = (
  await Promise.all(
    images.map((img) =>
      getImage({ src: img, width: 1600, format: "webp", quality: "high" }),
    ),
  )
).map((img) => img.src);
---

<!-- Interactive Room Slider / Gallery -->
<div
  id="room-gallery-slider"
  class="relative w-full mb-12 animate-on-scroll"
  data-images={JSON.stringify(sliderSrcs)}
>
  <!-- Large Active Image Display -->
  <div class="relative w-full aspect-[16/9] md:aspect-[21/9] rounded-2xl overflow-hidden shadow-lg border border-black/5 dark:border-white/5 group">
    <div class="w-full h-full relative">
      <Image
        id="active-gallery-image"
        src={images[0]}
        alt={room.name[lang]}
        width={1600}
        height={900}
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover transition-opacity duration-300"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>

      <!-- Click to Zoom / Expand Indicator -->
      <button
        id="gallery-zoom-trigger"
        class="absolute bottom-6 right-6 bg-black/45 hover:bg-primary/95 text-white backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10 flex items-center gap-2 lg:hover:scale-105 transition-[transform,background-color] duration-300 shadow-md text-sm cursor-pointer"
        aria-label={t('room.expandPhoto')}
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
        </svg>
        <span>{t('room.zoom')}</span>
      </button>

      <!-- Navigation Arrows over main image -->
      <button
        id="slider-prev-arrow"
        class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/35 hover:bg-primary/90 text-white backdrop-blur-sm flex items-center justify-center border border-white/10 opacity-0 group-hover:opacity-100 transition-[opacity,transform,background-color] cursor-pointer lg:hover:scale-105"
        aria-label="Previous image"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="slider-next-arrow"
        class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/35 hover:bg-primary/90 text-white backdrop-blur-sm flex items-center justify-center border border-white/10 opacity-0 group-hover:opacity-100 transition-[opacity,transform,background-color] cursor-pointer lg:hover:scale-105"
        aria-label="Next image"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Thumbnails Row Below -->
  <div class="mt-4 flex flex-wrap gap-2 md:gap-3 justify-center">
    {images.map((img, idx) => (
      <button
        class={`gallery-thumb-selector-btn relative aspect-[4/3] w-20 sm:w-28 md:w-32 rounded-xl overflow-hidden border-2 cursor-pointer transition-[transform,border-color,opacity] duration-300 lg:hover:scale-105 shadow-sm ${idx === 0 ? 'border-primary' : 'border-transparent opacity-60 hover:opacity-100'}`}
        data-thumb-index={idx}
        aria-label={`View photo ${idx + 1}`}
      >
        <Image
          src={img}
          alt={`${room.name[lang]} thumb - ${idx + 1}`}
          width={300}
          height={225}
          layout="none"
          format="webp"
          class="w-full h-full object-cover"
        />
      </button>
    ))}
  </div>
</div>

<!-- Premium Fullscreen Lightbox -->
<!-- z-[100]: above navbar z-50. Re-parented to <body> at init (RoomDetail.astro) so
     this z-index competes in the ROOT stacking context — inside the transformed/transition
     <main> it could never beat the root-level navbar (MDN: stacking contexts are atomic). -->
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-md hidden flex-col items-center justify-center select-none"
  role="dialog"
  aria-modal="true"
  aria-label={t('room.photoGallery')}
>
  <!-- Top toolbar -->
  <div class="absolute top-0 inset-x-0 p-5 flex items-center justify-between z-50 bg-gradient-to-b from-black/60 to-transparent">
    <!-- Index Counter -->
    <span id="lightbox-counter" class="text-white/80 text-sm font-semibold tracking-wider font-body">1 / 1</span>

    <!-- Close Button -->
    <button
      id="lightbox-close-btn"
      class="w-11 h-11 rounded-full bg-white/5 hover:bg-white/15 text-white hover:text-secondary flex items-center justify-center transition-[background-color,color] duration-300 cursor-pointer border border-white/5 focus:outline-none"
      aria-label="Close gallery"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Slides Container -->
  <div class="relative w-full max-w-6xl max-h-[85vh] flex items-center justify-center px-6 md:px-24">
    {
      images.map((img, idx) => (
        <div class="lightbox-slide hidden w-full h-full flex items-center justify-center" data-slide-index={idx}>
          <Image
            src={img}
            alt={`${room.name[lang]} - Lightbox Photo ${idx + 1}`}
            width={1600}
            height={1066}
            layout="none"
            format="avif"
            loading="lazy"
            class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl transition-opacity duration-300"
          />
        </div>
      ))
    }
  </div>

  <!-- Prev Arrow -->
  <button
    id="lightbox-prev-btn"
    class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/5 hover:bg-white/15 text-white hover:text-secondary flex items-center justify-center transition-[background-color,color] duration-300 cursor-pointer border border-white/5 focus:outline-none"
    aria-label="Previous slide"
  >
    <svg class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>

  <!-- Next Arrow -->
  <button
    id="lightbox-next-btn"
    class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/5 hover:bg-white/15 text-white hover:text-secondary flex items-center justify-center transition-[background-color,color] duration-300 cursor-pointer border border-white/5 focus:outline-none"
    aria-label="Next slide"
  >
    <svg class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>
</div>
