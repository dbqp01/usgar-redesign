---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LogoUsgar from '../assets/logos/Logo usgar.svg';
import PlatformLogo from './icons/PlatformLogos.astro';
import { useTranslations } from '../i18n/utils';
import { siteSettings } from '../data/settings';

import type { Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;

const t = useTranslations(lang);

const currentYear = new Date().getFullYear();

const homeUrl = getRelativeLocaleUrl(lang, '');
const cleanHomeUrl = homeUrl.endsWith('/') ? homeUrl : `${homeUrl}/`;

const quickLinks = [
  { href: cleanHomeUrl, label: t('nav.home') },
  { href: getRelativeLocaleUrl(lang, 'rooms'), label: t('nav.rooms') },
  { href: getRelativeLocaleUrl(lang, 'gallery'), label: t('nav.gallery') },
  { href: `${cleanHomeUrl}#services`, label: t('nav.services') },
  { href: getRelativeLocaleUrl(lang, 'explore'), label: t('nav.explore') },
  { href: getRelativeLocaleUrl(lang, 'book'), label: t('nav.bookNow') },
];

const socialLinks = siteSettings.socialLinks
  .filter(s => s.platform === 'instagram' || s.platform === 'facebook')
  .map(s => ({
    href: s.url,
    label: s.label,
    icon: s.platform,
  }));

const tripadvisorUrl = siteSettings.socialLinks.find(s => s.platform === 'tripadvisor')?.url || '#';
const bookingUrl = siteSettings.socialLinks.find(s => s.platform === 'booking')?.url || '#';
const newsletterStatusLabels = {
  success: t('footer.newsletterSuccess'),
  error: t('footer.newsletterError'),
  invalid: t('footer.newsletterEmailInvalid'),
};
---

<footer class="bg-surface-light dark:bg-surface-dark transition-colors duration-500 pt-24 pb-12 overflow-hidden relative" id="contact">
  <!-- Giant editorial wordmark (background accent) -->
  <div data-footer-wordmark="USGAR" class="pointer-events-none absolute inset-x-0 top-2 flex justify-center overflow-hidden px-4 select-none" aria-hidden="true">
    <span class="block w-full max-w-full text-center font-display text-[clamp(4.5rem,12vw,11rem)] leading-none tracking-[0.02em] text-primary/[0.04] dark:text-white/[0.04]">
      USGAR
    </span>
  </div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Newsletter -->
    <div class="max-w-2xl mx-auto text-center mb-20">
      <p class="micro-label text-secondary mb-3">{t('footer.newsletterLabel')}</p>
      <h2 class="font-display text-3xl sm:text-4xl text-text-primary-light dark:text-white mb-3">
        {t('footer.newsletterTitle')}
      </h2>
      <p class="text-sm text-text-secondary-light dark:text-text-secondary-dark font-light mb-6">
        {t('footer.newsletterDesc')}
      </p>
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto" novalidate data-labels={JSON.stringify(newsletterStatusLabels)}>
        <label for="newsletter-email" class="sr-only">Email</label>
        <input
          type="email"
          id="newsletter-email"
          name="email"
          autocomplete="email"
          required
          placeholder={t('footer.newsletterPlaceholder')}
          class="flex-1 px-5 py-3.5 rounded-full bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
        />
        <button
          type="submit"
          class="btn-primary font-semibold px-7 py-3.5 rounded-full text-sm uppercase tracking-wider whitespace-nowrap"
        >
          {t('footer.newsletterButton')}
        </button>
      </form>
      <p id="newsletter-status" class="hidden mt-3 text-xs font-semibold" role="status"></p>
    </div>

    <!-- Logo (SVG vectorial: queda bien en tema claro y oscuro) -->
    <div class="flex justify-center mb-16">
      <a href={getRelativeLocaleUrl(lang, '')} aria-label="USGAR Hotels Home">
        <LogoUsgar class="h-14 w-auto opacity-80 hover:opacity-100 transition-opacity drop-shadow-sm block" />
      </a>
    </div>

    <!-- 3-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-12 mb-16">
      <!-- Contact -->
      <div class="text-center md:text-left">
        <h3 class="font-display font-bold text-xl mb-6 text-text-primary-light dark:text-white uppercase tracking-wider">{t('footer.contact')}</h3>
        <address class="not-italic space-y-4 text-sm text-text-secondary-light dark:text-text-secondary-dark font-body font-light">
          <p class="flex items-start justify-center md:justify-start gap-3">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteSettings.address[lang]}</span>
          </p>
          <p class="flex items-center justify-center md:justify-start gap-3">
            <svg class="w-4 h-4 flex-shrink-0 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${siteSettings.email}`} class="hover:text-primary-light dark:hover:text-white transition-colors">{siteSettings.email}</a>
          </p>
          <p class="flex items-center justify-center md:justify-start gap-3">
            <svg class="w-4 h-4 flex-shrink-0 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:+${siteSettings.phoneRaw}`} class="hover:text-primary-light dark:hover:text-white transition-colors">{siteSettings.phone}</a>
          </p>
        </address>
      </div>

      <!-- Quick Links -->
      <div class="text-center">
        <h3 class="font-display font-bold text-xl mb-6 text-text-primary-light dark:text-white uppercase tracking-wider">{t('footer.quickLinks')}</h3>
        <nav class="space-y-3" aria-label={t('footer.quickLinksNav')}>
          {quickLinks.map(link => (
            <a
              href={link.href}
              class="block text-sm text-text-secondary-light dark:text-text-secondary-dark hover:text-primary-light dark:hover:text-white transition-colors duration-200"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Social Media -->
      <div class="text-center md:text-right">
        <h3 class="font-display font-bold text-xl mb-6 text-text-primary-light dark:text-white uppercase tracking-wider">{t('footer.followUs')}</h3>
        <div class="flex justify-center md:justify-end gap-4 mb-6">
          {socialLinks.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-12 h-12 rounded-full border border-black/10 dark:border-white/20 flex items-center justify-center text-text-primary-light dark:text-white hover:bg-secondary hover:text-text-primary-light hover:border-transparent transition-[transform,background-color,border-color,box-shadow] duration-300 lg:hover:-translate-y-1 shadow-sm hover:shadow-lg"
              aria-label={social.label}
            >
              {social.icon === 'instagram' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                </svg>
              )}
              {social.icon === 'facebook' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
        <p class="text-xs text-text-secondary-light/60 dark:text-text-secondary-dark font-body uppercase tracking-widest">
          {t('footer.findUs')}
        </p>
      </div>
    </div>

    <!-- As Featured In — brutal trust bar -->
    <div class="border-t border-black/10 dark:border-white/10 pt-8 mt-8 mb-6">
      <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-text-secondary-light/70 dark:text-text-secondary-dark/70">
          {t('footer.asFeaturedIn')}
        </span>
        <a href={tripadvisorUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2.5 opacity-70 hover:opacity-100 transition-opacity">
          <PlatformLogo platform="tripadvisor" class="w-7 h-7 text-text-secondary-light dark:text-white" />
          <span class="font-body font-light italic text-lg tracking-wide text-text-secondary-light/80 dark:text-white/80">TripAdvisor</span>
        </a>
        <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2.5 opacity-70 hover:opacity-100 transition-opacity">
          <PlatformLogo platform="booking" class="w-7 h-7 text-text-secondary-light dark:text-white" />
          <span class="font-body font-light italic text-lg tracking-wide text-text-secondary-light/80 dark:text-white/80">Booking.com</span>
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-black/10 dark:border-white/10 pt-8 mt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-text-secondary-light/70 dark:text-text-secondary-dark/70 uppercase tracking-widest">
        <p>
          &copy; {currentYear} USGAR Hotels. {t('footer.rights')}
        </p>
        <p>
          {t('footer.madeWith')}
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  const labels = JSON.parse(
    document.getElementById('newsletter-form')?.dataset.labels || '{}'
  );
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const status = document.getElementById('newsletter-status') as HTMLElement | null;
  const input = document.getElementById('newsletter-email') as HTMLInputElement | null;

  function showStatus(message: string, ok: boolean) {
    if (!status) return;
    status.textContent = message;
    status.className = `mt-3 text-xs font-semibold ${ok ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!input) return;

    if (!input.validity.valid || input.value.trim() === '') {
      showStatus(labels.invalid || 'Invalid email', false);
      return;
    }

    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: input.value.trim(),
          locale: document.documentElement.lang || 'en',
        }),
      });
      const data = await res.json();
      if (data.success) {
        input.value = '';
        showStatus(labels.success || 'Subscribed', true);
      } else {
        showStatus(labels.error || 'Something went wrong', false);
      }
    } catch {
      showStatus(labels.error || 'Something went wrong', false);
    }
  });
</script>
