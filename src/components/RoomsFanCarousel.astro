---
// src/components/RoomsFanCarousel.astro
// 3D fan carousel of rooms: continuous autoplay (no hover pause), drag with
// inertia, click opens an accessible <dialog> modal with summary + amenities + CTA.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeader from './ui/SectionHeader.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { rooms } from '../data/rooms';
import { useTranslations, type Locale } from '../i18n/utils';
import { translateBeds } from '../utils/helpers';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const allRoomImages = import.meta.glob<{ default: ImageMetadata }>('../assets/rooms/**/*.jpg', { eager: true });

const roomsWithPhotos = rooms.map((room) => {
  const keys = Object.keys(allRoomImages)
    .filter((k) => k.includes(`/${room.photoFolder}/`))
    .sort((a, b) => a.localeCompare(b));
  const first = keys[0];
  return { ...room, photo: first ? allRoomImages[first].default : undefined };
});

// Serialized modal payload (current locale only — small, single source of truth)
const fanData = rooms.map((room) => ({
  slug: room.slug,
  name: room.name[lang],
  description: room.description[lang],
  price: room.pricePerNight,
  beds: translateBeds(room.beds, lang),
  maxGuests: room.maxGuests,
  guestLabel: room.maxGuests === 1 ? t('booking.guest') : t('booking.guests_plural'),
  image: room.images[0] || '',
  amenities: (room.amenities || [])
    .map((key) => room.amenityLabels?.[key]?.[lang] || room.amenityLabels?.[key]?.en || '')
    .filter(Boolean),
}));
---

<section id="rooms" class="scroll-mt-28 sm:scroll-mt-32 py-12 sm:py-16 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500 overflow-hidden">
  <div class="max-w-[1400px] mx-auto">
    <SectionHeader
      number="01"
      eyebrow={t('rooms.sectionLabel')}
      title={t('roomsSection.heading')}
      subtitle={t('roomsSection.subheading')}
    />

    <!-- 3D Fan Stage -->
    <div
      id="rooms-fan-stage"
      class="relative w-full h-[420px] sm:h-[520px] cursor-grab active:cursor-grabbing select-none touch-pan-y"
      data-fan-data={JSON.stringify(fanData)}
    >
      {roomsWithPhotos.map((room, i) => (
        <article
          data-fan-card={room.slug}
          class="fan-card group absolute left-1/2 top-1/2 w-[240px] sm:w-[300px] aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl border border-black/10 dark:border-white/10 bg-surface-card-dark cursor-pointer"
          aria-label={room.name[lang]}
        >
          {room.photo ? (
            <Image
              src={room.photo}
              alt={room.name[lang]}
              width={600}
              height={800}
              format="webp"
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
          ) : (
            <div class="absolute inset-0 bg-primary-dark w-full h-full"></div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>

          <div class="absolute bottom-0 inset-x-0 p-5 text-white">
            <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-secondary mb-1">
              {t('rooms.from')} ${room.pricePerNight} {t('rooms.perNight')}
            </p>
            <h3 class="font-display text-xl sm:text-2xl leading-tight">
              {room.name[lang]}
            </h3>
            <p class="text-xs text-white/70 mt-1.5">
              {room.maxGuests} {room.maxGuests === 1 ? t('booking.guest') : t('booking.guests_plural')} · {translateBeds(room.beds, lang)}
            </p>
            <span class="inline-flex items-center gap-2 mt-3 text-xs font-semibold uppercase tracking-wider text-white/90 group-hover:text-secondary transition-colors">
              {t('roomsSection.viewDetails')}
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </div>
        </article>
      ))}

      <!-- Drag hint -->
      <div class="absolute bottom-2 left-1/2 -translate-x-1/2 text-[10px] font-mono uppercase tracking-[0.3em] text-text-secondary-light dark:text-text-secondary-dark opacity-70 pointer-events-none">
        ⟵ {t('roomsSection.tapHint')} ⟶
      </div>
    </div>
  </div>
</section>

<!-- Accessible Room Modal -->
<dialog
  id="room-modal"
  class="fixed inset-0 m-auto w-[min(92vw,560px)] max-h-[86vh] rounded-3xl bg-surface-card-light dark:bg-surface-card-dark border border-black/10 dark:border-white/10 shadow-2xl backdrop:bg-black/70 backdrop:backdrop-blur-sm p-0 overflow-hidden open:flex flex-col"
  aria-labelledby="room-modal-title"
>
  <div class="relative h-52 sm:h-64 flex-shrink-0">
    <img id="room-modal-image" src="" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
    <button
      id="room-modal-close"
      class="absolute top-4 right-4 w-10 h-10 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center border border-white/20 transition-colors cursor-pointer"
      aria-label="Close"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <h3 id="room-modal-title" class="absolute bottom-4 left-6 right-6 font-display text-2xl text-white"></h3>
  </div>

  <div class="p-6 space-y-5 overflow-y-auto">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-secondary-light dark:text-text-secondary-dark">
      <span id="room-modal-guests" class="font-semibold"></span>
      <span>•</span>
      <span id="room-modal-beds"></span>
    </div>
    <p id="room-modal-description" class="text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark"></p>

    <div>
      <h4 class="text-[10px] font-bold uppercase tracking-[0.25em] text-primary dark:text-primary-soft mb-3">
        {t('room.amenities')}
      </h4>
      <ul id="room-modal-amenities" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></ul>
    </div>

    <div class="flex items-center justify-between border-t border-black/5 dark:border-white/5 pt-4">
      <div>
        <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-secondary-light dark:text-text-secondary-dark">
          {t('rooms.from')}
        </p>
        <p class="font-display text-3xl font-bold text-primary dark:text-primary-soft">
          $<span id="room-modal-price"></span> <span class="text-sm font-normal text-text-secondary-light dark:text-text-secondary-dark">/{t('rooms.perNight')}</span>
        </p>
      </div>
      <a
        id="room-modal-cta"
        href="#"
        class="btn-primary font-semibold px-6 py-3.5 rounded-xl text-sm"
      >
        {t('room.bookThisRoom')}
      </a>
    </div>
  </div>
</dialog>

<script>
  import { initRoomsFanCarousel } from '../features/animations/modules/roomsFanCarousel';

  let cleanup: (() => void) | null = null;

  function initFan() {
    const stage = document.getElementById('rooms-fan-stage') as HTMLElement | null;
    if (!stage) return;

    cleanup?.();

    const modal = document.getElementById('room-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('room-modal-close') as HTMLButtonElement | null;
    const img = document.getElementById('room-modal-image') as HTMLImageElement | null;
    const title = document.getElementById('room-modal-title') as HTMLElement | null;
    const desc = document.getElementById('room-modal-description') as HTMLElement | null;
    const guests = document.getElementById('room-modal-guests') as HTMLElement | null;
    const beds = document.getElementById('room-modal-beds') as HTMLElement | null;
    const price = document.getElementById('room-modal-price') as HTMLElement | null;
    const amenitiesEl = document.getElementById('room-modal-amenities') as HTMLElement | null;
    const cta = document.getElementById('room-modal-cta') as HTMLAnchorElement | null;

    const lang = document.documentElement.lang || 'en';
    const bookBase = lang === 'en' ? '/book' : `/${lang}/book`;

    function openRoomModal(slug: string) {
      if (!modal || !stage) return;
      const data = JSON.parse(stage.dataset.fanData || '[]');
      const room = data.find((r: any) => r.slug === slug);
      if (!room) return;

      if (img) { img.src = room.image; img.alt = room.name; }
      if (title) title.textContent = room.name;
      if (desc) desc.textContent = room.description;
      if (guests) guests.textContent = `${room.maxGuests} ${room.guestLabel}`;
      if (beds) beds.textContent = room.beds;
      if (price) price.textContent = room.price;
      if (cta) cta.href = `${bookBase}?roomType=${slug}`;

      if (amenitiesEl) {
        amenitiesEl.innerHTML = '';
        room.amenities.forEach((label: string) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-2 text-xs text-text-secondary-light dark:text-text-secondary-dark';
          li.innerHTML = `<svg class="w-3.5 h-3.5 text-tertiary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span></span>`;
          (li.querySelector('span') as HTMLElement).textContent = label;
          amenitiesEl.appendChild(li);
        });
      }

      modal.showModal();
    }

    closeBtn?.addEventListener('click', () => modal?.close());

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Static fan (CSS transform base) + modal still interactive
      stage.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest<HTMLElement>('[data-fan-card]');
        const slug = card?.dataset.fanCard;
        if (slug) openRoomModal(slug);
      });
      return;
    }

    cleanup = initRoomsFanCarousel(stage, openRoomModal);
  }

  document.addEventListener('astro:page-load', initFan);
  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
    cleanup = null;
  }, { once: true });
</script>

<style>
  /* Static fan baseline (no-JS / reduced-motion): cards pre-positioned in an arc.
     The JS engine overrides transforms with the animated fan. */
  #rooms-fan-stage {
    perspective: 1200px;
    --fan-radius: clamp(230px, 36vw, 330px);
  }

  .fan-card {
    transform: translate(-50%, -50%) rotateY(var(--fan-pos, 0deg)) translateZ(var(--fan-radius)) scale(1);
    opacity: 0.9;
    will-change: transform, opacity;
  }

  .fan-card:nth-child(1) { --fan-pos: 0deg; }
  .fan-card:nth-child(2) { --fan-pos: 90deg; }
  .fan-card:nth-child(3) { --fan-pos: 180deg; }
  .fan-card:nth-child(4) { --fan-pos: 270deg; }

  .fan-card:hover {
    opacity: 1 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .fan-card {
      opacity: 1;
      will-change: auto;
    }
  }
</style>
