---
// src/components/navbar/LanguageSwitcher.astro
// One concept, two placements: a hover dropdown on desktop and a grid in the
// mobile drawer. Rendered twice on the page via the `variant` prop.
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  variant: 'desktop' | 'mobile';
  locales: { code: Locale; label: string }[];
  getLocaleUrl: (targetLang: Locale) => string;
}

const { variant, locales, getLocaleUrl } = Astro.props as Props;
const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<!-- Language Switcher Dropdown (desktop) -->
{variant === 'desktop' && (
  <div class="relative group">
      <button
        type="button"
        id="lang-switcher-desktop-btn"
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls="lang-dropdown-desktop"
        class="nav-link nav-link-text nav-btn-border text-sm font-medium px-3 py-1.5 rounded-full border border-current/20 hover:border-primary hover:text-primary transition-[color,border-color] duration-300 drop-shadow-md flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        aria-label={t('nav.language')}
      >
        <span>{lang.toUpperCase()}</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div id="lang-dropdown-desktop" class="absolute right-0 mt-2 w-40 rounded-2xl bg-surface-card-light dark:bg-surface-card-dark shadow-2xl border border-black/10 dark:border-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-[opacity,visibility] duration-200 z-50 py-2">
        {locales.map(l => (
          <a
            href={getLocaleUrl(l.code)}
            class:list={[
              'flex items-center gap-3 px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:bg-primary/20',
              l.code === lang ? 'text-primary bg-primary/10' : 'text-text-primary-light dark:text-text-primary-dark hover:bg-black/5 dark:hover:bg-white/5'
            ]}
          >
            <span>{l.label}</span>
          </a>
        ))}
      </div>
    </div>
  )
}

<!-- Language Switcher Mobile Grid -->
{variant === 'mobile' && (
  <div class="flex flex-col gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark px-4">{t('nav.languageTitle')}</span>
      <div class="grid grid-cols-2 gap-2">
        {locales.map(l => (
          <a
            href={getLocaleUrl(l.code)}
            class:list={[
              'mobile-lang-link flex items-center gap-2 p-3 rounded-xl border text-sm font-medium transition-colors',
              l.code === lang ? 'border-primary bg-primary/10 text-primary' : 'border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5'
            ]}
          >
            <span>{l.label}</span>
          </a>
        ))}
      </div>
    </div>
  )
}
