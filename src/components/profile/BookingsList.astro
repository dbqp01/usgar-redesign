---
// src/components/profile/BookingsList.astro
// VIEW 1: reservations history — header + "new booking" CTA, empty state and
// the bookings list container filled by the page's inline profile script.
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
---

<!-- VIEW 1: Bookings Section -->
<div id="view-bookings" class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <span class="text-xs font-semibold text-primary dark:text-purple-pastel uppercase tracking-widest block">
        Reservations History
      </span>
      <h2 class="font-display text-2xl">
        {t('auth.myBookings')}
      </h2>
    </div>

    <a
      href="/book"
      class="bg-primary hover:bg-primary-dark text-white text-xs font-semibold uppercase tracking-wider px-5 py-2.5 rounded-full transition-[background-color,color,box-shadow] duration-300 shadow-md hover:shadow-lg inline-flex items-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      <span>{t('auth.startBooking')}</span>
    </a>
  </div>

  <!-- Empty Bookings State -->
  <div id="profile-empty-bookings" class="hidden text-center py-16 bg-surface-card-light dark:bg-surface-card-dark p-8 rounded-3xl border border-black/10 dark:border-white/10 space-y-4">
    <svg class="w-12 h-12 text-stone-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
    </svg>
    <p class="text-base font-semibold">{t('auth.noBookingsYet')}</p>
    <a
      href="/book"
      class="inline-block bg-primary hover:bg-primary-dark text-white font-semibold px-6 py-3 rounded-full text-sm transition-[background-color,color] shadow-md"
    >
      {t('auth.startBooking')}
    </a>
  </div>

  <!-- Bookings List Container -->
  <div id="profile-bookings-list" class="hidden space-y-4"></div>
</div>
