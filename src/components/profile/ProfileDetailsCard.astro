---
// src/components/profile/ProfileDetailsCard.astro
// VIEW 2: personal details form (real editing). Fields are populated and the
// submit is handled by the page's inline profile script.
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
---

<!-- VIEW 2: Personal Details Form (Real Editing) -->
<div id="view-personal" class="hidden space-y-6">
  <div class="bg-surface-card-light dark:bg-surface-card-dark p-8 md:p-10 rounded-3xl border border-black/10 dark:border-white/10 shadow-xl space-y-6">
    <div>
      <h2 class="font-display text-2xl font-bold">{t('profile.personalInformation')}</h2>
      <p class="text-text-secondary-light dark:text-text-secondary-dark text-sm">
        Update your personal details for faster check-ins and direct contact.
      </p>
    </div>

    <form id="form-personal-details" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="edit-fullname" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
            Full Name *
          </label>
          <input
            type="text"
            id="edit-fullname"
            name="fullName"
            required
            autocomplete="name"
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary outline-none transition-[border-color,box-shadow]"
          />
        </div>

        <div>
          <label for="edit-email" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
            Email Address (Read Only)
          </label>
          <input
            type="email"
            id="edit-email"
            disabled
            class="w-full px-4 py-3 rounded-xl bg-stone-100 dark:bg-surface-card-dark border border-black/10 dark:border-white/10 text-sm text-stone-500 dark:text-stone-300 cursor-not-allowed outline-none"
          />
        </div>
      </div>

      <div>
        <label for="edit-phone" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
          Phone / WhatsApp Number
        </label>
        <input
          type="tel"
          id="edit-phone"
          name="phone"
          placeholder="+51 984 000 000"
          autocomplete="tel"
          class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary outline-none transition-[border-color,box-shadow] placeholder:text-stone-400 dark:placeholder:text-stone-500"
        />
      </div>

      <div class="flex items-center justify-end">
        <button
          type="submit"
          id="btn-save-personal"
          class="bg-primary hover:bg-primary-dark text-white font-semibold text-sm px-8 py-3.5 rounded-xl transition-[background-color,color,box-shadow] duration-300 shadow-md hover:shadow-lg cursor-pointer"
        >
          Save Profile Changes
        </button>
      </div>
    </form>
  </div>
</div>
