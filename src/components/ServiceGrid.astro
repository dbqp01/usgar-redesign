---
import SectionHeader from './ui/SectionHeader.astro';
import { services } from '../data/services';
import { useTranslations } from '../i18n/utils';

import type { Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

// Grouping services for the numbered list
const highlights: Array<{
  id: string;
  title: Record<string, string>;
  desc: Record<string, string>;
  icon: string;
}> = [
  {
    id: 'breakfast',
    title: { en: 'Andean Breakfast', es: 'Desayuno Andino', fr: 'Petit-Déjeuner Andin', pt: 'Café da Manhã Andino' },
    desc: { en: 'Local flavors to start your day right.', es: 'Sabores locales para empezar bien tu día.', fr: 'Saveurs locales pour bien démarrer votre journée.', pt: 'Sabores locais para começar bem o seu dia.' },
    icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 19h16M7 19V7a2 2 0 012-2h6a2 2 0 012 2v12M17 9h2a2 2 0 012 2v2a2 2 0 01-2 2h-2" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 2v3M14 2v3" /></svg>'
  },
  {
    id: 'oxygen',
    title: { en: 'Oxygen & Acclimatization', es: 'Oxígeno & Aclimatación', fr: 'Oxygène & Acclimatation', pt: 'Oxigênio & Aclimação' },
    desc: { en: 'Complimentary oxygen to help you adjust to Cusco.', es: 'Oxígeno de cortesía para ayudarte a aclimatarte a Cusco.', fr: 'Oxygène gracieux pour vous aider à vous acclimater.', pt: 'Oxigênio de cortesia para ajudar na aclimação.' },
    icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>'
  },
  {
    id: 'tours',
    title: { en: 'Machu Picchu Tours', es: 'Tours Machu Picchu', fr: 'Tours Machu Picchu', pt: 'Passeios Machu Picchu' },
    desc: { en: 'Seamless travel assistance.', es: 'Asistencia de viaje sin complicaciones.', fr: 'Assistance voyage personnalisée.', pt: 'Assistência de viagem simplificada.' },
    icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2L2 22h20L12 2zM12 8l3 6H9l3-6z" /></svg>'
  },
  {
    id: 'comfort',
    title: { en: 'Boutique Comfort', es: 'Confort Boutique', fr: 'Confort Boutique', pt: 'Conforto Boutique' },
    desc: { en: 'Crafted spaces for authentic rest.', es: 'Espacios diseñados para un descanso auténtico.', fr: 'Des espaces conçus pour un repos authentique.', pt: 'Espaços projetados para um descanso autêntico.' },
    icon: '<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>'
  }
];

---


<section id="services" class="scroll-mt-28 sm:scroll-mt-32 py-12 sm:py-16 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500 relative overflow-hidden">
  
  <div class="max-w-[1400px] mx-auto relative z-10 animate-on-scroll">
    
    <!-- Section Header -->
    <SectionHeader
      number="05"
      eyebrow={t('services.sectionLabel')}
      title={t('global.elevatedExperience')}
      subtitle={t('services.description')}
    />

    <!-- Brutalist numbered services list -->
    <div class="divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10">
      {highlights.map((item, i) => (
        <div class="group flex items-center gap-5 sm:gap-10 py-8 sm:py-10 transition-colors">
          <span class="font-mono text-xs sm:text-sm text-secondary w-8 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
          <div class="w-12 h-12 sm:w-16 sm:h-16 rounded-2xl bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 flex items-center justify-center flex-shrink-0 text-secondary transition-all duration-500 group-hover:bg-secondary group-hover:text-white" set:html={item.icon}></div>
          <div class="flex-1 min-w-0">
            <h3 class="font-display text-2xl sm:text-4xl text-text-primary-light dark:text-white group-hover:text-secondary transition-colors duration-300">
              {item.title[lang]}
            </h3>
            <p class="text-sm text-text-secondary-light dark:text-text-secondary-dark font-light max-w-2xl opacity-0 max-h-0 overflow-hidden transition-all duration-500 group-hover:opacity-100 group-hover:max-h-24 group-hover:mt-2">
              {item.desc[lang]}
            </p>
          </div>
          <svg class="w-6 h-6 flex-shrink-0 text-text-secondary-light dark:text-text-secondary-dark opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      ))}
    </div>

    <!-- Also Included — professional typographic row -->
    <div class="mt-12 rounded-3xl border border-black/10 dark:border-white/10 bg-white dark:bg-surface-card-dark p-8 sm:p-10">
      <div class="flex items-center gap-4 mb-8">
        <h3 class="font-display text-2xl font-bold text-text-primary-light dark:text-white">{t('global.alsoIncluded')}</h3>
        <span class="flex-1 h-px bg-black/10 dark:bg-white/10"></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-text-secondary-light dark:text-text-secondary-dark">06</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-5">
        {services.filter(s => !['breakfast', 'oxygen', 'tours'].includes(s.id)).slice(0, 6).map((service, i) => (
          <div class="flex items-center gap-3 text-text-primary-light dark:text-white">
            <span class="font-mono text-[10px] text-secondary w-5 flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
            <span class="w-4 h-px bg-secondary flex-shrink-0"></span>
            <span class="font-body text-sm font-medium truncate">{service.name[lang]}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
