---
import { Picture } from 'astro:assets';
import SectionHeader from './ui/SectionHeader.astro';
import { services } from '../data/services';
import { useTranslations, type Locale } from '../i18n/utils';
import breakfastImage from '../assets/hotel/fallback-room-desayuno.jpg';
import oxygenImage from '../assets/hotel/fallback-room-oxigeno.jpg';
import toursImage from '../assets/explore/machu-picchu.jpg';
import comfortImage from '../assets/hotel/hero-slide-patio.jpg';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const imageByService: Record<string, typeof breakfastImage> = {
  breakfast: breakfastImage,
  oxigeno: oxygenImage,
  tours: toursImage,
  garden: comfortImage,
};

const featureIds = ['breakfast', 'oxigeno', 'tours', 'garden'];
const featureServices = featureIds
  .map((id) => {
    const service = services.find((item) => item.id === id);
    return service ? { ...service, image: imageByService[id] } : null;
  })
  .filter((service): service is NonNullable<typeof service> => Boolean(service));

const includedServices = services
  .filter((service) => !featureIds.includes(service.id))
  .slice(0, 6);
---

<section id="services" class="scroll-mt-28 sm:scroll-mt-32 overflow-hidden bg-surface-light px-4 py-16 transition-colors duration-500 dark:bg-surface-dark sm:py-24">
  <div class="relative z-10 mx-auto max-w-[1400px] animate-on-scroll">
    <SectionHeader
      number="05"
      eyebrow={t('services.sectionLabel')}
      title={t('global.elevatedExperience')}
      subtitle={t('services.description')}
    />

    <div data-services-scenes class="grid grid-cols-1 gap-5 sm:gap-7 md:grid-cols-2">
      {featureServices.map((service, index) => (
        <article data-service-scene class="group relative isolate min-h-[390px] overflow-hidden rounded-[1.75rem] border border-black/10 bg-surface-card-dark sm:min-h-[500px]">
          <Picture
            src={service.image}
            alt={service.name[lang]}
            formats={['avif']}
            fallbackFormat="avif"
            quality="high"
            fit="cover"
            position="center"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            pictureAttributes={{ class: 'absolute inset-0 block h-full w-full' }}
            class="h-full w-full object-cover transition-transform duration-1000 ease-out will-change-transform motion-safe:group-hover:scale-[1.045]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/25 to-black/5"></div>
          <div class="absolute left-5 top-5 z-10 flex items-center gap-3 text-[10px] font-mono uppercase tracking-[0.25em] text-white/80 sm:left-7 sm:top-7">
            <span class="text-secondary">{String(index + 1).padStart(2, '0')}</span>
            <span class="h-px w-8 bg-secondary/80"></span>
            <span>{t('services.sectionLabel')}</span>
          </div>
          <div class="absolute inset-x-5 bottom-5 z-10 sm:inset-x-7 sm:bottom-7">
            <div class="max-w-xl border-l-2 border-secondary bg-black/35 px-5 py-4 backdrop-blur-md transition-transform duration-700 ease-out motion-safe:group-hover:translate-x-2 sm:px-6 sm:py-5">
              <h3 class="font-display text-3xl leading-none text-white sm:text-5xl">{service.name[lang]}</h3>
              <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/75 sm:text-base">{service.description[lang]}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 rounded-[1.5rem] border border-black/10 bg-white p-6 dark:border-white/10 dark:bg-surface-card-dark sm:mt-10 sm:p-8">
      <div class="mb-6 flex items-center gap-4">
        <h3 class="font-display text-2xl font-bold text-text-primary-light dark:text-white">{t('global.alsoIncluded')}</h3>
        <span class="h-px flex-1 bg-black/10 dark:bg-white/10"></span>
        <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-text-secondary-light dark:text-text-secondary-dark">06</span>
      </div>
      <div class="grid grid-cols-1 gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {includedServices.map((service, index) => (
          <div class="flex items-center gap-3 text-text-primary-light dark:text-white">
            <span class="w-5 flex-shrink-0 font-mono text-[10px] text-secondary">{String(index + 1).padStart(2, '0')}</span>
            <span class="h-px w-4 flex-shrink-0 bg-secondary"></span>
            <span class="truncate font-body text-sm font-medium">{service.name[lang]}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initServicesScenes } from '../features/animations/modules/servicesScenes';

  let cleanup: (() => void) | null = null;

  function init() {
    const root = document.querySelector('[data-services-scenes]') as HTMLElement | null;
    if (!root) return;
    cleanup?.();
    cleanup = initServicesScenes(root);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
