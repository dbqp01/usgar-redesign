---
// src/components/booking/GuestStep.astro
// Step 2: Guest Details & Mandatory Flight Details for Airport Transfer.
// Preserves: #checkout-form, #guest-name, #guest-email, #guest-phone, #airport-transfer, #flight-time, #flight-details, #transfer-details, #transfer-calculation, #estimated-arrival-time, #auth-prefill-banner, data-guest-step, data-guest-next, data-guest-back
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<div data-guest-step class="space-y-6">
  <form id="checkout-form" class="bg-surface-card-light dark:bg-surface-card-dark p-6 sm:p-8 rounded-2xl border border-black/8 dark:border-white/10 shadow-sm space-y-6">
    <div class="border-b border-black/6 dark:border-white/6 pb-4">
      <h2 class="font-display text-xl sm:text-2xl font-bold text-text-primary-light dark:text-white">
        {t('book.guestDetails')}
      </h2>
      <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5">
        {t('book.guestSubtitle')}
      </p>
    </div>

    <!-- Login Prefill Banner -->
    <div id="auth-prefill-banner" class="flex items-center justify-between gap-3 p-3.5 rounded-xl border border-secondary/20 bg-secondary/5">
      <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark font-medium">
        {t('auth.loginToBookFaster')}
      </p>
      <a
        href={`/login?redirect=${encodeURIComponent('/book')}`}
        class="flex-shrink-0 bg-primary hover:bg-primary-dark text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors"
      >
        {t('auth.signIn')}
      </a>
    </div>

    <!-- Inputs Grid -->
    <div class="space-y-4">
      <div>
        <label for="guest-name" class="block text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
          {t('book.fullName')} *
        </label>
        <input
          type="text"
          id="guest-name"
          name="guestName"
          required
          placeholder={t('book.guestNamePlaceholder')}
          class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all placeholder:text-black/30 dark:placeholder:text-white/30"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="guest-email" class="block text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
            {t('book.emailLabel')} *
          </label>
          <input
            type="email"
            id="guest-email"
            name="guestEmail"
            required
            placeholder={t('book.emailPlaceholder')}
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all placeholder:text-black/30 dark:placeholder:text-white/30"
          />
        </div>

        <div>
          <label for="guest-phone" class="block text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
            {t('book.phoneWhatsApp')} *
          </label>
          <input
            type="tel"
            id="guest-phone"
            name="guestPhone"
            required
            placeholder={t('book.phonePlaceholder')}
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all placeholder:text-black/30 dark:placeholder:text-white/30"
          />
        </div>
      </div>

      <!-- Airport Transfer Service Card -->
      <div class="pt-4 border-t border-black/6 dark:border-white/6 space-y-4">
        <div class="p-4 sm:p-5 rounded-xl border border-black/8 dark:border-white/10 bg-black/2 dark:bg-white/2 space-y-4">
          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input
              type="checkbox"
              id="airport-transfer"
              name="airportTransfer"
              class="w-4 h-4 rounded text-secondary focus:ring-secondary border-black/15 dark:border-white/15 cursor-pointer accent-secondary mt-0.5"
            />
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-bold text-text-primary-light dark:text-white">
                  {t('book.airportPickupCheckbox')}
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 uppercase tracking-wider">
                  {t('book.transferBadge')}
                </span>
              </div>
              <span class="text-xs text-text-secondary-light dark:text-text-secondary-dark block mt-1">
                {t('book.transferDesc')}
              </span>
            </div>
          </label>

          <div id="transfer-details" class="hidden pl-7 space-y-4 pt-3 border-t border-black/6 dark:border-white/6 animate-fade-in">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="flight-time" class="block text-[11px] font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
                  {t('book.flightTimeExactLabel')}
                </label>
                <input
                  type="time"
                  id="flight-time"
                  name="flightTime"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-xs font-semibold text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all cursor-pointer"
                />
              </div>

              <div>
                <label for="flight-details" class="block text-[11px] font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1.5">
                  {t('book.flightDetailsLabel')}
                </label>
                <input
                  type="text"
                  id="flight-details"
                  name="flightDetails"
                  placeholder={t('book.flightDetailsPlaceholder')}
                  class="w-full px-3.5 py-2.5 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-xs font-medium text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all placeholder:text-black/30 dark:placeholder:text-white/30"
                />
              </div>
            </div>

            <!-- Coordination Info Box -->
            <div id="transfer-calculation" class="p-3.5 rounded-xl bg-secondary/10 border border-secondary/20 space-y-1">
              <p class="text-xs font-bold text-secondary-dark dark:text-secondary uppercase tracking-wider flex items-center gap-1.5">
                <svg class="w-4 h-4 text-secondary-dark dark:text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {t('book.transferNoticeTitle')}
              </p>
              <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark leading-relaxed">
                {t('book.transferNoticeText')}
              </p>
              <p id="estimated-arrival-container" class="hidden text-[11px] text-text-primary-light dark:text-white font-semibold pt-1">
                {t('book.estimatedArrivalLabel')}
                <span id="estimated-arrival-time" class="text-secondary-dark dark:text-secondary font-bold">--:--</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <!-- Navigation Buttons -->
  <div class="flex items-center justify-between">
    <button
      type="button"
      data-guest-back
      class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-xs font-bold uppercase tracking-wider border border-black/10 dark:border-white/10 text-text-secondary-light dark:text-text-secondary-dark hover:border-primary/40 transition-colors cursor-pointer"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" />
      </svg>
      {t('wizard.back')}
    </button>
    <button
      type="button"
      data-guest-next
      class="inline-flex items-center gap-2.5 rounded-xl px-8 py-3.5 text-xs font-bold uppercase tracking-wider btn-primary shadow-lg transition-all"
    >
      <span>{t('book.continueToPayment')}</span>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </button>
  </div>
</div>

<script>
  import { wizardStore } from '../../features/booking/wizardStore';
  import { toastApi } from '../../features/ui/toast';

  let abortController = new AbortController();

  function initGuestStep() {
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const root = document.querySelector('[data-guest-step]') as HTMLElement | null;
    if (!root) return;

    const nextBtn = root.querySelector('[data-guest-next]') as HTMLButtonElement | null;
    const backBtn = root.querySelector('[data-guest-back]') as HTMLButtonElement | null;
    const errorBanner = document.getElementById('error-banner');
    if (!nextBtn || !backBtn) return;

    const L = (window as any).__LABELS || {};

    function showError(msg: string) {
      toastApi.error({ title: msg });
      if (errorBanner) {
        const errorMessage = document.getElementById('error-message');
        if (errorMessage) errorMessage.textContent = msg;
        errorBanner.classList.remove('hidden');
      }
    }

    const transferCb = document.getElementById('airport-transfer') as HTMLInputElement | null;
    const transferDetails = document.getElementById('transfer-details');
    const flightTimeInput = document.getElementById('flight-time') as HTMLInputElement | null;
    const flightDetailsInput = document.getElementById('flight-details') as HTMLInputElement | null;
    const estimatedArrivalContainer = document.getElementById('estimated-arrival-container');
    const estimatedArrivalSpan = document.getElementById('estimated-arrival-time');

    transferCb?.addEventListener('change', () => {
      if (transferDetails) {
        transferDetails.classList.toggle('hidden', !transferCb.checked);
      }
    }, { signal });

    flightTimeInput?.addEventListener('input', () => {
      const val = flightTimeInput.value;
      if (val && estimatedArrivalContainer && estimatedArrivalSpan) {
        const parts = val.split(':');
        if (parts.length === 2) {
          const hours = parseInt(parts[0], 10);
          const minutes = parseInt(parts[1], 10);
          const landingDate = new Date();
          landingDate.setHours(hours);
          landingDate.setMinutes(minutes + 45);
          const estHours = String(landingDate.getHours()).padStart(2, '0');
          const estMinutes = String(landingDate.getMinutes()).padStart(2, '0');
          estimatedArrivalSpan.textContent = `${estHours}:${estMinutes} ${L.guestArrivalNote || ''}`;
          estimatedArrivalContainer.classList.remove('hidden');
        }
      }
    }, { signal });

    nextBtn.addEventListener('click', () => {
      errorBanner?.classList.add('hidden');
      const guestNameInput = document.getElementById('guest-name') as HTMLInputElement | null;
      const guestEmailInput = document.getElementById('guest-email') as HTMLInputElement | null;
      const guestPhoneInput = document.getElementById('guest-phone') as HTMLInputElement | null;

      if (wizardStore.getState().processing) return;

      if (!guestNameInput?.value || !guestEmailInput?.value || !guestPhoneInput?.value) {
        showError(L.fillAllFields || 'Por favor completa todos los campos obligatorios del huésped');
        return;
      }
      if (!guestEmailInput.validity.valid) {
        showError(L.invalidEmail || 'Ingresa un correo electrónico válido');
        return;
      }

      // Mandatory validation if Airport Transfer checkbox is checked
      if (transferCb?.checked) {
        if (!flightTimeInput?.value || !flightDetailsInput?.value?.trim()) {
          showError(L.guestTransferValidation || 'To arrange your private transfer, please enter your exact landing time and flight number.');
          return;
        }
      }

      nextBtn.disabled = true;
      nextBtn.setAttribute('aria-busy', 'true');
      const continueLabel = L.checkingAvailability || 'Starting secure payment...';
      if (nextBtn.querySelector('span')) nextBtn.querySelector('span')!.textContent = continueLabel;
      wizardStore.setState({ step: 3, processing: true });
    }, { signal });

    const originalLabel = nextBtn.querySelector('span')?.textContent || (L.continueToPayment || 'Continue to payment');
    const unsub = wizardStore.subscribe((state) => {
      if (!state.processing && nextBtn.disabled) {
        nextBtn.disabled = false;
        nextBtn.removeAttribute('aria-busy');
        const span = nextBtn.querySelector('span');
        if (span && state.error === null) span.textContent = originalLabel;
      }
    });
    abortController.signal.addEventListener('abort', () => unsub());

    backBtn.addEventListener('click', () => wizardStore.back(), { signal });

    function applyUserData(u: any) {
      const banner = document.getElementById('auth-prefill-banner');
      if (banner) banner.classList.add('hidden');
      const nameInput = document.getElementById('guest-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('guest-email') as HTMLInputElement | null;
      if (nameInput && u.name && !nameInput.value) nameInput.value = u.name;
      if (emailInput && u.email && !emailInput.value) emailInput.value = u.email;
    }

    async function autoFillUser() {
      const cached = sessionStorage.getItem('usgar_auth_user');
      if (cached) {
        try { applyUserData(JSON.parse(cached)); } catch {}
      }
      try {
        const res = await fetch('/api/auth/me', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        if (data.success && data.user) {
          sessionStorage.setItem('usgar_auth_user', JSON.stringify(data.user));
          applyUserData(data.user);
        }
      } catch {}
    }

    autoFillUser();
  }

  document.addEventListener('astro:page-load', initGuestStep);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
  });
</script>
