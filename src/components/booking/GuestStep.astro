---
// src/components/booking/GuestStep.astro
// Paso 2 (datos del huesped): extraido del flujo anterior de book.astro,
// con ids y payload intactos. Validacion local antes de continuar al pago.
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<div data-guest-step class="space-y-6">
  <form id="checkout-form" class="bg-surface-card-light dark:bg-surface-card-dark p-6 md:p-8 rounded-3xl border border-black/5 dark:border-white/5 shadow-sm space-y-6">
    <h2 class="font-display text-2xl flex items-center gap-3 border-b border-black/5 dark:border-white/5 pb-3">
      <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold">2</span>
      {t('book.guestDetails')}
    </h2>

    <div id="auth-prefill-banner" class="p-4 rounded-xl border border-primary/20 bg-primary/5 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark font-medium">
          {t('auth.loginToBookFaster')}
        </p>
      </div>
      <a
        href={`/login?redirect=${encodeURIComponent('/book')}`}
        class="flex-shrink-0 bg-primary hover:bg-primary-dark text-white text-xs font-semibold px-4 py-2 rounded-full transition-[background-color,color]"
      >
        {t('auth.signIn')}
      </a>
    </div>

    <div class="space-y-4">
      <div>
        <label for="guest-name" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
          {t('book.fullName')} *
        </label>
        <input
          type="text"
          id="guest-name"
          name="guestName"
          required
          placeholder="e.g. John Doe"
          class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="guest-email" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
            Email *
          </label>
          <input
            type="email"
            id="guest-email"
            name="guestEmail"
            required
            placeholder="e.g. john@example.com"
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
          />
        </div>

        <div>
          <label for="guest-phone" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
            {t('book.phoneWhatsApp')} *
          </label>
          <input
            type="tel"
            id="guest-phone"
            name="guestPhone"
            required
            placeholder="e.g. +51 987 654 321"
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
          />
        </div>
      </div>

      <div class="pt-4 border-t border-black/5 dark:border-white/5 space-y-4">
        <label class="flex items-center gap-3 cursor-pointer">
          <input
            type="checkbox"
            id="airport-transfer"
            name="airportTransfer"
            class="w-4 h-4 rounded text-primary focus:ring-primary border-black/10 dark:border-white/10 cursor-pointer"
          />
          <span class="text-sm font-medium text-text-primary-light dark:text-text-primary-dark">
            {t('book.airportPickupCheckbox')}
          </span>
        </label>

        <div id="transfer-details" class="hidden pl-7 space-y-4 animate-fade-in">
          <div>
            <label for="flight-time" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
              {t('book.flightTimeLabel')}
            </label>
            <input
              type="time"
              id="flight-time"
              name="flightTime"
              class="px-4 py-3 rounded-xl bg-stone-50 dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-[border-color,box-shadow] w-full sm:w-48 cursor-pointer"
            />
          </div>

          <div id="transfer-calculation" class="hidden p-4 rounded-xl bg-primary/10 border border-primary/20 space-y-1.5 max-w-md">
            <h4 class="font-semibold text-xs text-primary uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-4 h-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {t('book.arrivalCalculationTitle')}
            </h4>
            <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark leading-relaxed">
              {t('book.arrivalCalculationText')}
            </p>
            <p class="text-xs font-semibold text-text-primary-light dark:text-text-primary-dark">
              {t('book.estimatedArrivalLabel')}
              <span id="estimated-arrival-time" class="text-primary font-bold text-sm">--:--</span>
            </p>
            <p class="text-[10px] text-stone-500 italic">
              {t('book.estimatedArrivalNote')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </form>

  <div class="flex items-center justify-between">
    <button
      type="button"
      data-guest-back
      class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold uppercase tracking-wider border border-black/10 dark:border-white/10 text-text-secondary-light dark:text-text-secondary-dark hover:border-primary/40 transition-colors cursor-pointer"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" />
      </svg>
      {t('wizard.back')}
    </button>
    <button
      type="button"
      data-guest-next
      class="inline-flex items-center gap-3 rounded-xl px-8 py-3 text-sm font-semibold uppercase tracking-wider btn-primary"
    >
      <span>{t('wizard.continue')}</span>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </button>
  </div>
</div>

<script>
  import { wizardStore } from '../../features/booking/wizardStore';
  import { toastApi } from '../../features/ui/toast';

  let abortController = new AbortController();

  function initGuestStep() {
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const root = document.querySelector('[data-guest-step]') as HTMLElement | null;
    const nextBtn = root?.querySelector('[data-guest-next]') as HTMLButtonElement | null;
    const backBtn = root?.querySelector('[data-guest-back]') as HTMLButtonElement | null;
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');
    if (!root || !nextBtn || !backBtn) return;

    const L = (window as any).__LABELS || {};

    function showError(msg: string) {
      toastApi.error({ title: msg });
      if (errorBanner && errorMessage) {
        errorMessage.textContent = msg;
        errorBanner.classList.remove('hidden');
        errorBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    const airportTransferCheckbox = document.getElementById('airport-transfer') as HTMLInputElement | null;
    const transferDetails = document.getElementById('transfer-details');
    const flightTimeInput = document.getElementById('flight-time') as HTMLInputElement | null;
    const transferCalculation = document.getElementById('transfer-calculation');
    const estimatedArrivalSpan = document.getElementById('estimated-arrival-time');

    airportTransferCheckbox?.addEventListener('change', () => {
      if (airportTransferCheckbox.checked) {
        transferDetails?.classList.remove('hidden');
      } else {
        transferDetails?.classList.add('hidden');
        if (flightTimeInput) flightTimeInput.value = '';
        transferCalculation?.classList.add('hidden');
      }
    }, { signal });

    flightTimeInput?.addEventListener('input', () => {
      const timeVal = flightTimeInput.value;
      if (timeVal && estimatedArrivalSpan && transferCalculation) {
        const [hoursStr, minutesStr] = timeVal.split(':');
        const hours = parseInt(hoursStr, 10);
        const minutes = parseInt(minutesStr, 10);
        const landingDate = new Date();
        landingDate.setHours(hours);
        landingDate.setMinutes(minutes + 45);
        const estHours = String(landingDate.getHours()).padStart(2, '0');
        const estMinutes = String(landingDate.getMinutes()).padStart(2, '0');
        estimatedArrivalSpan.textContent = `${estHours}:${estMinutes}`;
        transferCalculation.classList.remove('hidden');
      } else {
        transferCalculation?.classList.add('hidden');
      }
    }, { signal });

    nextBtn.addEventListener('click', () => {
      errorBanner?.classList.add('hidden');
      const guestNameInput = document.getElementById('guest-name') as HTMLInputElement | null;
      const guestEmailInput = document.getElementById('guest-email') as HTMLInputElement | null;
      const guestPhoneInput = document.getElementById('guest-phone') as HTMLInputElement | null;

      if (wizardStore.getState().processing) return;

      if (!guestNameInput?.value || !guestEmailInput?.value || !guestPhoneInput?.value) {
        showError(L.fillAllFields);
        return;
      }
      if (!guestEmailInput.validity.valid) {
        showError(L.invalidEmail);
        return;
      }
      // Si ya estamos en el paso 3 (guest + payment juntos), next() es no-op.
      // setState({step:3}) SIEMPRE notifica -> PaymentStep.start() se re-evalua
      // con los campos llenos -> createHold -> cardForm monta.
      nextBtn.disabled = true;
      nextBtn.setAttribute('aria-busy', 'true');
      const continueLabel = L.checkingAvailability || 'Checking availability...';
      if (nextBtn.querySelector('span')) nextBtn.querySelector('span')!.textContent = continueLabel;
      wizardStore.setState({ step: 3, processing: true });
    }, { signal });

    // Restaurar el botón si el proceso de pago termina en error o el usuario vuelve atrás
    const originalLabel = nextBtn.querySelector('span')?.textContent || '';
    const unsub = wizardStore.subscribe((state) => {
      if (!state.processing && nextBtn.disabled) {
        nextBtn.disabled = false;
        nextBtn.removeAttribute('aria-busy');
        const span = nextBtn.querySelector('span');
        if (span && state.error === null) span.textContent = originalLabel;
      }
    });
    abortController.signal.addEventListener('abort', () => unsub());

    backBtn.addEventListener('click', () => wizardStore.back(), { signal });

    // Auto-fill datos del usuario logueado
    function applyUserData(u: any) {
      const banner = document.getElementById('auth-prefill-banner');
      if (banner) banner.classList.add('hidden');
      const nameInput = document.getElementById('guest-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('guest-email') as HTMLInputElement | null;
      if (nameInput && u.name && !nameInput.value) nameInput.value = u.name;
      if (emailInput && u.email && !emailInput.value) emailInput.value = u.email;
    }

    async function autoFillUser() {
      const cached = sessionStorage.getItem('usgar_auth_user');
      if (cached) {
        try { applyUserData(JSON.parse(cached)); } catch {}
      }
      try {
        const res = await fetch('/api/auth/me', { credentials: 'include' });
        if (!res.ok) return;
        const data = await res.json();
        if (data.success && data.user) {
          sessionStorage.setItem('usgar_auth_user', JSON.stringify(data.user));
          applyUserData(data.user);
        }
      } catch {}
    }

    autoFillUser();
  }

  document.addEventListener('astro:page-load', initGuestStep);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
  });
</script>
