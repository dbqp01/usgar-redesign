---
// src/components/booking/WizardProgress.astro
// Indicador de 3 pasos del wizard con acabado visual de lujo.
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const stepLabels = [t('wizard.step1Label'), t('wizard.step2Label'), t('wizard.step3Label')];
---

<nav aria-label="Booking progress" class="mb-10" data-wizard-progress>
  <ol class="flex items-center justify-center gap-2 sm:gap-6">
    {stepLabels.map((label, i) => {
      const n = i + 1;
      return (
        <li class="flex items-center gap-2 sm:gap-6" data-wizard-step-marker={n}>
          <div class="flex items-center gap-2 sm:gap-3">
            <span
              class="w-9 h-9 rounded-full border border-black/10 dark:border-white/10 text-text-secondary-light dark:text-text-secondary-dark flex items-center justify-center text-xs font-mono font-semibold transition-all duration-300 wizard-dot"
              data-wizard-step-dot
            >
              <span class="step-num">{String(n).padStart(2, '0')}</span>
              <svg class="step-check hidden w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            <span class="text-xs font-mono uppercase tracking-[0.16em] font-medium text-text-secondary-light dark:text-text-secondary-dark hidden sm:block">
              {label}
            </span>
          </div>
          {n < 3 && (
            <span class="h-0.5 w-8 sm:w-16 bg-black/10 dark:bg-white/10 rounded-full transition-colors duration-300" data-wizard-step-line={n}></span>
          )}
        </li>
      );
    })}
  </ol>
  <p class="mt-3 text-center text-xs font-mono tracking-wider uppercase text-text-secondary-light dark:text-text-secondary-dark/80" data-wizard-stepof>
    {t('wizard.stepOf').replace('{n}', '1')}
  </p>
</nav>

<style>
  :global([data-wizard-step-dot][data-state="active"]) {
    border-color: var(--color-secondary) !important;
    background-color: color-mix(in srgb, var(--color-secondary) 15%, transparent) !important;
    color: var(--color-secondary-dark) !important;
    font-weight: 700;
    box-shadow: 0 0 16px color-mix(in srgb, var(--color-secondary) 30%, transparent);
    transform: scale(1.08);
  }
  :global(.dark [data-wizard-step-dot][data-state="active"]) {
    color: var(--color-secondary) !important;
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-secondary) 35%, transparent);
  }

  :global([data-wizard-step-dot][data-state="done"]) {
    border-color: var(--color-teal-brand) !important;
    background-color: var(--color-teal-brand) !important;
    color: #ffffff !important;
  }
  :global([data-wizard-step-dot][data-state="done"] .step-num) {
    display: none;
  }
  :global([data-wizard-step-dot][data-state="done"] .step-check) {
    display: block;
  }
</style>

