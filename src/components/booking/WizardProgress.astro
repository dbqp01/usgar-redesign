---
// src/components/booking/WizardProgress.astro
// Luxury Boutique Stepper for USGAR Hotels.
// Preserves required DOM attributes: data-wizard-step-dot, data-wizard-step-line, data-wizard-stepof
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const stepLabels = [
  { num: 1, title: t('wizard.step1Label'), sub: t('wizard.step1Sub') },
  { num: 2, title: t('wizard.step2Label'), sub: t('wizard.step2Sub') },
  { num: 3, title: t('wizard.step3Label'), sub: t('wizard.step3Sub') }
];
---

<nav aria-label="Booking progress" class="mb-8" data-wizard-progress>
  <div class="bg-white/90 dark:bg-surface-card-dark/90 p-3 sm:p-4 rounded-2xl border border-black/8 dark:border-white/10 shadow-sm max-w-3xl mx-auto">
    <ol class="flex items-center justify-between">
      {stepLabels.map((s) => {
        const n = s.num;
        return (
          <li class="flex items-center flex-1 last:flex-none relative" data-wizard-step-marker={n}>
            <div class="flex items-center gap-2.5 sm:gap-3 z-10">
              <!-- Step Circle -->
              <span
                class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl border border-black/15 dark:border-white/15 text-text-secondary-light dark:text-text-secondary-dark flex items-center justify-center text-xs sm:text-sm font-semibold transition-all duration-300 bg-surface-light dark:bg-surface-dark shadow-sm wizard-dot"
                data-wizard-step-dot
              >
                <span class="step-num font-mono">{n}</span>
                <svg class="step-check hidden w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <!-- Step Label -->
              <div class="hidden md:flex flex-col">
                <span class="text-xs font-semibold text-text-primary-light dark:text-white leading-tight">
                  {s.title}
                </span>
                <span class="text-[10px] text-text-secondary-light dark:text-text-secondary-dark/70">
                  {s.sub}
                </span>
              </div>
            </div>

            <!-- Connecting line -->
            {n < 3 && (
              <div class="flex-1 h-0.5 mx-3 sm:mx-6 rounded-full bg-black/8 dark:bg-white/10 relative overflow-hidden hidden sm:block">
                <span class="absolute inset-y-0 left-0 w-0 bg-secondary rounded-full transition-all duration-500 ease-out" data-wizard-step-line={n}></span>
              </div>
            )}
          </li>
        );
      })}
    </ol>
  </div>
  <p class="mt-2 text-center text-[10px] uppercase font-mono tracking-widest text-text-secondary-light/60 dark:text-text-secondary-dark/60" data-wizard-stepof>
    {t('wizard.stepOf').replace('{n}', '1')}
  </p>
</nav>

<style>
  /* Active step state */
  :global([data-wizard-step-dot][data-state="active"]) {
    border-color: var(--color-secondary) !important;
    background: linear-gradient(135deg, var(--color-secondary), var(--color-secondary-dark)) !important;
    color: #ffffff !important;
    font-weight: 700;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-secondary) 40%, transparent) !important;
  }

  /* Done step state */
  :global([data-wizard-step-dot][data-state="done"]) {
    border-color: var(--color-teal-brand) !important;
    background-color: var(--color-teal-brand) !important;
    color: #ffffff !important;
  }
  :global([data-wizard-step-dot][data-state="done"] .step-num) {
    display: none;
  }
  :global([data-wizard-step-dot][data-state="done"] .step-check) {
    display: block;
  }

  /* Line state */
  :global([data-wizard-step-line].done-line) {
    width: 100% !important;
  }
</style>
