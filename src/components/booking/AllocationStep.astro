---
// src/components/booking/AllocationStep.astro
// Paso 2 del wizard: opciones del algoritmo roomAllocator (top 4),
// badge "Mejor precio", desglose de precios, preseleccion por ?roomType
// con toggle "Ver alternativas". Solo opciones de UNA habitacion son
// seleccionables para pago online (contrato del backend, ver DECISIONS).
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<div
  data-allocation-step
  class="bg-surface-card-light dark:bg-surface-card-dark p-6 md:p-8 rounded-3xl border border-black/5 dark:border-white/5 shadow-sm space-y-6"
>
  <h2 class="font-display text-2xl flex items-center gap-3 border-b border-black/5 dark:border-white/5 pb-3">
    <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold">2</span>
    {t('book.selectRoom')}
  </h2>

  <div data-allocation-options class="space-y-3"></div>

  <div data-allocation-status class="hidden items-center gap-2 p-3 rounded-xl border border-primary/20 bg-primary/5 text-primary text-sm">
    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <span data-allocation-status-text></span>
  </div>

  <div data-allocation-empty class="hidden p-4 rounded-xl border border-red-500/20 bg-red-500/5 text-red-600 dark:text-red-400 text-sm">
    {t('wizard.rangeUnavailable')}
  </div>

  <div class="flex items-center justify-between border-t border-black/5 dark:border-white/5 pt-6">
    <button
      type="button"
      data-allocation-back
      class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold uppercase tracking-wider border border-black/10 dark:border-white/10 text-text-secondary-light dark:text-text-secondary-dark hover:border-primary/40 transition-colors cursor-pointer"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" />
      </svg>
      {t('wizard.back')}
    </button>
    <button
      type="button"
      data-allocation-next
      disabled
      class="inline-flex items-center gap-3 rounded-xl px-8 py-3 text-sm font-semibold uppercase tracking-wider btn-primary disabled:opacity-40 disabled:pointer-events-none"
    >
      <span>{t('wizard.continue')}</span>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </button>
  </div>
</div>

<script>
  import { wizardStore } from '../../features/booking/wizardStore';
  import type { AllocationOption } from '../../features/booking/roomAllocator';

  let abortController = new AbortController();

  function initAllocation() {
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    // Escapa valores interpolados en templates HTML (XSS).
    const ENTITIES: Record<string, string> = {
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    };
    function escapeHtml(value: unknown): string {
      return String(value ?? '').replace(/[&<>"']/g, (c) => ENTITIES[c] ?? c);
    }

    const root = document.querySelector('[data-allocation-step]') as HTMLElement | null;
    const optionsEl = root?.querySelector('[data-allocation-options]') as HTMLElement | null;
    const emptyEl = root?.querySelector('[data-allocation-empty]') as HTMLElement | null;
    const nextBtn = root?.querySelector('[data-allocation-next]') as HTMLButtonElement | null;
    const backBtn = root?.querySelector('[data-allocation-back]') as HTMLButtonElement | null;
    if (!root || !optionsEl || !emptyEl || !nextBtn || !backBtn) return;
    const optEl = optionsEl!;
    const empty = emptyEl!;
    const next = nextBtn!;
    const back = backBtn!;
    const statusEl = root.querySelector('[data-allocation-status]') as HTMLElement | null;
    const statusText = root.querySelector('[data-allocation-status-text]') as HTMLElement | null;

    const L = (window as any).__LABELS || {};

    let selected: AllocationOption | null = null;

    function formatMoney(n: number): string {
      return `$${n.toFixed(0)}`;
    }

    function render() {
      const state = wizardStore.getState();
      const options = state.options;
      const availabilityMap = state.availabilityMap;
      const ROOMS = (window as any).__ROOMS_DATA || [];

      if (!options || options.length === 0) {
        empty.classList.remove('hidden');
        optEl.innerHTML = '';
        next.disabled = true;
        return;
      }
      empty.classList.add('hidden');

      const visible = options;
      const top = visible.slice(0, 6);

      optEl.innerHTML = top.map((opt, i) => {
        const multi = opt.rooms.length > 1;
        const isSelected = selected === opt;
        const mainSlug = opt.rooms[0]?.room?.slug;
        const roomObj = ROOMS.find((r: any) => r.slug === mainSlug);
        const imgUrl = roomObj?.images?.[0] || '';
        const bedsText = roomObj?.beds || '';
        const availQty = (!multi && availabilityMap && mainSlug) ? (availabilityMap[mainSlug] ?? null) : null;
        const outOfStock = availQty !== null && availQty <= 0;
        const payable = !multi && !outOfStock;

        const roomNames = opt.rooms.map((e) => escapeHtml(e.room.displayName)).join(' + ');
        const extrasLine = opt.extrasTotal > 0
          ? `<span class="text-text-secondary-light dark:text-text-secondary-dark">${L.extras || 'Extra guest'}: +${formatMoney(opt.extrasTotal)}</span>`
          : '';

        let stockBadgeHtml = '';
        if (outOfStock) {
          stockBadgeHtml += `<span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-rose-700 dark:text-rose-300 bg-rose-500/15 border border-rose-500/30 rounded-full px-2.5 py-0.5"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>${L.soldOut || 'Agotado'}</span>`;
        } else if (opt.bestPrice) {
          stockBadgeHtml += `<span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold uppercase tracking-wider text-secondary-dark dark:text-secondary bg-secondary/15 border border-secondary/40 rounded-full px-2.5 py-0.5"><svg class="w-3 h-3 text-secondary fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>${L.bestPrice || 'Best price'}</span>`;
        }
        if (!outOfStock && availQty === 1) {
          stockBadgeHtml += `<span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-bold uppercase tracking-wider text-amber-700 dark:text-amber-300 bg-amber-500/15 border border-amber-500/30 rounded-full px-2.5 py-0.5 animate-pulse-soft"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>${L.onlyThisRoom || 'Last unit available!'}</span>`;
        } else if (!outOfStock && availQty !== null && availQty > 1) {
          stockBadgeHtml += `<span class="inline-flex items-center gap-1.5 text-[10px] font-mono font-semibold uppercase tracking-wider text-teal-deep dark:text-teal-light bg-teal-brand/10 border border-teal-brand/20 rounded-full px-2.5 py-0.5"><span class="w-1.5 h-1.5 rounded-full bg-teal-brand"></span>${availQty} ${L.available || 'available'}</span>`;
        }

        return `
          <label
            data-allocation-option
            data-option-index="${i}"
            class="group relative flex flex-col md:flex-row md:items-center gap-4 p-4 md:p-5 rounded-2xl border transition-all duration-300 cursor-pointer overflow-hidden ${
              isSelected
                ? 'border-secondary bg-secondary/5 dark:bg-secondary/10 shadow-lg shadow-secondary/10 ring-2 ring-secondary'
                : payable
                  ? 'border-black/10 dark:border-white/10 bg-surface-card-light dark:bg-surface-card-dark hover:border-secondary/50 hover:shadow-md'
                  : 'border-black/5 dark:border-white/5 bg-stone-50 dark:bg-stone-900/40 opacity-75'
            }"
          >
            <div class="flex items-center gap-3 min-w-0 flex-1">
              <input
                type="radio"
                name="allocation"
                class="w-5 h-5 text-secondary focus:ring-secondary cursor-pointer accent-secondary flex-shrink-0"
                ${isSelected ? 'checked' : ''}
                ${payable ? '' : 'disabled aria-disabled="true"'}
              />

              ${imgUrl ? `
                <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden flex-shrink-0 bg-black/10 dark:bg-white/10 border border-black/5 dark:border-white/5">
                  <img src="${imgUrl}" alt="${roomNames}" onerror="this.onerror=null;this.src='/assets/rooms/doble-superior/01-doble.jpg';" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
              ` : ''}

              <div class="min-w-0 flex-1 space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-display text-lg text-text-primary-light dark:text-white font-bold leading-snug">${roomNames}</span>
                  ${stockBadgeHtml}
                  ${multi ? `<span class="text-[10px] font-mono uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark border border-black/10 dark:border-white/10 rounded-full px-2 py-0.5">${(L.roomsCount || '{n} rooms').replace('{n}', String(opt.rooms.length))}</span>` : ''}
                </div>

                ${bedsText ? `
                  <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark flex items-center gap-1.5 font-medium">
                    <svg class="w-3.5 h-3.5 text-secondary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2 4v16M2 20h20M22 20V12a4 4 0 0 0-4-4H4" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 12h4a2 2 0 0 0 2-2V8H6v4Z" />
                    </svg>
                    <span>${escapeHtml(bedsText)}</span>
                  </p>
                ` : ''}

                <div class="text-xs text-text-secondary-light dark:text-text-secondary-dark">
                  <span>${opt.nights} ${opt.nights === 1 ? (L.night || 'night') : (L.nights || 'nights')} - ${formatMoney(opt.roomTotal)}</span>
                  ${extrasLine ? `<span> - ${extrasLine}</span>` : ''}
                </div>
                ${multi ? `<p class="text-[11px] text-amber-600 dark:text-amber-400 font-medium">${L.multiRoomNote || ''}</p>` : ''}
              </div>
            </div>

            <div class="text-left md:text-right flex-shrink-0 border-t md:border-t-0 border-black/5 dark:border-white/5 pt-2 md:pt-0">
              <span class="block font-display text-2xl md:text-3xl font-bold text-primary font-display">${formatMoney(opt.total)}</span>
              <span class="block text-[11px] font-mono uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark font-medium">${L.perNight || '/night'}</span>
            </div>
          </label>
        `;
      }).join('');

      optEl.querySelectorAll<HTMLLabelElement>('[data-allocation-option]').forEach((label) => {
        label.addEventListener('click', () => {
          const idx = Number(label.dataset.optionIndex);
          const opt = top[idx];
          if (!opt || opt.rooms.length > 1) return;
          selected = opt;
          wizardStore.setState({ allocation: opt });
          next.disabled = false;
          render();
        }, { signal });
      });
    }

    back.addEventListener('click', () => wizardStore.back(), { signal });
    next.addEventListener('click', () => {
      if (next.disabled || !selected) return;
      wizardStore.next();
    }, { signal });

    // Preseleccionar la mejor opcion pagable (o la del ?roomType)
    function preselect() {
      const options = wizardStore.getState().options;
      if (!options || options.length === 0 || selected) return;
      const roomType = wizardStore.getState().roomType;
      const pre = roomType
        ? options.find((o) => o.rooms.length === 1 && o.rooms[0].room.slug === roomType)
        : options.find((o) => o.rooms.length === 1);
      if (pre) {
        selected = pre;
        wizardStore.setState({ allocation: pre });
        next.disabled = false;
      }
    }

    preselect();
    render();
    const unsub = wizardStore.subscribe(() => {
      if (statusEl && statusText) {
        const s = wizardStore.getState();
        if (s.selecting) {
          statusEl.classList.remove('hidden');
          statusEl.classList.add('flex');
          statusText.textContent = L.availabilityChecking || 'Checking availability...';
          optEl.classList.add('opacity-50', 'pointer-events-none');
        } else {
          statusEl.classList.add('hidden');
          statusEl.classList.remove('flex');
          optEl.classList.remove('opacity-50', 'pointer-events-none');
        }
      }
      preselect();
      render();
    });
    signal.addEventListener('abort', () => unsub());
  }

  document.addEventListener('astro:page-load', initAllocation);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
  });
</script>
