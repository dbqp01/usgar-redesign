---
// src/components/booking/AllocationStep.astro
// Seleccion de habitacion + tarifas (Estándar / No Reembolsable).
// Los precios de ambas tarifas vienen del backend (GET /api/rooms rate_plans,
// resueltos desde los Feature Price Plans de QloApps, ver DiscountResolver) —
// NUNCA hardcodear precios aqui. (audit 2026-08-12)
// Preserves: data-allocation-step, data-allocation-options, data-allocation-next, data-allocation-empty
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<div
  data-allocation-step
  class="bg-surface-card-light dark:bg-surface-card-dark p-5 sm:p-8 rounded-2xl border border-black/8 dark:border-white/10 shadow-sm space-y-6"
>
  <div class="flex items-center justify-between border-b border-black/6 dark:border-white/6 pb-4">
    <div>
      <h2 class="font-display text-xl sm:text-2xl font-bold text-text-primary-light dark:text-white">
        {t('allocation.title')}
      </h2>
      <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5">
        {t('allocation.subtitle')}
      </p>
    </div>
  </div>

  <!-- Options Container -->
  <div data-allocation-options class="space-y-6"></div>

  <!-- Loading Status -->
  <div data-allocation-status class="hidden items-center gap-3 p-4 rounded-xl border border-primary/20 bg-primary/5 text-primary text-sm font-medium">
    <svg class="w-5 h-5 animate-spin flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <span data-allocation-status-text>{t('allocation.checking')}</span>
  </div>

  <!-- Empty / Sold out -->
  <div data-allocation-empty class="hidden p-5 rounded-xl border border-rose-500/20 bg-rose-500/5 text-rose-600 dark:text-rose-400 text-sm">
    <p class="font-semibold">{t('wizard.rangeUnavailable')}</p>
    <p class="text-xs mt-1 opacity-90">{t('allocation.emptyHint')}</p>
  </div>

  <!-- Navigation Bar -->
  <div class="flex items-center justify-end pt-4 border-t border-black/6 dark:border-white/6">
    <button
      type="button"
      data-allocation-next
      disabled
      class="inline-flex items-center gap-2.5 rounded-xl px-7 py-3 text-xs font-bold uppercase tracking-wider btn-primary disabled:opacity-30 disabled:pointer-events-none transition-all"
    >
      <span>{t('wizard.continue')}</span>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </button>
  </div>
</div>

<script>
  import { wizardStore } from '../../features/booking/wizardStore';
  import type { AllocationOption } from '../../features/booking/roomAllocator';

  let abortController = new AbortController();

  function initAllocation() {
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const ENTITIES: Record<string, string> = {
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    };
    function escapeHtml(value: unknown): string {
      return String(value ?? '').replace(/[&<>"']/g, (c) => ENTITIES[c] ?? c);
    }

    const root = document.querySelector('[data-allocation-step]') as HTMLElement | null;
    const optionsEl = root?.querySelector('[data-allocation-options]') as HTMLElement | null;
    const emptyEl = root?.querySelector('[data-allocation-empty]') as HTMLElement | null;
    const nextBtn = root?.querySelector('[data-allocation-next]') as HTMLButtonElement | null;
    if (!root || !optionsEl || !emptyEl || !nextBtn) return;
    const optEl = optionsEl!;
    const empty = emptyEl!;
    const next = nextBtn!;
    const statusEl = root.querySelector('[data-allocation-status]') as HTMLElement | null;
    const statusText = root.querySelector('[data-allocation-status-text]') as HTMLElement | null;

    const L = (window as any).__LABELS || {};

    let selected: AllocationOption | null = null;
    let selectedRateType: 'standard' | 'non_refundable' = 'standard';
    // v4: combinaciones multi-habitacion detras de un toggle (ruido para
    // grupos pequenos, necesarias para grupos grandes).
    let showMulti = false;

    function formatMoney(n: number): string {
      return `$${Math.round(n)}`;
    }

    // Ratio no reembolsable de la habitación principal de la opción, servido
    // por el backend (rate_plans resueltos desde los Feature Price Plans de
    // QloApps). Sin datos (API caída) => ratio 1: ambas tarifas al mismo
    // precio (honesto). (audit 2026-08-12)
    function rateRatio(opt: AllocationOption): number {
      const plans = wizardStore.getState().ratePlans;
      const slug = opt.rooms[0]?.room?.slug;
      const rp = slug && plans ? plans[slug] : null;
      if (!rp || !rp.standard || rp.non_refundable >= rp.standard) return 1;
      return rp.non_refundable / rp.standard;
    }

    function render() {
      const state = wizardStore.getState();
      const options = state.options;
      const availabilityMap = state.availabilityMap;
      const ROOMS = (window as any).__ROOMS_DATA || [];
      const lang = (document.documentElement.lang || 'en') as string;

      // Nueva lista de opciones (cambio de fechas): la selección previa quedó obsoleta.
      if (!options || (selected && !options.includes(selected))) selected = null;
      next.disabled = !selected;

      if (!options || options.length === 0) {
        empty.classList.remove('hidden');
        optEl.innerHTML = '';
        return;
      }
      empty.classList.add('hidden');

      // v4: primero las opciones de UNA habitacion (comparables de un vistazo);
      // las combinaciones multi-habitacion van detras de un toggle.
      const singles = options.filter((o) => o.rooms.length === 1).slice(0, 4);
      const multis = options.filter((o) => o.rooms.length > 1).slice(0, 4);
      const hasMulti = multis.length > 0 && singles.length > 0;
      const top = singles.length > 0 ? (showMulti ? [...singles, ...multis] : singles) : multis;

      optEl.innerHTML = top.map((opt, i) => {
        const multi = opt.rooms.length > 1;
        const isSelected = selected === opt;
        const mainSlug = opt.rooms[0]?.room?.slug;
        const roomObj = ROOMS.find((r: any) => r.slug === mainSlug);
        const images = roomObj?.images ?? [];
        const bedsText = roomObj?.beds || '';
        const roomDesc = roomObj?.description?.[lang] || roomObj?.description?.es || '';
        // Servicios relevantes de la habitacion (los 8 del cliente), desde
        // room.amenities + amenityLabels (serializados en __ROOMS_DATA).
        // v3: solo los 3 primeros (recomendaciones compactas, estilo IBE).
        const amenityChips = (roomObj?.amenities ?? [])
          .slice(0, 3)
          .map((key: string) => {
            const lbl = roomObj?.amenityLabels?.[key]?.[lang]
              || roomObj?.amenityLabels?.[key]?.en
              || roomObj?.amenityLabels?.[key]?.es
              || '';
            return lbl
              ? `<span class="inline-flex items-center gap-1 px-2 py-1 rounded-full border border-black/8 dark:border-white/10 bg-black/2 dark:bg-white/2 text-[10px] font-medium text-text-secondary-light dark:text-text-secondary-dark">
                  <svg class="w-2.5 h-2.5 text-teal-brand flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                  ${escapeHtml(lbl)}
                </span>`
              : '';
          })
          .join('');
        const availQty = (!multi && availabilityMap && mainSlug) ? (availabilityMap[mainSlug] ?? null) : null;
        const outOfStock = availQty !== null && availQty <= 0;
        // Multi-room reservable desde 2026-08-12 (pipeline rooms[] completo);
        // solo se bloquea si la habitacion principal no tiene unidades.
        const payable = !outOfStock;

        const roomName = opt.rooms.map((e) => escapeHtml(e.room.displayName)).join(' + ');

        // Precios de tarifas: standard = total de la opción; no reembolsable =
        // descuento SOLO sobre el base de la habitacion (roomTotal); el cargo
        // por huesped adicional va a precio completo (decision del negocio,
        // paridad con CreateBookingAction). Ratio del backend (rate_plans).
        const standardTotal = opt.total;
        const ratio = rateRatio(opt);
        const nonRefundableTotal = Math.round(opt.roomTotal * ratio + opt.extrasTotal);
        const pct = Math.round((1 - ratio) * 100);
        const offerBadge = pct > 0 ? (L.allocationOfferBadge || 'Web Deal -{pct}%').replace('{pct}', String(pct)) : '';

        // Availability Pill — v3: las unidades disponibles se ven de un
        // vistazo (estilo "Sólo quedan 2" del IBE de referencia).
        let availBadge = '';
        if (outOfStock) {
          availBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-500 border border-rose-500/20 uppercase tracking-wider">${L.soldOut || 'Sold out'}</span>`;
        } else if (availQty === 1) {
          availBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 uppercase tracking-wider">${L.allocationLastUnit || 'Last unit!'}</span>`;
        } else if (availQty === 2) {
          availBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 uppercase tracking-wider">${(L.allocationUnitsLeft || 'Only {n} left').replace('{n}', String(availQty))}</span>`;
        } else if (availQty !== null && availQty > 2) {
          availBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-teal-brand/10 text-teal-deep dark:text-teal-light border border-teal-brand/25">${(L.allocationUnitsAvailable || '{n} available').replace('{n}', String(availQty))}</span>`;
        } else if (opt.bestPrice) {
          availBadge = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-secondary/15 text-secondary-dark dark:text-secondary border border-secondary/20 uppercase tracking-wider">${L.bestPrice || 'Best price'}</span>`;
        }

        const borderClass = isSelected
          ? 'border-secondary ring-2 ring-secondary/30 shadow-lg bg-surface-card-light dark:bg-surface-card-dark'
          : 'border-black/8 dark:border-white/10 hover:border-secondary/40 shadow-sm';

        const photoCount = (L.allocationPhotoCount || '1 / {n}').replace('{n}', String(images.length || 1));
        const totalLabel = (L.allocationTotalLabel || 'Total ({n} n)').replace('{n}', String(opt.nights));
        const perNight = Math.round(opt.total / opt.nights);

        // v4: fila compacta (patron Booking.com/SimpleBooking): foto miniatura,
        // info en una linea, tarifas como pills, precio/noche a la derecha.
        return `
          <div
            data-allocation-card="${i}"
            class="rounded-xl border ${borderClass} overflow-hidden transition-all duration-300 bg-surface-card-light dark:bg-surface-card-dark"
          >
            <div class="flex items-stretch gap-3 sm:gap-4 p-3 sm:p-4">
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-xl overflow-hidden bg-black/10 relative flex-shrink-0">
                ${images[0] ? `
                  <img
                    src="${images[0]}"
                    alt="${roomName}"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ` : ''}
                <span class="absolute bottom-1 right-1 text-[9px] font-mono font-bold bg-black/60 backdrop-blur-md text-white px-1.5 py-0.5 rounded">
                  ${photoCount}
                </span>
              </div>

              <div class="flex-1 min-w-0 flex flex-col justify-center gap-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="font-display text-sm sm:text-base font-bold text-text-primary-light dark:text-white leading-tight">
                    ${roomName}
                  </h3>
                  ${availBadge}
                </div>
                <p class="text-[11px] text-text-secondary-light dark:text-text-secondary-dark line-clamp-1">
                  ${escapeHtml(roomDesc)}
                </p>
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="inline-flex items-center gap-1 text-[10px] font-medium text-text-secondary-light dark:text-text-secondary-dark">
                    <svg class="w-3 h-3 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M2 4v16M2 20h20M22 20V12a4 4 0 0 0-4-4H4" />
                    </svg>
                    ${escapeHtml(bedsText)}
                  </span>
                  ${amenityChips}
                </div>
                <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                  <button
                    type="button"
                    data-select-rate="standard"
                    data-option-index="${i}"
                    ${payable ? '' : 'disabled aria-disabled="true"'}
                    title="${escapeHtml(L.allocationStandardRateDesc || 'Free cancellation up to 48h before arrival')}"
                    class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border text-[11px] font-bold transition-all cursor-pointer ${isSelected && selectedRateType === 'standard' ? 'border-secondary bg-secondary/10 ring-1 ring-secondary' : 'border-black/10 dark:border-white/10 hover:border-secondary'} ${payable ? '' : 'opacity-40 cursor-not-allowed'}"
                  >
                    <span class="w-2.5 h-2.5 rounded-full border border-black/20 dark:border-white/20 flex items-center justify-center">
                      <span class="${isSelected && selectedRateType === 'standard' ? 'w-1.5 h-1.5 rounded-full bg-secondary' : ''}"></span>
                    </span>
                    <span class="text-text-primary-light dark:text-white">${L.allocationStandardRate || 'Standard'}</span>
                    <span class="text-primary dark:text-primary-soft">${formatMoney(standardTotal)}</span>
                  </button>
                  <button
                    type="button"
                    data-select-rate="non_refundable"
                    data-option-index="${i}"
                    ${payable ? '' : 'disabled aria-disabled="true"'}
                    title="${escapeHtml(L.allocationNonRefundableRateDesc || 'Non-refundable · Immediate payment')}"
                    class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border text-[11px] font-bold transition-all cursor-pointer ${isSelected && selectedRateType === 'non_refundable' ? 'border-secondary bg-secondary/15 ring-1 ring-secondary' : 'border-secondary/30 hover:border-secondary'} ${payable ? '' : 'opacity-40 cursor-not-allowed'}"
                  >
                    <span class="w-2.5 h-2.5 rounded-full border border-secondary/40 flex items-center justify-center">
                      <span class="${isSelected && selectedRateType === 'non_refundable' ? 'w-1.5 h-1.5 rounded-full bg-secondary' : ''}"></span>
                    </span>
                    <span class="text-secondary-dark dark:text-secondary flex items-center gap-1">
                      ${L.allocationNonRefundableRate || 'Non-refundable'}
                      ${offerBadge ? `<span class="px-1 py-0.5 rounded bg-secondary/15 text-[9px] font-bold uppercase tracking-wider">${offerBadge}</span>` : ''}
                    </span>
                    <span class="text-secondary-dark dark:text-secondary">
                      ${nonRefundableTotal !== standardTotal ? `<span class="line-through opacity-50 mr-0.5">${formatMoney(standardTotal)}</span>` : ''}${formatMoney(nonRefundableTotal)}
                    </span>
                  </button>
                </div>
              </div>

              <div class="flex flex-col items-end justify-center gap-0.5 flex-shrink-0">
                <span class="font-display text-lg font-bold text-primary dark:text-primary-soft">${formatMoney(perNight)}</span>
                <span class="text-[10px] text-text-secondary-light dark:text-text-secondary-dark whitespace-nowrap">${L.perNight || '/night'} · ${totalLabel.toLowerCase()}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Toggle de combinaciones multi-habitacion (solo si existen).
      if (hasMulti) {
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.dataset.showMulti = 'true';
        toggle.className = 'w-full mt-3 py-2.5 rounded-xl border border-black/10 dark:border-white/10 text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark hover:border-secondary transition-all cursor-pointer';
        toggle.textContent = showMulti
          ? (L.allocationHideMulti || 'Hide room combinations')
          : (L.allocationShowMulti || 'View {n} options with multiple rooms').replace('{n}', String(multis.length));
        toggle.addEventListener('click', () => {
          showMulti = !showMulti;
          render();
        }, { signal });
        optEl.appendChild(toggle);
      }

      // Click en tarifa: selecciona la opción + tarifa. Sin auto-avance:
      // el usuario compara y continúa con el botón (patrón del IBE de referencia).
      optEl.querySelectorAll<HTMLButtonElement>('[data-select-rate]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = Number(btn.dataset.optionIndex);
          const rateType = btn.dataset.selectRate as 'standard' | 'non_refundable';
          const opt = top[idx];
          if (!opt) return;

          selected = opt;
          selectedRateType = rateType;
          wizardStore.setState({ allocation: opt, rateType });
          next.disabled = false;
          render();
        }, { signal });
      });
    }

    next.addEventListener('click', () => {
      if (next.disabled || !selected) return;
      wizardStore.next();
    }, { signal });

    function preselect() {
      const options = wizardStore.getState().options;
      if (!options || options.length === 0 || selected) return;
      const roomType = wizardStore.getState().roomType;
      const pre = roomType
        ? options.find((o) => o.rooms.length === 1 && o.rooms[0].room.slug === roomType)
        : options.find((o) => o.rooms.length === 1);
      if (pre) {
        selected = pre;
        wizardStore.setState({ allocation: pre });
        next.disabled = false;
      }
    }

    preselect();
    render();
    const unsub = wizardStore.subscribe(() => {
      if (statusEl && statusText) {
        const s = wizardStore.getState();
        if (s.selecting) {
          statusEl.classList.remove('hidden');
          statusEl.classList.add('flex');
          statusText.textContent = L.availabilityChecking || 'Checking availability...';
          optEl.classList.add('opacity-50', 'pointer-events-none');
        } else {
          statusEl.classList.add('hidden');
          statusEl.classList.remove('flex');
          optEl.classList.remove('opacity-50', 'pointer-events-none');
        }
      }
      preselect();
      render();
    });
    signal.addEventListener('abort', () => unsub());
  }

  document.addEventListener('astro:page-load', initAllocation);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
  });
</script>
