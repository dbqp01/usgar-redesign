---
import { rooms } from '../../data/rooms';
import { siteSettings } from '../../data/settings';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../../i18n/utils';

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
const privacyNotice = {
  es: 'Al continuar, compartirás la información que envíes con WhatsApp.',
  en: 'By continuing, you will share the information you send with WhatsApp.',
  fr: 'En continuant, vous partagerez les informations envoyées avec WhatsApp.',
  pt: 'Ao continuar, você compartilhará as informações enviadas com o WhatsApp.',
}[lang];
const noScriptNotice = {
  es: 'Indica tus fechas y huéspedes en el mensaje de WhatsApp.',
  en: 'Include your dates and number of guests in your WhatsApp message.',
  fr: 'Indiquez vos dates et le nombre de personnes dans votre message WhatsApp.',
  pt: 'Informe suas datas e o número de hóspedes na mensagem do WhatsApp.',
}[lang];
const copy = {
  es: { title: 'Consulta tu estancia', intro: 'El hotel confirmará la disponibilidad y el precio antes de reservar.', action: 'Consultar por WhatsApp', message: 'Hola, quisiera consultar disponibilidad para', dates: 'Fechas', guests: 'Huéspedes', pending: 'por indicar' },
  en: { title: 'Enquire about your stay', intro: 'The hotel will confirm availability and price before you book.', action: 'Ask on WhatsApp', message: 'Hello, I would like to enquire about availability for', dates: 'Dates', guests: 'Guests', pending: 'to be provided' },
  fr: { title: 'Demandez votre séjour', intro: 'L’hôtel confirmera la disponibilité et le prix avant la réservation.', action: 'Demander sur WhatsApp', message: 'Bonjour, je souhaite connaître la disponibilité pour', dates: 'Dates', guests: 'Personnes', pending: 'à préciser' },
  pt: { title: 'Consulte sua estadia', intro: 'O hotel confirmará a disponibilidade e o preço antes da reserva.', action: 'Consultar pelo WhatsApp', message: 'Olá, gostaria de consultar a disponibilidade para', dates: 'Datas', guests: 'Hóspedes', pending: 'a informar' },
}[lang];
---

<section class="max-w-6xl mx-auto px-4 pt-[calc(6rem+env(safe-area-inset-top))] pb-16" data-inquiry-page data-dates={copy.dates} data-guests={copy.guests} data-pending={copy.pending}>
  <header class="max-w-2xl mb-8">
    <h1 class="font-display text-3xl sm:text-4xl text-text-primary-light dark:text-white">{copy.title}</h1>
    <p class="mt-3 text-sm sm:text-base text-text-secondary-light dark:text-text-secondary-dark">{copy.intro}</p>
    <p class="mt-3 text-xs text-text-secondary-light dark:text-text-secondary-dark">{privacyNotice} <a href={getRelativeLocaleUrl(lang, 'privacy')} class="underline">{t('footer.privacy')}</a></p>
    <noscript><p class="mt-3 text-sm text-text-secondary-light dark:text-text-secondary-dark">{noScriptNotice}</p></noscript>
  </header>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {rooms.map((room) => {
      const baseMessage = `${copy.message} ${room.name[lang]}.`;
      const message = `${baseMessage} ${copy.dates}: ${copy.pending}. ${copy.guests}: ${copy.pending}.`;
      return (
        <article class="overflow-hidden rounded-2xl border border-black/8 dark:border-white/10 bg-surface-card-light dark:bg-surface-card-dark shadow-sm">
          <img src={room.images[0]} alt={room.name[lang]} class="w-full h-44 object-cover" loading="lazy" />
          <div class="p-4 space-y-4">
            <h2 class="font-display text-lg text-text-primary-light dark:text-white">{room.name[lang]}</h2>
            <a data-inquiry-room data-base-message={baseMessage} href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(message)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              {copy.action}
              <span class="sr-only"> — {room.name[lang]}</span>
            </a>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  function updateInquiryLinks() {
    const section = document.querySelector<HTMLElement>('[data-inquiry-page]');
    if (!section) return;
    const params = new URLSearchParams(window.location.search);
    const checkin = params.get('checkin') || params.get('checkIn') || '';
    const checkout = params.get('checkout') || params.get('checkOut') || '';
    const guests = params.get('guests') || '';
    const dates = /^\d{4}-\d{2}-\d{2}$/.test(checkin) && /^\d{4}-\d{2}-\d{2}$/.test(checkout) && checkout > checkin
      ? `${checkin} → ${checkout}` : section.dataset.pending;
    const guestCount = /^[1-9]\d?$/.test(guests) ? guests : section.dataset.pending;
    section.querySelectorAll<HTMLAnchorElement>('[data-inquiry-room]').forEach((link) => {
      const url = new URL(link.href);
      url.searchParams.set('text', `${link.dataset.baseMessage} ${section.dataset.dates}: ${dates}. ${section.dataset.guests}: ${guestCount}.`);
      link.href = url.toString();
    });
  }
  document.addEventListener('astro:page-load', updateInquiryLinks);
</script>
