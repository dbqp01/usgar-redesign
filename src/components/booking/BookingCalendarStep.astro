---
// debt: oversized module (384 LOC) — split into concept-named components when touched; ceiling 250 pure LOC
// src/components/booking/BookingCalendarStep.astro
// Paso 1 del wizard: calendario custom (dual-month desktop / single mobile),
// rango por clic, disponibilidad via API con degradacion, y disparo del
// algoritmo roomAllocator hacia el store.
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const guestOptions = Array.from({ length: 7 }, (_, i) => i + 1);
---

<div
  data-booking-calendar
  class="bg-surface-card-light dark:bg-surface-card-dark p-6 md:p-8 rounded-3xl border border-black/5 dark:border-white/5 shadow-sm space-y-6"
>
  <h2 class="font-display text-2xl flex items-center gap-3 border-b border-black/5 dark:border-white/5 pb-3">
    <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold">1</span>
    {t('wizard.calendarTitle')}
  </h2>

  <div class="flex flex-col gap-8 lg:flex-row lg:gap-10">
    <div class="flex-1 space-y-3" data-calendar-month="0"></div>
    <div class="flex-1 space-y-3 hidden lg:block" data-calendar-month="1"></div>
  </div>

  <div class="flex items-center gap-5 text-xs text-text-secondary-light dark:text-text-secondary-dark" data-calendar-legend>
    <span class="inline-flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-teal-brand" aria-hidden="true"></span>
      {t('wizard.legendAvailable')}
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-black/15 dark:bg-white/25" aria-hidden="true"></span>
      {t('wizard.legendSoldOut')}
    </span>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-end gap-4 border-t border-black/5 dark:border-white/5 pt-6">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 flex-1">
      <div>
        <label for="checkin" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
          {t('wizard.checkIn')}
        </label>
        <input
          type="date"
          id="checkin"
          name="checkin"
          class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] cursor-pointer"
        />
      </div>
      <div>
        <label for="checkout" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
          {t('wizard.checkOut')}
        </label>
        <input
          type="date"
          id="checkout"
          name="checkout"
          class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] cursor-pointer"
        />
      </div>
      <div>
        <label for="guests" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
          {t('wizard.guestsLabel')}
        </label>
        <select
          id="guests"
          name="guests"
          class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] appearance-none cursor-pointer"
        >
          {guestOptions.map((g) => (
            <option value={g} class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-white">{g}</option>
          ))}
        </select>
      </div>
    </div>

    <button
      type="button"
      data-calendar-continue
      disabled
      class="w-full sm:w-auto inline-flex items-center justify-center gap-3 rounded-xl px-8 py-3.5 text-sm font-semibold uppercase tracking-wider btn-primary disabled:opacity-40 disabled:pointer-events-none"
    >
      <span>{t('wizard.continue')}</span>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </button>
  </div>

  <div data-calendar-banner class="hidden p-4 rounded-xl border border-amber-500/20 bg-amber-500/5 text-amber-700 dark:text-amber-300 text-sm"></div>
  <div data-calendar-checking class="hidden p-4 rounded-xl border border-primary/20 bg-primary/5 text-primary text-sm flex items-center gap-2">
    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <span>{t('wizard.availabilityChecking')}</span>
  </div>
</div>

<script>
  import { buildMonthGrid, nightsBetween, clampRange, formatISODate, addDays } from '../../features/booking/calendar';
import { formatDate } from '../../utils/format';
  import { allocateRooms } from '../../features/booking/roomAllocator';
  import { wizardStore } from '../../features/booking/wizardStore';
  import { bookingService } from '../../services/bookingService';
  import { animateCalendarDays } from '../../features/animations/modules/bookingCalendar';
  import { toastApi } from '../../features/ui/toast';

  let abortController = new AbortController();
  let cleanupAnim: (() => void) | null = null;
  let firstCompute = true;

  // Disponibilidad por día cargada del backend: { 'YYYY-MM-DD': { slug: qty } }
  let calendarAvailability: Record<string, Record<string, number>> = {};

  interface SerializedRoom {
    slug: string;
    name: Record<string, string>;
    pricePerNight: number;
    beds: string;
    baseOccupancy: number;
    extraGuestCharge: number;
    maxGuests: number;
  }

  function isPast(date: string): boolean {
    return date < formatISODate(new Date());
  }

  function escapeAttr(value: string): string {
    return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  /** Orden fijo de los dots por habitación (1 dot por slug, teal = disponible ese día). */
  const ROOM_DOT_ORDER = ['matrimonial', 'doble-superior', 'triple-standar', 'familiar-superior'];

  /** Mini-dots de disponibilidad por habitación para un día con datos. */
  function roomDots(day: Record<string, number>): string {
    return ROOM_DOT_ORDER.map((slug) => {
      const available = (day[slug] ?? 0) > 0;
      const cls = available ? 'bg-teal-brand' : 'bg-rose-500';
      return `<span class="w-1 h-1 rounded-full ${cls}" aria-hidden="true"></span>`;
    }).join('');
  }

  /** Noches del rango [checkIn, checkOut) — el día de salida no se pernocta. */
  function rangeDays(checkIn: string, checkOut: string): string[] {
    const days: string[] = [];
    const cursor = new Date(checkIn + 'T00:00:00');
    const end = new Date(checkOut + 'T00:00:00');
    while (cursor < end) {
      days.push(formatISODate(cursor));
      cursor.setDate(cursor.getDate() + 1);
    }
    return days;
  }

  /** true si la habitación tiene qty > 0 en TODOS los días del rango con datos por día.
   *  Días sin datos (fuera de la ventana del calendario) no se validan aquí:
   *  decide la API de rango. */
  function roomAvailableEveryDay(slug: string, checkIn: string, checkOut: string): boolean {
    for (const d of rangeDays(checkIn, checkOut)) {
      const day = calendarAvailability[d];
      if (day && day[slug] !== undefined) {
        if ((day[slug] ?? 0) < 1) return false;
      }
    }
    // Sin datos por día (calendarAvailability aún no resolvió o rango fuera de
    // ventana) NO se filtra: decide la API de rango. Esto arregla la race del
    // init con params en URL (el fetch de calendario resuelve después).
    return true;
  }

  /** Labels i18n del host (evita colisión con el global `L` de Leaflet). */
  function labels(): Record<string, string> {
    return (window as any).__LABELS || {};
  }

  /** Un día está agotado cuando NINGUNA habitación tiene disponibilidad. */
  function isDaySoldOut(date: string): boolean {
    const day = calendarAvailability[date];
    if (!day) return false;
    const slugs = Object.keys(day);
    if (slugs.length === 0) return false;
    return slugs.every((slug) => (day[slug] ?? 0) <= 0);
  }

  /** Etiqueta del tooltip: lista de habitaciones con disponibilidad ese día. */
  function availableRoomsLabel(date: string): string {
    const day = calendarAvailability[date];
    if (!day) return '';
    const lang = (document.documentElement.lang || 'en') as string;
    const rooms = (window as any).__ROOMS_DATA as SerializedRoom[] || [];
    const available = Object.entries(day)
      .filter(([, qty]) => (qty ?? 0) > 0)
      .map(([slug]) => {
        const room = rooms.find((r) => r.slug === slug);
        return room ? (room.name[lang] || slug) : slug;
      });
    if (available.length === 0) return '';
    const lb = labels();
    return `${lb.availableOn || 'Available:'} ${available.slice(0, 4).join(', ')}${available.length > 4 ? '…' : ''}`;
  }

  async function loadCalendarAvailability(): Promise<void> {
    const today = new Date();
    const from = formatISODate(today);
    const end = new Date(today); end.setMonth(end.getMonth() + 3);
    const to = formatISODate(end);
    try {
      const res = await bookingService.getAvailabilityCalendar(from, to);
      if (res.success && res.data) {
        calendarAvailability = res.data;
      }
    } catch {
      calendarAvailability = {};
    }
  }

  function renderMonth(container: HTMLElement, year: number, month: number, opts: {
    lang: string;
    weekDays: string[];
    onPick: (date: string) => void;
  }) {
    const cells = buildMonthGrid(year, month);
    const monthName = new Date(year, month, 1).toLocaleDateString(opts.lang === 'es' ? 'es' : opts.lang === 'fr' ? 'fr' : opts.lang === 'pt' ? 'pt' : 'en', { month: 'long', year: 'numeric' });

    container.innerHTML = `
      <div class="flex items-center justify-between">
        <span class="font-display text-lg capitalize">${monthName}</span>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-mono uppercase tracking-widest text-text-secondary-light dark:text-text-secondary-dark">
        ${opts.weekDays.map((d) => `<span class="py-1">${d}</span>`).join('')}
      </div>
      <div class="grid grid-cols-7 gap-1" role="grid" aria-label="${monthName}">
        ${cells.map((cell) => {
          if (!cell.inMonth) return '<span></span>';
          const past = cell.past;
          const dayNum = Number(cell.date.slice(-2));
          const dateLabel = formatDate(cell.date, opts.lang);
          const soldOut = !past && calendarAvailability[cell.date] !== undefined && isDaySoldOut(cell.date);
          const disabledAttr = past || soldOut ? 'tabindex="-1" aria-disabled="true"' : '';
          const stateClass = past
            ? 'opacity-25 pointer-events-none'
            : soldOut
              ? 'opacity-30 pointer-events-none bg-red-500/10 text-red-500/70 line-through'
              : 'hover:bg-primary/10 hover:text-primary';
          const tooltip = soldOut
            ? ` title="${escapeAttr(labels().soldOut || 'Sold out')}"`
            : calendarAvailability[cell.date] && !past
              ? ` title="${escapeAttr(availableRoomsLabel(cell.date))}"`
              : '';
          const dots = !past && calendarAvailability[cell.date] ? roomDots(calendarAvailability[cell.date]) : '';
          return `<button type="button" role="gridcell" data-calendar-day data-date="${cell.date}" data-past="${past}" data-sold-out="${soldOut}" aria-label="${dateLabel}${soldOut ? ' - ' + (labels().soldOut || 'Sold out') : ''}" ${disabledAttr}${tooltip} class="aspect-square rounded-lg text-sm flex items-center justify-center transition-colors duration-200 cursor-pointer select-none ${stateClass}"><span class="flex flex-col items-center justify-center gap-0.5 leading-none"><span>${dayNum}</span>${dots ? `<span class="flex items-center justify-center gap-0.5">${dots}</span>` : ''}</span></button>`;
        }).join('')}
      </div>
    `;

    container.querySelectorAll<HTMLButtonElement>('[data-calendar-day]').forEach((btn) => {
      btn.addEventListener('click', () => opts.onPick(btn.dataset.date || ''), { signal: abortController.signal });
    });
  }

  function refreshSelection(checkIn: string, checkOut: string) {
    document.querySelectorAll<HTMLButtonElement>('[data-calendar-day]').forEach((btn) => {
      const date = btn.dataset.date || '';
      if (!date) return;
      const past = btn.dataset.past === 'true';
      const isStart = date === checkIn;
      const isEnd = date === checkOut;
      const range = checkIn && checkOut && date > checkIn && date < checkOut;
      const stateClass = past
        ? 'opacity-25 pointer-events-none'
        : isStart || isEnd
          ? 'bg-primary text-white font-bold'
          : range
            ? 'bg-primary/15 text-primary'
            : 'hover:bg-primary/10 hover:text-primary';
      btn.className = `aspect-square rounded-lg text-sm flex items-center justify-center transition-colors duration-200 cursor-pointer select-none ${stateClass}`;
      btn.setAttribute('aria-selected', isStart || isEnd ? 'true' : 'false');
    });
  }

  function initCalendar() {
    abortController.abort();
    abortController = new AbortController();

    const root = document.querySelector('[data-booking-calendar]') as HTMLElement | null;
    if (!root) return;

    const month0 = root.querySelector('[data-calendar-month="0"]') as HTMLElement | null;
    const month1 = root.querySelector('[data-calendar-month="1"]') as HTMLElement | null;
    const checkinInput = root.querySelector('#checkin') as HTMLInputElement | null;
    const checkoutInput = root.querySelector('#checkout') as HTMLInputElement | null;
    const guestsSelect = root.querySelector('#guests') as HTMLSelectElement | null;
    const continueBtn = root.querySelector('[data-calendar-continue]') as HTMLButtonElement | null;
    const banner = root.querySelector('[data-calendar-banner]') as HTMLElement | null;
    const checking = root.querySelector('[data-calendar-checking]') as HTMLElement | null;
    if (!month0 || !month1 || !checkinInput || !checkoutInput || !guestsSelect || !continueBtn || !banner || !checking) return;
    const checkin = checkinInput!;
    const checkout = checkoutInput!;
    const guestsSel = guestsSelect!;
    const continueBt = continueBtn!;
    const bannerEl = banner!;
    const checkingEl = checking!;

    const lang = (document.documentElement.lang || 'en') as string;
    const ROOMS = (window as any).__ROOMS_DATA as SerializedRoom[] || [];
    const INVENTORY = (window as any).__ROOM_INVENTORY as Record<string, number> || {};
    const L = (window as any).__LABELS || {};

    const params = new URLSearchParams(window.location.search);

    let checkIn = params.get('checkin') || params.get('checkIn') || '';
    let checkOut = params.get('checkout') || params.get('checkOut') || '';
    const guests = Number(params.get('guests')) || 2;
    const roomTypeParam = params.get('roomType') || params.get('room_type') || null;
    if (guestsSelect) guestsSel.value = String(guests);
    wizardStore.setState({ roomType: roomTypeParam, guests });

    const syncMinDates = () => {
      const todayIso = formatISODate(new Date());
      checkin.min = todayIso;
      if (checkIn) {
        checkout.min = addDays(checkIn, 1);
      } else {
        checkout.min = todayIso;
      }
    };

    const seedDates = () => {
      if (!checkIn) {
        const t = new Date(); t.setDate(t.getDate() + 1);
        checkIn = formatISODate(t);
      }
      if (!checkOut) {
        checkOut = addDays(checkIn, 1);
      }
      const r = clampRange(checkIn, checkOut);
      checkIn = r.checkIn;
      checkOut = r.checkOut;
      checkin.value = checkIn;
      checkout.value = checkOut;
      syncMinDates();
    };
    seedDates();

    let viewYear = new Date(checkIn + 'T00:00:00').getFullYear();
    let viewMonth = new Date(checkIn + 'T00:00:00').getMonth();
    if (new Date().getMonth() === viewMonth && new Date().getFullYear() === viewYear) {
      viewMonth = new Date().getMonth();
    }

    const render = () => {
      renderMonth(month0, viewYear, viewMonth, { lang, weekDays: ['Su','Mo','Tu','We','Th','Fr','Sa'], onPick });
      const next = new Date(viewYear, viewMonth + 1, 1);
      renderMonth(month1, next.getFullYear(), next.getMonth(), { lang, weekDays: ['Su','Mo','Tu','We','Th','Fr','Sa'], onPick });
      cleanupAnim?.();
      cleanupAnim = animateCalendarDays(month0);
      refreshSelection(checkIn, checkOut);
    };

    let isSelectingRange = false;

    function onPick(date: string) {
      if (isPast(date)) return;
      if (!isSelectingRange) {
        checkIn = date;
        checkOut = '';
        checkin.value = checkIn;
        checkout.value = '';
        isSelectingRange = true;
        continueBt.disabled = true;
        syncMinDates();
        refreshSelection(checkIn, '');
      } else {
        if (date > checkIn) {
          checkOut = date;
          checkin.value = checkIn;
          checkout.value = checkOut;
          isSelectingRange = false;
          syncMinDates();
          refreshSelection(checkIn, checkOut);
          void computeAllocation();
        } else {
          checkIn = date;
          checkOut = '';
          checkin.value = checkIn;
          checkout.value = '';
          isSelectingRange = true;
          continueBt.disabled = true;
          syncMinDates();
          refreshSelection(checkIn, '');
        }
      }
    }

    checkin.addEventListener('change', () => {
      checkIn = checkin.value;
      if (checkOut && checkOut <= checkIn) {
        checkOut = addDays(checkIn, 1);
      }
      checkout.value = checkOut;
      isSelectingRange = false;
      syncMinDates();
      void computeAllocation();
      refreshSelection(checkIn, checkOut);
    }, { signal: abortController.signal });

    checkout.addEventListener('change', () => {
      checkOut = checkout.value;
      if (checkIn && checkOut <= checkIn) {
        checkIn = addDays(checkout.value, -1);
        checkin.value = checkIn;
      }
      isSelectingRange = false;
      syncMinDates();
      void computeAllocation();
      refreshSelection(checkIn, checkOut);
    }, { signal: abortController.signal });

    guestsSel.addEventListener('change', () => {
      if (checkIn && checkOut) void computeAllocation();
    }, { signal: abortController.signal });

    async function computeAllocation() {
      if (!checkIn || !checkOut) return;
      const nights = nightsBetween(checkIn, checkOut);
      if (nights < 1) return;

      continueBt.disabled = true;
      checkingEl.classList.remove('hidden');
      bannerEl.classList.add('hidden');

      wizardStore.setState({ checkIn, checkOut, guests: Number(guestsSel.value), selecting: true, error: null });

      // Validación día a día (solo cuando hay datos por día): si un día del rango
      // está totalmente agotado, bloquear sin llamar a la API de rango.
      if (rangeDays(checkIn, checkOut).some((d) => isDaySoldOut(d))) {
        checkingEl.classList.add('hidden');
        bannerEl.textContent = L.rangeUnavailable || '';
        bannerEl.classList.remove('hidden');
        toastApi.error({ title: L.rangeUnavailable || '' });
        wizardStore.setState({ selecting: false, error: L.rangeUnavailable || '', allocation: null, options: null });
        return;
      }

      const allocatable = ROOMS.map((r) => ({
        slug: r.slug,
        displayName: r.name[lang] || r.slug,
        baseOccupancy: r.baseOccupancy,
        maxCapacity: r.maxGuests,
        extraGuestCharge: r.extraGuestCharge,
        pricePerNight: r.pricePerNight,
        inventory: INVENTORY[r.slug] ?? 0,
      }));

      let res: { success: boolean; data?: any[] | null };
      try {
        res = await bookingService.getAvailableRooms(checkIn, checkOut);
      } catch {
        res = { success: false, data: null };
      }

      if (res.success && Array.isArray(res.data)) {
        for (const item of res.data) {
          const s = item.slug ?? item.room_slug;
          const target = allocatable.find((a) => a.slug === s);
          if (target && item.price) {
            target.pricePerNight = Number(item.price);
          }
          if (target && item.total_rooms) {
            target.inventory = Number(item.total_rooms);
          }
        }
      }

      const availability: Record<string, number> | null = res.success
        ? Object.fromEntries((res.data ?? []).map((r: any) => [r.slug ?? r.room_slug, Number(r.available_qty ?? r.available ?? 0)]))
        : null;

      // Filtro por día (calendarAvailability): excluir habitaciones con qty 0 en
      // CUALQUIER día del rango. Las habitaciones sin datos por día pasan sin
      // filtrar — decide la API de rango. El allocator recibe availability ya
      // filtrado y no cambia de contrato.
      const filteredAvailability: Record<string, number> | null = availability
        ? Object.fromEntries(
            Object.entries(availability).filter(([slug, qty]) => qty > 0 && roomAvailableEveryDay(slug, checkIn, checkOut))
          )
        : null;

      const allocation = allocateRooms({ guests: Number(guestsSel.value), nights, rooms: allocatable, availability: filteredAvailability });
      const total = allocation.length > 0 ? allocation[0].total : 0;

      wizardStore.setState({
        selecting: false,
        error: res.success ? null : (L.availabilityDegraded || ''),
        allocation: allocation.length > 0 ? allocation[0] : null,
        options: allocation.length > 0 ? allocation : null,
        availabilityMap: filteredAvailability || availability,
      });

      if (!res.success) {
        bannerEl.textContent = L.availabilityDegraded || '';
        bannerEl.classList.remove('hidden');
        toastApi.warning({ title: L.availabilityDegraded || '', description: '' });
      } else if (allocation.length === 0) {
        bannerEl.textContent = L.rangeUnavailable || '';
        bannerEl.classList.remove('hidden');
        toastApi.error({ title: L.rangeUnavailable || '' });
      }

      checkingEl.classList.add('hidden');
      if (allocation.length > 0) {
        continueBt.disabled = false;
        continueBt.setAttribute('data-ready', 'true');
        continueBt.dataset.total = String(total);
      }

      if (!firstCompute && allocation.length > 0) {
        toastApi.success({
          title: L.toastOptionsUpdated || 'Options updated',
          description: (L.toastBestPrice || 'Best price {total}').replace('{total}', `$${total}`),
        });
      }
      firstCompute = false;
    }

    continueBt.addEventListener('click', () => {
      if (continueBt.disabled) return;
      wizardStore.next();
    }, { signal: abortController.signal });

    render();
    if (checkIn && checkOut) void computeAllocation();
    // Cargar disponibilidad por día para marcar días agotados; al llegar,
    // re-renderizar el calendario con los días bloqueados y tooltips.
    void loadCalendarAvailability().then(() => {
      if (calendarAvailability && Object.keys(calendarAvailability).length > 0) {
        render();
        if (checkIn && checkOut) {
          const r = clampRange(checkIn, checkOut);
          checkIn = r.checkIn;
          checkOut = r.checkOut;
          refreshSelection(checkIn, checkOut);
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initCalendar);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
    cleanupAnim?.();
    cleanupAnim = null;
  });
</script>
