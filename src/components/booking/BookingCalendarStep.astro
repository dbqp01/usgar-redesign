---
// src/components/booking/BookingCalendarStep.astro
// Step 1: Sleek Date Bar + Collapsible Dual-Month Calendar (Single Unified Calendar - No Native Browser Popups).
// Preserves: data-booking-calendar, data-calendar-month="0", data-calendar-month="1",
// #checkin, #checkout, #guests, data-calendar-continue, data-calendar-banner, data-calendar-checking
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const guestOptions = Array.from({ length: 7 }, (_, i) => i + 1);
---

<div
  data-booking-calendar
  class="bg-surface-card-light dark:bg-surface-card-dark p-4 sm:p-6 rounded-2xl border border-black/8 dark:border-white/10 shadow-sm space-y-4"
>
  <!-- Sleek Top Inputs Bar (Custom text inputs - opens single custom calendar) -->
  <div class="grid grid-cols-2 sm:grid-cols-12 gap-3 items-end">
    <div class="sm:col-span-4">
      <label for="checkin" class="block text-[10px] font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1">
        {t('wizard.checkIn')}
      </label>
      <div class="relative">
        <input
          type="text"
          id="checkin"
          name="checkin"
          readonly
          placeholder="YYYY-MM-DD"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-xs font-semibold text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all cursor-pointer pr-8 select-none"
        />
        <div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-text-secondary-light dark:text-text-secondary-dark">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="sm:col-span-4">
      <label for="checkout" class="block text-[10px] font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1">
        {t('wizard.checkOut')}
      </label>
      <div class="relative">
        <input
          type="text"
          id="checkout"
          name="checkout"
          readonly
          placeholder="YYYY-MM-DD"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-xs font-semibold text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all cursor-pointer pr-8 select-none"
        />
        <div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-text-secondary-light dark:text-text-secondary-dark">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="sm:col-span-2">
      <label for="guests" class="block text-[10px] font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-1">
        {t('wizard.guestsLabel')}
      </label>
      <div class="relative">
        <select
          id="guests"
          name="guests"
          class="w-full px-3 py-2 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-xs font-medium text-text-primary-light dark:text-white focus:ring-2 focus:ring-secondary/40 focus:border-secondary outline-none transition-all appearance-none cursor-pointer pr-8"
        >
          {guestOptions.map((g) => (
            <option value={g} class="bg-white dark:bg-surface-dark">{g} {g === 1 ? t('booking.guest') : t('booking.guests_plural')}</option>
          ))}
        </select>
        <div class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-text-secondary-light dark:text-text-secondary-dark">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </div>
    </div>

    <div class="sm:col-span-2">
      <button
        type="button"
        data-toggle-calendar
        class="w-full px-3 py-2 rounded-xl border border-secondary/30 bg-secondary/5 hover:bg-secondary/15 text-secondary-dark dark:text-secondary text-xs font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5"
      >
        <span>{t('wizard.toggleCalendar')}</span>
        <svg class="w-3.5 h-3.5 transition-transform" data-calendar-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Collapsible Calendar Drawer -->
  <div data-calendar-drawer class="hidden space-y-4 pt-3 border-t border-black/6 dark:border-white/6 animate-fade-in">
    <!-- Month Header Controls -->
    <div class="flex items-center justify-between">
      <h3 class="font-display text-sm font-bold text-text-primary-light dark:text-white">
        {t('wizard.calendarTitle')}
      </h3>
      <div class="flex items-center gap-1">
        <button type="button" data-calendar-prev class="p-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer text-text-secondary-light dark:text-text-secondary-dark" aria-label={t('wizard.prevMonth')}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button type="button" data-calendar-next-month class="p-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors cursor-pointer text-text-secondary-light dark:text-text-secondary-dark" aria-label={t('wizard.nextMonth')}>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Calendar Grids -->
    <div class="flex flex-col gap-4 lg:flex-row lg:gap-6">
      <div class="flex-1" data-calendar-month="0"></div>
      <div class="flex-1 hidden lg:block" data-calendar-month="1"></div>
    </div>

    <!-- Legend -->
    <div class="flex items-center gap-4 text-[10px] text-text-secondary-light dark:text-text-secondary-dark font-body pt-2">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-teal-brand" aria-hidden="true"></span>
        {t('wizard.legendAvailable')}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-rose-400" aria-hidden="true"></span>
        {t('wizard.legendSoldOut')}
      </span>
    </div>
  </div>

  <!-- Status Banners -->
  <div data-calendar-banner class="hidden p-3 rounded-xl border border-amber-500/20 bg-amber-500/5 text-amber-700 dark:text-amber-300 text-xs"></div>
  <div data-calendar-checking class="hidden p-3 rounded-xl border border-primary/15 bg-primary/5 text-primary text-xs flex items-center gap-2">
    <svg class="w-4 h-4 animate-spin flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <span>{t('wizard.availabilityChecking')}</span>
  </div>
</div>

<script>
  import { buildMonthGrid, nightsBetween, clampRange, formatISODate, addDays } from '../../features/booking/calendar';
  import { formatDate } from '../../utils/format';
  import { allocateRooms } from '../../features/booking/roomAllocator';
  import { wizardStore } from '../../features/booking/wizardStore';
  import { bookingService } from '../../services/bookingService';
  import { animateCalendarDays } from '../../features/animations/modules/bookingCalendar';
  import { toastApi } from '../../features/ui/toast';

  let abortController = new AbortController();
  let cleanupAnim: (() => void) | null = null;
  let firstCompute = true;

  let calendarAvailability: Record<string, Record<string, number>> = {};

  interface SerializedRoom {
    slug: string;
    name: Record<string, string>;
    pricePerNight: number;
    beds: string;
    baseOccupancy: number;
    extraGuestCharge: number;
    maxGuests: number;
  }

  function isPast(date: string): boolean {
    return date < formatISODate(new Date());
  }

  function escapeAttr(value: string): string {
    return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  const ROOM_DOT_ORDER = ['matrimonial', 'doble-superior', 'triple-standar', 'familiar-superior'];

  function roomDots(day: Record<string, number>): string {
    return ROOM_DOT_ORDER.map((slug) => {
      const available = (day[slug] ?? 0) > 0;
      const cls = available ? 'bg-teal-brand' : 'bg-rose-400';
      return `<span class="w-1 h-1 rounded-full ${cls}" aria-hidden="true"></span>`;
    }).join('');
  }

  function rangeDays(checkIn: string, checkOut: string): string[] {
    const days: string[] = [];
    const cursor = new Date(checkIn + 'T00:00:00');
    const end = new Date(checkOut + 'T00:00:00');
    while (cursor < end) {
      days.push(formatISODate(cursor));
      cursor.setDate(cursor.getDate() + 1);
    }
    return days;
  }

  function roomAvailableEveryDay(slug: string, checkIn: string, checkOut: string): boolean {
    for (const d of rangeDays(checkIn, checkOut)) {
      const day = calendarAvailability[d];
      if (day && day[slug] !== undefined) {
        if ((day[slug] ?? 0) < 1) return false;
      }
    }
    return true;
  }

  function labels(): Record<string, string> {
    return (window as any).__LABELS || {};
  }

  function isDaySoldOut(date: string): boolean {
    const day = calendarAvailability[date];
    if (!day) return false;
    const slugs = Object.keys(day);
    if (slugs.length === 0) return false;
    return slugs.every((slug) => (day[slug] ?? 0) <= 0);
  }

  function availableRoomsLabel(date: string): string {
    const day = calendarAvailability[date];
    if (!day) return '';
    const lang = (document.documentElement.lang || 'en') as string;
    const rooms = (window as any).__ROOMS_DATA as SerializedRoom[] || [];
    const available = Object.entries(day)
      .filter(([, qty]) => (qty ?? 0) > 0)
      .map(([slug]) => {
        const room = rooms.find((r) => r.slug === slug);
        return room ? (room.name[lang] || slug) : slug;
      });
    if (available.length === 0) return '';
    const lb = labels();
    return `${lb.availableOn || 'Available:'} ${available.slice(0, 4).join(', ')}${available.length > 4 ? '...' : ''}`;
  }

  async function loadCalendarAvailability(): Promise<void> {
    const today = new Date();
    const from = formatISODate(today);
    const end = new Date(today); end.setMonth(end.getMonth() + 3);
    const to = formatISODate(end);
    try {
      const res = await bookingService.getAvailabilityCalendar(from, to);
      if (res.success && res.data) {
        calendarAvailability = res.data;
      }
    } catch {
      calendarAvailability = {};
    }
  }

  function renderMonth(container: HTMLElement, year: number, month: number, opts: {
    lang: string;
    weekDays: string[];
    onPick: (date: string) => void;
  }) {
    const cells = buildMonthGrid(year, month);
    const monthName = new Date(year, month, 1).toLocaleDateString(
      opts.lang === 'es' ? 'es' : opts.lang === 'fr' ? 'fr' : opts.lang === 'pt' ? 'pt' : 'en',
      { month: 'long', year: 'numeric' }
    );

    container.innerHTML = `
      <div class="text-center mb-2">
        <span class="font-display text-xs font-bold capitalize text-text-primary-light dark:text-white">${monthName}</span>
      </div>
      <div class="grid grid-cols-7 gap-0.5 text-center text-[9px] font-body font-semibold uppercase tracking-widest text-text-secondary-light/60 dark:text-text-secondary-dark/60 mb-1">
        ${opts.weekDays.map((d) => `<span class="py-0.5">${d}</span>`).join('')}
      </div>
      <div class="grid grid-cols-7 gap-0.5" role="grid" aria-label="${monthName}">
        ${cells.map((cell) => {
          if (!cell.inMonth) return '<span></span>';
          const past = cell.past;
          const dayNum = Number(cell.date.slice(-2));
          const dateLabel = formatDate(cell.date, opts.lang);
          const soldOut = !past && calendarAvailability[cell.date] !== undefined && isDaySoldOut(cell.date);
          const disabledAttr = past || soldOut ? 'tabindex="-1" aria-disabled="true"' : '';
          const stateClass = past
            ? 'opacity-20 pointer-events-none'
            : soldOut
              ? 'opacity-30 pointer-events-none line-through text-rose-400'
              : 'hover:bg-secondary/10 hover:text-secondary-dark dark:hover:text-secondary';
          const tooltip = soldOut
            ? ` title="${escapeAttr(labels().soldOut || 'Sold out')}"`
            : calendarAvailability[cell.date] && !past
              ? ` title="${escapeAttr(availableRoomsLabel(cell.date))}"`
              : '';
          const dots = !past && calendarAvailability[cell.date] ? roomDots(calendarAvailability[cell.date]) : '';
          return `<button type="button" role="gridcell" data-calendar-day data-date="${cell.date}" data-past="${past}" data-sold-out="${soldOut}" aria-label="${dateLabel}${soldOut ? ' - ' + (labels().soldOut || 'Sold out') : ''}" ${disabledAttr}${tooltip} class="aspect-square rounded text-xs font-body flex items-center justify-center transition-all duration-150 cursor-pointer select-none ${stateClass}"><span class="flex flex-col items-center justify-center gap-0.5 leading-none"><span>${dayNum}</span>${dots ? `<span class="flex items-center justify-center gap-px">${dots}</span>` : ''}</span></button>`;
        }).join('')}
      </div>
    `;

    container.querySelectorAll<HTMLButtonElement>('[data-calendar-day]').forEach((btn) => {
      btn.addEventListener('click', () => opts.onPick(btn.dataset.date || ''), { signal: abortController.signal });
    });
  }

  function refreshSelection(checkIn: string, checkOut: string) {
    document.querySelectorAll<HTMLButtonElement>('[data-calendar-day]').forEach((btn) => {
      const date = btn.dataset.date || '';
      if (!date) return;
      const past = btn.dataset.past === 'true';
      const soldOut = btn.dataset.soldOut === 'true';
      if (past || soldOut) return;
      const isStart = date === checkIn;
      const isEnd = date === checkOut;
      const range = checkIn && checkOut && date > checkIn && date < checkOut;
      const stateClass = isStart || isEnd
        ? 'bg-primary text-white font-semibold shadow-sm'
        : range
          ? 'bg-primary/10 text-primary dark:text-primary-soft'
          : 'hover:bg-secondary/10 hover:text-secondary-dark dark:hover:text-secondary';
      btn.className = `aspect-square rounded text-xs font-body flex items-center justify-center transition-all duration-150 cursor-pointer select-none ${stateClass}`;
      btn.setAttribute('aria-selected', isStart || isEnd ? 'true' : 'false');
    });
  }

  function initCalendar() {
    abortController.abort();
    abortController = new AbortController();

    const root = document.querySelector('[data-booking-calendar]') as HTMLElement | null;
    if (!root) return;

    const month0 = root.querySelector('[data-calendar-month="0"]') as HTMLElement | null;
    const month1 = root.querySelector('[data-calendar-month="1"]') as HTMLElement | null;
    const checkinInput = root.querySelector<HTMLInputElement>('#checkin');
    const checkoutInput = root.querySelector<HTMLInputElement>('#checkout');
    const guestsSelect = root.querySelector<HTMLSelectElement>('#guests');
    const banner = root.querySelector('[data-calendar-banner]') as HTMLElement | null;
    const checking = root.querySelector('[data-calendar-checking]') as HTMLElement | null;
    const prevBtn = root.querySelector('[data-calendar-prev]') as HTMLButtonElement | null;
    const nextMonthBtn = root.querySelector('[data-calendar-next-month]') as HTMLButtonElement | null;
    const toggleBtn = root.querySelector('[data-toggle-calendar]') as HTMLButtonElement | null;
    const drawer = root.querySelector('[data-calendar-drawer]') as HTMLElement | null;
    const chevron = root.querySelector('[data-calendar-chevron]') as HTMLElement | null;

    if (!month0 || !month1 || !checkinInput || !checkoutInput || !guestsSelect || !banner || !checking) return;
    const checkin = checkinInput!;
    const checkout = checkoutInput!;
    const guestsSel = guestsSelect!;
    const bannerEl = banner!;
    const checkingEl = checking!;

    // Toggle drawer functionality (Clicking inputs also toggles custom calendar!)
    const toggleDrawer = (open?: boolean) => {
      if (drawer) {
        const isHidden = open !== undefined ? !open : drawer.classList.contains('hidden');
        drawer.classList.toggle('hidden', !isHidden);
        if (chevron) chevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
      }
    };

    toggleBtn?.addEventListener('click', () => toggleDrawer(), { signal: abortController.signal });
    checkin.addEventListener('click', () => toggleDrawer(true), { signal: abortController.signal });
    checkout.addEventListener('click', () => toggleDrawer(true), { signal: abortController.signal });

    const lang = (document.documentElement.lang || 'en') as string;
    const ROOMS = (window as any).__ROOMS_DATA as SerializedRoom[] || [];
    const INVENTORY = (window as any).__ROOM_INVENTORY as Record<string, number> || {};
    const L = (window as any).__LABELS || {};

    const params = new URLSearchParams(window.location.search);

    let checkIn = params.get('checkin') || params.get('checkIn') || '';
    let checkOut = params.get('checkout') || params.get('checkOut') || '';
    const guests = Number(params.get('guests')) || 2;
    const roomTypeParam = params.get('roomType') || params.get('room_type') || null;
    if (guestsSelect) guestsSel.value = String(guests);
    wizardStore.setState({ roomType: roomTypeParam, guests });

    const seedDates = () => {
      const todayIso = formatISODate(new Date());
      // DYNAMIC DEFAULT DATES: If missing or in the past, default to Tomorrow -> +3 days
      if (!checkIn || checkIn < todayIso) {
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        checkIn = formatISODate(tomorrow);
      }
      if (!checkOut || checkOut <= checkIn) {
        checkOut = addDays(checkIn, 3);
      }
      const r = clampRange(checkIn, checkOut);
      checkIn = r.checkIn;
      checkOut = r.checkOut;
      checkin.value = checkIn;
      checkout.value = checkOut;
    };
    seedDates();

    let viewYear = new Date(checkIn + 'T00:00:00').getFullYear();
    let viewMonth = new Date(checkIn + 'T00:00:00').getMonth();
    if (new Date().getMonth() === viewMonth && new Date().getFullYear() === viewYear) {
      viewMonth = new Date().getMonth();
    }

    const weekDays = lang === 'es' ? ['Do','Lu','Ma','Mi','Ju','Vi','Sa']
      : lang === 'fr' ? ['Di','Lu','Ma','Me','Je','Ve','Sa']
      : lang === 'pt' ? ['Do','Se','Te','Qu','Qu','Se','Sa']
      : ['Su','Mo','Tu','We','Th','Fr','Sa'];

    const render = () => {
      renderMonth(month0, viewYear, viewMonth, { lang, weekDays, onPick });
      const next = new Date(viewYear, viewMonth + 1, 1);
      renderMonth(month1, next.getFullYear(), next.getMonth(), { lang, weekDays, onPick });
      cleanupAnim?.();
      cleanupAnim = animateCalendarDays(month0);
      refreshSelection(checkIn, checkOut);
    };

    prevBtn?.addEventListener('click', () => {
      const today = new Date();
      if (viewYear > today.getFullYear() || (viewYear === today.getFullYear() && viewMonth > today.getMonth())) {
        viewMonth -= 1;
        if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
        render();
      }
    }, { signal: abortController.signal });

    nextMonthBtn?.addEventListener('click', () => {
      viewMonth += 1;
      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
      render();
    }, { signal: abortController.signal });

    let isSelectingRange = false;

    function onPick(date: string) {
      if (isPast(date)) return;
      if (!isSelectingRange) {
        checkIn = date;
        checkOut = '';
        checkin.value = checkIn;
        checkout.value = '';
        isSelectingRange = true;
        refreshSelection(checkIn, '');
      } else {
        if (date > checkIn) {
          checkOut = date;
          checkin.value = checkIn;
          checkout.value = checkOut;
          isSelectingRange = false;
          refreshSelection(checkIn, checkOut);
          toggleDrawer(false); // Close calendar drawer once full range is selected
          void computeAllocation();
        } else {
          checkIn = date;
          checkOut = '';
          checkin.value = checkIn;
          checkout.value = '';
          isSelectingRange = true;
          refreshSelection(checkIn, '');
        }
      }
    }

    guestsSel.addEventListener('change', () => {
      if (checkIn && checkOut) void computeAllocation();
    }, { signal: abortController.signal });

    async function computeAllocation() {
      if (!checkIn || !checkOut) return;
      const nights = nightsBetween(checkIn, checkOut);
      if (nights < 1) return;

      checkingEl.classList.remove('hidden');
      bannerEl.classList.add('hidden');

      wizardStore.setState({ checkIn, checkOut, guests: Number(guestsSel.value), selecting: true, error: null });

      if (rangeDays(checkIn, checkOut).some((d) => isDaySoldOut(d))) {
        checkingEl.classList.add('hidden');
        bannerEl.textContent = L.rangeUnavailable || '';
        bannerEl.classList.remove('hidden');
        toastApi.error({ title: L.rangeUnavailable || '' });
        wizardStore.setState({ selecting: false, error: L.rangeUnavailable || '', allocation: null, options: null });
        return;
      }

      const allocatable = ROOMS.map((r) => ({
        slug: r.slug,
        displayName: r.name[lang] || r.slug,
        baseOccupancy: r.baseOccupancy,
        maxCapacity: r.maxGuests,
        extraGuestCharge: r.extraGuestCharge,
        pricePerNight: r.pricePerNight,
        inventory: INVENTORY[r.slug] ?? 0,
      }));

      let res: { success: boolean; data?: any[] | null };
      try {
        res = await bookingService.getAvailableRooms(checkIn, checkOut);
      } catch {
        res = { success: false, data: null };
      }

      if (res.success && Array.isArray(res.data)) {
        for (const item of res.data) {
          const s = item.slug ?? item.room_slug;
          const target = allocatable.find((a) => a.slug === s);
          if (target && item.price) {
            target.pricePerNight = Number(item.price);
          }
          if (target && item.total_rooms) {
            target.inventory = Number(item.total_rooms);
          }
        }
      }

      // Tarifas por habitación servidas por el backend (rate_plans resueltos
      // desde las Catalog Price Rules de QloApps) — fuente del % no reembolsable.
      const ratePlans: Record<string, { standard: number; non_refundable: number }> = {};
      if (res.success && Array.isArray(res.data)) {
        for (const item of res.data) {
          const s = item.slug ?? item.room_slug;
          if (s && item.rate_plans?.standard && item.rate_plans?.non_refundable) {
            ratePlans[s] = {
              standard: Number(item.rate_plans.standard),
              non_refundable: Number(item.rate_plans.non_refundable),
            };
          }
        }
      }

      const availability: Record<string, number> | null = res.success
        ? Object.fromEntries((res.data ?? []).map((r: any) => [r.slug ?? r.room_slug, Number(r.available_qty ?? r.available ?? 0)]))
        : null;

      const filteredAvailability: Record<string, number> | null = availability
        ? Object.fromEntries(
            Object.entries(availability).filter(([slug, qty]) => qty > 0 && roomAvailableEveryDay(slug, checkIn, checkOut))
          )
        : null;

      const allocation = allocateRooms({ guests: Number(guestsSel.value), nights, rooms: allocatable, availability: filteredAvailability });
      const total = allocation.length > 0 ? allocation[0].total : 0;

      wizardStore.setState({
        selecting: false,
        error: res.success ? null : (L.availabilityDegraded || ''),
        allocation: allocation.length > 0 ? allocation[0] : null,
        options: allocation.length > 0 ? allocation : null,
        availabilityMap: filteredAvailability || availability,
        ratePlans: Object.keys(ratePlans).length > 0 ? ratePlans : null,
      });

      if (!res.success) {
        bannerEl.textContent = L.availabilityDegraded || '';
        bannerEl.classList.remove('hidden');
      } else if (allocation.length === 0) {
        bannerEl.textContent = L.rangeUnavailable || '';
        bannerEl.classList.remove('hidden');
        toastApi.error({ title: L.rangeUnavailable || '' });
      }

      checkingEl.classList.add('hidden');

      if (!firstCompute && allocation.length > 0) {
        toastApi.success({
          title: L.toastOptionsUpdated || 'Options updated',
          description: (L.toastBestPrice || 'Best price {total}').replace('{total}', `$${total}`),
        });
      }
      firstCompute = false;
    }

    render();
    if (checkIn && checkOut) void computeAllocation();
    void loadCalendarAvailability().then(() => {
      if (calendarAvailability && Object.keys(calendarAvailability).length > 0) {
        render();
        if (checkIn && checkOut) {
          const r = clampRange(checkIn, checkOut);
          checkIn = r.checkIn;
          checkOut = r.checkOut;
          refreshSelection(checkIn, checkOut);
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initCalendar);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
    cleanupAnim?.();
    cleanupAnim = null;
  });
</script>
