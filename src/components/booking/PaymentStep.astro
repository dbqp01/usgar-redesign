---
// debt: oversized module (564 LOC) — split into concept-named components when touched; ceiling 250 pure LOC
// src/components/booking/PaymentStep.astro
// Paso 3 del wizard: el flujo de pago MercadoPago EXISTENTE, intacto
// (createHold -> cardForm -> processPayment). Solo maquetado editorial.
// W5 (todos 28-31): pending -> success (sin apilar), pre-retry booking-status
// + payment-check, countdown del hold + extend, cooldown deterministico,
// beforeunload guard. Todo texto sale del i18n (todo 30).
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<div data-payment-step class="space-y-6">
  <div data-payment-panel class="hidden bg-surface-card-light dark:bg-surface-card-dark p-6 md:p-8 rounded-3xl border border-black/5 dark:border-white/5 shadow-sm space-y-6">
    <h2 class="font-display text-2xl flex items-center gap-3 border-b border-black/5 dark:border-white/5 pb-3">
      <span class="w-7 h-7 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm font-semibold">3</span>
      {t('book.paymentDetails')}
    </h2>

    <div data-payment-note class="hidden p-4 rounded-xl border border-primary/20 bg-primary/5 text-primary text-sm"></div>

    <div id="mp-payment-form-wrap" class="space-y-4">
      <div id="cardPaymentBrick_container"></div>

      <div data-payment-error class="hidden p-4 rounded-xl border border-red-400/30 bg-red-500/5 text-red-600 dark:text-red-400 text-sm space-y-1">
        <p data-payment-error-text></p>
      </div>

      <p data-hold-countdown class="hidden text-center text-xs font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-400"></p>
    </div>

    <div class="flex items-center justify-between pt-2">
      <button
        type="button"
        data-payment-back
        class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold uppercase tracking-wider border border-black/10 dark:border-white/10 text-text-secondary-light dark:text-text-secondary-dark hover:border-primary/40 transition-colors cursor-pointer"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" />
        </svg>
        {t('wizard.back')}
      </button>
    </div>
  </div>

  <div data-payment-placeholder class="hidden flex-col items-center justify-center gap-4 p-8 rounded-3xl border border-dashed border-black/10 dark:border-white/10 text-sm text-text-secondary-light dark:text-text-secondary-dark">
    <div class="flex items-center justify-center gap-3">
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span data-payment-placeholder-text>{t('payment.preparing')}</span>
    </div>
    <button
      type="button"
      data-payment-cancel
      class="inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-xs font-semibold uppercase tracking-wider border border-black/10 dark:border-white/10 text-text-secondary-light dark:text-text-secondary-dark hover:border-red-400/50 hover:text-red-500 transition-colors cursor-pointer"
    >
      {t('wizard.back')}
    </button>
  </div>
</div>

<script>
  import { wizardStore } from '../../features/booking/wizardStore';
  import { bookingService } from '../../services/bookingService';
  import { toastApi } from '../../features/ui/toast';
  import { useTranslations, type Locale } from '@/i18n/utils';
  import { resolvePaymentOutcome, planRetryAfterFailure } from '@/utils/paymentStatus';
  import { formatCountdown, shouldExtendHold } from '@/utils/holdCountdown';
  import { statusDetailKey, paymentErrorFallbackKey } from '@/utils/paymentErrors';

  type TFunc = (key: string) => string;

  // Locales del SDK de MercadoPago por idioma del sitio (todo 30).
  const MP_LOCALES: Record<Locale, string> = { en: 'en-US', es: 'es-PE', fr: 'fr-FR', pt: 'pt-BR' };

  // Todo 31: cooldown deterministico >= 60s entre reintentos tras fallo de red.
  const RETRY_COOLDOWN_MS = 60_000;

  let abortController = new AbortController();
  let started = false;
  let cardFormInstance: any = null;
  // Timer de seguridad: si onReady no llega (iframes bloqueados por adblocker,
  // SDK lento), habilita el botón Pay para no bloquear al usuario para siempre.
  let payReadyTimer: number | null = null;
  // Todo 29: countdown del hold + extend (una sola vez).
  let countdownTimer: number | null = null;
  let holdExtendCalled = false;
  // Todo 31: estado del reintento.
  let retryBlockedStreak = 0;
  let cooldownEndsAt = 0;
  let retryTimer: number | null = null;
  let processingPayment = false;

  function setProcessing(p: boolean): void {
    wizardStore.setState({ processing: p });
  }

  function showPaymentPanel(): void {
    const panel = document.querySelector('[data-payment-panel]') as HTMLElement | null;
    const placeholder = document.querySelector('[data-payment-placeholder]') as HTMLElement | null;
    const guestStep = document.querySelector('[data-guest-step]') as HTMLElement | null;
    if (panel) panel.classList.remove('hidden');
    if (placeholder) placeholder.classList.add('hidden');
    // Transición de formularios: ocultar el guest para que el usuario
    // se enfoque únicamente en el pago (flujo paso a paso).
    if (guestStep) guestStep.classList.add('hidden');
    // Dirigir al usuario al formulario de pago recién montado
    requestAnimationFrame(() => {
      panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  function showPaymentPlaceholder(): void {
    const panel = document.querySelector('[data-payment-panel]') as HTMLElement | null;
    const placeholder = document.querySelector('[data-payment-placeholder]') as HTMLElement | null;
    if (panel) panel.classList.add('hidden');
    if (placeholder) placeholder.classList.remove('hidden');
  }

  function resetPaymentUi(): void {
    const panel = document.querySelector('[data-payment-panel]') as HTMLElement | null;
    const placeholder = document.querySelector('[data-payment-placeholder]') as HTMLElement | null;
    const guestStep = document.querySelector('[data-guest-step]') as HTMLElement | null;
    if (panel) panel.classList.add('hidden');
    if (placeholder) placeholder.classList.add('hidden');
    // Restaurar el guest form (visible de nuevo al volver atrás o reintentar)
    if (guestStep) guestStep.classList.remove('hidden');
    const cardError = document.querySelector('[data-payment-error]') as HTMLElement | null;
    if (cardError) cardError.classList.add('hidden');
  }

  function loadMercadoPagoSdk(): Promise<void> {
    return new Promise((resolve, reject) => {
      if (typeof (window as any).MercadoPago !== 'undefined') {
        resolve();
        return;
      }
      const s = document.createElement('script');
      s.src = 'https://sdk.mercadopago.com/js/v2';
      s.async = true;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error('MercadoPago SDK could not load'));
      document.head.appendChild(s);
    });
  }

  // ---- Todo 28: redirigir a success sin apilar reintentos ----
  function redirectToSuccess(cartId: string): void {
    const lang = (document.documentElement.lang || 'en') as Locale;
    let successUrl = `/book/success?booking=${cartId}`;
    if (lang !== 'en') successUrl = `/${lang}${successUrl}`;
    window.location.href = successUrl;
  }

  // ---- Todo 29: countdown del hold + extend (una vez) + beforeunload ----
  function stopHoldCountdown(): void {
    if (countdownTimer !== null) {
      window.clearInterval(countdownTimer);
      countdownTimer = null;
    }
  }

  async function startHoldCountdown(cartId: string, accessToken: string, t: TFunc): Promise<void> {
    stopHoldCountdown();
    const el = document.querySelector('[data-hold-countdown]') as HTMLElement | null;
    if (!el) return;
    try {
      const res = await bookingService.getBookingStatus(cartId, accessToken);
      if (!res.success) return;
      let timeLeft = Math.max(0, Number(res.data?.time_left_seconds ?? 0));
      if (timeLeft <= 0) return;

      const render = () => {
        el.textContent = t('payment.holdCountdown').replace('{n}', formatCountdown(timeLeft));
        el.classList.remove('hidden');
      };
      render();
      countdownTimer = window.setInterval(() => {
        timeLeft -= 1;
        if (timeLeft <= 0) {
          stopHoldCountdown();
          render();
          return;
        }
        render();
        // Extender UNA vez al llegar a ~60s (endpoint extend-hold del backend).
        if (shouldExtendHold(timeLeft, 60, holdExtendCalled)) {
          holdExtendCalled = true;
          void extendHoldOnce(cartId, accessToken, t);
        }
      }, 1000);
    } catch {
      // Sin countdown el pago sigue funcionando (best-effort).
    }
  }

  async function extendHoldOnce(cartId: string, accessToken: string, t: TFunc): Promise<void> {
    try {
      const response = await fetch('/api/extend-hold', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cart_id: cartId, access_token: accessToken }),
      });
      const payload = await response.json();
      if (payload?.success && payload.time_left_seconds) {
        // Reiniciar el countdown con el nuevo tiempo del hold.
        stopHoldCountdown();
        void startHoldCountdown(cartId, accessToken, t);
      }
    } catch {
      // Best-effort: si el extend falla, el countdown sigue y el usuario puede pagar.
    }
  }

  // ---- Todo 31: cooldown deterministico visible en el botón ----
  function startCooldown(seconds: number, t: TFunc): void {
    const btn = document.getElementById('btn-final-pay') as HTMLButtonElement | null;
    const text = document.getElementById('btn-final-text');
    const spinner = document.getElementById('btn-final-spinner');
    if (spinner) spinner.classList.add('hidden');
    if (btn) {
      btn.disabled = true;
      btn.classList.add('disabled:pointer-events-none');
    }
    let remaining = seconds;
    const tick = () => {
      if (text) text.textContent = t('payment.retryCooldown').replace('{n}', formatCountdown(Math.max(0, remaining)));
      if (remaining <= 0) {
        if (retryTimer !== null) { window.clearInterval(retryTimer); retryTimer = null; }
        if (btn) {
          btn.disabled = false;
          btn.classList.remove('disabled:pointer-events-none');
        }
        if (text) text.textContent = t('payment.payNow');
        return;
      }
      remaining -= 1;
    };
    if (retryTimer !== null) window.clearInterval(retryTimer);
    retryTimer = window.setInterval(tick, 1000);
    tick();
  }

  function stopCooldown(): void {
    if (retryTimer !== null) {
      window.clearInterval(retryTimer);
      retryTimer = null;
    }
  }

  // ---- Todo 31: flujo pre-retry (booking-status -> payment-check -> plan) ----
  async function handlePaymentFailure(
    error: { code?: string; message?: string; statusDetail?: string },
    cartId: string,
    accessToken: string,
    t: TFunc,
    showError: (msg: string) => void
  ): Promise<void> {
    const isNetworkFailure = error.code === 'TIMEOUT_ERROR' || error.code === 'NETWORK_ERROR';

    // Mensaje accionable por status_detail (todo 26/30) o generico.
    const detailKey = statusDetailKey(error.statusDetail);
    showError(detailKey ? t(detailKey) : t(paymentErrorFallbackKey()));

    try {
      // 1) Estado local: si ya hay payment_id o pago confirmado -> success.
      const local = await bookingService.getBookingStatus(cartId, accessToken);
      if (local.success && resolvePaymentOutcome(null, local.data) === 'redirect_success') {
        redirectToSuccess(cartId);
        return;
      }
      // 2) MP por external_reference (payment-check, todo 31): pago existente
      //    -> success; NUNCA crear un segundo pago.
      const check = await bookingService.checkPayment(cartId, accessToken);
      const plan = planRetryAfterFailure({
        localStatus: local.success ? local.data : null,
        paymentCheck: check.success ? check.data : null,
        blockedStreak: retryBlockedStreak,
        cooldownEndsAt,
        now: Date.now(),
      });
      if (plan.action === 'redirect_success') {
        redirectToSuccess(cartId);
        return;
      }
      if (plan.action === 'manual_review') {
        showError(t('payment.manualReview'));
        return; // el botón queda deshabilitado; guiado a revisión manual.
      }
      if (plan.action === 'cooldown') {
        startCooldown(plan.cooldownSeconds || 60, t);
        return;
      }
      // retry seguro: marcar bloqueo (solo fallos de red) + cooldown >= 60s.
      if (isNetworkFailure) retryBlockedStreak += 1;
      cooldownEndsAt = Date.now() + RETRY_COOLDOWN_MS;
      startCooldown(Math.ceil(RETRY_COOLDOWN_MS / 1000), t);
    } catch {
      // No verificable (red caída también para las consultas): fail-safe.
      if (isNetworkFailure) retryBlockedStreak += 1;
      cooldownEndsAt = Date.now() + RETRY_COOLDOWN_MS;
      startCooldown(Math.ceil(RETRY_COOLDOWN_MS / 1000), t);
    }
  }

  function initPaymentStep() {
    abortController.abort();
    abortController = new AbortController();

    const root = document.querySelector('[data-payment-step]') as HTMLElement | null;
    if (!root) return;

    const backBtn = root.querySelector('[data-payment-back]') as HTMLButtonElement | null;
    backBtn?.addEventListener('click', handlePaymentBack, { signal: abortController.signal });
    const cancelBtn = root.querySelector('[data-payment-cancel]') as HTMLButtonElement | null;
    cancelBtn?.addEventListener('click', handlePaymentBack, { signal: abortController.signal });

    const start = () => {
      if (started) return;
      const state = wizardStore.getState();
      if (state.step !== 3) return;
      const guestNameInput = document.getElementById('guest-name') as HTMLInputElement | null;
      const guestEmailInput = document.getElementById('guest-email') as HTMLInputElement | null;
      const guestPhoneInput = document.getElementById('guest-phone') as HTMLInputElement | null;
      if (!guestNameInput?.value || !guestEmailInput?.value || !guestPhoneInput?.value) return;
      started = true;
      void runPaymentFlow(state);
    };

    const unsub = wizardStore.subscribe(() => start());
    abortController.signal.addEventListener('abort', () => unsub());
    start();
  }

  async function runPaymentFlow(state: any) {
    const allocation = state.allocation;
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');
    if (!allocation || allocation.rooms.length !== 1) return;

    // Feedback inmediato: mostramos el placeholder "Preparing secure payment..."
    // mientras se crea el hold, y recién al éxito mostramos el formulario real.
    showPaymentPlaceholder();

    const room = allocation.rooms[0].room;
    const lang = (document.documentElement.lang || 'en') as Locale;
    const t = useTranslations(lang);

    function showError(msg: string) {
      toastApi.error({ title: msg });
      if (errorBanner && errorMessage) {
        errorMessage.textContent = msg;
        errorBanner.classList.remove('hidden');
        errorBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    // Errores de validación/tokenización del cardForm de MercadoPago:
    // se muestran inline, junto al botón de pago (el banner global queda
    // reservado para errores del backend).
    function showCardError(msg: string): void {
      const box = document.querySelector('[data-payment-error]') as HTMLElement | null;
      const text = document.querySelector('[data-payment-error-text]') as HTMLElement | null;
      if (!box || !text) return;
      text.textContent = msg;
      box.classList.remove('hidden');
    }

    function clearCardError(): void {
      const box = document.querySelector('[data-payment-error]') as HTMLElement | null;
      if (box) box.classList.add('hidden');
    }

    const guestNameInput = document.getElementById('guest-name') as HTMLInputElement | null;
    const guestEmailInput = document.getElementById('guest-email') as HTMLInputElement | null;
    const guestPhoneInput = document.getElementById('guest-phone') as HTMLInputElement | null;
    const airportTransferCheckbox = document.getElementById('airport-transfer') as HTMLInputElement | null;
    const flightTimeInput = document.getElementById('flight-time') as HTMLInputElement | null;

    if (!guestNameInput?.value || !guestEmailInput?.value || !guestPhoneInput?.value) {
      wizardStore.back();
      return;
    }

    try {
        const result = await bookingService.createHold({
          roomSlug: room.slug,
          checkIn: state.checkIn,
          checkOut: state.checkOut,
          guests: state.guests,
          guestDetails: {
            firstName: guestNameInput.value.split(' ')[0] || guestNameInput.value,
            lastName: guestNameInput.value.split(' ').slice(1).join(' ') || guestNameInput.value,
            email: guestEmailInput.value,
            phone: guestPhoneInput.value,
            specialRequests: airportTransferCheckbox?.checked ? `Airport transfer requested at ${flightTimeInput?.value || ''}` : '',
          },
        });

        if (!result.success) {
          // Orden crítico: setProcessing(false) dispara notify -> start().
          // started debe seguir true DURANTE ese notify para no relanzar el
          // flujo en loop; se resetea después para permitir el reintento manual.
          resetPaymentUi();
          setProcessing(false);
          started = false;
          showError(result.error.message);
          return;
        }

        const data = result.data;
        const mpPublicKey = data.mp_public_key;
        const cartId = data.cart_id;
        const accessToken = data.access_token;
        const totalAmount = data.gateway_price || data.price || allocation.total;

        if (!mpPublicKey || !cartId || !accessToken) {
          resetPaymentUi();
          setProcessing(false);
          started = false;
          showError(t('book.noPaymentUrl'));
          return;
        }

        try {
          await loadMercadoPagoSdk();
        } catch {
          resetPaymentUi();
          setProcessing(false);
          started = false;
          showError(t('book.unexpectedError'));
          return;
        }

        // Todo 30: locale del SDK por idioma (es-PE default para es).
        const mp = new (window as any).MercadoPago(mpPublicKey, { locale: MP_LOCALES[lang] || 'es-PE' });

        // Todo 29: countdown del hold desde time_left_seconds (best-effort).
        void startHoldCountdown(cartId, accessToken, t);

        // Mostrar el formulario ANTES de crear el Card Payment Brick.
        showPaymentPanel();
        setProcessing(false);

        const bricksBuilder = mp.bricks();

        cardFormInstance = await bricksBuilder.create('cardPayment', 'cardPaymentBrick_container', {
          initialization: {
            amount: Number(totalAmount),
            payer: {
              email: guestEmailInput?.value || '',
            },
          },
          customization: {
            visual: {
              style: {
                theme: 'default',
              },
            },
          },
          callbacks: {
            onReady: () => {
              if (payReadyTimer !== null) { window.clearTimeout(payReadyTimer); payReadyTimer = null; }
            },
            onBinChange: () => {
              clearCardError();
            },
            onSubmit: (cardFormData: any) => {
              return new Promise<void>(async (resolve, reject) => {
                clearCardError();
                processingPayment = true;
                errorBanner?.classList.add('hidden');

                try {
                  const processRes = await bookingService.processPayment(cartId!, accessToken!, cardFormData);

                  if (processRes.success) {
                    resolve();
                    redirectToSuccess(cartId!);
                    return;
                  }

                  const outcome = resolvePaymentOutcome(processRes.error, null);
                  if (outcome === 'redirect_success') {
                    resolve();
                    redirectToSuccess(cartId!);
                    return;
                  }

                  reject();
                  await handlePaymentFailure(
                    {
                      code: processRes.error.code,
                      message: processRes.error.message,
                      statusDetail: processRes.error.statusDetail,
                    },
                    cartId!,
                    accessToken!,
                    t,
                    showError
                  );
                } catch (err: any) {
                  reject();
                  await handlePaymentFailure(
                    { code: 'NETWORK_ERROR', message: err.message || '' },
                    cartId!,
                    accessToken!,
                    t,
                    showError
                  );
                } finally {
                  processingPayment = false;
                }
              });
            },
            onError: (error: any) => {
              console.error('Card Payment Brick error:', error);
              showCardError(t('book.unexpectedError'));
            },
          },
        });
      } catch (err: any) {
        console.error(err);
        resetPaymentUi();
        setProcessing(false);
        started = false; // permitir reintento tras error inesperado
        showError(err.message || t('book.unexpectedError'));
      }
  }

  function handlePaymentBack(): void {
    // Volver al formulario de datos (guest): desmontar el cardForm (doc MP:
    // unmount() limpia los iframes de secure-fields) y restaurar el guest.
    if (payReadyTimer !== null) { window.clearTimeout(payReadyTimer); payReadyTimer = null; }
    stopCooldown();
    stopHoldCountdown();
    if (cardFormInstance && typeof cardFormInstance.unmount === 'function') {
      try { cardFormInstance.unmount(); } catch (e) { console.warn('cardForm unmount error:', e); }
    }
    cardFormInstance = null;
    resetPaymentUi();
    setProcessing(false);
    started = false;
  }

  // Todo 29: guard beforeunload durante processPayment (avisar antes de salir
  // mientras el pago está en vuelo — el doble submit y el abandono son el
  // riesgo que estos todos mitigan).
  function handleBeforeUnload(event: BeforeUnloadEvent): void {
    if (processingPayment) {
      event.preventDefault();
    }
  }

  document.addEventListener('astro:page-load', initPaymentStep);
  window.addEventListener('beforeunload', handleBeforeUnload);
  document.addEventListener('astro:before-preparation', () => {
    if (payReadyTimer !== null) { window.clearTimeout(payReadyTimer); payReadyTimer = null; }
    stopCooldown();
    stopHoldCountdown();
    abortController.abort();
  });
</script>
