---
// src/components/CuscoMap.astro
// Hand-drawn illustrated SVG map of Cusco center (flat editorial style):
// hotel, San Pedro Market and Plaza de Armas with animated route traces.
// Replaces the Leaflet integration (removes ~145KB JS from the page).
import { useTranslations, type Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<section id="map-section" class="py-12 sm:py-16 px-4 bg-surface-card-light dark:bg-surface-dark text-text-primary-light dark:text-white relative overflow-hidden transition-colors duration-500">
  <div class="max-w-[1400px] mx-auto relative z-10 animate-on-scroll">
    <div class="text-center mb-12 space-y-3">
      <span class="tag-dash-title block">
        {t('map.sectionLabel')}
      </span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl text-text-primary-light dark:text-white tracking-tight leading-tight">
        {t('map.title')}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-text-secondary-light dark:text-text-secondary-dark font-body font-light max-w-2xl mx-auto">
        {t('map.description')}
      </p>
    </div>

    <!-- Illustrated Map -->
    <div
      id="cusco-illustrated-map"
      class="relative w-full rounded-3xl overflow-hidden shadow-2xl border border-black/5 dark:border-white/10 bg-[#F4F0F6] dark:bg-[#17141C]"
    >
      <svg viewBox="0 0 800 620" class="w-full h-auto block" role="img" aria-label={t('map.title')}>
        <defs>
          <!-- Paper grain texture (subtle, hand-drawn feel) -->
          <filter id="grain">
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
            <feColorMatrix type="saturate" values="0" />
            <feComponentTransfer><feFuncA type="table" tableValues="0 0.04" /></feComponentTransfer>
            <feComposite operator="over" in2="SourceGraphic" />
          </filter>
        </defs>

        <!-- Base -->
        <rect width="800" height="620" fill="currentColor" class="text-[#F4F0F6] dark:text-[#17141C]" />

        <!-- City blocks (flat illustration: rounded blocks, warm stone palette) -->
        <g filter="url(#grain)">
          <!-- Row 1 (north, near Plaza de Armas) -->
          <rect x="60" y="40" width="150" height="90" rx="10" fill="#E4D9EA" class="dark:fill-[#2A2233]" />
          <rect x="230" y="30" width="140" height="105" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />
          <rect x="390" y="40" width="120" height="95" rx="10" fill="#E4D9EA" class="dark:fill-[#2A2233]" />
          <rect x="530" y="25" width="110" height="110" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />

          <!-- Plaza de Armas (central square, gold-tinted) -->
          <rect x="610" y="115" width="130" height="110" rx="12" fill="#EFE3C3" class="dark:fill-[#3A3223]" stroke="#D4AF37" stroke-opacity="0.35" />

          <!-- Row 2 -->
          <rect x="60" y="170" width="160" height="100" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />
          <rect x="250" y="165" width="130" height="115" rx="10" fill="#E4D9EA" class="dark:fill-[#2A2233]" />
          <rect x="400" y="170" width="150" height="105" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />
          <rect x="570" y="160" width="80" height="110" rx="10" fill="#E4D9EA" class="dark:fill-[#2A2233]" />

          <!-- Row 3 -->
          <rect x="50" y="300" width="140" height="110" rx="10" fill="#E4D9EA" class="dark:fill-[#2A2233]" />
          <rect x="210" y="295" width="120" height="115" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />

          <!-- San Pedro Market (gold-tinted block) -->
          <rect x="600" y="300" width="140" height="105" rx="12" fill="#EFE3C3" class="dark:fill-[#3A3223]" stroke="#D4AF37" stroke-opacity="0.35" />

          <!-- Row 4 (south, hotel zone) -->
          <rect x="60" y="445" width="160" height="105" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />
          <rect x="240" y="430" width="150" height="120" rx="10" fill="#E4D9EA" class="dark:fill-[#2A2233]" />
          <rect x="410" y="440" width="130" height="110" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />
          <rect x="560" y="435" width="120" height="115" rx="10" fill="#E4D9EA" class="dark:fill-[#2A2233]" />
          <rect x="700" y="450" width="80" height="100" rx="10" fill="#EDE5F0" class="dark:fill-[#241D2C]" />
        </g>

        <!-- Streets (organic curved paths, hand-drawn feel) -->
        <g stroke="#FFFFFF" class="dark:stroke-[#0F0E12]" stroke-width="16" stroke-linecap="round" fill="none" opacity="0.9">
          <path d="M 20 155 Q 240 150 480 160 T 790 150" />
          <path d="M 20 285 Q 260 290 540 300 T 790 285" />
          <path d="M 20 425 Q 250 430 560 420 T 790 435" />
          <path d="M 160 20 Q 170 200 165 610" />
          <path d="M 360 20 Q 355 300 370 620" />
          <path d="M 550 15 Q 545 250 560 620" />
        </g>

        <!-- Route traces (animated draw on scroll) -->
        <g fill="none" stroke-linecap="round">
          <!-- Hotel -> San Pedro Market -->
          <path id="route-market" class="map-route" d="M 300 480 C 380 470 470 420 610 355" stroke="#D4AF37" stroke-width="3" stroke-dasharray="10 8" opacity="0.9" />
          <!-- Hotel -> Plaza de Armas -->
          <path id="route-plaza" class="map-route" d="M 320 460 C 420 380 480 250 650 175" stroke="#7E628D" stroke-width="3" stroke-dasharray="10 8" opacity="0.9" />
        </g>

        <!-- Points of interest -->
        <g>
          <!-- USGAR hotel (main marker, pulsing gold) -->
          <g class="map-point" data-point="usgar">
            <circle class="map-pulse" cx="300" cy="480" r="16" fill="none" stroke="#D4AF37" stroke-width="2" />
            <circle cx="300" cy="480" r="11" fill="#D4AF37" stroke="#FFFFFF" stroke-width="3" class="dark:stroke-[#17141C]" />
            <text x="300" y="515" text-anchor="middle" class="map-label text-[#2E1A38] dark:text-[#C8B8D0]" font-family="ui-monospace, monospace" font-size="13" font-weight="700" letter-spacing="1.5">{t('map.hotelLabel')}</text>
            <text x="300" y="533" text-anchor="middle" class="map-label text-[#7E628D] dark:text-[#8E7A9A]" font-family="ui-monospace, monospace" font-size="11" letter-spacing="1">{t('map.here')}</text>
          </g>

          <!-- San Pedro Market -->
          <g class="map-point" data-point="market">
            <circle cx="650" cy="345" r="8" fill="#2A7B72" stroke="#FFFFFF" stroke-width="2.5" class="dark:stroke-[#17141C]" />
            <text x="650" y="325" text-anchor="middle" class="map-label text-[#2E1A38] dark:text-[#C8B8D0]" font-family="ui-monospace, monospace" font-size="12" font-weight="600" letter-spacing="1">{t('map.marketLabel')}</text>
            <text x="650" y="310" text-anchor="middle" class="map-label text-[#7E628D] dark:text-[#8E7A9A]" font-family="ui-monospace, monospace" font-size="10" letter-spacing="1">{t('map.walkTime')} · 6 min</text>
          </g>

          <!-- Plaza de Armas -->
          <g class="map-point" data-point="plaza">
            <circle cx="690" cy="155" r="8" fill="#2A7B72" stroke="#FFFFFF" stroke-width="2.5" class="dark:stroke-[#17141C]" />
            <text x="690" y="135" text-anchor="middle" class="map-label text-[#2E1A38] dark:text-[#C8B8D0]" font-family="ui-monospace, monospace" font-size="12" font-weight="600" letter-spacing="1">{t('map.plazaLabel')}</text>
            <text x="690" y="120" text-anchor="middle" class="map-label text-[#7E628D] dark:text-[#8E7A9A]" font-family="ui-monospace, monospace" font-size="10" letter-spacing="1">{t('map.walkTime')} · 8 min</text>
          </g>
        </g>
      </svg>

      <!-- Address footnote -->
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 px-5 py-2 rounded-full bg-black/45 dark:bg-black/60 backdrop-blur-md border border-white/10 text-white text-[11px] font-mono tracking-[0.15em]">
        {t('map.addressPrefix')} · {t('map.addressHotel')}
      </div>
    </div>
  </div>
</section>

<script>
  import { initCuscoMap } from '../features/animations/modules/cuscoMap';

  let cleanup: (() => void) | null = null;

  function initMap() {
    const map = document.getElementById('cusco-illustrated-map') as HTMLElement | null;
    if (!map) return;
    cleanup?.();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    cleanup = initCuscoMap(map);
  }

  document.addEventListener('astro:page-load', initMap);
  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
    cleanup = null;
  }, { once: true });
</script>
