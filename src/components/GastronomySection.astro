---
import { Image } from 'astro:assets';
import SectionHeader from './ui/SectionHeader.astro';
import desayunoImg from '../assets/hotel/fallback-room-desayuno.jpg';
import recepcionImg from '../assets/hotel/hero-slide-recepcion.jpg';
import patioImg from '../assets/hotel/hero-slide-patio.jpg';

import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const culinaryOffers = [
  {
    id: 'buffet',
    title: { en: 'Daily Buffet Breakfast', es: 'Desayuno Buffet Diario', fr: 'Petit-Déjeuner Buffet Quotidien', pt: 'Café da Manhã Buffet Diário' },
    schedule: '06:00 AM - 09:00 AM',
    metric: '100%',
    metricLabel: { en: 'Included in Stay', es: 'Incluido en tu Estadía', fr: 'Inclus dans le Séjour', pt: 'Incluído na Estadia' },
    desc: {
      en: 'Fresh tropical fruits, artisan breads, eggs prepared to order, regional cheeses, coffee, and authentic hot Andean herbal teas.',
      es: 'Frutas frescas del valle, panes artesanales, huevos al gusto, quesos regionales, café pasado e infusiones andinas calientes.',
      fr: 'Fruits frais, pains artisanaux, œufs préparés à la commande, fromages régionaux, café et infusions andines chaudes.',
      pt: 'Frutas frescas, pães artesanais, ovos preparados na hora, queijos regionais, café e infusões andinas quentes.'
    },
    image: desayunoImg,
    size: 'col-span-1 lg:col-span-2 row-span-2'
  },
  {
    id: 'teas',
    title: { en: 'Coca & Muña Station', es: 'Estación de Mates', fr: 'Station de Boissons Chaudes', pt: 'Estação de Chás' },
    schedule: '24 Hours',
    metric: '24/7',
    metricLabel: { en: 'Complimentary', es: 'De Cortesía', fr: 'Gracieux', pt: 'De Cortesia' },
    desc: {
      en: 'Unlimited hot Coca and Muña leaf infusions to prevent altitude sickness and stay energized.',
      es: 'Infusiones ilimitadas de hoja de Coca y Muña para prevenir el soroche y mantenerte activo.',
      fr: 'Infusions illimitées de feuilles de Coca et Muña pour prévenir le mal de l\'altitude.',
      pt: 'Infusões ilimitadas de folhas de Coca e Muña para prevenir o soroche.'
    },
    image: recepcionImg,
    size: 'col-span-1 lg:col-span-1 row-span-1'
  },
  {
    id: 'cafeteria',
    title: { en: 'Evening Cafeteria', es: 'Cafetería Nocturna', fr: 'Cafétéria du Soir', pt: 'Cafetaria Noturna' },
    schedule: 'Until 22:00 PM',
    metric: '22:00',
    metricLabel: { en: 'Open Daily', es: 'Abierto Diario', fr: 'Ouvert Tous les Jours', pt: 'Aberto Diariamente' },
    desc: {
      en: 'Warm beverages, light snacks, and cozy seating after your Machu Picchu tours.',
      es: 'Bebidas calientes, bocadillos ligeros y ambiente acogedor después de tus tours a Machu Picchu.',
      fr: 'Boissons chaudes, en-cas légers et ambiance chaleureuse après vos visites.',
      pt: 'Bebidas quentes, lanches leves e ambiente acolhedor após seus passeios.'
    },
    image: patioImg,
    size: 'col-span-1 lg:col-span-1 row-span-1'
  }
];
---

<section id="gastronomy" class="scroll-mt-28 sm:scroll-mt-32 py-12 sm:py-20 px-4 bg-surface-light dark:bg-surface-dark relative overflow-hidden transition-colors duration-500">
  <div class="max-w-[1400px] mx-auto animate-on-scroll">
    
    <!-- Section Header -->
    <SectionHeader
      number="04"
      eyebrow={t('gastronomy.sectionLabel')}
      title="AUKA RESTOBAR"
      subtitle={t('gastronomy.description')}
    />

    <!-- Showroom: feature image (crossfade) + numbered rows -->
    <div id="gastronomy-showroom" class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
      <!-- Feature image (crossfade on row hover) -->
      <div class="relative rounded-3xl overflow-hidden border border-black/5 dark:border-white/10 aspect-[4/3] lg:aspect-auto lg:min-h-[520px] bg-surface-card-dark">
        {culinaryOffers.map((offer, i) => (
          <div class="absolute inset-0 showroom-slide" data-slide={i}>
            <Image
              src={offer.image}
              alt={offer.title[lang]}
              width={1200}
              height={900}
              format="webp"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
            <div class="absolute bottom-5 left-5 px-4 py-2 rounded-full bg-black/45 backdrop-blur-md border border-white/10 text-white text-[11px] font-mono tracking-[0.15em]">
              {offer.metric} — {offer.metricLabel[lang]}
            </div>
          </div>
        ))}
      </div>

      <!-- Numbered rows -->
      <div class="flex flex-col justify-center">
        {culinaryOffers.map((offer, i) => (
          <button
            type="button"
            class="showroom-row group text-left border-b border-black/10 dark:border-white/10 py-7 first:border-t cursor-pointer transition-colors"
            data-row={i}
            aria-label={offer.title[lang]}
          >
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-xs text-secondary flex-shrink-0">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-2xl sm:text-4xl text-text-primary-light dark:text-white group-hover:text-secondary transition-colors duration-300">
                {offer.title[lang]}
              </h3>
              <span class="ml-auto text-[10px] sm:text-xs font-mono uppercase tracking-widest text-text-secondary-light dark:text-text-secondary-dark whitespace-nowrap">
                {offer.schedule}
              </span>
            </div>
            <p class="showroom-desc mt-3 text-sm text-text-secondary-light dark:text-text-secondary-dark font-light max-w-lg opacity-0 max-h-0 overflow-hidden transition-all duration-500 group-hover:opacity-100 group-hover:max-h-40 group-hover:mt-3">
              {offer.desc[lang]}
            </p>
          </button>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import { initGastronomyShowroom } from '../features/animations/modules/gastronomyShowroom';

  let cleanup: (() => void) | null = null;

  function initShowroom() {
    const root = document.getElementById('gastronomy-showroom');
    if (!root) return;
    cleanup?.();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    cleanup = initGastronomyShowroom(root);
  }

  document.addEventListener('astro:page-load', initShowroom);
  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
    cleanup = null;
  }, { once: true });
</script>
