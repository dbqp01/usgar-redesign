---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LogoUsgar from '../assets/logos/Logo usgar.svg';
import { useTranslations, type Locale } from '../i18n/utils';
import DesktopNav from './navbar/DesktopNav.astro';
import LanguageSwitcher from './navbar/LanguageSwitcher.astro';
import ThemeToggle from './navbar/ThemeToggle.astro';
import AuthNav from './navbar/AuthNav.astro';
import CTAGroup from './navbar/CTAGroup.astro';
import MobileNavToggle from './navbar/MobileNavToggle.astro';
import MobileMenu from './navbar/MobileMenu.astro';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const searchParams = Astro.url.search;

const isHome = currentPath === '/' || currentPath === '' || /^\/(es|fr|pt)\/?$/.test(currentPath);

const locales: { code: Locale; label: string }[] = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Espanol' },
  { code: 'fr', label: 'Francais' },
  { code: 'pt', label: 'Portugues' }
];

function getLocaleUrl(targetLang: Locale): string {
  let cleanPath = currentPath.replace(/^\/(es|fr|pt)(\/|$)/, '/');
  if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
  if (targetLang === 'en') {
    return cleanPath + searchParams;
  }
  return `/${targetLang}${cleanPath === '/' ? '' : cleanPath}${searchParams}`;
}

const homeUrl = getRelativeLocaleUrl(lang, '');
const cleanHomeUrl = homeUrl.endsWith('/') ? homeUrl : `${homeUrl}/`;

const navLinks = [
  { href: getRelativeLocaleUrl(lang, 'rooms'), label: t('nav.rooms') },
  { href: `${cleanHomeUrl}#services`, label: t('nav.services') },
  { href: getRelativeLocaleUrl(lang, 'explore'), label: t('nav.explore') },
  { href: getRelativeLocaleUrl(lang, 'gallery'), label: t('nav.gallery') },
  { href: getRelativeLocaleUrl(lang, 'contact'), label: t('nav.contact') },
];
---

<header
  id="main-navbar"
  class:list={[
    "fixed top-0 left-0 right-0 z-50 transition-[background-color,backdrop-filter,box-shadow,border-color] duration-500",
    { "glass shadow-sm navbar-scrolled": !isHome }
  ]}
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo (SVG vectorial: queda bien en tema claro y oscuro) -->
      <a href={getRelativeLocaleUrl(lang, '')} class="flex-shrink-0 relative z-10" aria-label="USGAR Hotels Home">
        <LogoUsgar class="h-10 w-auto block" />
      </a>

      <DesktopNav navLinks={navLinks} currentPath={currentPath} />

      <!-- Right Side: Language, Theme, CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <LanguageSwitcher variant="desktop" locales={locales} getLocaleUrl={getLocaleUrl} />
        <ThemeToggle variant="desktop" />
        <AuthNav variant="desktop" />
        <CTAGroup variant="desktop" />
      </div>

      <MobileNavToggle />
    </div>
  </nav>

  <MobileMenu navLinks={navLinks} locales={locales} getLocaleUrl={getLocaleUrl} />
</header>

<script>
  import { getUser, logout } from '../utils/auth-client';
  import gsap from 'gsap';

  let ctx: gsap.MatchMedia;

  async function initAuth(signal: AbortSignal) {
    const loginBtn = document.getElementById('auth-login-btn');
    const userDropdown = document.getElementById('auth-user-dropdown');
    const userPhoto = document.getElementById('auth-user-photo') as HTMLImageElement;
    const userInitial = document.getElementById('auth-user-initial');
    const userName = document.getElementById('auth-user-name');
    const logoutBtn = document.getElementById('auth-logout-btn');

    const mobileLoginBtn = document.getElementById('mobile-auth-login-btn');
    const mobileUserContainer = document.getElementById('mobile-auth-user');
    const mobileUserPhoto = document.getElementById('mobile-auth-user-photo') as HTMLImageElement;
    const mobileUserInitial = document.getElementById('mobile-auth-user-initial');
    const mobileUserName = document.getElementById('mobile-auth-user-name');
    const mobileLogoutBtn = document.getElementById('mobile-auth-logout-btn');

    try {
      const user = await getUser(false);
      
      if (user) {
        if (loginBtn) loginBtn.classList.add('hidden');
        if (userDropdown) userDropdown.classList.remove('hidden');
        if (mobileLoginBtn) mobileLoginBtn.classList.add('hidden');
        if (mobileUserContainer) mobileUserContainer.classList.remove('hidden');

        const initial = user.name ? user.name.charAt(0).toUpperCase() : 'U';

        if (userName) userName.textContent = user.name || user.email;
        if (mobileUserName) mobileUserName.textContent = user.name || user.email;

        if (user.photo) {
          if (userPhoto) {
            userPhoto.src = user.photo;
            userPhoto.classList.remove('hidden');
            userInitial?.classList.add('hidden');
          }
          if (mobileUserPhoto) {
            mobileUserPhoto.src = user.photo;
            mobileUserPhoto.classList.remove('hidden');
            mobileUserInitial?.classList.add('hidden');
          }
        } else {
          if (userInitial) userInitial.textContent = initial;
          if (mobileUserInitial) mobileUserInitial.textContent = initial;
        }

        logoutBtn?.addEventListener('click', () => { logout(); }, { signal });
        mobileLogoutBtn?.addEventListener('click', () => { logout(); }, { signal });
      } else {
        if (loginBtn) loginBtn.classList.remove('hidden');
        if (userDropdown) userDropdown.classList.add('hidden');
        if (mobileLoginBtn) mobileLoginBtn.classList.remove('hidden');
        if (mobileUserContainer) mobileUserContainer.classList.add('hidden');
      }
    } catch {}
  }

  function initNavbar() {
    if (ctx) ctx.revert();
    
    // El abort controller es nativo pero GSAP context es mejor para las animaciones
    const abortController = new AbortController();
    const signal = abortController.signal;

    const navbar = document.getElementById('main-navbar');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileBackdrop = document.getElementById('mobile-backdrop');
    const mobilePanel = document.getElementById('mobile-panel');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileMenuCloseBtn = document.getElementById('mobile-menu-close-btn');

    if (!navbar) return;

    // --- 1. Sticky Navbar Logic (IntersectionObserver + sentinel: sin ScrollTrigger
    // ni lecturas de layout en init — los reflows forzados del navbar eran ~78ms) ---
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    const isHome = path === '' || path === '/' || path === '/es' || path === '/fr' || path === '/pt';

    let stickyIo: IntersectionObserver | null = null;
    if (isHome) {
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none;';
      document.body.insertBefore(sentinel, document.body.firstChild);
      stickyIo = new IntersectionObserver(([entry]) => {
        const scrolled = !entry.isIntersecting;
        navbar.classList.toggle('glass', scrolled);
        navbar.classList.toggle('shadow-sm', scrolled);
        navbar.classList.toggle('navbar-scrolled', scrolled);
      }, { rootMargin: '-40px 0px 0px 0px' });
      stickyIo.observe(sentinel);
    }

    // --- 2. Mobile Menu GSAP Logic ---
    // gsap.matchMedia() crea su propio context internamente (docs GSAP):
    // ctx.revert() revierte los tweens/ScrollTriggers de sus handlers.
    ctx = gsap.matchMedia();

    let isMenuOpen = false;
    let tl = gsap.timeline({ paused: true });

    // Coreografía Quiet Luxury
    if (mobileMenu && mobileBackdrop && mobilePanel) {
      ctx.add("(prefers-reduced-motion: no-preference)", () => {
          tl.clear();
          tl.set(mobileMenu, { display: 'block' })
            .to(mobileBackdrop, { autoAlpha: 1, duration: 0.3, ease: 'power2.out' })
            .to(mobilePanel, { x: '0%', duration: 0.5, ease: 'power4.out' }, '<0.1')
            .fromTo('.mobile-nav-link', 
              { x: 30, autoAlpha: 0 }, 
              { x: 0, autoAlpha: 1, duration: 0.4, stagger: 0.05, ease: 'power3.out' }, 
              '-=0.3'
            )
            .fromTo('.mobile-lang-link, .mobile-auth-item, .mobile-cta-btn',
              { y: 20, autoAlpha: 0 },
              { y: 0, autoAlpha: 1, duration: 0.4, stagger: 0.05, ease: 'power3.out' },
              '-=0.3'
            );
        });

        ctx.add("(prefers-reduced-motion: reduce)", () => {
          tl.clear();
          tl.set(mobileMenu, { display: 'block' })
            .to(mobileBackdrop, { autoAlpha: 1, duration: 0.1 })
            .to(mobilePanel, { x: '0%', duration: 0.1 }, '<')
            .set('.mobile-nav-link, .mobile-lang-link, .mobile-auth-item, .mobile-cta-btn', { autoAlpha: 1, x: 0, y: 0 });
        });
      }

      function openMenu() {
        if (!mobileMenu) return;
        isMenuOpen = true;
        document.body.style.overflow = 'hidden';
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        mobileMenuBtn?.setAttribute('aria-expanded', 'true');
        tl.timeScale(1).play();
      }

      function closeMenu() {
        if (!mobileMenu) return;
        isMenuOpen = false;
        document.body.style.overflow = '';
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        mobileMenuBtn?.setAttribute('aria-expanded', 'false');
        tl.timeScale(2).reverse(); // Reverse faster
      }

      function forceCloseInstant() {
        if (isMenuOpen) {
          isMenuOpen = false;
          document.body.style.overflow = '';
          mobileMenuBtn?.setAttribute('aria-expanded', 'false');
          tl.progress(0).pause();
        }
      }

      mobileMenuBtn?.addEventListener('click', () => isMenuOpen ? closeMenu() : openMenu(), { signal });
      mobileMenuCloseBtn?.addEventListener('click', closeMenu, { signal });
      mobileBackdrop?.addEventListener('click', closeMenu, { signal });

      mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeMenu, { signal });
      });

      // ¡El gancho salvador de Astro! 
      // Cuando Astro empieza a enrutar, matamos la animación instantáneamente y liberamos el scroll.
      // Registered with the per-init signal: abort() below removes this listener
      // itself, so it never accumulates across SPA navigations ({ once: true } is
      // only a safety net, not the primary cleanup).
      document.addEventListener('astro:before-preparation', () => {
        forceCloseInstant();
        stickyIo?.disconnect();
        abortController.abort();
        if (ctx) ctx.revert();
      }, { signal, once: true });

    // --- 3. Theme Toggle ---
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }
    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme, { signal });
    document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme, { signal });

    // --- 4. Initialize Auth ---
    initAuth(signal);
  }

  document.addEventListener('astro:page-load', initNavbar);
</script>
