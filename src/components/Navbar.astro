---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import logoLight from '../assets/logos/Logo usgar morado.png';
import logoDark from '../assets/logos/Logo usgar.png';
import { useTranslations, type Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const searchParams = Astro.url.search;

const isHome = currentPath === '/' || currentPath === '' || /^\/(es|fr|pt)\/?$/.test(currentPath);

const locales: { code: Locale; label: string; flag: string }[] = [
  { code: 'en', label: 'English', flag: '' },
  { code: 'es', label: 'Espanol', flag: '' },
  { code: 'fr', label: 'Francais', flag: '' },
  { code: 'pt', label: 'Portugues', flag: '' }
];

function getLocaleUrl(targetLang: Locale): string {
  let cleanPath = currentPath.replace(/^\/(es|fr|pt)(\/|$)/, '/');
  if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;
  if (targetLang === 'en') {
    return cleanPath + searchParams;
  }
  return `/${targetLang}${cleanPath === '/' ? '' : cleanPath}${searchParams}`;
}

const homeUrl = getRelativeLocaleUrl(lang, '');
const cleanHomeUrl = homeUrl.endsWith('/') ? homeUrl : `${homeUrl}/`;

const navLinks = [
  { href: getRelativeLocaleUrl(lang, 'rooms'), label: t('nav.rooms') },
  { href: `${cleanHomeUrl}#services`, label: t('nav.services') },
  { href: getRelativeLocaleUrl(lang, 'explore'), label: t('nav.explore') },
  { href: getRelativeLocaleUrl(lang, 'gallery'), label: t('nav.gallery') },
  { href: getRelativeLocaleUrl(lang, 'contact'), label: t('nav.contact') },
];
---

<header
  id="main-navbar"
  class:list={[
    "fixed top-0 left-0 right-0 z-50 transition-[background-color,backdrop-filter,box-shadow,border-color] duration-500",
    { "glass shadow-sm navbar-scrolled": !isHome }
  ]}
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href={getRelativeLocaleUrl(lang, '')} class="flex-shrink-0 relative z-10" aria-label="USGAR Hotels Home">
        <Image
          src={logoLight}
          alt="USGAR Hotels"
          width={120}
          class="h-10 w-auto block dark:hidden"
          loading="eager"
        />
        <Image
          src={logoDark}
          alt="USGAR Hotels"
          width={120}
          class="h-10 w-auto hidden dark:block"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'nav-link nav-link-text text-sm font-medium tracking-wide uppercase transition-colors duration-300 drop-shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md px-2 py-1',
              currentPath === link.href ? 'text-primary' : ''
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Right Side: Language, Theme, CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <!-- Language Switcher Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="nav-link nav-link-text nav-btn-border text-sm font-medium px-3 py-1.5 rounded-full border border-current/20 hover:border-primary hover:text-primary transition-[color,border-color] duration-300 drop-shadow-md flex items-center gap-1.5"
            aria-label="Select language"
          >
            <span>{locales.find(l => l.code === lang)?.flag}</span>
            <span>{lang.toUpperCase()}</span>
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute right-0 mt-2 w-40 rounded-2xl bg-surface-card-light dark:bg-surface-card-dark shadow-2xl border border-black/10 dark:border-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-[opacity,visibility] duration-200 z-50 py-2">
            {locales.map(l => (
              <a
                href={getLocaleUrl(l.code)}
                class:list={[
                  'flex items-center gap-3 px-4 py-2 text-sm font-medium transition-colors',
                  l.code === lang ? 'text-primary bg-primary/10' : 'text-text-primary-light dark:text-text-primary-dark hover:bg-black/5 dark:hover:bg-white/5'
                ]}
              >
                <span>{l.flag}</span>
                <span>{l.label}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Dark/Light Mode Toggle -->
        <button
          id="theme-toggle"
          class="nav-link nav-link-text relative w-10 h-10 rounded-full flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 drop-shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          aria-label="Toggle dark mode"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Auth State (Sign In / User Avatar) -->
        <div id="auth-nav-desktop" class="flex items-center gap-3 relative">
          <!-- Logged Out State -->
          <a
            id="auth-login-btn"
            href={getRelativeLocaleUrl(lang, 'login')}
            class="nav-link nav-link-text nav-btn-border text-sm font-medium px-4 py-2 rounded-full border border-current/20 hover:border-primary hover:text-primary transition-[color,border-color] duration-300 drop-shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          >
            {t('auth.signIn')}
          </a>

          <!-- Logged In State (Hidden initially) -->
          <div id="auth-user-dropdown" class="hidden relative group">
            <button
              type="button"
              aria-label="User menu"
              class="nav-link nav-link-text flex items-center gap-2 text-sm font-medium transition-colors hover:text-primary drop-shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-full px-2 py-1"
            >
              <div class="w-8 h-8 rounded-full overflow-hidden bg-primary/20 border border-primary/50 flex-shrink-0 flex items-center justify-center">
                <img id="auth-user-photo" src="" alt="User" class="w-full h-full object-cover hidden" />
                <span id="auth-user-initial" class="text-xs text-primary font-bold">U</span>
              </div>
              <span id="auth-user-name" class="max-w-[100px] truncate">User</span>
            </button>
            
            <div class="absolute right-0 mt-2 w-48 rounded-2xl bg-surface-card-light dark:bg-surface-card-dark shadow-2xl border border-black/10 dark:border-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-[opacity,visibility] duration-200 z-50 py-2">
              <a
                href={getRelativeLocaleUrl(lang, 'profile')}
                class="flex items-center gap-3 px-4 py-2 text-sm font-medium text-text-primary-light dark:text-text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                {t('auth.myProfile') || 'My Profile & Bookings'}
              </a>
              <div class="border-t border-black/10 dark:border-white/10 my-1"></div>
              <button
                id="auth-logout-btn"
                type="button"
                class="w-full flex items-center gap-3 px-4 py-2 text-sm font-medium text-red-500 hover:bg-red-500/10 transition-colors text-left"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                {t('auth.signOut') || 'Log Out'}
              </button>
            </div>
          </div>
        </div>

        <!-- CTA: Book Now -->
        <a
          href={getRelativeLocaleUrl(lang, 'book')}
          data-astro-prefetch="tap"
          class="bg-primary hover:bg-primary-dark text-white font-semibold text-sm px-6 py-2.5 rounded-full transition-[transform,background-color,box-shadow] duration-300 lg:hover:shadow-lg lg:hover:shadow-primary/25 lg:hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-surface-card-light dark:focus-visible:ring-offset-surface-card-dark"
        >
          {t('nav.bookNow')}
        </a>
      </div>

      <!-- Mobile: Theme + Hamburger -->
      <div class="flex lg:hidden items-center gap-2">
        <button
          id="theme-toggle-mobile"
          class="nav-link nav-link-text w-10 h-10 rounded-full flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 drop-shadow-md"
          aria-label="Toggle dark mode"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          class="nav-link nav-link-text w-10 h-10 rounded-full flex items-center justify-center hover:bg-black/5 dark:hover:bg-white/10 transition-colors duration-300 drop-shadow-md"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" id="hamburger-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" id="close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu (slide-in) -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden lg:hidden"
  >
    <!-- Backdrop -->
    <div id="mobile-backdrop" class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0"></div>

    <!-- Panel -->
    <div
      id="mobile-panel"
      class="absolute right-0 top-0 h-dvh w-80 max-w-[85vw] bg-surface-card-light dark:bg-surface-card-dark shadow-2xl flex flex-col pt-safe pb-safe overflow-y-auto"
      style="transform: translateX(100%);"
    >
      <div class="flex flex-col h-full px-6 py-6">
        <!-- Drawer Header with close button -->
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-black/10 dark:border-white/10">
          <span class="text-xs font-bold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark">Menu</span>
          <button
            id="mobile-menu-close-btn"
            type="button"
            class="touch-target p-2 rounded-full text-text-primary-light dark:text-text-primary-dark hover:bg-black/5 dark:hover:bg-white/10"
            aria-label="Close menu"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Nav Links -->
        <nav class="flex flex-col gap-1">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="mobile-nav-link text-base font-semibold py-3.5 px-4 rounded-xl hover:bg-primary/10 hover:text-primary transition-colors duration-200 flex items-center min-h-[48px]"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <div class="border-t border-black/10 dark:border-white/10 my-6"></div>

        <!-- Language Switcher Mobile Grid -->
        <div class="flex flex-col gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark px-4">Language</span>
          <div class="grid grid-cols-2 gap-2">
            {locales.map(l => (
              <a
                href={getLocaleUrl(l.code)}
                class:list={[
                  'mobile-lang-link flex items-center gap-2 p-3 rounded-xl border text-sm font-medium transition-colors',
                  l.code === lang ? 'border-primary bg-primary/10 text-primary' : 'border-black/10 dark:border-white/10 hover:bg-black/5 dark:hover:bg-white/5'
                ]}
              >
                <span>{l.flag}</span>
                <span>{l.label}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Spacer -->
        <div class="flex-1"></div>

        <!-- Mobile Auth State -->
        <div id="auth-nav-mobile" class="mt-4 mb-4 flex flex-col gap-2">
          <!-- Logged out -->
          <a
            id="mobile-auth-login-btn"
            href={getRelativeLocaleUrl(lang, 'login')}
            class="mobile-auth-item flex justify-center items-center gap-2 bg-stone-100 dark:bg-stone-800 text-text-primary-light dark:text-text-primary-dark font-medium py-3 rounded-xl transition-colors duration-200"
          >
            {t('auth.signIn')}
          </a>

          <!-- Logged in (hidden) -->
          <div id="mobile-auth-user" class="hidden flex flex-col gap-2">
            <div class="flex items-center gap-3 px-4 py-3 bg-primary/10 rounded-xl">
              <div class="w-10 h-10 rounded-full overflow-hidden bg-primary/20 border border-primary/50 flex items-center justify-center flex-shrink-0">
                <img id="mobile-auth-user-photo" src="" alt="User" class="w-full h-full object-cover hidden" />
                <span id="mobile-auth-user-initial" class="text-sm text-primary font-bold">U</span>
              </div>
              <span id="mobile-auth-user-name" class="font-medium text-text-primary-light dark:text-text-primary-dark truncate">User</span>
            </div>
            <a
              href={getRelativeLocaleUrl(lang, 'profile')}
              class="flex items-center gap-3 px-4 py-3 bg-stone-100 dark:bg-stone-800 rounded-xl font-medium text-text-primary-light dark:text-text-primary-dark"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
              {t('auth.myProfile') || 'My Profile & Bookings'}
            </a>
            <button
              id="mobile-auth-logout-btn"
              type="button"
              class="flex items-center gap-3 px-4 py-3 bg-red-500/10 rounded-xl font-medium text-red-500 text-left"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
              {t('auth.signOut') || 'Log Out'}
            </button>
          </div>
        </div>

        <!-- CTA -->
        <a
          href={getRelativeLocaleUrl(lang, 'book')}
          data-astro-prefetch="tap"
          class="mobile-cta-btn bg-primary hover:bg-primary-dark text-white font-semibold text-center py-4 rounded-2xl transition-colors duration-300 text-lg shadow-md"
        >
          {t('nav.bookNow')}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { getUser, logout } from '../utils/auth-client';
  import gsap from 'gsap';

  let ctx: gsap.Context;

  async function initAuth(signal: AbortSignal) {
    const loginBtn = document.getElementById('auth-login-btn');
    const userDropdown = document.getElementById('auth-user-dropdown');
    const userPhoto = document.getElementById('auth-user-photo') as HTMLImageElement;
    const userInitial = document.getElementById('auth-user-initial');
    const userName = document.getElementById('auth-user-name');
    const logoutBtn = document.getElementById('auth-logout-btn');

    const mobileLoginBtn = document.getElementById('mobile-auth-login-btn');
    const mobileUserContainer = document.getElementById('mobile-auth-user');
    const mobileUserPhoto = document.getElementById('mobile-auth-user-photo') as HTMLImageElement;
    const mobileUserInitial = document.getElementById('mobile-auth-user-initial');
    const mobileUserName = document.getElementById('mobile-auth-user-name');
    const mobileLogoutBtn = document.getElementById('mobile-auth-logout-btn');

    try {
      const user = await getUser(false);
      
      if (user) {
        if (loginBtn) loginBtn.classList.add('hidden');
        if (userDropdown) userDropdown.classList.remove('hidden');
        if (mobileLoginBtn) mobileLoginBtn.classList.add('hidden');
        if (mobileUserContainer) mobileUserContainer.classList.remove('hidden');

        const initial = user.name ? user.name.charAt(0).toUpperCase() : 'U';

        if (userName) userName.textContent = user.name || user.email;
        if (mobileUserName) mobileUserName.textContent = user.name || user.email;

        if (user.photo) {
          if (userPhoto) {
            userPhoto.src = user.photo;
            userPhoto.classList.remove('hidden');
            userInitial?.classList.add('hidden');
          }
          if (mobileUserPhoto) {
            mobileUserPhoto.src = user.photo;
            mobileUserPhoto.classList.remove('hidden');
            mobileUserInitial?.classList.add('hidden');
          }
        } else {
          if (userInitial) userInitial.textContent = initial;
          if (mobileUserInitial) mobileUserInitial.textContent = initial;
        }

        logoutBtn?.addEventListener('click', () => { logout(); }, { signal });
        mobileLogoutBtn?.addEventListener('click', () => { logout(); }, { signal });
      } else {
        if (loginBtn) loginBtn.classList.remove('hidden');
        if (userDropdown) userDropdown.classList.add('hidden');
        if (mobileLoginBtn) mobileLoginBtn.classList.remove('hidden');
        if (mobileUserContainer) mobileUserContainer.classList.add('hidden');
      }
    } catch {}
  }

  function initNavbar() {
    if (ctx) ctx.revert();
    
    // El abort controller es nativo pero GSAP context es mejor para las animaciones
    const abortController = new AbortController();
    const signal = abortController.signal;

    const navbar = document.getElementById('main-navbar');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileBackdrop = document.getElementById('mobile-backdrop');
    const mobilePanel = document.getElementById('mobile-panel');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileMenuCloseBtn = document.getElementById('mobile-menu-close-btn');

    if (!navbar) return;

    // --- 1. Sticky Navbar Logic (IntersectionObserver + sentinel: sin ScrollTrigger
    // ni lecturas de layout en init — los reflows forzados del navbar eran ~78ms) ---
    const path = window.location.pathname.replace(/\/$/, '') || '/';
    const isHome = path === '' || path === '/' || path === '/es' || path === '/fr' || path === '/pt';

    let stickyIo: IntersectionObserver | null = null;
    if (isHome) {
      const sentinel = document.createElement('div');
      sentinel.setAttribute('aria-hidden', 'true');
      sentinel.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:1px;pointer-events:none;';
      document.body.insertBefore(sentinel, document.body.firstChild);
      stickyIo = new IntersectionObserver(([entry]) => {
        const scrolled = !entry.isIntersecting;
        navbar.classList.toggle('glass', scrolled);
        navbar.classList.toggle('shadow-sm', scrolled);
        navbar.classList.toggle('navbar-scrolled', scrolled);
      }, { rootMargin: '-40px 0px 0px 0px' });
      stickyIo.observe(sentinel);
    }

    // --- 2. Mobile Menu GSAP Logic ---
    ctx = gsap.context(() => {

      let isMenuOpen = false;
      let tl = gsap.timeline({ paused: true });
      const mm = gsap.matchMedia();

      // Coreografía Quiet Luxury
      if (mobileMenu && mobileBackdrop && mobilePanel) {
        mm.add("(prefers-reduced-motion: no-preference)", () => {
          tl.clear();
          tl.set(mobileMenu, { display: 'block' })
            .to(mobileBackdrop, { autoAlpha: 1, duration: 0.3, ease: 'power2.out' })
            .to(mobilePanel, { x: '0%', duration: 0.5, ease: 'power4.out' }, '<0.1')
            .fromTo('.mobile-nav-link', 
              { x: 30, autoAlpha: 0 }, 
              { x: 0, autoAlpha: 1, duration: 0.4, stagger: 0.05, ease: 'power3.out' }, 
              '-=0.3'
            )
            .fromTo('.mobile-lang-link, .mobile-auth-item, .mobile-cta-btn',
              { y: 20, autoAlpha: 0 },
              { y: 0, autoAlpha: 1, duration: 0.4, stagger: 0.05, ease: 'power3.out' },
              '-=0.3'
            );
        });

        mm.add("(prefers-reduced-motion: reduce)", () => {
          tl.clear();
          tl.set(mobileMenu, { display: 'block' })
            .to(mobileBackdrop, { autoAlpha: 1, duration: 0.1 })
            .to(mobilePanel, { x: '0%', duration: 0.1 }, '<')
            .set('.mobile-nav-link, .mobile-lang-link, .mobile-auth-item, .mobile-cta-btn', { autoAlpha: 1, x: 0, y: 0 });
        });
      }

      function openMenu() {
        if (!mobileMenu) return;
        isMenuOpen = true;
        document.body.style.overflow = 'hidden';
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        mobileMenuBtn?.setAttribute('aria-expanded', 'true');
        tl.timeScale(1).play();
      }

      function closeMenu() {
        if (!mobileMenu) return;
        isMenuOpen = false;
        document.body.style.overflow = '';
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        mobileMenuBtn?.setAttribute('aria-expanded', 'false');
        tl.timeScale(2).reverse(); // Reverse faster
      }

      function forceCloseInstant() {
        if (isMenuOpen) {
          isMenuOpen = false;
          document.body.style.overflow = '';
          mobileMenuBtn?.setAttribute('aria-expanded', 'false');
          tl.progress(0).pause();
        }
      }

      mobileMenuBtn?.addEventListener('click', () => isMenuOpen ? closeMenu() : openMenu(), { signal });
      mobileMenuCloseBtn?.addEventListener('click', closeMenu, { signal });
      mobileBackdrop?.addEventListener('click', closeMenu, { signal });

      mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeMenu, { signal });
      });

      // ¡El gancho salvador de Astro! 
      // Cuando Astro empieza a enrutar, matamos la animación instantáneamente y liberamos el scroll.
      // Registered with the per-init signal: abort() below removes this listener
      // itself, so it never accumulates across SPA navigations ({ once: true } is
      // only a safety net, not the primary cleanup).
      document.addEventListener('astro:before-preparation', () => {
        forceCloseInstant();
        stickyIo?.disconnect();
        abortController.abort();
        if (ctx) ctx.revert();
      }, { signal, once: true });
    });

    // --- 3. Theme Toggle ---
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }
    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme, { signal });
    document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme, { signal });

    // --- 4. Initialize Auth ---
    initAuth(signal);
  }

  document.addEventListener('astro:page-load', initNavbar);
</script>
