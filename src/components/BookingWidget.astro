---
// debt: oversized module (261 LOC) — split into concept-named components when touched; ceiling 250 pure LOC
// src/components/BookingWidget.astro
// Widget de reserva de la HOME: aqui empieza la decision de fechas.
// Calendario custom (mismo motor que el wizard: calendar.ts) en popover,
// rango por clic, validacion con toasts y redirect a /book con parametros.
import { rooms } from '../data/rooms';
import { useTranslations, type Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const roomTypes = rooms.map(r => ({ value: r.slug, label: r.name[lang] }));
---

<section id="booking-widget" class="relative z-50 -mt-10 sm:-mt-24 mb-2 sm:mb-4" data-story-parallax="0.05">
  <div class="max-w-6xl mx-auto px-4">
    <div class="glass rounded-2xl p-6 shadow-xl shadow-black/5">
      <form id="booking-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
        <!-- Dates (popover trigger) -->
        <div class="relative">
          <label for="widget-dates" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
            {t('booking.checkin')} - {t('booking.checkout')}
          </label>
          <button
            type="button"
            id="widget-dates"
            data-widget-dates
            popovertarget="widget-popover"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="widget-popover"
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark text-left hover:border-primary/40 transition-colors cursor-pointer"
          >
            <span data-widget-dates-label class="font-medium">-- / --</span>
          </button>

          <!-- Calendar Popover -->
          <div
            id="widget-popover"
            popover="auto"
            data-widget-popover
            role="dialog"
            aria-labelledby="widget-popover-title"
            class="absolute left-0 right-0 sm:right-auto sm:w-[560px] top-full mt-3 hidden z-50 p-6 rounded-2xl bg-white dark:bg-surface-card-dark border border-black/10 dark:border-white/10 shadow-2xl shadow-black/15 max-sm:fixed max-sm:left-4 max-sm:right-4 max-sm:top-20 max-sm:bottom-[calc(5rem+env(safe-area-inset-bottom)+1px)] max-sm:w-auto max-sm:max-h-[calc(100dvh-9rem)] max-sm:overflow-y-auto max-sm:mt-0"
          >
            <span id="widget-popover-title" class="sr-only">{t('booking.checkin')} - {t('booking.checkout')}</span>
            <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
              <div class="flex-1 space-y-3" data-widget-month="0"></div>
              <div class="flex-1 space-y-3 hidden lg:block" data-widget-month="1"></div>
            </div>
            <div class="mt-4 pt-4 border-t border-black/5 dark:border-white/5 flex items-center justify-between text-xs">
              <span data-widget-range class="font-mono text-text-secondary-light dark:text-text-secondary-dark">--</span>
              <button type="button" data-widget-done class="text-xs font-semibold uppercase tracking-wider text-primary hover:text-primary-dark cursor-pointer">
                {t('wizard.continue')}
              </button>
            </div>
          </div>
        </div>

        <!-- Guests -->
        <div>
          <label for="guests" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
            {t('booking.guests')}
          </label>
          <select
            id="guests"
            name="guests"
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-[border-color,box-shadow] appearance-none cursor-pointer"
          >
            <option value="1" class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">1 {t('booking.guest')}</option>
            <option value="2" selected class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">2 {t('booking.guests_plural')}</option>
            <option value="3" class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">3 {t('booking.guests_plural')}</option>
            <option value="4" class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">4 {t('booking.guests_plural')}</option>
            <option value="5" class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">5 {t('booking.guests_plural')}</option>
            <option value="6" class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">6 {t('booking.guests_plural')}</option>
            <option value="7" class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">7 {t('booking.guests_plural')}</option>
          </select>
        </div>

        <!-- Room Type -->
        <div>
          <label for="room-type" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
            {t('booking.roomType')}
          </label>
          <select
            id="room-type"
            name="room-type"
            class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-[border-color,box-shadow] appearance-none cursor-pointer"
          >
            <option value="" class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">{t('booking.anyRoom')}</option>
            {roomTypes.map(rt => (
              <option value={rt.value} class="bg-white dark:bg-surface-card-dark text-text-primary-light dark:text-text-primary-dark">{rt.label}</option>
            ))}
          </select>
        </div>

        <!-- Search Button -->
        <div>
          <button
            type="submit"
            data-widget-submit
            class="w-full bg-secondary hover:bg-secondary-dark text-text-primary-light font-semibold py-3 px-6 rounded-xl transition-[transform,background-color,box-shadow] duration-300 hover:shadow-lg hover:shadow-secondary/25 hover:-translate-y-0.5 text-sm uppercase tracking-wider cursor-pointer"
          >
            {t('booking.search')}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline define:vars={{
  widgetLabels: JSON.stringify({
    nights: t('book.nights'),
    done: t('wizard.continue'),
    toastDatesAdjusted: t('wizard.toast.datesAdjusted'),
    toastDatesAdjustedDesc: t('wizard.toast.datesAdjustedDesc'),
  }),
}}>
  window.__WIDGET_LABELS = JSON.parse(widgetLabels);
</script>

<script>
  import { buildMonthGrid, nightsBetween, clampRange, formatISODate, addDays } from '../features/booking/calendar';
import { formatDate } from '../utils/format';
  import { animateCalendarDays } from '../features/animations/modules/bookingCalendar';
  import { toastApi } from '../features/ui/toast';

  let abortController = new AbortController();
  let cleanupAnim: (() => void) | null = null;

  function initBookingWidget() {
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const form = document.getElementById('booking-form') as HTMLFormElement | null;
    if (!form) return;

    const trigger = form.querySelector('[data-widget-dates]') as HTMLButtonElement | null;
    const triggerLabel = form.querySelector('[data-widget-dates-label]') as HTMLElement | null;
    const popover = form.querySelector('[data-widget-popover]') as HTMLElement | null;
    const month0 = form.querySelector('[data-widget-month="0"]') as HTMLElement | null;
    const month1 = form.querySelector('[data-widget-month="1"]') as HTMLElement | null;
    const rangeEl = form.querySelector('[data-widget-range]') as HTMLElement | null;
    const doneBtn = form.querySelector('[data-widget-done]') as HTMLButtonElement | null;
    if (!trigger || !triggerLabel || !popover || !month0 || !month1 || !rangeEl || !doneBtn) return;

    // TS 6 no propaga el narrowing de const a function declarations hoisted:
    // aliases no-null tras el guard (mismo patrón que BookingCalendarStep/AllocationStep).
    const triggerEl = trigger;
    const popoverEl = popover;
    const month0El = month0;
    const month1El = month1;
    const popoverParent = popoverEl.parentElement;
    const popoverNextSibling = popoverEl.nextSibling;

    const lang = (document.documentElement.lang || 'en') as string;
    const W = (window as any).__WIDGET_LABELS || {};

    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(today.getDate() + 1);
    const dayAfter = new Date(today);
    dayAfter.setDate(today.getDate() + 2);

    let checkIn = formatISODate(tomorrow);
    let checkOut = formatISODate(dayAfter);
    let viewYear = today.getFullYear();
    let viewMonth = today.getMonth();
    let open = false;

    const fmt = (iso: string) => new Date(iso + 'T00:00:00').toLocaleDateString(lang === 'es' ? 'es' : lang === 'fr' ? 'fr' : lang === 'pt' ? 'pt' : 'en', { day: '2-digit', month: 'short' });

    function renderLabel() {
      if (triggerLabel) triggerLabel.textContent = `${fmt(checkIn)} - ${fmt(checkOut)}`;
    }
    function renderRange() {
      const nights = nightsBetween(checkIn, checkOut);
      if (rangeEl) rangeEl.textContent = `${fmt(checkIn)} - ${fmt(checkOut)} (${nights} ${W.nights || 'nights'})`;
    }

    function renderMonth(container: HTMLElement, year: number, month: number) {
      const cells = buildMonthGrid(year, month);
      const monthName = new Date(year, month, 1).toLocaleDateString(lang === 'es' ? 'es' : lang === 'fr' ? 'fr' : lang === 'pt' ? 'pt' : 'en', { month: 'long', year: 'numeric' });
      const weekDays = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];

      container.innerHTML = `
        <div class="font-display text-lg capitalize">${monthName}</div>
        <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-mono uppercase tracking-widest text-text-secondary-light dark:text-text-secondary-dark">
          ${weekDays.map((d) => `<span class="py-1">${d}</span>`).join('')}
        </div>
        <div class="grid grid-cols-7 gap-1" role="grid" aria-label="${monthName}">
          ${cells.map((cell) => {
            if (!cell.inMonth) return '<span></span>';
            const past = cell.past;
            const dayNum = Number(cell.date.slice(-2));
            const dateLabel = formatDate(cell.date, lang);
            const disabledAttr = past ? 'tabindex="-1" aria-disabled="true"' : '';
            return `<button type="button" role="gridcell" data-calendar-day data-date="${cell.date}" data-past="${past}" aria-label="${dateLabel}" ${disabledAttr} class="aspect-square rounded-lg text-sm flex items-center justify-center transition-colors duration-200 cursor-pointer select-none ${past ? 'opacity-25 pointer-events-none' : 'hover:bg-primary/10 hover:text-primary'}">${dayNum}</button>`;
          }).join('')}
        </div>
      `;
    }

    function refreshSelection() {
      popoverEl.querySelectorAll<HTMLButtonElement>('[data-calendar-day]').forEach((btn) => {
        const date = btn.dataset.date || '';
        if (!date) return;
        const past = btn.dataset.past === 'true';
        const isStart = date === checkIn;
        const isEnd = date === checkOut;
        const range = checkIn && checkOut && date > checkIn && date < checkOut;
        const stateClass = past
          ? 'opacity-25 pointer-events-none'
          : isStart || isEnd
            ? 'bg-primary text-white font-bold'
            : range
              ? 'bg-primary/15 text-primary'
              : 'hover:bg-primary/10 hover:text-primary';
        btn.className = `aspect-square rounded-lg text-sm flex items-center justify-center transition-colors duration-200 cursor-pointer select-none ${stateClass}`;
        btn.setAttribute('aria-selected', isStart || isEnd ? 'true' : 'false');
      });
    }

    function render() {
      renderMonth(month0El, viewYear, viewMonth);
      const next = new Date(viewYear, viewMonth + 1, 1);
      renderMonth(month1El, next.getFullYear(), next.getMonth());
      cleanupAnim?.();
      cleanupAnim = animateCalendarDays(month0El);
      refreshSelection();
      renderLabel();
      renderRange();
    }

    let picked: string | null = checkIn;

    function portalPopoverOnMobile() {
      if (window.matchMedia('(max-width: 639px)').matches && popoverEl.parentElement !== document.body) {
        document.body.appendChild(popoverEl);
      }
    }

    function restorePopoverPosition() {
      if (popoverParent && popoverEl.parentElement !== popoverParent) {
        popoverParent.insertBefore(popoverEl, popoverNextSibling);
      }
    }

    function positionPopover() {
      if (window.matchMedia('(max-width: 639px)').matches) {
        popoverEl.style.top = '';
        popoverEl.style.bottom = '';
        popoverEl.style.marginTop = '';
        popoverEl.style.marginBottom = '';
        return;
      }

      const triggerRect = triggerEl.getBoundingClientRect();
      const shouldOpenAbove = window.innerHeight - triggerRect.bottom < popoverEl.offsetHeight + 12;
      popoverEl.style.top = shouldOpenAbove ? 'auto' : '';
      popoverEl.style.bottom = shouldOpenAbove ? '100%' : '';
      popoverEl.style.marginTop = shouldOpenAbove ? '0' : '';
      popoverEl.style.marginBottom = shouldOpenAbove ? '0.75rem' : '';
    }

    function openPopover() {
      portalPopoverOnMobile();
      open = true;
      popoverEl.classList.remove('hidden');
      triggerEl.setAttribute('aria-expanded', 'true');
      render();
      positionPopover();
    }
    function closePopover() {
      open = false;
      popoverEl.classList.add('hidden');
      triggerEl.setAttribute('aria-expanded', 'false');
      restorePopoverPosition();
      picked = checkIn;
    }

    triggerEl.addEventListener('click', () => (open ? closePopover() : openPopover()), { signal });

    popoverEl.addEventListener('click', (e) => {
      const day = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-calendar-day]');
      if (!day) return;
      const date = day.dataset.date || '';
      if (day.dataset.past === 'true' || !date) return;
      if (!picked || (checkIn && checkOut)) {
        picked = date;
        checkIn = date;
        checkOut = addDays(date, 1);
      } else {
        checkOut = date;
        const r = clampRange(checkIn, checkOut);
        checkIn = r.checkIn;
        checkOut = r.checkOut;
        picked = null;
      }
      refreshSelection();
      renderLabel();
      renderRange();
    }, { signal });

    doneBtn.addEventListener('click', closePopover, { signal });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (open && !form.contains(target) && !popoverEl.contains(target)) closePopover();
    }, { signal });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePopover();
    }, { signal });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = clampRange(checkIn, checkOut);
      const adjusted = r.checkIn !== checkIn || r.checkOut !== checkOut;
      checkIn = r.checkIn;
      checkOut = r.checkOut;
      renderLabel();
      if (adjusted) {
        toastApi.warning({ title: W.toastDatesAdjusted || 'Dates adjusted', description: W.toastDatesAdjustedDesc || '' });
      }

      const guests = (document.getElementById('guests') as HTMLSelectElement)?.value;
      const roomType = (document.getElementById('room-type') as HTMLSelectElement)?.value;

      const params = new URLSearchParams();
      params.append('checkin', checkIn);
      params.append('checkout', checkOut);
      if (guests) params.append('guests', guests);
      if (roomType) params.append('roomType', roomType);

      const basePath = lang === 'en' ? '/book' : `/${lang}/book`;
      window.location.href = `${basePath}?${params.toString()}`;
    }, { signal });

    renderLabel();
  }

  document.addEventListener('astro:page-load', initBookingWidget);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
    cleanupAnim?.();
    cleanupAnim = null;
  });
</script>
