---
// src/components/RoomsEditorialGrid.astro
// Editorial asymmetric bento grid of the 4 room types: one hero card +
// three standard cards. Hover reveals price, capacity, amenities and CTA.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SectionHeader from './ui/SectionHeader.astro';
import { rooms } from '../data/rooms';
import { useTranslations, type Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const imgGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/rooms/**/*.jpg', { eager: true });

function firstImage(photoFolder: string): ImageMetadata | undefined {
  const keys = Object.keys(imgGlob)
    .filter((k) => k.includes(`/rooms/${photoFolder}/`))
    .sort();
  return keys.length ? imgGlob[keys[0]].default : undefined;
}

const gridRooms = rooms.slice(0, 4).map((room, i) => ({
  room,
  hero: i === 0,
  img: firstImage(room.photoFolder),
}));
---

<section id="rooms" class="scroll-mt-28 sm:scroll-mt-32 py-12 sm:py-20 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500 relative overflow-hidden">
  <div class="max-w-[1400px] mx-auto animate-on-scroll">
    <SectionHeader
      number="03"
      eyebrow={t('rooms.sectionLabel')}
      title={t('rooms.title')}
      subtitle={t('rooms.description')}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 auto-rows-[300px] sm:auto-rows-[340px] gap-5 sm:gap-7">
      {gridRooms.map(({ room, hero, img }) => (
        <a
          href={getRelativeLocaleUrl(lang, `rooms/${room.slug}`)}
          data-astro-prefetch="tap"
          class={`group relative overflow-hidden rounded-3xl border border-black/5 dark:border-white/10 shadow-xl bg-surface-card-dark block ${hero ? 'md:col-span-2 lg:row-span-2' : ''}`}
          aria-label={room.name[lang]}
        >
          {img && (
            <Image
              src={img}
              alt={room.name[lang]}
              width={hero ? 1200 : 800}
              height={hero ? 800 : 700}
              format="webp"
              loading={hero ? 'eager' : 'lazy'}
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-105"
            />
          )}

          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>

          <div class="absolute top-5 left-5 flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-full bg-black/35 backdrop-blur-md border border-white/15 text-[10px] font-mono uppercase tracking-[0.2em] text-white/90">
              {t('rooms.upTo')} {room.maxGuests} {t('room.guests')}
            </span>
            <span class="px-3 py-1.5 rounded-full bg-black/35 backdrop-blur-md border border-white/15 text-[10px] font-mono uppercase tracking-[0.2em] text-white/90">
              {t('rooms.from')} ${room.pricePerNight} {t('rooms.perNight')}
            </span>
          </div>

          <div class="absolute bottom-0 inset-x-0 p-6 sm:p-8">
            <h3 class={`font-display text-white leading-tight mb-2 group-hover:text-secondary transition-colors duration-300 ${hero ? 'text-3xl sm:text-5xl' : 'text-2xl sm:text-3xl'}`}>
              {room.name[lang]}
            </h3>

            {hero && room.amenities.slice(0, 2).map((id) => (
              <span class="mr-3 inline-flex items-center gap-1.5 text-[11px] font-mono uppercase tracking-widest text-white/80">
                <svg class="w-3.5 h-3.5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {room.amenityLabels[id]?.[lang] || id}
              </span>
            ))}

            <div class="flex items-center gap-2 mt-4 text-xs font-bold uppercase tracking-widest text-secondary">
              <span class="opacity-0 translate-y-2 transition-all duration-500 group-hover:opacity-100 group-hover:translate-y-0">
                {t('roomsSection.viewDetails')}
              </span>
              <svg class="w-4 h-4 opacity-0 -translate-x-2 transition-all duration-500 group-hover:opacity-100 group-hover:translate-x-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- View All -->
    <div class="text-center mt-10">
      <a
        href={getRelativeLocaleUrl(lang, 'rooms')}
        data-astro-prefetch="tap"
        class="inline-flex items-center gap-3 btn-primary font-semibold px-8 py-4 rounded-xl text-sm uppercase tracking-wider group"
      >
        <span>{t('rooms.viewAll')}</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
