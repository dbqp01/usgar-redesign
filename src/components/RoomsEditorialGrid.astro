---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SectionHeader from './ui/SectionHeader.astro';
import { rooms } from '../data/rooms';
import { useTranslations, type Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const imgGlob = import.meta.glob<{ default: ImageMetadata }>('../assets/rooms/**/*.jpg', { eager: true });

function firstImage(photoFolder: string): ImageMetadata | undefined {
  const keys = Object.keys(imgGlob)
    .filter((key) => key.includes(`/rooms/${photoFolder}/`))
    .sort();
  return keys.length ? imgGlob[keys[0]].default : undefined;
}

const galleryRooms = rooms.slice(0, 4).map((room) => ({
  room,
  image: firstImage(room.photoFolder),
}));
---

<section id="rooms" class="scroll-mt-28 sm:scroll-mt-32 overflow-hidden bg-surface-light px-4 py-16 transition-colors duration-500 dark:bg-surface-dark sm:py-24">
  <div class="mx-auto max-w-[1400px] animate-on-scroll">
    <SectionHeader
      number="03"
      eyebrow={t('rooms.sectionLabel')}
      title={t('rooms.title')}
      subtitle={t('rooms.description')}
    />

    <div data-rooms-gallery class="grid grid-cols-1 gap-5 sm:gap-7 md:grid-cols-2">
      {galleryRooms.map(({ room, image }, index) => (
        <a
          href={getRelativeLocaleUrl(lang, `rooms/${room.slug}`)}
        data-astro-prefetch="viewport"
          data-room-card
          data-room-index={String(index + 1).padStart(2, '0')}
          data-cursor-label={t('cursor.view')}
          class="group relative isolate block min-h-[390px] overflow-hidden rounded-[1.75rem] border border-black/10 bg-surface-card-dark shadow-xl outline-none sm:min-h-[500px]"
          aria-label={room.name[lang]}
        >
          {image && (
            <Picture
              src={image}
              alt={room.name[lang]}
              formats={['avif']}
              fallbackFormat="avif"
              quality="high"
              fit="cover"
              position="center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              pictureAttributes={{ class: 'absolute inset-0 block h-full w-full' }}
              class="h-full w-full object-cover transition-transform duration-1000 ease-out will-change-transform motion-safe:group-hover:scale-[1.045]"
            />
          )}

          <div class="absolute inset-0 -z-0 bg-gradient-to-t from-black/95 via-black/15 to-black/5"></div>
          <div class="absolute inset-x-0 top-0 flex items-center justify-between p-5 text-[10px] font-mono uppercase tracking-[0.22em] text-white/80 sm:p-7">
            <span class="text-secondary">{String(index + 1).padStart(2, '0')} / 04</span>
            <span>{room.maxGuests} {t('room.guests')}</span>
          </div>

          <div class="absolute inset-x-0 bottom-0 z-10 p-5 sm:p-7">
            <div class="mb-4 h-px w-12 bg-secondary transition-all duration-700 group-hover:w-24"></div>
            <h3 class="max-w-[18ch] font-display text-3xl leading-[0.95] text-white transition-colors duration-500 group-hover:text-secondary sm:text-5xl">
              {room.name[lang]}
            </h3>
            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[10px] font-mono uppercase tracking-[0.18em] text-white/75">
              <span>{t('rooms.from')} ${room.pricePerNight} {t('rooms.perNight')}</span>
              <span>{room.amenityLabels[room.amenities[0]]?.[lang] || room.beds}</span>
              <span class="inline-flex items-center gap-2 text-secondary">
                {t('roomsSection.viewDetails')}
                <svg class="h-3.5 w-3.5 transition-transform duration-500 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center sm:mt-12">
      <a
        href={getRelativeLocaleUrl(lang, 'rooms')}
        data-astro-prefetch="tap"
        class="group inline-flex items-center gap-3 rounded-xl px-8 py-4 text-sm font-semibold uppercase tracking-wider btn-primary"
      >
        <span>{t('rooms.viewAll')}</span>
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import { initRoomsGallery } from '../features/animations/modules/roomsGallery';

  let cleanup: (() => void) | null = null;

  function init() {
    const root = document.querySelector('[data-rooms-gallery]') as HTMLElement | null;
    if (!root) return;
    cleanup?.();
    cleanup = initRoomsGallery(root);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
