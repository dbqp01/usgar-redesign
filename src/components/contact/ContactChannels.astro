---
// src/components/contact/ContactChannels.astro
// Right column of the contact page: direct channels (WhatsApp, Email,
// Reception Phone) + OTA/review badges.
import { useTranslations, type Locale } from '../../i18n/utils';
import { siteSettings } from '../../data/settings';

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
---

<!-- Canales directos: lista tipografica con hairlines -->
<div>
  <h3
    class="font-display text-2xl sm:text-3xl text-text-primary-light dark:text-white font-bold"
  >
    {t("contact.directChannels")}
  </h3>

  <div
    class="mt-6 divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10"
  >
    <!-- WhatsApp -->
    <a
      href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(t("contact.whatsappQuery"))}`}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-4 py-5 transition-colors duration-300"
    >
      <span
        class="w-10 h-10 rounded-lg bg-teal-brand/10 text-teal-brand flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
          ></path>
        </svg>
      </span>
      <span class="flex-1 min-w-0">
        <span
          class="block text-sm font-semibold text-text-primary-light dark:text-white group-hover:text-teal-brand transition-colors duration-300"
        >
          {t("contact.whatsappText")}
        </span>
        <span
          class="block text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5 font-mono"
        >
          {siteSettings.phone}
        </span>
      </span>
      <svg
        class="w-4 h-4 text-secondary opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-300 flex-shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>

    <!-- Email -->
    <a
      href={`mailto:${siteSettings.email}`}
      class="group flex items-center gap-4 py-5 transition-colors duration-300"
    >
      <span
        class="w-10 h-10 rounded-lg bg-primary/10 text-primary dark:text-purple-soft flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
      </span>
      <span class="flex-1 min-w-0">
        <span
          class="block text-sm font-semibold text-text-primary-light dark:text-white group-hover:text-primary-light transition-colors duration-300"
        >
          {t("contact.emailText")}
        </span>
        <span
          class="block text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5 font-mono truncate"
        >
          {siteSettings.email}
        </span>
      </span>
      <svg
        class="w-4 h-4 text-secondary opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-300 flex-shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>

    <!-- Recepcion telefonica -->
    <a
      href={`tel:+${siteSettings.phoneRaw}`}
      class="group flex items-center gap-4 py-5 transition-colors duration-300"
    >
      <span
        class="w-10 h-10 rounded-lg bg-secondary/15 text-secondary-dark dark:text-secondary flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-hover:scale-110"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
      </span>
      <span class="flex-1 min-w-0">
        <span
          class="block text-sm font-semibold text-text-primary-light dark:text-white group-hover:text-secondary-dark dark:group-hover:text-secondary transition-colors duration-300"
        >
          {t("contact.callText")}
        </span>
        <span
          class="block text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5 font-mono"
        >
          {siteSettings.phone}
        </span>
      </span>
      <svg
        class="w-4 h-4 text-secondary opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-300 flex-shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
      </svg>
    </a>
  </div>

  <!-- Portales OTA -->
  <div
    class="mt-6 pt-5 border-t border-black/10 dark:border-white/10 flex flex-wrap items-center justify-between gap-3"
  >
    <span
      class="text-xs font-medium text-text-secondary-light dark:text-text-secondary-dark"
    >
      {t("contact.otaLabel")}
    </span>
    <div class="flex gap-5">
      <a
        href="https://www.tripadvisor.com.pe/Hotel_Review-g294314-d12461523-Reviews-Usgar_San_Pedro_Boutique-Cusco_Cusco_Region.html"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-bold text-text-primary-light dark:text-white underline decoration-secondary/60 decoration-2 underline-offset-4 hover:text-secondary transition-colors duration-300 cursor-pointer"
      >
        TripAdvisor
      </a>
      <a
        href="https://www.booking.com/hotel/pe/chavin-imperio-del-sol.es.html?aid=311839&label=chavin-imperio-del-sol-zuUKmuTcIrFOMWxyHhV97gS539509797055%3Apl%3Ata%3Ap1%3Ap2%3Aac%3Aap%3Aneg%3Afi%3Atiaud-2395231936498%3Akwd-2440927734184%3Alp9060927%3Ali%3Adec%3Adm%3Appccp%3DUmFuZG9tSVYkc2RlIyh9YcUc3ZfdbbfEuXomSVxn0TU&sid=cde5b6d1678ed661cd007c4cc75870a4&dest_id=-345275&dest_type=city&dist=0&group_adults=2&group_children=0&hapos=1&hpos=1&no_rooms=1&req_adults=2&req_children=0&room1=A%2CA&sb_price_type=total&sr_order=popularity&srepoch=1782702781&srpvid=7032169be43f00ba&type=total&ucfs=1&"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-bold text-text-primary-light dark:text-white underline decoration-tertiary/60 decoration-2 underline-offset-4 hover:text-tertiary dark:hover:text-mint transition-colors duration-300 cursor-pointer"
      >
        Booking.com
      </a>
    </div>
  </div>
</div>
