---
// src/components/contact/ContactForm.astro
// Left column of the contact page: support form glass card + its submit logic.
// The <script> lives here because every id it touches (#contact-form,
// #btn-contact-submit, #contact-spinner, #contact-success) is inside this card.
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
---

<!-- Columna izquierda: formulario editorial (5 cols) -->
<div class="lg:col-span-5">
  <header class="mb-8">
    <h2
      class="font-display text-3xl sm:text-4xl text-primary dark:text-white font-bold"
    >
      {t("contact.getInTouch")}
    </h2>
    <p
      class="mt-2 text-sm text-text-secondary-light dark:text-text-secondary-dark leading-relaxed max-w-md"
    >
      {t("contact.formIntro")}
    </p>
  </header>

  <form id="contact-form" class="space-y-7" novalidate>
    <!-- Nombre -->
    <div>
      <label
        for="contact-name"
        class="block text-xs font-semibold uppercase tracking-[0.14em] text-text-secondary-light dark:text-text-secondary-dark mb-2"
      >
        {t("contact.formName")} *
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        autocomplete="name"
        class="w-full bg-transparent border-b-2 border-black/10 dark:border-white/15 focus:border-secondary px-0 py-3 text-sm text-text-primary-light dark:text-text-primary-dark focus-visible:outline-none transition-colors duration-300"
      />
    </div>

    <!-- Correo -->
    <div>
      <label
        for="contact-email"
        class="block text-xs font-semibold uppercase tracking-[0.14em] text-text-secondary-light dark:text-text-secondary-dark mb-2"
      >
        {t("contact.formEmail")} *
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        autocomplete="email"
        class="w-full bg-transparent border-b-2 border-black/10 dark:border-white/15 focus:border-secondary px-0 py-3 text-sm text-text-primary-light dark:text-text-primary-dark focus-visible:outline-none transition-colors duration-300"
      />
    </div>

    <!-- Categoria de asunto -->
    <div>
      <label
        for="contact-subject"
        class="block text-xs font-semibold uppercase tracking-[0.14em] text-text-secondary-light dark:text-text-secondary-dark mb-2"
      >
        {t("contact.formSubject")}
      </label>
      <div class="relative">
        <select
          id="contact-subject"
          name="subject"
          class="w-full appearance-none bg-transparent border-b-2 border-black/10 dark:border-white/15 focus:border-secondary px-0 py-3 pr-8 text-sm text-text-primary-light dark:text-text-primary-dark focus-visible:outline-none transition-colors duration-300 cursor-pointer"
        >
          <option value="general" class="bg-surface-light dark:bg-surface-card-dark">{t("contact.subjectGeneral")}</option>
          <option value="booking" class="bg-surface-light dark:bg-surface-card-dark">{t("contact.subjectBooking")}</option>
          <option value="transfer" class="bg-surface-light dark:bg-surface-card-dark">{t("contact.subjectTransfer")}</option>
          <option value="acclimatization" class="bg-surface-light dark:bg-surface-card-dark">{t("contact.subjectAcclimatization")}</option>
        </select>
        <svg
          class="w-4 h-4 text-secondary pointer-events-none absolute right-1 top-1/2 -translate-y-1/2"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
    </div>

    <!-- Mensaje -->
    <div>
      <label
        for="contact-message"
        class="block text-xs font-semibold uppercase tracking-[0.14em] text-text-secondary-light dark:text-text-secondary-dark mb-2"
      >
        {t("contact.formMessage")} *
      </label>
      <textarea
        id="contact-message"
        name="message"
        required
        rows="4"
        placeholder={t("contact.messagePlaceholder")}
        class="w-full bg-transparent border-b-2 border-black/10 dark:border-white/15 focus:border-secondary px-0 py-3 text-sm text-text-primary-light dark:text-text-primary-dark focus-visible:outline-none transition-colors duration-300 resize-none placeholder:text-stone-400 dark:placeholder:text-stone-500"
      ></textarea>
    </div>

    <!-- Boton de envio -->
    <button
      type="submit"
      id="btn-contact-submit"
      class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 rounded-lg transition-[transform,background-color,color,box-shadow] duration-300 hover:shadow-lg hover:shadow-primary/20 lg:hover:-translate-y-0.5 text-xs sm:text-sm uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2"
    >
      <span>{t("contact.formSubmit")}</span>
      <!-- Spinner -->
      <svg
        id="contact-spinner"
        class="hidden animate-spin h-5 w-5 text-current"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
    </button>

    <!-- Error banner -->
    <div
      id="contact-error"
      class="hidden p-4 rounded-lg bg-red-50 dark:bg-red-950/40 border-l-4 border-red-500 text-red-700 dark:text-red-300 text-xs leading-relaxed flex items-start gap-2.5"
      role="alert"
    >
      <svg
        class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
        ></path>
      </svg>
      <span id="contact-error-text">{t("contact.formError")}</span>
    </div>

    <!-- Success Message -->
    <div
      id="contact-success"
      role="status"
      aria-live="polite"
      class="hidden p-4 rounded-lg bg-teal-brand/10 border-l-4 border-teal-brand text-teal-deep dark:text-teal-light text-xs leading-relaxed flex items-start gap-2.5"
    >
      <svg
        class="w-5 h-5 text-teal-brand flex-shrink-0 mt-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="3"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 13l4 4L19 7"></path>
      </svg>
      <span>{t("contact.successMessage")}</span>
    </div>
  </form>
</div>

<script>
  let abortController = new AbortController();

  function initContactForm() {
    // Abort previous listeners to prevent duplicates during ViewTransitions
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const form = document.getElementById("contact-form") as HTMLFormElement;
    const btnSubmit = document.getElementById(
      "btn-contact-submit",
    ) as HTMLButtonElement;
    const spinner = document.getElementById("contact-spinner");
    const successBanner = document.getElementById("contact-success");
    const errorBanner = document.getElementById("contact-error");
    const errorText = document.getElementById("contact-error-text");

    if (!form || !btnSubmit || !spinner || !successBanner || !errorBanner || !errorText) return;

    const defaultError = errorText.textContent;

    form.addEventListener(
      "submit",
      async (e) => {
        e.preventDefault();

        // Hide previous banners
        successBanner.classList.add("hidden");
        errorBanner.classList.add("hidden");
        errorText.textContent = defaultError;

        // Disable button & show spinner
        btnSubmit.disabled = true;
        spinner.classList.remove("hidden");

        try {
          const formData = new FormData(form);
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "Accept": "application/json",
            },
            body: JSON.stringify({
              name: String(formData.get("name") || "").trim(),
              email: String(formData.get("email") || "").trim(),
              subject: String(formData.get("subject") || ""),
              message: String(formData.get("message") || "").trim(),
            }),
          });

          const data = await res.json().catch(() => ({}));

          if (!res.ok || !data?.success) {
            const serverMessage = data?.error?.message;
            if (typeof serverMessage === "string" && serverMessage) {
              errorText.textContent = serverMessage;
            }
            throw new Error("contact submit failed");
          }

          form.reset();
          successBanner.classList.remove("hidden");
        } catch {
          errorBanner.classList.remove("hidden");
        } finally {
          spinner.classList.add("hidden");
          btnSubmit.disabled = false;
        }
      },
      { signal },
    );
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
