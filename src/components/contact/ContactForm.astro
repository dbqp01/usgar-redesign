---
// src/components/contact/ContactForm.astro
// Left column of the contact page: support form glass card + its submit logic.
// The <script> lives here because every id it touches (#contact-form,
// #btn-contact-submit, #contact-spinner, #contact-success) is inside this card.
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
---

<!-- Left Column: Support Form Glass Card (5 cols) -->
<div
  class="lg:col-span-5 glass p-6 sm:p-8 rounded-3xl border border-black/5 dark:border-white/10 shadow-xl space-y-6 animate-on-scroll glow-card-hover"
>
  <div class="border-b border-black/5 dark:border-white/10 pb-4">
    <span class="tag-dash-title block mb-1"
      >{t("contact.getInTouch")}</span
    >
    <h2
      class="font-display text-2xl sm:text-3xl text-primary dark:text-secondary font-bold"
    >
      {t("contact.getInTouch")}
    </h2>
  </div>

  <form id="contact-form" class="space-y-4">
    <!-- Name -->
    <div>
      <label
        for="contact-name"
        class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
      >
        {t("contact.formName")} *
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        placeholder="e.g. Alexander Humboldt"
        class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
      />
    </div>

    <!-- Email -->
    <div>
      <label
        for="contact-email"
        class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
      >
        {t("contact.formEmail")} *
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        placeholder="e.g. alexander@example.com"
        class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
      />
    </div>

    <!-- Subject Category -->
    <div>
      <label
        for="contact-subject"
        class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
      >
        {t("contact.formSubject")}
      </label>
      <select
        id="contact-subject"
        name="subject"
        class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] cursor-pointer"
      >
        <option value="general">{t("contact.subjectGeneral")}</option>
        <option value="booking">{t("contact.subjectBooking")}</option>
        <option value="transfer">{t("contact.subjectTransfer")}</option>
        <option value="acclimatization"
          >{t("contact.subjectAcclimatization")}</option
        >
      </select>
    </div>

    <!-- Message -->
    <div>
      <label
        for="contact-message"
        class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
      >
        {t("contact.formMessage")} *
      </label>
      <textarea
        id="contact-message"
        name="message"
        required
        rows="4"
        placeholder={t("contact.messagePlaceholder")}
        class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400 resize-none"
      ></textarea>
    </div>

    <!-- Submit Button -->
    <button
      type="submit"
      id="btn-contact-submit"
      class="w-full bg-primary hover:bg-primary-dark text-white dark:bg-secondary dark:hover:bg-secondary-dark dark:text-stone-950 font-bold py-4 rounded-xl transition-[transform,background-color,color,box-shadow] duration-300 hover:shadow-lg hover:shadow-primary/20 lg:hover:-translate-y-0.5 text-xs sm:text-sm uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2"
    >
      <span>{t("contact.formSubmit")}</span>
      <!-- Spinner -->
      <svg
        id="contact-spinner"
        class="hidden animate-spin h-5 w-5 text-current"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
    </button>

    <!-- Success Message -->
    <div
      id="contact-success"
      class="hidden p-4 rounded-xl bg-teal-brand/10 border border-teal-brand/30 text-teal-deep dark:text-teal-light text-xs leading-relaxed flex items-start gap-2.5"
    >
      <svg
        class="w-5 h-5 text-teal-brand flex-shrink-0 mt-0.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="3"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M5 13l4 4L19 7"></path>
      </svg>
      <span>{t("contact.successMessage")}</span>
    </div>
  </form>
</div>

<script>
  let abortController = new AbortController();

  function initContactForm() {
    // Abort previous listeners to prevent duplicates during ViewTransitions
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const form = document.getElementById("contact-form") as HTMLFormElement;
    const btnSubmit = document.getElementById(
      "btn-contact-submit",
    ) as HTMLButtonElement;
    const spinner = document.getElementById("contact-spinner");
    const successBanner = document.getElementById("contact-success");

    if (!form || !btnSubmit || !spinner || !successBanner) return;

    form.addEventListener(
      "submit",
      async (e) => {
        e.preventDefault();

        // Hide success banner
        successBanner.classList.add("hidden");

        // Disable button & show spinner
        btnSubmit.disabled = true;
        spinner.classList.remove("hidden");

        // Simulate network response
        await new Promise((resolve) => setTimeout(resolve, 1200));

        // Reset state and show success banner
        spinner.classList.add("hidden");
        btnSubmit.disabled = false;
        successBanner.classList.remove("hidden");
        form.reset();
      },
      { signal },
    );
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
