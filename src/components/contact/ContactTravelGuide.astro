---
// src/components/contact/ContactTravelGuide.astro
// Right column of the contact page: Cusco survival & travel guide card
// (directions, airport pickup, altitude safety, reception hours).
import { useTranslations, type Locale } from '../../i18n/utils';

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
---

<!-- Guia de llegada a Cusco: filas editoriales con iconos -->
<div class="mt-14">
  <h3
    class="font-display text-2xl sm:text-3xl text-text-primary-light dark:text-white"
  >
    {t("contact.directionsTitle")}
  </h3>
  <p
    class="mt-2 text-sm text-text-secondary-light dark:text-text-secondary-dark leading-relaxed max-w-xl"
  >
    {t("contact.directionsDesc")}
  </p>

  <div class="mt-8 space-y-7">
    <!-- Traslado desde el aeropuerto -->
    <div class="flex gap-4">
      <span
        class="w-10 h-10 rounded-lg bg-primary/10 text-primary dark:text-purple-soft flex items-center justify-center flex-shrink-0"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 17a2 2 0 100-4 2 2 0 000 4zm8 0a2 2 0 100-4 2 2 0 000 4zm2-10h-3V4H5v10h13V7z"
          ></path>
        </svg>
      </span>
      <div>
        <h4
          class="text-sm font-semibold text-text-primary-light dark:text-white"
        >
          {t("contact.airportPickup")}
        </h4>
        <p
          class="mt-1 text-xs text-text-secondary-light dark:text-text-secondary-dark leading-relaxed"
        >
          {t("contact.airportPickupDesc")}
        </p>
      </div>
    </div>

    <!-- Soroche -->
    <div class="flex gap-4">
      <span
        class="w-10 h-10 rounded-lg bg-secondary/15 text-secondary-dark dark:text-secondary flex items-center justify-center flex-shrink-0"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"
          ></path>
        </svg>
      </span>
      <div>
        <h4
          class="text-sm font-semibold text-text-primary-light dark:text-white"
        >
          {t("contact.altitudeTitle")}
        </h4>
        <p
          class="mt-1 text-xs text-text-secondary-light dark:text-text-secondary-dark leading-relaxed"
        >
          {t("contact.altitudeDesc")}
        </p>
      </div>
    </div>

    <!-- Recepcion y horarios -->
    <div class="flex gap-4">
      <span
        class="w-10 h-10 rounded-lg bg-tertiary/10 text-tertiary dark:text-mint flex items-center justify-center flex-shrink-0"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          ></path>
        </svg>
      </span>
      <div class="flex-1">
        <h4
          class="text-sm font-semibold text-text-primary-light dark:text-white"
        >
          {t("contact.receptionTitle")}
        </h4>
        <p
          class="mt-1 text-xs text-text-secondary-light dark:text-text-secondary-dark leading-relaxed"
        >
          {t("contact.receptionDesc")}
        </p>
        <p
          class="mt-2 font-mono text-[11px] font-semibold text-secondary-dark dark:text-secondary"
        >
          {t("contact.checkinHours")}
        </p>
      </div>
    </div>
  </div>
</div>
