---
// src/components/CookieConsent.astro
// Aviso informativo (Ley 29733 / GDPR ePrivacy). El sitio solo usa
// almacenamiento estrictamente necesario, así que no hay categorías opcionales
// que aceptar o rechazar: se informa del almacenamiento real y se reconoce el
// aviso. No se bloquea ni se borra ninguna cookie.
// Tercero condicional: el Brick de MercadoPago solo se carga en /book y puede
// fijar sus propias cookies; el aviso lo dice expresamente.
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const privacyUrl = getRelativeLocaleUrl(lang, "privacy");
const termsUrl = getRelativeLocaleUrl(lang, "terms");

// Copy local: las claves de src/i18n no describen el almacenamiento real.
const COPY = {
  en: {
    title: "Cookies and local storage",
    text: "We only store what the site needs to work: login and security cookies (e.g. usgar_session, usgar_csrf), your theme and this notice in local storage, and your booking and login state in session storage. No analytics or marketing cookies. MercadoPago may set its own cookies when you book.",
    action: "Understood",
  },
  es: {
    title: "Cookies y almacenamiento local",
    text: "Solo guardamos lo que el sitio necesita para funcionar: cookies de inicio de sesión y seguridad (p. ej. usgar_session, usgar_csrf), tu tema y este aviso en el almacenamiento local, y tu reserva y sesión en el almacenamiento de sesión. Sin cookies de analítica ni marketing. MercadoPago puede usar sus propias cookies al reservar.",
    action: "Entendido",
  },
  fr: {
    title: "Cookies et stockage local",
    text: "Nous ne stockons que ce qui est nécessaire au fonctionnement du site : cookies de connexion et de sécurité (p. ex. usgar_session, usgar_csrf), votre thème et cet avis dans le stockage local, et votre réservation et connexion dans le stockage de session. Aucun cookie d'analyse ni de marketing. MercadoPago peut utiliser ses propres cookies lors d'une réservation.",
    action: "Compris",
  },
  pt: {
    title: "Cookies e armazenamento local",
    text: "Guardamos apenas o que o site precisa para funcionar: cookies de login e segurança (p. ex. usgar_session, usgar_csrf), seu tema e este aviso no armazenamento local, e sua reserva e login no armazenamento de sessão. Sem cookies de análise nem de marketing. A MercadoPago pode usar cookies próprios ao reservar.",
    action: "Entendi",
  },
} as const;

const copy = COPY[lang] ?? COPY.en;
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-[1200] hidden px-2 pb-2 sm:px-4 sm:pb-4"
  role="region"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-text"
>
  <div class="mx-auto flex max-w-3xl flex-col gap-2 rounded-xl border border-black/10 bg-white p-3 shadow-2xl dark:border-white/20 dark:bg-surface-card-dark sm:gap-4 sm:rounded-2xl sm:p-5 sm:flex-row sm:items-center">
    <div class="flex-1">
      <h2 id="cookie-consent-title" class="font-display text-xs uppercase tracking-wider text-text-primary-light dark:text-white sm:text-sm">
        {copy.title}
      </h2>
      <p id="cookie-consent-text" class="text-sm leading-relaxed text-text-secondary-light dark:text-text-secondary-dark sm:mt-1">
        {copy.text}{" "}
        <a href={privacyUrl} class="underline decoration-secondary underline-offset-2 hover:text-secondary transition-colors">
          {t("footer.privacy")}
        </a>
        {" · "}
        <a href={termsUrl} class="underline decoration-secondary underline-offset-2 hover:text-secondary transition-colors">
          {t("footer.terms")}
        </a>
      </p>
    </div>
    <div class="flex flex-shrink-0 justify-end gap-2">
      <button
        type="button"
        data-cookie-choice="acknowledged"
        class="btn-primary inline-flex min-h-11 items-center justify-center rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-wider sm:min-h-0 sm:px-5"
      >
        {copy.action}
      </button>
    </div>
  </div>
</div>

<script>
  // Persistente entre páginas: el módulo se ejecuta UNA vez (cache del bundler),
  // así que la lógica debe re-correr en cada navegación (astro:page-load) y
  // limpiarse antes de preparar la transición (astro:before-preparation).
  const STORAGE_KEY = "usgar-cookie-consent";
  const ACKNOWLEDGED = "acknowledged";
  let timer: number | null = null;

  function hasStoredChoice(): boolean {
    try {
      return localStorage.getItem(STORAGE_KEY) !== null;
    } catch {
      return true; // localStorage bloqueado (Safari privado): no molestar
    }
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, ACKNOWLEDGED);
    } catch {
      /* no-op */
    }
    hideBanner();
  }

  function showBanner(el: HTMLElement) {
    el.classList.remove("hidden");
  }

  function hideBanner() {
    const el = document.getElementById("cookie-consent");
    el?.classList.add("hidden");
    if (timer !== null) window.clearTimeout(timer);
    timer = null;
  }

  function initCookieConsent() {
    const banner = document.getElementById("cookie-consent") as HTMLElement | null;
    if (!banner) return;

    // Keep the consent banner clear of the fixed booking controls.
    const mobileBookingBar = document.querySelector('[data-mobile-booking-bar]:not(.hidden)');
    if (window.innerWidth < 1024 && mobileBookingBar) {
      banner.style.bottom = "4.5rem";
    } else if (/^\/(es|fr|pt)?\/?$/.test(location.pathname)) {
      banner.style.bottom = "9rem";
    }

    // Estado ya reconocido (esta página o una anterior): oculto, sin eventos.
    if (hasStoredChoice()) {
      banner.classList.add("hidden");
      return;
    }

    // Primera visita: mostrar tras un respiro; el botón solo reconoce el aviso.
    if (timer === null) {
      timer = window.setTimeout(() => showBanner(banner), 1500);
    }
    const action = banner.querySelector<HTMLButtonElement>("[data-cookie-choice]");
    if (action && !action.dataset.hooked) {
      action.dataset.hooked = "1";
      action.addEventListener("click", save);
    }
  }

  document.addEventListener("astro:page-load", initCookieConsent);
  document.addEventListener("astro:before-preparation", () => {
    if (timer !== null) window.clearTimeout(timer);
    timer = null;
    const bannerEl = document.getElementById("cookie-consent");
    if (bannerEl) bannerEl.style.bottom = "";
  });
</script>
