---
// src/components/CookieConsent.astro
// Banner informativo de cookies (Ley 29733 / GDPR ePrivacy): el sitio solo usa
// cookies estrictamente necesarias, asi que no hay cookies que bloquear — solo
// se informa y se guarda la eleccion en localStorage.
// Sin scripts de tracking/analytics en src/; cookies propias usgar_session y
// usgar_panel, ambas de sesión/funcionales. Nota: el iframe del Brick de MP
// puede fijar sus propias cookies de terceros, fuera del control del sitio.
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const privacyUrl = getRelativeLocaleUrl(lang, "privacy");
const termsUrl = getRelativeLocaleUrl(lang, "terms");
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-[1200] hidden px-2 pb-2 sm:px-4 sm:pb-4"
  role="region"
  aria-label={t("cookie.title")}
>
  <div class="mx-auto flex max-w-3xl flex-col gap-2 rounded-xl border border-black/10 bg-white/95 p-3 shadow-2xl dark:border-white/10 dark:bg-surface-card-dark/95 sm:gap-4 sm:rounded-2xl sm:p-5 sm:flex-row sm:items-center">
    <div class="flex-1">
      <p class="font-display text-xs uppercase tracking-wider text-text-primary-light dark:text-white sm:text-sm">
        {t("cookie.title")}
      </p>
      <p class="text-[11px] leading-snug text-text-secondary-light dark:text-text-secondary-dark sm:mt-1 sm:text-xs sm:leading-relaxed">
        {t("cookie.text")}{" "}
        <a href={privacyUrl} class="underline decoration-secondary underline-offset-2 hover:text-secondary transition-colors">
          {t("footer.privacy")}
        </a>
        {" · "}
        <a href={termsUrl} class="underline decoration-secondary underline-offset-2 hover:text-secondary transition-colors">
          {t("footer.terms")}
        </a>
      </p>
    </div>
    <div class="flex flex-shrink-0 justify-end gap-2">
      <button
        type="button"
        data-cookie-choice="declined"
        class="rounded-full border border-black/10 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-text-secondary-light transition-colors hover:border-secondary hover:text-secondary dark:border-white/15 dark:text-text-secondary-dark sm:px-5 sm:py-2 sm:text-xs"
      >
        {t("cookie.decline")}
      </button>
      <button
        type="button"
        data-cookie-choice="accepted"
        class="btn-primary rounded-full px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider sm:px-5 sm:py-2 sm:text-xs"
      >
        {t("cookie.accept")}
      </button>
    </div>
  </div>
</div>

<script>
  // Persistente entre páginas: el módulo se ejecuta UNA vez (cache del bundler),
  // así que la lógica debe re-correr en cada navegación (astro:page-load) y
  // limpiarse antes de preparar la transición (astro:before-preparation).
  const STORAGE_KEY = "usgar-cookie-consent";
  let timer: number | null = null;

  function hasStoredChoice(): boolean {
    try {
      return localStorage.getItem(STORAGE_KEY) !== null;
    } catch {
      return true; // localStorage bloqueado (Safari privado): no molestar
    }
  }

  function save(choice: string) {
    try {
      localStorage.setItem(STORAGE_KEY, choice);
    } catch {
      /* no-op */
    }
    hideBanner();
  }

  function showBanner(el: HTMLElement) {
    el.classList.remove("hidden");
  }

  function hideBanner() {
    const el = document.getElementById("cookie-consent");
    el?.classList.add("hidden");
    if (timer !== null) window.clearTimeout(timer);
    timer = null;
  }

  function initCookieConsent() {
    const banner = document.getElementById("cookie-consent") as HTMLElement | null;
    if (!banner) return;

    // Keep the consent banner clear of the fixed booking controls.
    const mobileBookingBar = document.querySelector('[data-mobile-booking-bar]:not(.hidden)');
    if (window.innerWidth < 1024 && mobileBookingBar) {
      banner.style.bottom = "4.5rem";
    } else if (/^\/(es|fr|pt)?\/?$/.test(location.pathname)) {
      banner.style.bottom = "9rem";
    }

    // Estado ya decidido (esta página o una anterior): oculto, sin eventos.
    if (hasStoredChoice()) {
      banner.classList.add("hidden");
      return;
    }

    // Primera visita: mostrar tras un respiro; aceptar/rechazar guarda la elección.
    if (timer === null) {
      timer = window.setTimeout(() => showBanner(banner), 1500);
    }
    banner.querySelectorAll<HTMLButtonElement>("[data-cookie-choice]").forEach((btn) => {
      if (btn.dataset.hooked) return;
      btn.dataset.hooked = "1";
      btn.addEventListener("click", () => save(btn.dataset.cookieChoice || "accepted"));
    });
  }

  document.addEventListener("astro:page-load", initCookieConsent);
  document.addEventListener("astro:before-preparation", () => {
    if (timer !== null) window.clearTimeout(timer);
    timer = null;
    const bannerEl = document.getElementById("cookie-consent");
    if (bannerEl) bannerEl.style.bottom = "";
  });
</script>
