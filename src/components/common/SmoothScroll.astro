---
/**
 * USGAR Hotels — SmoothScroll.astro
 * Inicializa Lenis Smooth Scroll y lo sincroniza con GSAP ScrollTrigger
 * para una navegacion fluida inmersiva (Quiet Luxury).
 */
---

<script>
  import { ScrollStoryEngine } from '../../utils/scrollStoryEngine';
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  let lenisInstance: any = null;

  function initSmoothScroll() {
    if (typeof window === 'undefined' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    try {
      gsap.registerPlugin(ScrollTrigger);

      if (!lenisInstance) {
        lenisInstance = new Lenis({
          duration: 1.5,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        lenisInstance.on('scroll', ScrollTrigger.update);

        gsap.ticker.add((time: number) => {
          lenisInstance.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
        (window as any).__lenis = lenisInstance;
      }

      // Initialize story engine animations for home/interactive sections
      ScrollStoryEngine.initHomePageStory();

    } catch (e) {
      console.warn('SmoothScroll init note:', e);
    }
  }

  // Teardown ScrollTrigger on View Transitions before swap
  document.addEventListener('astro:before-preparation', () => {
    ScrollStoryEngine.cleanup();
  });

  // Re-init on page load / transition completed
  document.addEventListener('astro:page-load', initSmoothScroll);
</script>

