---
/**
 * USGAR Hotels - SmoothScroll.astro
 * Inicializa Lenis Smooth Scroll y lo sincroniza con GSAP ScrollTrigger
 * para una navegacion fluida inmersiva (Quiet Luxury).
 */
---

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initLifecycle } from '../../features/animations/animationLifecycle';
  import { bootAnimations } from '../../features/animations/engine';

  gsap.registerPlugin(ScrollTrigger);

  let lenisInstance: Lenis | null = null;
  let rafCallback: ((time: number) => void) | null = null;
  let lenisCtx: gsap.Context | null = null;

  function initLenis() {
    if (typeof window === 'undefined') return;

    const isMobileTouch = window.matchMedia('(pointer: coarse)').matches || window.innerWidth < 1024;

    if (!isMobileTouch && !lenisInstance) {
      lenisCtx = gsap.context(() => {
        lenisInstance = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          anchors: true,
        });

        lenisInstance.on('scroll', ScrollTrigger.update);

        rafCallback = (time: number) => {
          lenisInstance!.raf(time * 1000);
        };
        gsap.ticker.add(rafCallback);
        gsap.ticker.lagSmoothing(0);
      });
    }
  }

  function destroyLenis() {
    if (lenisInstance) {
      lenisInstance.destroy();
      lenisInstance = null;
    }
    if (lenisCtx) {
      lenisCtx.revert();
      lenisCtx = null;
    }
    if (rafCallback) {
      gsap.ticker.remove(rafCallback);
      rafCallback = null;
    }
  }

  // --- In-page hash anchors (#rooms, #main-content) ---------------------------
  // The ClientRouter (astro:transitions, Layout.astro) intercepts EVERY
  // same-origin anchor click - including hash-only links like href="#rooms" -
  // with a document (bubble) listener that preventDefaults and runs a full
  // view transition, so the page never scrolls (router source: ClientRouter.astro
  // registers on document, bubble; bails out on ev.defaultPrevented). This
  // capture-phase listener runs BEFORE the router's: preventDefault() makes the
  // router bail out via its own defaultPrevented check. Bundled module scripts
  // execute only once per load (docs: "Script re-execution"), so this listener
  // persists across every view transition. pushState() only updates the hash -
  // it never fires hashchange nor loads the URL (MDN History.pushState).
  const isModifiedClick = (ev: MouseEvent) =>
    (ev.button && ev.button !== 0) || ev.metaKey || ev.ctrlKey || ev.altKey || ev.shiftKey;

  function resolveHashTarget(hash: string): HTMLElement | null {
    let id = hash.slice(1);
    try {
      id = decodeURIComponent(id);
    } catch {
      // malformed escape: keep the raw id
    }
    return document.getElementById(id);
  }

  function smoothScrollTo(target: HTMLElement): void {
    // Lenis scrollTo honors the section's CSS scroll-margin-top (lenis dist);
    // under prefers-reduced-motion it jumps instantly (respectReducedMotion).
    if (lenisInstance) {
      lenisInstance.scrollTo(target);
    } else {
      target.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function scrollToInitialHash(): void {
    const { hash } = location;
    if (!hash || hash === '#') return;
    const target = resolveHashTarget(hash);
    if (!target) return;
    // Two frames: let Lenis compute dimensions and the layout settle first.
    requestAnimationFrame(() => requestAnimationFrame(() => smoothScrollTo(target)));
  }

  document.addEventListener(
    'click',
    (ev: MouseEvent) => {
      if (isModifiedClick(ev)) return; // new tab/window/download: leave native
      const origin = ev.composedPath()[0];
      if (!(origin instanceof Element)) return;
      const anchor = origin.closest('a[href^="#"]');
      if (!anchor) return;
      const hash = anchor.getAttribute('href');
      if (!hash || hash === '#') return; // bare "#" = top: leave native
      const target = resolveHashTarget(hash);
      if (!target) return; // unknown id: leave native/router behavior
      ev.preventDefault(); // router bails out (ev.defaultPrevented check)
      ev.stopPropagation(); // Lenis's own anchor handler must not double-fire
      history.pushState(null, '', hash);
      smoothScrollTo(target);
    },
    true
  );

  function initPage() {
    initLenis();
    bootAnimations();
    scrollToInitialHash();
  }

  initLifecycle();

  document.addEventListener('astro:before-preparation', () => {
    destroyLenis();
  });

  document.addEventListener('astro:page-load', initPage);
</script>
