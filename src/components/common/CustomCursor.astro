---
// src/components/common/CustomCursor.astro
// Dual-layer cinematic cursor: instant dot + lagging ring.
// Rules (design spec 2026-08-01): only on (hover:hover) and (pointer:fine),
// disabled with prefers-reduced-motion, kill-switch via <html data-cursor="false">.
---

<div
  id="custom-cursor"
  class="hidden md:block fixed top-0 left-0 z-[110] pointer-events-none mix-blend-difference"
  aria-hidden="true"
>
  <span class="cursor-dot absolute rounded-full bg-white will-change-transform"></span>
  <span class="cursor-ring absolute rounded-full border border-white/60 will-change-transform"></span>
</div>

<script>
  import gsap from 'gsap';

  let ctx: gsap.Context | null = null;

  function initCursor() {
    // Kill-switch from settings.json (data-cursor="false" on <html>)
    if (document.documentElement.dataset.cursor === 'false') return;
    // Only precise pointers, never on touch/coarse devices
    if (window.matchMedia('(pointer: coarse)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cursor = document.getElementById('custom-cursor');
    if (!cursor) return;

    const dot = cursor.querySelector('.cursor-dot') as HTMLElement;
    const ring = cursor.querySelector('.cursor-ring') as HTMLElement;
    if (!dot || !ring) return;

    if (ctx) ctx.revert();
    ctx = gsap.context(() => {
      const SIZE = { dot: 8, ring: 36, ringHover: 64 };

      gsap.set(dot, { width: SIZE.dot, height: SIZE.dot, xPercent: -50, yPercent: -50, autoAlpha: 0 });
      gsap.set(ring, { width: SIZE.ring, height: SIZE.ring, xPercent: -50, yPercent: -50, autoAlpha: 0 });

      // Dot tracks instantly, ring lags (power3) — classic cinematic pairing
      const dotX = gsap.quickTo(dot, 'x', { duration: 0.12, ease: 'power3' });
      const dotY = gsap.quickTo(dot, 'y', { duration: 0.12, ease: 'power3' });
      const ringX = gsap.quickTo(ring, 'x', { duration: 0.5, ease: 'power3' });
      const ringY = gsap.quickTo(ring, 'y', { duration: 0.5, ease: 'power3' });

      let isVisible = false;

      const onMouseMove = (e: MouseEvent) => {
        dotX(e.clientX);
        dotY(e.clientY);
        ringX(e.clientX);
        ringY(e.clientY);

        if (!isVisible) {
          gsap.to([dot, ring], { autoAlpha: 1, duration: 0.25 });
          isVisible = true;
        }

        const target = e.target as HTMLElement | null;
        const isInteractive = !!target?.closest?.(
          'a, button, input, select, textarea, [role="button"], [data-cursor-hover]'
        );

        gsap.to(ring, {
          width: isInteractive ? SIZE.ringHover : SIZE.ring,
          height: isInteractive ? SIZE.ringHover : SIZE.ring,
          borderColor: isInteractive ? 'rgba(255,255,255,0.9)' : 'rgba(255,255,255,0.6)',
          duration: 0.35,
          ease: 'power2.out',
          overwrite: 'auto',
        });
        gsap.to(dot, {
          width: isInteractive ? 4 : SIZE.dot,
          height: isInteractive ? 4 : SIZE.dot,
          duration: 0.35,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      };

      const onMouseLeave = () => {
        if (isVisible) {
          gsap.to([dot, ring], { autoAlpha: 0, duration: 0.2 });
          isVisible = false;
        }
      };

      window.addEventListener('mousemove', onMouseMove);
      document.documentElement.addEventListener('mouseleave', onMouseLeave);

      // Cleanup on Astro ViewTransitions
      document.addEventListener('astro:before-preparation', () => {
        window.removeEventListener('mousemove', onMouseMove);
        document.documentElement.removeEventListener('mouseleave', onMouseLeave);
        isVisible = false;
        if (ctx) ctx.revert();
      }, { once: true });
    });
  }

  document.addEventListener('astro:page-load', initCursor);
</script>
