---
// src/components/common/Preloader.astro
import { siteSettings } from '../../data/settings';
---
<div id="cinematic-preloader" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#121214] text-white overflow-hidden pointer-events-none">
  <div class="relative flex flex-col items-center">
    <div class="overflow-hidden">
      <h1 id="preloader-text" class="text-4xl md:text-6xl font-serif tracking-[0.2em] transform translate-y-full opacity-0">{siteSettings.hotelName}</h1>
    </div>
    <div 
      id="preloader-line"
      class="mt-4 h-[1px] bg-white opacity-60 rounded-full"
      style="width: 100px; transform: scaleX(0); transform-origin: left; will-change: transform;"
    ></div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { register } from "../../features/animations/animationLifecycle";

  declare global {
    interface Window {
      __preloaderDone?: boolean;
    }
  }

  // Shared done-guard with the is:inline fallback in Layout.astro head:
  // usgar:preloader-done fires exactly once per load (timeline path OR fallback).
  function done() {
    if (window.__preloaderDone) return;
    window.__preloaderDone = true;
    window.dispatchEvent(new CustomEvent("usgar:preloader-done"));
  }

  document.addEventListener("astro:page-load", () => {
    if (sessionStorage.getItem("usgar_loaded")) {
      const preloader = document.getElementById("cinematic-preloader");
      if (preloader) {
        preloader.style.display = "none";
      }
      done();
      return;
    }

    const preloader = document.getElementById("cinematic-preloader");
    if (!preloader) return;

    // gsap.matchMedia() crea su propio context internamente (docs GSAP); el
    // scope por defecto se pasa como unico parametro (igual que ctx(scope)).
    const mm = gsap.matchMedia(preloader);

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const tl = gsap.timeline({
        onComplete: () => {
          sessionStorage.setItem("usgar_loaded", "true");
          gsap.set(preloader, { autoAlpha: 0, display: "none" });
          done();
        },
      });

      tl.to("#preloader-text", {
        y: 0,
        autoAlpha: 1,
        duration: 0.6,
        ease: "power4.out",
      })
      .to("#preloader-line", {
        scaleX: 1,
        duration: 0.55,
        ease: "power3.inOut",
      }, "-=0.35")
      .to(preloader, {
        autoAlpha: 0,
        duration: 0.4,
        ease: "power2.inOut",
        delay: 0.1
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      sessionStorage.setItem("usgar_loaded", "true");
      gsap.set(preloader, { autoAlpha: 0, display: "none" });
      done();
    });

    register("preloader", mm);
  });
</script>
