---
// src/components/common/Preloader.astro
import { siteSettings } from '../../data/settings';
---
<div id="cinematic-preloader" class="fixed inset-0 z-[100] flex items-center justify-center bg-black text-white overflow-hidden pointer-events-none" style="clip-path: inset(0 0 0 0);">
  <div class="relative flex flex-col items-center select-none">
    <div class="overflow-hidden">
      <div id="preloader-text" role="presentation" class="text-4xl md:text-6xl font-display tracking-[0.25em] uppercase text-white transform translate-y-full opacity-0">
        {siteSettings.hotelName}
      </div>
    </div>
    <div class="mt-6 flex items-center gap-3 font-mono text-xs text-secondary tracking-widest">
      <span id="preloader-counter">00%</span>
      <span class="w-12 h-[1px] bg-secondary/40 relative overflow-hidden">
        <span id="preloader-line" class="absolute inset-0 bg-secondary transform -translate-x-full"></span>
      </span>
    </div>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { register } from "../../features/animations/animationLifecycle";

  declare global {
    interface Window {
      __preloaderDone?: boolean;
    }
  }

  function done() {
    if (window.__preloaderDone) return;
    window.__preloaderDone = true;
    window.dispatchEvent(new CustomEvent("usgar:preloader-done"));
  }

  document.addEventListener("astro:page-load", () => {
    try {
      if (sessionStorage.getItem("usgar_loaded")) {
        const preloader = document.getElementById("cinematic-preloader");
        if (preloader) preloader.style.display = "none";
        done();
        return;
      }
    } catch (_) {}

    const preloader = document.getElementById("cinematic-preloader");
    const text = document.getElementById("preloader-text");
    const counter = document.getElementById("preloader-counter");
    const line = document.getElementById("preloader-line");

    if (!preloader || !text || !counter || !line) return;

    const mm = gsap.matchMedia(preloader);

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const obj = { val: 0 };

      const tl = gsap.timeline({
        onComplete: () => {
          try {
            sessionStorage.setItem("usgar_loaded", "true");
          } catch (_) {}
          gsap.set(preloader, { display: "none" });
          done();
        },
      });

      tl.to(text, {
        y: 0,
        autoAlpha: 1,
        duration: 0.5,
        ease: "power3.out",
      })
      .to(obj, {
        val: 100,
        duration: 0.7,
        ease: "power2.inOut",
        onUpdate: () => {
          counter.textContent = `${Math.floor(obj.val).toString().padStart(2, "0")}%`;
          line.style.transform = `translateX(${obj.val - 100}%)`;
        },
      }, "-=0.2")
      .to(preloader, {
        clipPath: "inset(0 0 100% 0)",
        duration: 0.5,
        ease: "power4.inOut",
      });
    });

    mm.add("(prefers-reduced-motion: reduce)", () => {
      try {
        sessionStorage.setItem("usgar_loaded", "true");
      } catch (_) {}
      gsap.set(preloader, { display: "none" });
      done();
    });

    register("preloader", mm);
  });
</script>
