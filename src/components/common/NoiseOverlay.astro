---
// src/components/common/NoiseOverlay.astro
// Crea una textura visual de ruido analogico (desktop only for perf)
---
<div class="pointer-events-none fixed inset-0 z-50 mix-blend-overlay opacity-30 hidden lg:block">
  <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
    <filter id="noiseFilter">
      <feTurbulence 
        type="fractalNoise" 
        baseFrequency="0.75" 
        numOctaves="1" 
        stitchTiles="stitch"/>
    </filter>
    <rect width="100%" height="100%" filter="url(#noiseFilter)" />
  </svg>
</div>

<style>
  div {
    animation: noise-shift 8s infinite alternate;
  }
  @keyframes noise-shift {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-2px, -2px); }
  }
  @media (prefers-reduced-motion: reduce) {
    div {
      animation: none;
    }
  }
</style>
