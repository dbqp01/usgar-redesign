---
import { Image } from 'astro:assets';
import { useTranslations } from "../i18n/utils";
import aboutData from "../content/about/about.json";
import patioImg from '../assets/hotel/hero-slide-patio.jpg';
import fachadaImg from '../assets/hotel/fallback-room-fachada.jpg';

import type { Locale } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;

const t = useTranslations(lang);

const title = (aboutData as any)[`title_${lang}`] || aboutData.title_en || aboutData.title_es;
const purpose = (aboutData as any)[`purpose_${lang}`] || aboutData.purpose_en || aboutData.purpose_es;
---

<section id="about" class="scroll-mt-28 sm:scroll-mt-32 py-12 sm:py-20 lg:py-16 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500 overflow-hidden relative">
  <div class="max-w-[1400px] mx-auto relative z-10">
    
    <!-- Editorial Layout: Staggered columns -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center animate-on-scroll">
      
      <!-- Text Content (Left on Desktop) -->
      <div class="lg:col-span-5 space-y-6 sm:space-y-8 lg:pr-6">
        <div class="space-y-4">
          <div class="flex items-start gap-5">
            <span class="section-number text-6xl sm:text-7xl mt-1" aria-hidden="true">06</span>
            <div class="space-y-4">
              <span class="tag-dash-title block">
                {t('about.sectionLabel')}
              </span>
              <h2 class="font-display text-4xl sm:text-5xl lg:text-5xl text-text-primary-light dark:text-white leading-[1.1]">
                {title}
              </h2>
            </div>
          </div>
        </div>
        
        <p class="text-base sm:text-lg text-text-secondary-light dark:text-text-secondary-dark font-body font-light leading-relaxed">
          {purpose}
        </p>
        
        <!-- Minimalist Values List -->
        <div class="pt-6 border-t border-black/10 dark:border-white/10">
          <div class="grid grid-cols-2 gap-y-4 gap-x-4">
             {aboutData.values.slice(0, 4).map((valor) => {
               const valTitle = (valor as any)[`title_${lang}`] || valor.title_en || valor.title_es;
               return (
                 <div class="flex items-center gap-3 group">
                   <div class="w-6 h-px bg-secondary transition-[width] duration-300 group-hover:w-10"></div>
                   <h3 class="font-display tracking-widest uppercase text-xs font-bold text-primary dark:text-white">
                     {valTitle}
                   </h3>
                 </div>
               );
             })}
          </div>
        </div>
        
      </div>

      <!-- Image Composition (Right on Desktop) with 3D Tilt Container -->
      <div class="lg:col-span-7 relative h-[380px] sm:h-[480px] lg:h-[460px] max-h-[60vh] w-full group" data-tilt-container>
        
        <!-- Main Large Image -->
        <div class="absolute top-0 right-0 w-[82%] h-[82%] rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl z-10 border border-black/5 dark:border-white/5 transition-transform duration-500 ease-out" data-tilt-layer="0.5">
          <Image
            src={patioImg}
            alt="Patio Inca Colonial USGAR Hotels"
            width={800}
            height={600}
            format="webp"
            class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>

        <!-- Offset Smaller Image -->
        <div class="absolute bottom-0 left-0 w-[52%] h-[58%] rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl z-20 border-4 border-surface-light dark:border-surface-dark transition-transform duration-500 ease-out" data-tilt-layer="1.2">
          <Image
            src={fachadaImg}
            alt="Fachada USGAR Hotels"
            width={500}
            height={500}
            format="webp"
            class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
          />
        </div>
        
        <!-- Decorative Radial Glow -->
        <div class="absolute top-1/2 left-1/3 -translate-y-1/2 -translate-x-1/2 w-40 h-40 rounded-full border border-secondary/30 z-0 hidden sm:block animate-pulse-soft"></div>
      </div>
      
    </div>
    
  </div>
</section>
