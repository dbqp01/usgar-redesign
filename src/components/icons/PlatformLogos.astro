---
// src/components/icons/PlatformLogos.astro
// Official platform logos as inline SVGs (fill currentColor by default;
// Google keeps its brand colors). Reusable via <PlatformLogo platform="..." class="..." />.
interface Props {
  platform: 'tripadvisor' | 'booking' | 'google' | 'expedia';
  class?: string;
}

const { platform, class: cls = 'w-5 h-5' } = Astro.props;
---

{platform === 'tripadvisor' && (
  <svg class={cls} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 004.04 10.43 5.976 5.976 0 004.075-1.6L12 19.705l1.922-2.09a5.972 5.972 0 004.075 1.6 5.997 5.997 0 004.04-10.43L24 6.648h-4.35a13.573 13.573 0 00-7.644-2.353zM12 6.76c1.874 0 3.727.56 5.295 1.587H6.706A11.115 11.115 0 0112 6.76zM5.997 17.213a3.997 3.997 0 110-7.994 3.997 3.997 0 010 7.994zm12.006 0a3.997 3.997 0 110-7.994 3.997 3.997 0 010 7.994zM5.997 11.219a2.0 2.0 0 100 4.0 2.0 2.0 0 000-4.0zm12.006 0a2.0 2.0 0 100 4.0 2.0 2.0 0 000-4.0z" />
  </svg>
)}

{platform === 'booking' && (
  <svg class={cls} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M2.273 0v24h7.619c6.727 0 9.836-3.552 9.836-7.552 0-2.87-1.552-5.292-4.162-6.275v-.076c2.041-1.066 3.234-2.987 3.234-5.262C18.8 1.55 16.127 0 10.545 0H2.273zm4.5 3.6h3.22c2.652 0 4.108.869 4.108 2.87 0 2.152-1.607 3.145-4.108 3.145H6.773V3.6zm0 9.615h3.524c2.955 0 4.869.945 4.869 3.372 0 2.393-1.914 3.413-4.538 3.413H6.773v-6.785z" />
  </svg>
)}

{platform === 'google' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true">
    <path fill="var(--color-google-blue)" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47a5.53 5.53 0 01-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z" />
    <path fill="var(--color-google-green)" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09A11.99 11.99 0 0012 24z" />
    <path fill="var(--color-google-yellow)" d="M5.27 14.29a7.19 7.19 0 010-4.58V6.62H1.29a11.98 11.98 0 000 10.76l3.98-3.09z" />
    <path fill="var(--color-google-red)" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.69 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75z" />
  </svg>
)}

{platform === 'expedia' && (
  <svg class={cls} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2c1.35 0 2.47.5 3.36 1.5.89 1 1.34 2.25 1.34 3.76 0 1.36-.38 2.52-1.14 3.48a8.9 8.9 0 011.6 1.6c.9 1.19 1.36 2.6 1.36 4.23 0 1.6-.46 2.91-1.38 3.94C14.86 22.03 13.7 22.54 12.3 22.54c-1.57 0-2.88-.54-3.93-1.63-1.05-1.09-1.57-2.46-1.57-4.1 0-1.48.46-2.8 1.39-3.94a8.5 8.5 0 011.63-1.64c-.77-.96-1.16-2.12-1.16-3.47 0-1.5.46-2.75 1.37-3.75C9.63 2.5 10.69 2 12 2zm0 10.66c-.6 0-1.16.5-1.68 1.5-.52 1-.79 2.2-.79 3.6 0 1.43.26 2.62.79 3.57.53.95 1.1 1.43 1.68 1.43.6 0 1.16-.48 1.69-1.43.53-.95.8-2.14.8-3.57 0-1.4-.27-2.6-.8-3.6-.53-1-1.1-1.5-1.69-1.5z" />
  </svg>
)}
