---
// src/components/LocationMap.astro
// Luxury Boutique Location Map: CARTO Dark Matter + Interactive Leaflet,
// hotel pin blanco con pulso radar dorado, POI landmarks, glassmorphism
// overlays y Google Maps CTA. (audit 2026-08-12: tiles dark_all de cartocdn y
// pin blanco + ping bg-secondary confirmados en locationMap.ts)
import { useTranslations, type Locale } from '../i18n/utils';
import { siteSettings } from '../data/settings';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const { latitude: lat, longitude: lng } = siteSettings;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;

const pois = [
  {
    id: 'market',
    name: t('map.marketLabel'),
    lat: -13.5209,
    lng: -71.9823,
    timeText: `6 min ${t('map.walkTime')}`,
  },
  {
    id: 'plaza',
    name: t('map.plazaLabel'),
    lat: -13.5167,
    lng: -71.9781,
    timeText: `8 min ${t('map.walkTime')}`,
  },
  {
    id: 'station',
    name: lang === 'es' ? 'Estación de Tren San Pedro' : 'San Pedro Train Station',
    lat: -13.5222,
    lng: -71.9835,
    timeText: `3 min ${t('map.walkTime')}`,
  },
];
---

<section id="map-section" class="relative overflow-hidden bg-surface-card-light px-4 py-16 text-text-primary-light transition-colors duration-500 dark:bg-surface-dark dark:text-white sm:py-24">
  <div class="max-w-[1400px] mx-auto relative z-10 animate-on-scroll">
    <div class="text-center mb-12 space-y-2">
      <span class="tag-dash-title block">
        {t('map.sectionLabel')}
      </span>
      <div class="flex items-center justify-center gap-4">
        <span class="section-number text-6xl sm:text-7xl" aria-hidden="true">09</span>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl text-text-primary-light dark:text-white tracking-tight leading-tight">
          {t('map.title')}
        </h2>
      </div>
      <p class="mt-4 text-base sm:text-lg text-text-secondary-light dark:text-text-secondary-dark font-body font-light max-w-2xl mx-auto">
        {t('map.description')}
      </p>
    </div>

    <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-[minmax(0,1fr)_380px]">
      <!-- Map Container (light tiles, follows theme) -->
      <div class="relative min-h-[420px] overflow-hidden rounded-[2rem] border border-black/10 bg-white shadow-xl dark:border-white/10 dark:bg-surface-card-dark sm:min-h-[520px]">
        <div id="location-map" class="absolute inset-0" data-lat={lat} data-lng={lng} data-pois={JSON.stringify(pois)}></div>

        <!-- Coordinates overlay (enlaza a Google Maps con la dirección) -->
        <div class="absolute top-5 left-5 pointer-events-none z-[1001]">
          <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-mono text-[11px] tracking-widest text-stone-800 bg-white/85 backdrop-blur-md px-4 py-2 rounded-full border border-black/10 shadow-lg hover:shadow-xl hover:bg-white transition-[box-shadow,background-color]">
            <span class="h-2 w-2 rounded-full bg-secondary animate-pulse"></span>
            {Math.abs(lat).toFixed(4)}° {lat < 0 ? 'S' : 'N'} / {Math.abs(lng).toFixed(4)}° {lng < 0 ? 'W' : 'E'}
          </a>
        </div>

        <!-- Location Badge overlay -->
        <div class="absolute top-5 right-5 pointer-events-none z-[1001]">
          <span class="inline-block font-mono text-[11px] tracking-widest text-stone-800 bg-white/85 backdrop-blur-md px-4 py-2 rounded-full border border-black/10 shadow-lg">
            {t('map.locationOverlay')}
          </span>
        </div>

        <!-- Directions CTA -->
        <a
          id="map-directions-btn"
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="absolute bottom-5 left-5 z-[1001] inline-flex items-center gap-3 bg-gradient-to-r from-secondary-light via-secondary to-secondary-dark text-black px-6 py-3.5 rounded-full text-xs font-bold uppercase tracking-widest pointer-events-auto shadow-2xl shadow-secondary/30 hover:brightness-110 group transition-all duration-300 transform hover:-translate-y-0.5"
        >
          <span>{t('map.directions')}</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Info column -->
      <div class="flex flex-col justify-center gap-6 lg:px-4 bg-white dark:bg-surface-card-dark p-6 rounded-[2rem] border border-black/5 dark:border-white/5">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-secondary font-semibold">
            {t('map.addressPrefix')}
          </p>
          <h3 class="font-display text-3xl sm:text-4xl text-text-primary-light dark:text-white leading-tight mt-1">
            {t('map.addressHotel')}
          </h3>
        </div>

        <div class="divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10">
          {pois.map((poi, i) => (
            <a
              data-map-poi={poi.id}
              href={`https://www.google.com/maps/search/?api=1&query=${poi.lat},${poi.lng}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between py-4 cursor-pointer group transition-colors hover:text-secondary"
            >
              <div class="flex items-center gap-3">
                <span class="h-5 w-5 rounded-full bg-secondary text-stone-900 text-[10px] font-bold flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-sm font-medium text-text-primary-light dark:text-white group-hover:text-secondary transition-colors">
                  {poi.name}
                </span>
              </div>
              <span class="font-mono text-xs text-text-secondary-light dark:text-text-secondary-dark group-hover:text-secondary transition-colors">
                {poi.timeText}
              </span>
            </a>
          ))}
        </div>

        <p class="text-sm text-text-secondary-light dark:text-text-secondary-dark font-light leading-relaxed">
          {siteSettings.address[lang]}
        </p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .leaflet-container {
    background-color: #f2efe8 !important;
    font-family: inherit;
  }
  .usgar-leaflet-popup .leaflet-popup-content-wrapper {
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(140, 105, 0, 0.25);
    border-radius: 1rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
    color: #181818;
  }
  .usgar-leaflet-popup .leaflet-popup-tip {
    background: rgba(255, 255, 255, 0.97);
    border: 1px solid rgba(140, 105, 0, 0.25);
  }
  .usgar-leaflet-tooltip {
    background: rgba(255, 255, 255, 0.95) !important;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(140, 105, 0, 0.3) !important;
    border-radius: 9999px !important;
    color: #181818 !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
  }
  .leaflet-control-zoom {
    border: 1px solid rgba(0, 0, 0, 0.1) !important;
    border-radius: 0.75rem !important;
    overflow: hidden;
    backdrop-filter: blur(12px);
    background: rgba(255, 255, 255, 0.9) !important;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
    margin-right: 1.25rem !important;
    margin-bottom: 1.25rem !important;
  }
  .leaflet-control-zoom a {
    background: transparent !important;
    color: #181818 !important;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
  }
  .leaflet-control-zoom a:hover {
    background: rgba(212, 175, 55, 0.25) !important;
    color: #8c6900 !important;
  }
  .leaflet-control-attribution {
    background: rgba(255, 255, 255, 0.8) !important;
    color: #78716c !important;
  }
  .leaflet-control-attribution a {
    color: #8c6900 !important;
  }
</style>

<script>
  import { initLocationMap, type MapPOI } from '../features/animations/modules/locationMap';

  let cleanup: (() => void) | null = null;
  let observer: IntersectionObserver | null = null;
  let initToken = 0;

  function initMap() {
    const el = document.getElementById('location-map') as HTMLElement | null;
    if (!el) return;
    const token = ++initToken;
    observer?.disconnect();
    observer = null;
    cleanup?.();
    cleanup = null;
    const lat = parseFloat(el.dataset.lat || '-13.521528');
    const lng = parseFloat(el.dataset.lng || '-71.984886');
    let pois: MapPOI[] = [];
    try {
      if (el.dataset.pois) {
        pois = JSON.parse(el.dataset.pois);
      }
    } catch {}

    observer = new IntersectionObserver(async (entries) => {
      if (!entries[0].isIntersecting) return;
      observer?.disconnect();
      observer = null;
      try {
        const mapCleanup = await initLocationMap(el, lat, lng, pois);
        if (token !== initToken || !el.isConnected) {
          mapCleanup();
          return;
        }
        cleanup = mapCleanup;
      } catch (err) {
        // Surface failures instead of failing silently (client reported "map not working")
        console.error('[LocationMap] init failed:', err);
      }
    }, { rootMargin: '400px' });
    observer.observe(el);
  }

  document.addEventListener('astro:page-load', initMap);
  document.addEventListener('astro:before-preparation', () => {
    initToken += 1;
    observer?.disconnect();
    observer = null;
    cleanup?.();
    cleanup = null;
  });
</script>

