---
import { Image } from 'astro:assets';
import patioImg from '../assets/hotel/hero-slide-patio.jpg';
import pasilloImg from '../assets/hotel/fallback-room-pasillo.jpg';

import type { Locale } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const stats = [
  { value: '1650', label: { en: 'Colonial Foundation', es: 'Fundación Colonial', fr: 'Fondation Coloniale', pt: 'Fundação Colonial' } },
  { value: '3,400m', label: { en: 'Highland Serenity', es: 'Serenidad Andina', fr: 'Sérénité Andine', pt: 'Serenidade Andina' } },
  { value: '24/7', label: { en: 'Oxygen & Tea', es: 'Oxígeno y Té', fr: 'Oxygène & Infusions', pt: 'Oxigênio & Chás' } }
];

---

<section id="heritage-section" class="scroll-mt-28 sm:scroll-mt-32 py-12 sm:py-16 px-4 bg-surface-card-dark text-white relative overflow-hidden transition-colors duration-500">
  <!-- Decorative SVG path that draws on scroll -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-25 z-0" viewBox="0 0 1400 900" fill="none" preserveAspectRatio="none">
    <path id="heritage-svg-path" d="M -100 100 Q 700 0 1500 450 T -100 800" stroke="var(--color-secondary, #D4AF37)" stroke-width="3" stroke-linecap="round" />
  </svg>

  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- Editorial Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center animate-on-scroll">
      
      <!-- Left: Massive Image with Parallax feel -->
      <div class="relative w-full aspect-[3/4] sm:aspect-square lg:aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl img-hover-zoom" data-story-parallax="0.12">
        <Image
          src={patioImg}
          alt="Patio Inca Colonial USGAR Hotels"
          width={800}
          height={1200}
          format="webp"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <!-- Inner Glow & Gradient -->
        <div class="absolute inset-0 border border-white/10 rounded-2xl z-10 pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent opacity-80 z-0"></div>
        
        <div class="absolute bottom-8 left-8 right-8 z-20">
           <p class="font-display text-4xl sm:text-5xl text-white tracking-wide font-bold">
             {t('heritage.fusionTitle')}
           </p>
           <p class="text-sm font-light text-white/80 mt-2 font-body max-w-sm">
             {t('heritage.fusionDesc')}
           </p>
        </div>
      </div>
      
      <!-- Right: Staggered Content & Huge Typography -->
      <div class="space-y-12">
        
        <div class="space-y-4">
          <div class="flex items-start gap-5">
            <span class="section-number text-6xl sm:text-8xl mt-1" aria-hidden="true">02</span>
            <div class="space-y-4">
              <span class="tag-dash-title block text-secondary">
                {t('heritage.sectionLabel')}
              </span>
              <h2 class="font-display text-5xl sm:text-6xl lg:text-7xl leading-none text-white tracking-tight">
                {t('heritage.heading')}
              </h2>
            </div>
          </div>
          <p class="text-lg text-text-secondary-dark font-body font-light leading-relaxed pt-6">
            {t('heritage.description')}
          </p>
        </div>

        <!-- Metric Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 pt-10 border-t border-white/10">
          {stats.map((stat) => (
            <div class="space-y-1" data-story-parallax="0.08">
              <span class="font-display text-5xl sm:text-6xl font-bold text-secondary block">{stat.value}</span>
              <span class="text-[10px] font-mono uppercase tracking-widest text-text-secondary-dark font-semibold">
                {stat.label[lang]}
              </span>
            </div>
          ))}
        </div>

        <!-- Secondary Floating Image -->
        <div class="relative w-full h-64 sm:h-80 rounded-2xl overflow-hidden shadow-xl img-hover-zoom hidden sm:block" data-story-parallax="0.18">
           <Image
            src={pasilloImg}
            alt="Pasillos de Piedra USGAR Hotels"
            width={800}
            height={500}
            format="webp"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

      </div>

    </div>
  </div>
</section>
