---
import Layout from '../layouts/Layout.astro';
import { useTranslations, type Locale } from "../i18n/utils";

export const prerender = true;

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

// La página es prerender (output: static): Astro.url.searchParams se evalúa en
// BUILD, no por request — por eso ?error= y ?redirect= se leen en el CLIENTE
// (URLSearchParams(window.location.search)) dentro del script, y aquí solo
// queda una constante por defecto para el SSR inicial.
const DEFAULT_REDIRECT = '/my-bookings';
---

<Layout title={`${t('auth.signIn')} - USGAR Hotels`} lang={lang}>
  <div class="min-h-screen py-28 px-4 flex items-center justify-center animate-fade-in">
    <div class="w-full max-w-md bg-surface-card-light dark:bg-surface-card-dark p-8 md:p-10 rounded-3xl border border-black/10 dark:border-white/10 shadow-2xl space-y-8">
      
      <!-- Header -->
      <div class="text-center space-y-2">
        <span class="text-xs font-semibold text-primary dark:text-purple-pastel uppercase tracking-widest">
          USGAR Hotels
        </span>
        <h1 class="font-display text-3xl md:text-4xl font-bold">
          {t('auth.welcomeTitle')}
        </h1>
        <p class="text-text-secondary-light dark:text-text-secondary-dark text-sm">
          {t('auth.welcomeSubtitle')}
        </p>
      </div>

      <!-- Error Alert (dinámico vía JS — ver initLogin: el banner SSR no funciona en prerender) -->
      <div id="auth-alert" class="hidden p-4 rounded-xl border text-sm font-medium flex items-center gap-3">
        <span id="auth-alert-text"></span>
      </div>

      <!-- Social Login Buttons (Hidden by default, shown by JS if enabled) -->
      <div id="oauth-container" class="space-y-3">
        <!-- Google -->
        <div id="provider-Google" class="hidden">
          <a
            href={`/api/auth/login?provider=Google&redirect=${encodeURIComponent(DEFAULT_REDIRECT)}`}
          class="w-full flex items-center justify-center gap-3 px-4 py-3.5 rounded-xl border border-black/10 dark:border-white/10 bg-white dark:bg-surface-dark hover:bg-stone-50 dark:hover:bg-stone-800 text-text-primary-light dark:text-text-primary-dark font-medium text-sm transition-[background-color,color,box-shadow] duration-300 shadow-sm hover:shadow"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="var(--color-google-blue)" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
            <path fill="var(--color-google-green)" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.11-6.72-4.96H1.26v3.15C3.24 21.3 7.31 24 12 24z"/>
            <path fill="var(--color-google-yellow)" d="M5.28 14.24c-.25-.72-.38-1.49-.38-2.24s.13-1.52.38-2.24V6.61H1.26C.46 8.23 0 10.06 0 12s.46 3.77 1.26 5.39l4.02-3.15z"/>
            <path fill="var(--color-google-red)" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.24 2.7 1.26 6.61l4.02 3.15c.95-2.85 3.6-4.96 6.72-4.96z"/>
          </svg>
          <span>{t('auth.continueWithGoogle')}</span>
          </a>
        </div>

        <!-- Microsoft -->
        <div id="provider-MicrosoftGraph" class="hidden">
          <a
            href={`/api/auth/login?provider=MicrosoftGraph&redirect=${encodeURIComponent(DEFAULT_REDIRECT)}`}
          class="w-full flex items-center justify-center gap-3 px-4 py-3.5 rounded-xl border border-black/10 dark:border-white/10 bg-white dark:bg-surface-dark hover:bg-stone-50 dark:hover:bg-stone-800 text-text-primary-light dark:text-text-primary-dark font-medium text-sm transition-[background-color,color,box-shadow] duration-300 shadow-sm hover:shadow"
        >
          <svg class="w-5 h-5" viewBox="0 0 23 23">
            <path fill="var(--color-ms-orange)" d="M1 1h10v10H1z"/>
            <path fill="var(--color-ms-green)" d="M12 1h10v10H12z"/>
            <path fill="var(--color-ms-blue)" d="M1 12h10v10H1z"/>
            <path fill="var(--color-ms-yellow)" d="M12 12h10v10H12z"/>
          </svg>
          <span>{t('auth.continueWithMicrosoft')}</span>
          </a>
        </div>

        <!-- Facebook -->
        <div id="provider-Facebook" class="hidden">
          <a
            href={`/api/auth/login?provider=Facebook&redirect=${encodeURIComponent(DEFAULT_REDIRECT)}`}
          class="w-full flex items-center justify-center gap-3 px-4 py-3.5 rounded-xl border border-black/10 dark:border-white/10 bg-facebook hover:bg-facebook-dark text-white font-medium text-sm transition-[background-color,color,box-shadow] duration-300 shadow-sm hover:shadow"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>{t('auth.continueWithFacebook')}</span>
          </a>
        </div>
      </div>

      <!-- Divider -->
      <div id="auth-divider" class="relative flex items-center justify-center hidden">
        <div class="border-t border-black/10 dark:border-white/10 w-full"></div>
        <span class="bg-surface-card-light dark:bg-surface-card-dark px-3 text-xs text-text-secondary-light dark:text-text-secondary-dark uppercase tracking-wider font-semibold whitespace-nowrap">
          {t('auth.orUseEmail')}
        </span>
        <div class="border-t border-black/10 dark:border-white/10 w-full"></div>
      </div>

      <!-- Tabs: Sign In / Sign Up -->
      <div>
        <div class="flex border-b border-black/10 dark:border-white/10 mb-6">
          <button
            id="tab-login-btn"
            type="button"
            class="flex-1 py-3 text-center text-sm font-semibold border-b-2 border-primary text-primary transition-[border-color,color] cursor-pointer"
          >
            {t('auth.signIn')}
          </button>
          <button
            id="tab-register-btn"
            type="button"
            class="flex-1 py-3 text-center text-sm font-semibold border-b-2 border-transparent text-text-secondary-light dark:text-text-secondary-dark hover:text-primary transition-[border-color,color] cursor-pointer"
          >
            {t('auth.signUp')}
          </button>
        </div>

        <!-- Form: Login -->
        <form id="login-form" action="/api/auth/login-email" method="POST" class="space-y-4">
          <input type="hidden" name="redirect" value={DEFAULT_REDIRECT} />
          <div>
            <label for="login-email" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
              {t('auth.emailAddress')} *
            </label>
            <input
              type="email"
              id="login-email"
              name="email"
              required
              autocomplete="email"
              placeholder="e.g. john@example.com"
              class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none transition-[border-color,box-shadow]"
            />
          </div>

          <div>
            <label for="login-password" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
              {t('auth.password')} *
            </label>
            <input
              type="password"
              id="login-password"
              name="password"
              required
              autocomplete="current-password"
              placeholder=""
              class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none transition-[border-color,box-shadow]"
            />
          </div>

          <button
            type="submit"
            id="login-submit"
            class="w-full bg-primary hover:bg-primary-dark text-white font-semibold py-3.5 rounded-xl transition-[background-color,color,box-shadow] duration-300 shadow-md hover:shadow-lg cursor-pointer"
          >
            {t('auth.signIn')}
          </button>
        </form>

        <!-- Form: Register (Hidden by default) -->
        <form id="register-form" action="/api/auth/register" method="POST" class="space-y-4 hidden">
          <input type="hidden" name="redirect" value={DEFAULT_REDIRECT} />
          <div>
            <label for="reg-name" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
              {t('auth.fullName')} *
            </label>
            <input
              type="text"
              id="reg-name"
              name="fullName"
              required
              autocomplete="name"
              placeholder="e.g. John Doe"
              class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none transition-[border-color,box-shadow]"
            />
          </div>

          <div>
            <label for="reg-email" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
              {t('auth.emailAddress')} *
            </label>
            <input
              type="email"
              id="reg-email"
              name="email"
              required
              autocomplete="email"
              placeholder="e.g. john@example.com"
              class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none transition-[border-color,box-shadow]"
            />
          </div>

          <div>
            <label for="reg-password" class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-text-secondary-dark mb-2">
              {t('auth.password')} *
            </label>
            <input
              type="password"
              id="reg-password"
              name="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder=""
              class="w-full px-4 py-3 rounded-xl bg-white dark:bg-surface-dark border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-primary outline-none transition-[border-color,box-shadow]"
            />
          </div>

          <button
            type="submit"
            id="register-submit"
            class="w-full bg-primary hover:bg-primary-dark text-white font-semibold py-3.5 rounded-xl transition-[background-color,color,box-shadow] duration-300 shadow-md hover:shadow-lg cursor-pointer"
          >
            {t('auth.signUp')}
          </button>
        </form>
      </div>
    </div>
  </div>

  <script is:inline data-astro-rerun define:vars={{ DEFAULT_REDIRECT, tErrorLogin: t('auth.loginError'), tEmailExists: t('auth.emailExists'), tSignIn: t('auth.signIn'), tSignUp: t('auth.signUp') }}>
    (function() {
      // The login form must be re-bound on EVERY entry under client-side
      // navigation: the form elements are re-created on each body swap, so the
      // getElementById calls and listeners below MUST re-run on every entry —
      // never wrap initLogin in a `window.__loginInit` latch.
      //
      // Two mechanisms cooperate to re-run it:
      //   1. data-astro-rerun (plan Todo 5) — forces the router to re-execute
      //      this inline script on every transition. NOTE: with define:vars
      //      present, Astro strips data-astro-rerun from the served <script>
      //      tag (verified on Astro 7.1.1 dev, see swap-functions.js), so the
      //      reliable mechanism is #2.
      //   2. A persistent `astro:page-load` listener registered EXACTLY ONCE.
      //      `astro:page-load` fires at the end of the initial load and of
      //      every client-side navigation, so the handler re-binds the fresh
      //      form elements each entry. document/window are persistent targets,
      //      so the registration is guarded by window.__loginPageLoadBound
      //      (the guard covers ONLY this persistent listener — it must never
      //      wrap the form re-binding inside initLogin).
      function initLogin() {
      const loginSubmitLabel = tSignIn;
      const registerSubmitLabel = tSignUp;
      const tabLoginBtn = document.getElementById('tab-login-btn');
      const tabRegisterBtn = document.getElementById('tab-register-btn');
      const loginForm = document.getElementById('login-form');
      const registerForm = document.getElementById('register-form');
      const alertBox = document.getElementById('auth-alert');
      const alertText = document.getElementById('auth-alert-text');

      function showAlert(msg, isSuccess = false) {
        if (!alertBox || !alertText) return;
        alertText.textContent = msg;
        alertBox.className = isSuccess
          ? 'p-4 rounded-xl border border-green-500/20 bg-green-500/10 text-green-600 dark:text-green-400 text-sm font-medium flex items-center gap-3'
          : 'p-4 rounded-xl border border-red-500/20 bg-red-500/10 text-red-600 dark:text-red-400 text-sm font-medium flex items-center gap-3';
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      function hideAlert() {
        if (alertBox) alertBox.classList.add('hidden');
      }

      // ── Redirect y error se leen del CLIENTE (no de Astro.url: la página es
      // prerender, ?error= y ?redirect= no existen en build de producción) ──
      // Validación idéntica a la del backend (AuthLoginAction/AuthCallbackAction):
      // solo rutas relativas del mismo origen, nunca '//' ni absolutas.
      const urlParams = new URLSearchParams(window.location.search);
      const rawRedirect = urlParams.get('redirect');
      const redirect = rawRedirect && rawRedirect.startsWith('/') && !rawRedirect.startsWith('//') && rawRedirect !== '/'
        ? rawRedirect
        : DEFAULT_REDIRECT;

      const oauthError = urlParams.get('error');
      if (oauthError) {
        showAlert(decodeURIComponent(oauthError));
      }

      // Re-escribir los links OAuth y los inputs ocultos con el redirect real
      document.querySelectorAll('#oauth-container a[href*="/api/auth/login"]').forEach(a => {
        const url = new URL(a.href);
        url.searchParams.set('redirect', redirect);
        a.href = url.toString();
      });
      document.querySelectorAll('input[name="redirect"]').forEach(i => { i.value = redirect; });

      // Fetch active OAuth providers
      fetch('/api/auth/providers')
        .then(res => res.json())
        .then(data => {
          if (data.success && data.providers && data.providers.length > 0) {
            data.providers.forEach(p => {
              const el = document.getElementById('provider-' + p);
              if (el) el.classList.remove('hidden');
            });
            document.getElementById('auth-divider')?.classList.remove('hidden');
          } else {
            document.getElementById('oauth-container')?.classList.add('hidden');
          }
        })
        .catch(() => {});

      // Tab switching
      tabLoginBtn?.addEventListener('click', () => {
        hideAlert();
        tabLoginBtn.className = 'flex-1 py-3 text-center text-sm font-semibold border-b-2 border-primary text-primary transition-[border-color,color] cursor-pointer';
        tabRegisterBtn.className = 'flex-1 py-3 text-center text-sm font-semibold border-b-2 border-transparent text-text-secondary-light dark:text-text-secondary-dark hover:text-primary transition-[border-color,color] cursor-pointer';
        loginForm?.classList.remove('hidden');
        registerForm?.classList.add('hidden');
      });

      tabRegisterBtn?.addEventListener('click', () => {
        hideAlert();
        tabRegisterBtn.className = 'flex-1 py-3 text-center text-sm font-semibold border-b-2 border-primary text-primary transition-[border-color,color] cursor-pointer';
        tabLoginBtn.className = 'flex-1 py-3 text-center text-sm font-semibold border-b-2 border-transparent text-text-secondary-light dark:text-text-secondary-dark hover:text-primary transition-[border-color,color] cursor-pointer';
        registerForm?.classList.remove('hidden');
        loginForm?.classList.add('hidden');
      });

      // Helper to activate Sign In tab
      function switchToSignIn(email = '') {
        hideAlert();
        if (tabLoginBtn && tabRegisterBtn && loginForm && registerForm) {
          tabLoginBtn.className = 'flex-1 py-3 text-center text-sm font-semibold border-b-2 border-primary text-primary transition-[border-color,color] cursor-pointer';
          tabRegisterBtn.className = 'flex-1 py-3 text-center text-sm font-semibold border-b-2 border-transparent text-text-secondary-light dark:text-text-secondary-dark hover:text-primary transition-[border-color,color] cursor-pointer';
          loginForm.classList.remove('hidden');
          registerForm.classList.add('hidden');

          if (email) {
            const loginEmail = document.getElementById('login-email');
            const loginPass = document.getElementById('login-password');
            if (loginEmail) loginEmail.value = email;
            if (loginPass) loginPass.focus();
          }
        }
      }

      // Submit Login
      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideAlert();
        const email = document.getElementById('login-email').value;
        const password = document.getElementById('login-password').value;
        const submitBtn = document.getElementById('login-submit');

        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '...'; }

        try {
          const res = await fetch('/api/auth/login-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            sessionStorage.removeItem('usgar_auth_user');
            window.location.href = redirect;
          } else {
            showAlert(data.error?.message || data.message || tErrorLogin, false);
          }
        } catch {
          showAlert(tErrorLogin, false);
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = loginSubmitLabel; }
        }
      });

      // Submit Register
      registerForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideAlert();
        const fullName = document.getElementById('reg-name').value;
        const email = document.getElementById('reg-email').value;
        const password = document.getElementById('reg-password').value;
        const submitBtn = document.getElementById('register-submit');

        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '...'; }

        try {
          const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fullName, email, password }),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            sessionStorage.removeItem('usgar_auth_user');
            window.location.href = redirect;
          } else {
            const errMsg = data.error?.message || data.message || '';
            // Si la cuenta ya existe, alternar inteligentemente a Iniciar Sesion
            if (res.status === 409 || errMsg.includes('already exists') || errMsg.includes('ya existe')) {
              showAlert(tEmailExists, false);
              setTimeout(() => { switchToSignIn(email); }, 1500);
            } else {
              showAlert(errMsg || tEmailExists, false);
            }
          }
        } catch {
          showAlert(tEmailExists, false);
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = registerSubmitLabel; }
        }
      });
      }

      // Register the persistent page-load listener exactly once per document.
      // The handler re-runs initLogin on every entry (fresh form elements).
      if (!window.__loginPageLoadBound) {
        window.__loginPageLoadBound = true;
        document.addEventListener('astro:page-load', initLogin);
      }
    })();
  </script>
</Layout>
