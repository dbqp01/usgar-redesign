---
import Layout from "../layouts/Layout.astro";
import BookingWidget from "../components/BookingWidget.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import FAQSection from "../components/FAQSection.astro";
import CuscoMap from "../components/CuscoMap.astro";
import ReviewMarquee from "../components/ReviewMarquee.astro";
import AboutSection from "../components/AboutSection.astro";
import HeritageSection from "../components/HeritageSection.astro";
import RoomsFanCarousel from "../components/RoomsFanCarousel.astro";
import GastronomySection from "../components/GastronomySection.astro";
import TypographicMarquee from "../components/TypographicMarquee.astro";
import Hero from "../components/Hero.astro";
import ExploreCarousel from "../components/ExploreCarousel.astro";
import InstagramSection from "../components/InstagramSection.astro";
import { rooms } from "../data/rooms";
import { useTranslations } from "../i18n/utils";
import faqData from "../content/faq/faq.json";
import { siteSettings } from "../data/settings";

import type { Locale } from "../i18n/utils";

const lang = (Astro.currentLocale || "en") as Locale;

const t = useTranslations(lang);

const hotelSchema = {
  "@context": "https://schema.org",
  "@type": "Hotel",
  name: siteSettings.hotelName,
  description: siteSettings.siteDescription[lang],
  image: "https://usgarhotels.com/assets/logos/Logo%20usgar%20morado.png",
  telephone: `+${siteSettings.phoneRaw}`,
  email: siteSettings.email,
  url: "https://sanpedro.hotelesusgar.com" + (lang !== "en" ? `/${lang}` : ""),
  address: {
    "@type": "PostalAddress",
    streetAddress: siteSettings.streetAddress,
    addressLocality: siteSettings.city,
    addressRegion: siteSettings.region,
    postalCode: siteSettings.postalCode,
    addressCountry: siteSettings.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: siteSettings.latitude,
    longitude: siteSettings.longitude,
  },
  starRating: {
    "@type": "Rating",
    ratingValue: String(siteSettings.starRating),
  },
  priceRange: siteSettings.priceRange,
  numberOfRooms: rooms.length,
  checkinTime: siteSettings.checkinTime,
  checkoutTime: siteSettings.checkoutTime,
  amenityFeature: [
    {
      "@type": "LocationFeatureSpecification",
      name: "Free Wi-Fi",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Breakfast Included",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Hot Water 24h",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Central Heating",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "24h Reception",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Luggage Storage",
      value: true,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqData.questions.map((faq) => ({
    "@type": "Question",
    name: (faq as any)[`question_${lang}`] || faq.question_en,
    acceptedAnswer: {
      "@type": "Answer",
      text: (faq as any)[`answer_${lang}`] || faq.answer_en,
    },
  })),
};

const schemas = [hotelSchema, faqSchema];
---

<Layout
  title={`${t("hero.title")} â€” ${siteSettings.hotelName}`}
  lang={lang}
  schema={schemas}
>
  <Hero lang={lang} />

  <!-- ==========================================
       BOOKING WIDGET
       ========================================== -->
  <BookingWidget />

  <!-- ==========================================
       TRUST MARQUEE â€” Positive Reviews Ribbon
       ========================================== -->
  <ReviewMarquee lang={lang} />

  <!-- ==========================================
       ABOUT SECTION
       ========================================== -->
  <AboutSection />

  <TypographicMarquee items={[t('global.marquee1'), t('global.marquee2'), t('global.marquee3'), t('global.marquee4')]} />

  <!-- ==========================================
       HERITAGE SECTION (Image 1 reference: Legado y Espiritualidad)
       ========================================== -->
  <HeritageSection />

  <!-- ==========================================
       INTERACTIVE ROOMS — 3D Fan Carousel
       ========================================== -->
  <RoomsFanCarousel />

  <!-- ==========================================
       GASTRONOMY SECTION (Image 3 reference: Auka Restobar / Rueda GastronÃ³mica)
       ========================================== -->
  <GastronomySection />

  <!-- ==========================================
       SERVICES SECTION
       ========================================== -->
  <ServiceGrid />

  <!-- ==========================================
       EXPLORE CUSCO PREVIEW (Cinematic Showcase)
       ========================================== -->
  <ExploreCarousel lang={lang} />

  <InstagramSection lang={lang} />

  <!-- ==========================================
       FAQ SECTION
       ========================================== -->
  <FAQSection lang={lang} />

  <!-- ==========================================
       MAP SECTION
       ========================================== -->
  <CuscoMap />

  <TypographicMarquee items={[t('global.marquee1'), t('global.marquee2'), t('global.marquee3'), t('global.marquee4')]} reverse />
</Layout>
