---
// debt: oversized module (266 LOC) — split into concept-named components when touched; ceiling 250 pure LOC
import Layout from "../layouts/Layout.astro";
import { useTranslations, type Locale } from "../i18n/utils";
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeader from "../components/ui/SectionHeader.astro";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

// Dynamically import all images
const hotelImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/hotel/**/*.jpg",
);
const roomImages = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/rooms/**/*.jpg",
);

// Resolve promises
const hotelPhotos = await Promise.all(
  Object.entries(hotelImages).map(async ([path, resolver]) => {
    const meta = (await resolver()).default;
    return { src: meta.src, metadata: meta, category: "hotel", path };
  }),
);

const roomPhotos = await Promise.all(
  Object.entries(roomImages).map(async ([path, resolver]) => {
    const meta = (await resolver()).default;
    return { src: meta.src, metadata: meta, category: "rooms", path };
  }),
);

// Combine and sort photos
const allPhotos = [...hotelPhotos, ...roomPhotos].sort((a, b) =>
  a.path.localeCompare(b.path),
);

// Optimized lightbox URLs (lightbox max display ~1024px; 1600px cubre retina)
const lightboxSrcs = (
  await Promise.all(
    allPhotos.map((photo) =>
      getImage({ src: photo.metadata, width: 1600, format: "avif", quality: "high" }),
    ),
  )
).map((img) => img.src);

// Room video tours: cada video usa como poster la primera foto de su habitación
const roomVideoSlugs = [
  ...new Set(
    roomPhotos
      .map((p) => p.path.match(/rooms\/([^/]+)\//)?.[1])
      .filter(Boolean) as string[],
  ),
];
const videoItems = roomVideoSlugs.map((slug) => ({
  slug,
  video: `/videos/rooms/${slug}.mp4`,
  poster: roomPhotos.find((p) => p.path.includes(`rooms/${slug}/`))?.metadata,
}));
// Media unificado para el lightbox: fotos (imagen) + videos (video)
type GalleryMedia = { type: "image"; src: string } | { type: "video"; src: string; poster: string };
const lightboxMedia: GalleryMedia[] = [
  ...lightboxSrcs.map((src): GalleryMedia => ({ type: "image", src })),
  ...(await Promise.all(
    videoItems.map(async (v): Promise<GalleryMedia> => ({
      type: "video",
      src: v.video,
      poster: v.poster ? (await getImage({ src: v.poster, width: 1280, format: "avif", quality: "high" })).src : "",
    })),
  )),
];
---

<Layout
  title={`${t("gallery.title")} - USGAR Hotels`}
  lang={lang}
>
  <div class="flex-1 px-4 animate-fade-in">
    <!-- Editorial Header -->
    <section class="relative overflow-hidden bg-surface-light px-4 pb-8 pt-32 transition-colors duration-500 dark:bg-surface-dark sm:pt-36">
      <div class="mx-auto max-w-[1400px]">
        <SectionHeader
          number="06"
          eyebrow={lang === "es" ? "Instalaciones y Habitaciones" : "Facilities & Accommodations"}
          title={t("gallery.title")}
          subtitle={t("gallery.subtitle")}
        />
      </div>
    </section>

    <!-- Category Filters -->
    <section class="pb-24 px-4 max-w-[1400px] mx-auto">
      <div class="flex flex-wrap justify-center gap-3 mb-10 border-b border-black/5 dark:border-white/5 pb-6">
        <button
          class="filter-btn active px-6 py-2.5 rounded-full text-sm font-semibold border-2 border-primary bg-primary text-white transition-[border-color,background-color,color,transform,box-shadow] cursor-pointer shadow-sm lg:hover:scale-105"
          data-filter="all"
        >
          {t("gallery.filterAll")}
        </button>
        <button
          class="filter-btn px-6 py-2.5 rounded-full text-sm font-semibold border-2 border-transparent text-text-secondary-light dark:text-text-secondary-dark hover:border-black/10 dark:hover:border-white/10 hover:text-primary dark:hover:text-secondary transition-[border-color,background-color,color,transform,box-shadow] cursor-pointer lg:hover:scale-105"
          data-filter="hotel"
        >
          {t("gallery.filterHotel")}
        </button>
        <button
          class="filter-btn px-6 py-2.5 rounded-full text-sm font-semibold border-2 border-transparent text-text-secondary-light dark:text-text-secondary-dark hover:border-black/10 dark:hover:border-white/10 hover:text-primary dark:hover:text-secondary transition-[border-color,background-color,color,transform,box-shadow] cursor-pointer lg:hover:scale-105"
          data-filter="rooms"
        >
          {t("gallery.filterRooms")}
        </button>
      </div>
    </section>

    <!-- Photo + Video Grid -->
    <div
      id="gallery-grid"
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5"
      data-media={JSON.stringify(lightboxMedia)}
    >
      {
        allPhotos.map((photo, index) => (
          <div
            class="gallery-item group relative aspect-[4/3] rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-[transform,opacity,box-shadow,border-color] duration-500 cursor-pointer border border-black/5 dark:border-white/5"
            data-category={photo.category}
            data-index={index}
          >
            <Picture
              src={photo.metadata}
              alt={`${t("gallery.title")} - ${index + 1}`}
              formats={["avif"]}
              fallbackFormat="avif"
              quality="high"
              fit="cover"
              loading={index < 1 ? "eager" : "lazy"}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Overlay visual -->
            <div class="absolute inset-0 bg-black/10 group-hover:bg-black/35 transition-colors duration-300 flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-[opacity,transform,background-color] duration-300 scale-90 group-hover:scale-100 p-3 rounded-full bg-white/15 backdrop-blur-md border border-white/25 shadow-md">
                <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>
            </div>
          </div>
        ))
      }
      {
        videoItems.map((video, videoIndex) => (
          <div
            class="gallery-item group relative aspect-[4/3] rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-[transform,opacity,box-shadow,border-color] duration-500 cursor-pointer border border-black/5 dark:border-white/5 bg-black"
            data-category="rooms"
            data-index={allPhotos.length + videoIndex}
          >
            {video.poster && (
              <Picture
                src={video.poster}
                alt={`${t("gallery.title")} - ${video.slug} video`}
                formats={["avif"]}
                fallbackFormat="avif"
                quality="high"
                fit="cover"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-70"
              />
            )}
            <!-- Video overlay: play icon + label -->
            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/45 transition-colors duration-300 flex flex-col items-center justify-center gap-2">
              <div class="p-4 rounded-full bg-white/15 backdrop-blur-md border border-white/25 shadow-md">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <span class="text-white text-xs font-semibold tracking-widest uppercase bg-black/40 px-3 py-1 rounded-full">
                {t("gallery.videoTour")}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Visor Modal (Lightbox) -->
    <div
      id="gallery-lightbox"
      class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 backdrop-blur-md transition-[opacity,visibility,background-color] duration-300"
    >
      <!-- Close Button -->
      <button
        id="lightbox-close-btn"
        class="absolute top-6 right-6 w-12 h-12 rounded-full bg-white/10 hover:bg-primary text-white flex items-center justify-center border border-white/10 transition-[background-color,color,transform] cursor-pointer z-50 lg:hover:scale-105"
        aria-label="Close"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Navigation Arrows -->
      <button
        id="lightbox-prev-btn"
        class="absolute left-6 w-14 h-14 rounded-full bg-white/5 hover:bg-primary text-white flex items-center justify-center border border-white/10 transition-[background-color,color,transform] cursor-pointer z-50 lg:hover:scale-105"
        aria-label="Previous"
      >
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="lightbox-next-btn"
        class="absolute right-6 w-14 h-14 rounded-full bg-white/5 hover:bg-primary text-white flex items-center justify-center border border-white/10 transition-[background-color,color,transform] cursor-pointer z-50 lg:hover:scale-105"
        aria-label="Next"
      >
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Image Slide Container -->
      <div class="relative max-w-5xl max-h-[80vh] px-4 flex items-center justify-center">
        <img
          id="lightbox-img"
          src=""
          alt="Lightbox active"
          class="max-w-full max-h-[80vh] rounded-xl object-contain shadow-2xl transition-[transform,opacity] duration-300 border border-white/5"
        />
        <video
          id="lightbox-video"
          src=""
          controls
          autoplay
          playsinline
          class="hidden max-w-full max-h-[80vh] rounded-xl shadow-2xl border border-white/5 bg-black"
        ></video>
        <!-- Counter overlay -->
        <div
          id="lightbox-counter"
          class="absolute -bottom-10 bg-white/10 backdrop-blur-md border border-white/10 px-4 py-1.5 rounded-full text-white text-xs font-semibold"
        >
          1 / 1
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let activeIndex = 0;
  let activeFilteredIndexes: number[] = [];
  let mediaList: { type: "image" | "video"; src: string; poster?: string }[] = [];
  let abortController = new AbortController();

  function initGallery() {
    abortController.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const grid = document.getElementById("gallery-grid");
    const items = document.querySelectorAll(".gallery-item");
    const filters = document.querySelectorAll(".filter-btn");

    const lightbox = document.getElementById("gallery-lightbox");
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const lightboxVideo = document.getElementById("lightbox-video") as HTMLVideoElement | null;
    const closeBtn = document.getElementById("lightbox-close-btn");
    const prevBtn = document.getElementById("lightbox-prev-btn");
    const nextBtn = document.getElementById("lightbox-next-btn");
    const counter = document.getElementById("lightbox-counter");

    if (!grid || !lightbox || !lightboxImg) return;

    // Bug D2: re-parent the lightbox to <body> at init. Inside <main> (GSAP/astro
    // transition transforms make it a stacking context) the lightbox z-[100] is
    // trapped and the fixed z-50 navbar paints above its close button. As a direct
    // body child its z-index competes in the root stacking context (MDN stacking
    // context docs). appendChild MOVES the node; fixed positioning is unaffected.
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    mediaList = JSON.parse(grid.getAttribute("data-media") || "[]");

    // Apply Filter Function
    function applyFilter(filter: string) {
      activeFilteredIndexes = [];

      items.forEach((item, index) => {
        const category = item.getAttribute("data-category");
        if (filter === "all" || category === filter) {
          item.classList.remove("hidden");
          activeFilteredIndexes.push(index);
        } else {
          item.classList.add("hidden");
        }
      });

      // Update item visual order/indices for Lightbox navigation
      items.forEach((item) => {
        const itemIdxStr = item.getAttribute("data-index");
        if (itemIdxStr) {
          const index = parseInt(itemIdxStr, 10);
          const newIdx = activeFilteredIndexes.indexOf(index);
          item.setAttribute("data-filtered-index", newIdx.toString());
        }
      });
    }

    // Initialize Default State
    applyFilter("all");

    // Click Filters
    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        filters.forEach((b) => {
          b.classList.remove("active", "bg-primary", "text-white", "border-primary");
          b.classList.add("border-transparent", "text-text-secondary-light", "dark:text-text-secondary-dark");
        });
        btn.classList.add("active", "bg-primary", "text-white", "border-primary");
        btn.classList.remove("border-transparent", "text-text-secondary-light", "dark:text-text-secondary-dark");

        const filter = btn.getAttribute("data-filter") || "all";
        applyFilter(filter);
      }, { signal });
    });

    // Lightbox Logic
    function updateLightbox() {
      if (!lightboxImg || mediaList.length === 0) return;
      const originalIdx = activeFilteredIndexes[activeIndex];
      const media = mediaList[originalIdx];
      if (!media) return;
      if (media.type === "video") {
        lightboxImg.classList.add("hidden");
        if (lightboxVideo) {
          lightboxVideo.classList.remove("hidden");
          lightboxVideo.src = media.src;
          lightboxVideo.play().catch(() => { /* autoplay blocked, acceptable */ });
        }
      } else {
        if (lightboxVideo) {
          lightboxVideo.pause();
          lightboxVideo.src = "";
          lightboxVideo.classList.add("hidden");
        }
        lightboxImg.classList.remove("hidden");
        lightboxImg.src = media.src;
      }
      if (counter) {
        counter.textContent = `${activeIndex + 1} / ${activeFilteredIndexes.length}`;
      }
    }

    function openLightbox(idx: number) {
      if (!lightbox) return;
      activeIndex = idx;
      updateLightbox();
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!lightbox) return;
      if (lightboxVideo) {
        lightboxVideo.pause();
        lightboxVideo.src = "";
        lightboxVideo.classList.add("hidden");
      }
      if (lightboxImg) lightboxImg.classList.remove("hidden");
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
    }

    function nextSlide() {
      if (activeFilteredIndexes.length === 0) return;
      activeIndex = (activeIndex + 1) % activeFilteredIndexes.length;
      updateLightbox();
    }

    function prevSlide() {
      if (activeFilteredIndexes.length === 0) return;
      activeIndex = (activeIndex - 1 + activeFilteredIndexes.length) % activeFilteredIndexes.length;
      updateLightbox();
    }

    // Clicks on Grid Items
    items.forEach((item) => {
      item.addEventListener("click", () => {
        const filteredIdxStr = item.getAttribute("data-filtered-index");
        if (filteredIdxStr) {
          openLightbox(parseInt(filteredIdxStr, 10));
        }
      }, { signal });
    });

    closeBtn?.addEventListener("click", closeLightbox, { signal });
    nextBtn?.addEventListener("click", nextSlide, { signal });
    prevBtn?.addEventListener("click", prevSlide, { signal });

    // Keyboard Events
    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (!lightbox || lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      else if (e.key === "ArrowRight") nextSlide();
      else if (e.key === "ArrowLeft") prevSlide();
    }, { signal });
  }

  document.addEventListener("astro:page-load", initGallery);
</script>
