---
// debt: oversized module (453 LOC @2026-08-12) — split into concept-named components when touched; ceiling 250 pure LOC
import Layout from '../../layouts/Layout.astro';
import { rooms } from '../../data/rooms';
import { useTranslations, type Locale } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

export const prerender = true;

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<Layout title={`${t('success.title')} - USGAR Hotels`} lang={lang}>
  <div class="py-24 px-4 max-w-3xl mx-auto flex-1 print:py-10">
    
    <!-- 1. Loading State Spinner -->
    <div id="loading-container" class="py-20 text-center space-y-4">
      <div class="inline-block animate-spin h-10 w-10 border-4 border-primary border-t-transparent rounded-full"></div>
      <p class="text-text-secondary-light dark:text-text-secondary-dark text-sm animate-pulse">
        {t('success.retrieving')}
      </p>
      <p id="polling-status" class="text-text-secondary-light dark:text-text-secondary-dark text-xs hidden">
      </p>
    </div>

    <!-- 2. Success Details Card (Hidden by default, shown client-side) -->
    <div id="success-container" class="hidden space-y-8 animate-fade-in">
      <!-- Success Banner Card -->
      <div class="bg-surface-card-light dark:bg-surface-card-dark p-8 rounded-3xl border border-black/5 dark:border-white/5 shadow-2xl text-center space-y-4 print:shadow-none print:border-none print:p-0">
        
        <!-- Animated success check icon -->
        <div class="mx-auto w-20 h-20 rounded-full bg-green-500/10 dark:bg-green-500/15 text-green-500 flex items-center justify-center border border-green-500/20 shadow-inner print:w-12 print:h-12">
          <svg class="w-10 h-10 print:w-6 print:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <div>
          <span class="text-xs font-semibold text-green-600 dark:text-green-400 uppercase tracking-widest">
            {t('success.paymentApproved')}
          </span>
          <h1 class="font-display text-4xl md:text-5xl mt-2 mb-3">
            {t('success.reservationConfirmed')}
          </h1>
          <p class="text-text-secondary-light dark:text-text-secondary-dark text-sm max-w-md mx-auto print:text-xs">
            {t('success.confirmationMessage')}
          </p>
        </div>

        <!-- Highlighted Confirmation Code -->
        <div class="inline-block bg-stone-50 dark:bg-stone-900 border border-black/5 dark:border-white/5 px-6 py-4 rounded-2xl print:bg-stone-100">
          <span class="block text-[10px] uppercase tracking-widest text-text-secondary-light dark:text-text-secondary-dark">
            {t('success.confirmationCode')}
          </span>
          <span id="success-conf-code" class="font-mono text-xl md:text-2xl font-bold text-primary select-all">
            ---
          </span>
        </div>
      </div>

      <!-- Details Receipt Card -->
      <div class="bg-surface-card-light dark:bg-surface-card-dark p-8 rounded-3xl border border-black/5 dark:border-white/5 shadow-lg space-y-6 print:shadow-none print:border-none print:p-0">
        <h2 class="font-display text-2xl border-b border-black/5 dark:border-white/5 pb-3">
          {t('success.bookingDetails')}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
          <!-- Guest details -->
          <div class="space-y-1">
            <span class="text-xs uppercase font-semibold text-text-secondary-light dark:text-text-secondary-dark tracking-wider">{t('success.primaryGuest')}</span>
            <p id="success-guest-name" class="font-bold text-text-primary-light dark:text-text-primary-dark">---</p>
            <p id="success-guest-email" class="text-text-secondary-light dark:text-text-secondary-dark">---</p>
            <p id="success-guest-phone" class="text-text-secondary-light dark:text-text-secondary-dark">---</p>
          </div>

          <!-- Stay Info -->
          <div class="space-y-1">
            <span class="text-xs uppercase font-semibold text-text-secondary-light dark:text-text-secondary-dark tracking-wider">{t('success.roomType')}</span>
            <p id="success-room-name" class="font-bold text-text-primary-light dark:text-text-primary-dark">---</p>
            <p id="success-guests-text" class="text-text-secondary-light dark:text-text-secondary-dark">---</p>
          </div>
        </div>

        <!-- Calendar Dates Summary Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-b border-black/5 dark:border-white/5 py-5">
          <div class="p-4 rounded-2xl bg-stone-50 dark:bg-stone-900 border border-black/5 dark:border-white/5">
            <span class="block text-[10px] uppercase font-semibold text-text-secondary-light dark:text-text-secondary-dark tracking-widest mb-1">{t('success.checkinDate')}</span>
            <p id="success-checkin" class="font-semibold text-sm">---</p>
            <span class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5 block">Desde/From 11:00 AM</span>
          </div>

          <div class="p-4 rounded-2xl bg-stone-50 dark:bg-stone-900 border border-black/5 dark:border-white/5">
            <span class="block text-[10px] uppercase font-semibold text-text-secondary-light dark:text-text-secondary-dark tracking-widest mb-1">{t('success.checkoutDate')}</span>
            <p id="success-checkout" class="font-semibold text-sm">---</p>
            <span class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5 block">Hasta/To 10:00 AM</span>
          </div>
        </div>

        <!-- Pricing summary -->
        <div class="flex items-center justify-between">
          <div class="space-y-1">
            <span class="text-xs uppercase font-semibold text-text-secondary-light dark:text-text-secondary-dark tracking-wider">{t('success.billingDetail')}</span>
            <p id="success-billing-nights" class="text-text-secondary-light dark:text-text-secondary-dark">---</p>
          </div>
          <div class="text-right">
            <span class="block text-xs uppercase font-semibold text-text-secondary-light dark:text-text-secondary-dark tracking-wider">{t('success.totalPaid')}</span>
            <p class="font-display text-3xl font-bold text-primary"><span id="success-currency-symbol">$</span> <span id="success-total-price">0</span> <span id="success-currency-code">USD</span></p>
          </div>
        </div>
      </div>

      <!-- Buttons Toolbar (Hidden when printing) -->
      <div class="flex flex-col sm:flex-row gap-4 justify-between items-center pt-4 print:hidden">
        <a
          href={getRelativeLocaleUrl(lang, '')}
          class="text-text-secondary-light dark:text-text-secondary-dark hover:text-primary dark:hover:text-primary font-semibold text-sm transition-colors duration-200"
        >
          &larr; {t('success.returnHome')}
        </a>

        <div class="flex gap-4 w-full sm:w-auto">
          <!-- Print Button -->
          <button
            type="button"
            onclick="window.print()"
            class="w-full sm:w-auto bg-stone-100 hover:bg-stone-200 dark:bg-stone-800 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 font-semibold py-3 px-6 rounded-xl transition-[background-color,color,border-color] duration-200 text-sm flex items-center justify-center gap-2 cursor-pointer border border-black/5 dark:border-white/5 shadow-sm"
          >
            <span>️ {t('success.printReceipt')}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 3. Pending State Card (payment still being verified) -->
    <div id="pending-container" class="hidden bg-surface-card-light dark:bg-surface-card-dark p-12 rounded-3xl border border-black/5 dark:border-white/5 shadow-2xl text-center space-y-6 animate-fade-in">
      <div class="mx-auto w-16 h-16 rounded-full bg-amber-500/10 dark:bg-amber-500/15 text-amber-500 flex items-center justify-center border border-amber-500/20 shadow-inner">
        <svg class="w-8 h-8 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h1 class="font-display text-3xl mb-2">
          {t('success.paymentPending')}
        </h1>
        <p class="text-text-secondary-light dark:text-text-secondary-dark text-sm max-w-md mx-auto">
          {t('success.verifyingPaymentMessage')}
        </p>
        <p id="pending-retry-status" class="text-text-secondary-light dark:text-text-secondary-dark text-xs mt-3">
          {t('success.verifyingPayment')}...
        </p>
      </div>
      <button
        type="button"
        data-verify-again
        class="inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold uppercase tracking-wider bg-primary hover:bg-primary-dark text-white transition-[background-color,color,box-shadow] duration-300 hover:shadow-lg hover:shadow-primary/25 cursor-pointer"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5.1 9a7 7 0 0111.9-3M18.9 15a7 7 0 01-11.9 3" />
        </svg>
        {t('success.verifyAgain')}
      </button>
      <a
        href={getRelativeLocaleUrl(lang, '')}
        class="inline-block text-text-secondary-light dark:text-text-secondary-dark hover:text-primary dark:hover:text-primary font-semibold text-sm transition-colors duration-200"
      >
        &larr; {t('success.returnHome')}
      </a>
    </div>

    <!-- 4. Error State Card (Hidden by default, shown client-side) -->
    <div id="error-container" class="hidden bg-surface-card-light dark:bg-surface-card-dark p-12 rounded-3xl border border-black/5 dark:border-white/5 shadow-2xl text-center space-y-6 animate-fade-in">
      <div class="mx-auto w-16 h-16 rounded-full bg-red-500/10 dark:bg-red-500/15 text-red-500 flex items-center justify-center border border-red-500/20 shadow-inner">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h1 id="error-title" class="font-display text-3xl mb-2">
          {t('success.notFound')}
        </h1>
        <p id="error-message-text" class="text-text-secondary-light dark:text-text-secondary-dark text-sm max-w-md mx-auto">
          {t('success.notFoundMessage')}
        </p>
      </div>
      <a
        href={getRelativeLocaleUrl(lang, '')}
        class="inline-block bg-primary hover:bg-primary-dark text-white font-semibold py-3 px-6 rounded-xl transition-[background-color,color,box-shadow] duration-300 hover:shadow-lg hover:shadow-primary/25 text-sm"
      >
        {t('success.returnHome')}
      </a>
    </div>

  </div>
</Layout>

<!-- Serialize rooms data into browser context -->
<script is:inline data-astro-rerun define:vars={{ 
  serializedRooms: JSON.stringify(rooms.map(r => ({ id: r.id, slug: r.slug, name: r.name, pricePerNight: r.pricePerNight }))),
  singleGuest: t('success.singleGuest'),
  pluralGuest: t('success.pluralGuest'),
  singleNight: t('success.singleNight'),
  pluralNight: t('success.pluralNight'),
  pluralRooms: t('success.pluralRooms'),
  pollingMsg: t('success.polling'),
  pendingStatusMsg: t('success.verifyingPayment'),
  verifyAgainMsg: t('success.verifyAgain'),
  inReviewMsg: t('success.inReview'),
  paymentExpiredTitle: t('success.paymentExpired'),
  paymentExpiredMsg: t('success.paymentExpiredMessage'),
  paymentRejectedTitle: t('success.paymentRejected'),
  paymentRejectedMsg: t('success.paymentRejectedMessage'),
  manualReviewMsg: t('success.manualReviewMessage'),
  retryCooldownMsg: t('success.retryCooldownMessage')
}}>
  window.__ROOMS_DATA = JSON.parse(serializedRooms);
  window.__I18N_DATA = { singleGuest, pluralGuest, singleNight, pluralNight, pluralRooms, pollingMsg, pendingStatusMsg, verifyAgainMsg, inReviewMsg, paymentExpiredTitle, paymentExpiredMsg, paymentRejectedTitle, paymentRejectedMsg, manualReviewMsg, retryCooldownMsg };
</script>

<script>
  import { mapBookingStatus, isPendingStatus, pendingMessageKey } from '../../utils/paymentStatus';
  import { formatDate } from '../../utils/format';

  // Todo 27: polling continuo cada 15s hasta 10 minutos (el polling anterior
  // moria ~88s y dejaba la tarjeta pending terminal) + boton manual
  // "Verificar de nuevo" + fraud_review/manual_review como pendiente con
  // mensaje "en revision" + expired_paid como pagado (enum nuevo de W2).
  const POLL_INTERVAL_MS = 15000;
  const MAX_POLL_ATTEMPTS = 40; // 15s x 40 = 10 min

  let pollingAbortController: AbortController | null = null;

  /** Fetch booking status with optional token for guest data access */
  async function fetchBookingStatus(bookingId: string, token: string, signal?: AbortSignal): Promise<any> {
    const API_BASE_URL = (import.meta.env.PUBLIC_API_URL || window.location.origin + '/api').replace(/\/$/, '');
    const tokenParam = token ? `&token=${encodeURIComponent(token)}` : '';
    const response = await fetch(`${API_BASE_URL}/booking-status?cart_id=${bookingId}${tokenParam}`, { signal });
    if (!response.ok) throw new Error('BOOKING_STATUS_ERROR');
    const payload = await response.json();
    return payload.data || payload;
  }

  function wait(ms: number, signal: AbortSignal): Promise<void> {
    return new Promise((resolve, reject) => {
      const timeout = setTimeout(resolve, ms);
      signal.addEventListener('abort', () => {
        clearTimeout(timeout);
        reject(new Error('Aborted'));
      });
    });
  }

  /** Poll hasta que el status deja de ser pendiente (intervalo fijo 15s). */
  async function pollForPayment(bookingId: string, token: string, signal: AbortSignal): Promise<any> {
    const pollingStatus = document.getElementById('polling-status');
    let last: any = null;

    for (let attempt = 0; attempt < MAX_POLL_ATTEMPTS; attempt++) {
      if (signal.aborted) throw new Error('Aborted');
      const booking = await fetchBookingStatus(bookingId, token, signal);
      last = booking;

      // Si el status ya no es pendiente, devolver inmediatamente.
      if (booking.status && !isPendingStatus(booking.status)) {
        return booking;
      }

      // Mostrar polling status tras el primer intento.
      if (attempt > 0 && pollingStatus) {
        const L = (window as any).__I18N_DATA || {};
        pollingStatus.classList.remove('hidden');
        pollingStatus.textContent = L.pollingMsg || '';
      }

      await wait(POLL_INTERVAL_MS, signal);
    }

    // Tras 10 min, devolver el ultimo estado conocido (la UI decide).
    return last;
  }

  async function loadSuccessPage() {
    if ((window as any).__successPageInitialized) return;
    (window as any).__successPageInitialized = true;

    type Locale = 'en' | 'es' | 'fr' | 'pt';
    const rawLang = (document.documentElement.lang || 'en') as Locale;
    const lang: Locale = ['en', 'es', 'fr', 'pt'].includes(rawLang) ? rawLang : 'en';
    const ROOMS_DATA = (window as any).__ROOMS_DATA || [];
    const L = (window as any).__I18N_DATA || {};

    const loadingContainer = document.getElementById('loading-container');
    const successContainer = document.getElementById('success-container');
    const pendingContainer = document.getElementById('pending-container');
    const errorContainer = document.getElementById('error-container');
    const verifyAgainBtn = document.querySelector('[data-verify-again]') as HTMLButtonElement | null;
    const pendingStatus = document.getElementById('pending-retry-status');
    const errorTitle = document.getElementById('error-title');
    const errorMsgText = document.getElementById('error-message-text');

    const params = new URLSearchParams(window.location.search);
    const bookingId = params.get('bookingId') || params.get('booking') || params.get('external_reference') || '';
    // Retrieve access token from URL, sessionStorage, or empty
    const token = params.get('token')
      || sessionStorage.getItem(`booking_token_${bookingId}`)
      || '';

    if (!bookingId) {
      loadingContainer?.classList.add('hidden');
      errorContainer?.classList.remove('hidden');
      return;
    }

    // Render compartido: lo usa el polling inicial y el boton "Verificar de nuevo".
    async function renderBooking(booking: any): Promise<void> {
      if (!booking || !booking.id_room_type) throw new Error('Data mismatch');

      const status = booking.status || '';
      const ui = mapBookingStatus(status);

      if (ui === 'paid') {
        // paid/approved/expired_paid -> tarjeta de exito.
        const room = ROOMS_DATA.find((r: any) => r.id === booking.id_room_type || r.slug === booking.id_room_type);

        const currency = booking.currency || 'USD';
        const currencySymbol = currency === 'PEN' ? 'S/.' : '$';

        const confCodeEl = document.getElementById('success-conf-code');
        const guestNameEl = document.getElementById('success-guest-name');
        const guestEmailEl = document.getElementById('success-guest-email');
        const guestPhoneEl = document.getElementById('success-guest-phone');
        const roomNameEl = document.getElementById('success-room-name');
        const guestsTextEl = document.getElementById('success-guests-text');
        const checkinEl = document.getElementById('success-checkin');
        const checkoutEl = document.getElementById('success-checkout');
        const billingNightsEl = document.getElementById('success-billing-nights');
        const totalPriceEl = document.getElementById('success-total-price');
        const currencySymbolEl = document.getElementById('success-currency-symbol');
        const currencyCodeEl = document.getElementById('success-currency-code');

        if (confCodeEl) confCodeEl.textContent = booking.cart_id || booking.id || bookingId;
        if (guestNameEl) guestNameEl.textContent = booking.guest_name || booking.guestName || '---';
        if (guestEmailEl) guestEmailEl.textContent = booking.guest_email || booking.guestEmail || '---';
        if (guestPhoneEl) guestPhoneEl.textContent = booking.guest_phone || booking.guestPhone || '---';
        if (roomNameEl) {
          // Multi-room (2026-08-12): room_summary lista todas las habitaciones.
          const summary = Array.isArray(booking.room_summary) ? booking.room_summary : null;
          if (summary && summary.length > 1) {
            roomNameEl.textContent = summary.map((r: any) => r.room_name || 'Room').join(' + ');
          } else {
            roomNameEl.textContent = booking.room_name || (room ? (room.name[lang] || room.name.en) : '---');
          }
        }

        if (guestsTextEl) {
          const guests = booking.guests || 2;
          guestsTextEl.textContent = guests === 1
            ? L.singleGuest || '1 Guest'
            : `${guests} ${L.pluralGuest || 'Guests'}`;
        }

        if (checkinEl) checkinEl.textContent = formatDate(booking.checkin || booking.checkIn, lang);
        if (checkoutEl) checkoutEl.textContent = formatDate(booking.checkout || booking.checkOut, lang);

        if (billingNightsEl) {
          const nights = booking.nights || 1;
          const summary = Array.isArray(booking.room_summary) ? booking.room_summary : null;
          if (summary && summary.length > 1) {
            // Multi-room: el desglose por noche solo refleja la habitacion
            // principal — mostrar cantidad de habitaciones + noches.
            billingNightsEl.textContent = `${summary.length} ${L.pluralRooms || 'Rooms'} · ${nights} ${nights === 1 ? (L.singleNight || 'night') : (L.pluralNight || 'nights')}`;
          } else {
            const priceNight = booking.price_per_night || (room ? room.pricePerNight : 0);
            billingNightsEl.textContent = nights === 1
              ? `1 ${L.singleNight || 'night'} x ${currencySymbol} ${priceNight} ${currency}`
              : `${nights} ${L.pluralNight || 'nights'} x ${currencySymbol} ${priceNight} ${currency}`;
          }
        }

        if (totalPriceEl) totalPriceEl.textContent = (booking.price || booking.totalPrice || 0).toString();
        if (currencySymbolEl) currencySymbolEl.textContent = currencySymbol;
        if (currencyCodeEl) currencyCodeEl.textContent = currency;

        loadingContainer?.classList.add('hidden');
        pendingContainer?.classList.add('hidden');
        errorContainer?.classList.add('hidden');
        successContainer?.classList.remove('hidden');
        return;
      }

      if (ui === 'pending') {
        // pending/manual_review/fraud_review -> tarjeta pendiente con mensaje
        // especifico ("en revision" para revisiones manuales/fraude).
        if (pendingStatus) {
          const key = pendingMessageKey(status);
          pendingStatus.textContent = key === 'success.inReview' ? (L.inReviewMsg || '') : ((L.pendingStatusMsg || '') + '...');
        }
        loadingContainer?.classList.add('hidden');
        successContainer?.classList.add('hidden');
        errorContainer?.classList.add('hidden');
        pendingContainer?.classList.remove('hidden');
        return;
      }

      // error: expired muestra estado correcto; failed/rejected/cancelled ->
      // pago rechazado (fix 2026-08-13: antes el webhook de rechazo dejaba
      // el hold pending hasta el TTL y la UI mostraba 'expired' en vez de
      // 'rejected'); el resto, reserva no encontrada.
      if (errorTitle && status === 'expired') errorTitle.textContent = L.paymentExpiredTitle || '';
      if (errorMsgText && status === 'expired') errorMsgText.textContent = L.paymentExpiredMsg || '';
      if (errorTitle && (status === 'failed' || status === 'rejected' || status === 'cancelled')) {
        errorTitle.textContent = L.paymentRejectedTitle || '';
      }
      if (errorMsgText && (status === 'failed' || status === 'rejected' || status === 'cancelled')) {
        errorMsgText.textContent = L.paymentRejectedMsg || '';
      }
      loadingContainer?.classList.add('hidden');
      successContainer?.classList.add('hidden');
      pendingContainer?.classList.add('hidden');
      errorContainer?.classList.remove('hidden');
    }

    // Boton manual "Verificar de nuevo": consulta inmediata sin esperar al poll.
    if (verifyAgainBtn) {
      verifyAgainBtn.addEventListener('click', async () => {
        if (verifyAgainBtn.disabled) return;
        verifyAgainBtn.disabled = true;
        if (pendingStatus) pendingStatus.textContent = L.verifyingPaymentMsg || (L.pendingStatusMsg || '') + '...';
        try {
          const booking = await fetchBookingStatus(bookingId, token);
          await renderBooking(booking);
        } catch (err) {
          console.error('[Success Page Verify Again]', err);
          if (pendingStatus) pendingStatus.textContent = L.verifyingPaymentMsg || (L.pendingStatusMsg || '') + '...';
        } finally {
          verifyAgainBtn.disabled = false;
        }
      });
    }

    try {
      pollingAbortController = new AbortController();
      // Poll para la confirmacion del pago (maneja la carrera del webhook).
      const booking = await pollForPayment(bookingId, token, pollingAbortController.signal);
      await renderBooking(booking);
    } catch (err) {
      console.error('[Success Page Error]', err);
      loadingContainer?.classList.add('hidden');
      errorContainer?.classList.remove('hidden');
    }
  }

  document.addEventListener('astro:page-load', loadSuccessPage);

  document.addEventListener('astro:before-preparation', () => {
    (window as any).__successPageInitialized = false;
    if (pollingAbortController) {
      pollingAbortController.abort();
      pollingAbortController = null;
    }
    delete (window as any).__ROOMS_DATA;
    delete (window as any).__I18N_DATA;
  });
</script>
