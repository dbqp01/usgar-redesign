---
import Layout from "../layouts/Layout.astro";
import LocationMap from "../components/LocationMap.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ContactChannels from "../components/contact/ContactChannels.astro";
import ContactTravelGuide from "../components/contact/ContactTravelGuide.astro";
import { Image } from "astro:assets";
import patioImg from "../assets/hotel/hero-slide-patio.jpg";
import { useTranslations, type Locale } from "../i18n/utils";
import { siteSettings } from "../data/settings";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `${t("contact.title")} - USGAR Hotels`,
  description: t("contact.subtitle"),
  url: `https://usgarhoteles.com/${lang !== "en" ? lang + "/" : ""}contact`,
  mainEntity: {
    "@type": "Hotel",
    name: siteSettings.hotelName,
    telephone: `+${siteSettings.phoneRaw}`,
    email: siteSettings.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: siteSettings.streetAddress,
      addressLocality: siteSettings.city,
      addressRegion: siteSettings.region,
      postalCode: siteSettings.postalCode,
      addressCountry: siteSettings.country,
    },
  },
};
---

<Layout
  title={`${t("contact.title")} - USGAR Hotels`}
  lang={lang}
  schema={contactSchema}
>
  <!-- Hero editorial: titulo display + CTAs directos + fotografia del patio -->
  <section
    class="relative pt-20 lg:pt-24 pb-16 md:pb-24 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500"
  >
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
      <div class="lg:col-span-7 relative z-10">
        <!-- Direccion como kicker editorial -->
        <p
          class="mb-5 text-[11px] font-semibold uppercase tracking-[0.18em] text-tertiary dark:text-mint flex items-center gap-2.5"
        >
          <span class="inline-block w-8 h-px bg-secondary"></span>
          {siteSettings.streetAddress}, {siteSettings.city}
        </p>

        <h1
          class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-text-primary-light dark:text-white leading-[1.1] mb-6"
        >
          {t("contact.title")}
        </h1>

        <p
          class="text-base sm:text-lg text-text-secondary-light dark:text-text-secondary-dark max-w-xl font-body font-light leading-relaxed mb-9"
        >
          {t("contact.subtitle")}
        </p>

        <!-- CTAs directos: WhatsApp con numero real + llamada a recepcion -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(t("contact.whatsappQuery"))}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-whatsapp text-stone-950 font-bold text-sm px-6 py-3.5 rounded-lg transition-[background-color,transform] duration-300 hover:bg-whatsapp/90 lg:hover:-translate-y-0.5 group"
          >
            <svg
              class="w-4.5 h-4.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            <span>{t("contact.whatsappDirect")}</span>
            <span class="font-mono text-xs opacity-70">+{siteSettings.phoneRaw}</span>
            <svg
              class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href={`tel:+${siteSettings.phoneRaw}`}
            class="inline-flex items-center gap-2 text-sm font-semibold text-text-primary-light dark:text-white hover:text-secondary transition-colors duration-300 group"
          >
            <svg
              class="w-4 h-4 text-secondary group-hover:rotate-12 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <span>{t("contact.callText")}</span>
            <span class="font-mono text-xs">{siteSettings.phone}</span>
          </a>
        </div>
      </div>

      <!-- Ancla visual editorial: patio del hotel -->
      <div class="lg:col-span-5 relative">
        <div
          class="hidden lg:block absolute -top-4 -left-4 w-full h-full border border-secondary/40 pointer-events-none"
          aria-hidden="true"
        ></div>
        <div class="relative aspect-[4/5] overflow-hidden">
          <Image
            src={patioImg}
            alt={t("contact.heroImageAlt")}
            width={720}
            height={900}
            fit="cover"
            layout="constrained"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
        <p
          class="mt-4 font-display text-lg text-primary dark:text-secondary flex items-baseline gap-3"
        >
          {t("contact.heroImageCaption")}
        </p>
      </div>
    </div>
  </section>

  <!-- Formulario + canales directos + guia de viaje -->
  <section class="pb-24 px-4 max-w-7xl mx-auto animate-on-scroll">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-start">
      <ContactForm />

      <!-- Columna derecha: canales directos y guia de llegada -->
      <div class="lg:col-span-7">
        <ContactChannels />
        <ContactTravelGuide />
      </div>
    </div>
  </section>

  <!-- FAQ: acordeon editorial sobre hairline, sin glass -->
  <section class="pb-24 px-4 max-w-4xl mx-auto">
    <h2
      class="font-display text-3xl sm:text-4xl text-text-primary-light dark:text-white font-bold"
    >
      {t("contact.faqTitle")}
    </h2>

    <div
      class="mt-8 divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10"
    >
      <details class="group py-5 cursor-pointer">
        <summary
          class="flex justify-between items-center gap-4 font-semibold text-sm sm:text-base text-text-primary-light dark:text-white list-none select-none"
        >
          <span>{t("contact.faqLuggageQ")}</span>
          <svg
            class="w-5 h-5 text-secondary group-open:rotate-180 transition-transform duration-300 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p
          class="mt-3 text-xs sm:text-sm text-text-secondary-light dark:text-text-secondary-dark leading-relaxed pr-8 max-w-2xl"
        >
          {t("contact.faqLuggageA")}
        </p>
      </details>

      <details class="group py-5 cursor-pointer">
        <summary
          class="flex justify-between items-center gap-4 font-semibold text-sm sm:text-base text-text-primary-light dark:text-white list-none select-none"
        >
          <span>{t("contact.faqOxygenQ")}</span>
          <svg
            class="w-5 h-5 text-secondary group-open:rotate-180 transition-transform duration-300 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p
          class="mt-3 text-xs sm:text-sm text-text-secondary-light dark:text-text-secondary-dark leading-relaxed pr-8 max-w-2xl"
        >
          {t("contact.faqOxygenA")}
        </p>
      </details>

      <details class="group py-5 cursor-pointer">
        <summary
          class="flex justify-between items-center gap-4 font-semibold text-sm sm:text-base text-text-primary-light dark:text-white list-none select-none"
        >
          <span>{t("contact.faqTransferQ")}</span>
          <svg
            class="w-5 h-5 text-secondary group-open:rotate-180 transition-transform duration-300 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p
          class="mt-3 text-xs sm:text-sm text-text-secondary-light dark:text-text-secondary-dark leading-relaxed pr-8 max-w-2xl"
        >
          {t("contact.faqTransferA")}
        </p>
      </details>
    </div>
  </section>

  <!-- Leaflet Map Section -->
  <LocationMap />
</Layout>
