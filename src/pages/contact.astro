---
import Layout from "../layouts/Layout.astro";
import MapSection from "../components/MapSection.astro";
import { useTranslations, type Locale } from "../i18n/utils";
import { siteSettings } from "../data/settings";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `${t("contact.title")} — USGAR Hotels`,
  description: t("contact.subtitle"),
  url: `https://hotelesusgar.com/${lang !== "en" ? lang + "/" : ""}contact`,
  mainEntity: {
    "@type": "Hotel",
    name: siteSettings.hotelName,
    telephone: `+${siteSettings.phoneRaw}`,
    email: siteSettings.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: siteSettings.streetAddress,
      addressLocality: siteSettings.city,
      addressRegion: siteSettings.region,
      postalCode: siteSettings.postalCode,
      addressCountry: siteSettings.country,
    },
  },
};
---

<Layout
  title={`${t("contact.title")} — USGAR Hotels`}
  lang={lang}
  schema={contactSchema}
>
  <!-- Hero Section with Ambient Light & Micro-Badges -->
  <section
    class="relative pt-32 pb-16 md:pt-40 md:pb-24 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500 overflow-hidden"
  >
    <!-- Ambient Light Glow Spheres -->
    <div
      class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-primary/15 dark:bg-primary-light/10 rounded-full blur-[100px] opacity-20 pointer-events-none"
    >
    </div>

    <div class="max-w-4xl mx-auto text-center relative z-10 animate-fade-in">
      <span class="tag-architectural mb-4 inline-flex">
        <svg
          class="w-3.5 h-3.5 text-secondary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {t("contact.sectionTag")}
      </span>

      <h1
        class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-text-primary-light dark:text-white leading-[1.1] mb-6"
      >
        {t("contact.title")}
      </h1>

      <p
        class="text-base sm:text-lg md:text-xl text-text-secondary-light dark:text-text-secondary-dark max-w-2xl mx-auto font-body font-light leading-relaxed mb-8"
      >
        {t("contact.subtitle")}
      </p>

      <!-- Quick Action Chips -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(t("contact.whatsappQuery"))}`}
          target="_blank"
          rel="noopener noreferrer"
          class="glass px-4 py-2.5 rounded-full text-xs font-semibold flex items-center gap-2 text-text-primary-light dark:text-white hover:border-[#2DB5A0]/40 transition-[border-color,transform,box-shadow] duration-300 group shadow-sm lg:hover:scale-105"
        >
          <span class="w-2 h-2 rounded-full bg-[#2DB5A0] animate-pulse"></span>
          <span>WhatsApp Direct</span>
          <svg
            class="w-3.5 h-3.5 text-[#2DB5A0] group-hover:translate-x-0.5 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href={`tel:+${siteSettings.phoneRaw}`}
          class="glass px-4 py-2.5 rounded-full text-xs font-semibold flex items-center gap-2 text-text-primary-light dark:text-white hover:border-secondary/40 transition-[border-color,transform,box-shadow] duration-300 group shadow-sm lg:hover:scale-105"
        >
          <svg
            class="w-3.5 h-3.5 text-secondary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span>{t("contact.receptionTitle")}</span>
        </a>

        <div
          class="glass px-4 py-2.5 rounded-full text-xs font-semibold text-text-secondary-light dark:text-purple-pastel flex items-center gap-1.5 shadow-sm"
        >
          <svg
            class="w-3.5 h-3.5 text-primary-light dark:text-purple-pastel"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>{t("contact.checkinCheckoutTitle")}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Interactive Glass Grid -->
  <section class="pb-24 px-4 max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Support Form Glass Card (5 cols) -->
      <div
        class="lg:col-span-5 glass p-6 sm:p-8 rounded-3xl border border-black/5 dark:border-white/10 shadow-xl space-y-6 animate-on-scroll glow-card-hover"
      >
        <div class="border-b border-black/5 dark:border-white/10 pb-4">
          <span class="tag-dash-title block mb-1"
            >{t("contact.getInTouch")}</span
          >
          <h2
            class="font-display text-2xl sm:text-3xl text-primary dark:text-secondary font-bold"
          >
            {t("contact.getInTouch")}
          </h2>
        </div>

        <form id="contact-form" class="space-y-4">
          <!-- Name -->
          <div>
            <label
              for="contact-name"
              class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
            >
              {t("contact.formName")} *
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="e.g. Alexander Humboldt"
              class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
            />
          </div>

          <!-- Email -->
          <div>
            <label
              for="contact-email"
              class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
            >
              {t("contact.formEmail")} *
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="e.g. alexander@example.com"
              class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400"
            />
          </div>

          <!-- Subject Category -->
          <div>
            <label
              for="contact-subject"
              class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
            >
              {t("contact.formSubject")}
            </label>
            <select
              id="contact-subject"
              name="subject"
              class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] cursor-pointer"
            >
              <option value="general">{t("contact.subjectGeneral")}</option>
              <option value="booking">{t("contact.subjectBooking")}</option>
              <option value="transfer">{t("contact.subjectTransfer")}</option>
              <option value="acclimatization"
                >{t("contact.subjectAcclimatization")}</option
              >
            </select>
          </div>

          <!-- Message -->
          <div>
            <label
              for="contact-message"
              class="block text-xs font-semibold uppercase tracking-wider text-text-secondary-light dark:text-purple-pastel mb-2"
            >
              {t("contact.formMessage")} *
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              placeholder={t("contact.messagePlaceholder")}
              class="w-full px-4 py-3.5 rounded-xl bg-white/70 dark:bg-stone-900/60 border border-black/10 dark:border-white/10 text-sm text-text-primary-light dark:text-text-primary-dark focus:ring-2 focus:ring-secondary focus:border-transparent outline-none transition-[border-color,box-shadow] placeholder:text-stone-400 resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="btn-contact-submit"
            class="w-full bg-primary hover:bg-primary-dark text-white dark:bg-secondary dark:hover:bg-secondary-dark dark:text-stone-950 font-bold py-4 rounded-xl transition-[transform,background-color,color,box-shadow] duration-300 hover:shadow-lg hover:shadow-primary/20 lg:hover:-translate-y-0.5 text-xs sm:text-sm uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2"
          >
            <span>{t("contact.formSubmit")}</span>
            <!-- Spinner -->
            <svg
              id="contact-spinner"
              class="hidden animate-spin h-5 w-5 text-current"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </button>

          <!-- Success Message -->
          <div
            id="contact-success"
            class="hidden p-4 rounded-xl bg-[#2DB5A0]/10 border border-[#2DB5A0]/30 text-[#1F9484] dark:text-[#4ECBB8] text-xs leading-relaxed flex items-start gap-2.5"
          >
            <svg
              class="w-5 h-5 text-[#2DB5A0] flex-shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="3"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{t("contact.successMessage")}</span>
          </div>
        </form>
      </div>

      <!-- Right Column: Direct Channels & Cusco Travel Hub (7 cols) -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Channels Glass Section -->
        <div
          class="glass p-6 sm:p-8 rounded-3xl border border-black/5 dark:border-white/10 shadow-xl space-y-6 animate-on-scroll"
        >
          <div class="border-b border-black/5 dark:border-white/10 pb-3">
            <span class="tag-dash-title block mb-1"
              >{t("contact.directChannels")}</span
            >
            <h3
              class="font-display text-2xl text-text-primary-light dark:text-white font-bold"
            >
              {t("contact.directChannels")}
            </h3>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- WhatsApp -->
            <a
              href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(t("contact.whatsappQuery"))}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-900/50 border border-black/5 dark:border-white/5 hover:border-[#2DB5A0]/40 hover:bg-[#2DB5A0]/5 transition-[border-color,background-color] duration-300 group"
            >
              <div
                class="w-12 h-12 rounded-xl bg-[#2DB5A0]/15 text-[#2DB5A0] flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                  ></path>
                </svg>
              </div>
              <div>
                <h4
                  class="font-semibold text-xs sm:text-sm text-text-primary-light dark:text-white"
                >
                  {t("contact.whatsappText")}
                </h4>
                <p
                  class="text-xs text-text-secondary-light dark:text-purple-pastel mt-0.5 font-mono"
                >
                  {siteSettings.phone}
                </p>
              </div>
            </a>

            <!-- Email -->
            <a
              href={`mailto:${siteSettings.email}`}
              class="flex items-center gap-4 p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-900/50 border border-black/5 dark:border-white/5 hover:border-primary/40 hover:bg-primary/5 transition-[border-color,background-color] duration-300 group"
            >
              <div
                class="w-12 h-12 rounded-xl bg-primary/15 dark:bg-primary-light/20 text-primary dark:text-purple-pastel flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <h4
                  class="font-semibold text-xs sm:text-sm text-text-primary-light dark:text-white"
                >
                  {t("contact.emailText")}
                </h4>
                <p
                  class="text-xs text-text-secondary-light dark:text-purple-pastel mt-0.5 font-mono"
                >
                  {siteSettings.email}
                </p>
              </div>
            </a>

            <!-- Reception Phone -->
            <a
              href={`tel:+${siteSettings.phoneRaw}`}
              class="flex items-center gap-4 p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-900/50 border border-black/5 dark:border-white/5 hover:border-secondary/40 hover:bg-secondary/5 transition-[border-color,background-color] duration-300 group"
            >
              <div
                class="w-12 h-12 rounded-xl bg-secondary/15 text-secondary-dark dark:text-secondary flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <div>
                <h4
                  class="font-semibold text-xs sm:text-sm text-text-primary-light dark:text-white"
                >
                  {t("contact.callText")}
                </h4>
                <p
                  class="text-xs text-text-secondary-light dark:text-purple-pastel mt-0.5"
                >
                  {siteSettings.phone}
                </p>
              </div>
            </a>

            <!-- Travel Portals Badges -->
            <div
              class="flex items-center justify-between p-4 rounded-2xl bg-stone-50/80 dark:bg-stone-900/50 border border-black/5 dark:border-white/5"
            >
              <span
                class="text-xs font-medium text-text-secondary-light dark:text-purple-pastel"
                >OTAs & Reviews:</span
              >
              <div class="flex gap-2">
                <a
                  href="https://www.tripadvisor.com.pe/Hotel_Review-g294314-d12461523-Reviews-Usgar_San_Pedro_Boutique-Cusco_Cusco_Region.html"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] bg-stone-200/70 dark:bg-stone-800 hover:bg-secondary/20 dark:hover:bg-secondary/20 hover:text-secondary-dark dark:hover:text-secondary px-3 py-2 rounded-lg font-bold transition-[background-color,color] cursor-pointer"
                >
                  TripAdvisor
                </a>
                <a
                  href="https://www.booking.com/hotel/pe/chavin-imperio-del-sol.es.html?aid=311839&label=chavin-imperio-del-sol-zuUKmuTcIrFOMWxyHhV97gS539509797055%3Apl%3Ata%3Ap1%3Ap2%3Aac%3Aap%3Aneg%3Afi%3Atiaud-2395231936498%3Akwd-2440927734184%3Alp9060927%3Ali%3Adec%3Adm%3Appccp%3DUmFuZG9tSVYkc2RlIyh9YcUc3ZfdbbfEuXomSVxn0TU&sid=cde5b6d1678ed661cd007c4cc75870a4&dest_id=-345275&dest_type=city&dist=0&group_adults=2&group_children=0&hapos=1&hpos=1&no_rooms=1&req_adults=2&req_children=0&room1=A%2CA&sb_price_type=total&sr_order=popularity&srepoch=1782702781&srpvid=7032169be43f00ba&type=total&ucfs=1&"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] bg-stone-200/70 dark:bg-stone-800 hover:bg-tertiary/20 dark:hover:bg-tertiary-light/20 hover:text-tertiary dark:hover:text-mint px-3 py-2 rounded-lg font-bold transition-[background-color,color] cursor-pointer"
                >
                  Booking.com
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Cusco Survival & Travel Guide Glass Card -->
        <div
          class="glass p-6 sm:p-8 rounded-3xl border border-black/5 dark:border-white/10 shadow-xl space-y-6 animate-on-scroll"
        >
          <div class="border-b border-black/5 dark:border-white/10 pb-3">
            <span class="tag-dash-title block mb-1"
              >{t("contact.directionsTitle")}</span
            >
            <h3
              class="font-display text-2xl text-text-primary-light dark:text-white font-bold"
            >
              {t("contact.directionsTitle")}
            </h3>
            <p
              class="text-xs sm:text-sm text-text-secondary-light dark:text-purple-pastel mt-1 leading-relaxed"
            >
              {t("contact.directionsDesc")}
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
            <!-- Airport Pickup -->
            <div
              class="p-5 rounded-2xl bg-primary/5 dark:bg-primary-light/10 border border-primary/10 dark:border-primary-light/20 space-y-2"
            >
              <h4
                class="font-semibold text-sm text-primary dark:text-purple-pastel flex items-center gap-2"
              >
                <svg
                  class="w-4 h-4 text-primary dark:text-purple-pastel flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 17a2 2 0 100-4 2 2 0 000 4zm8 0a2 2 0 100-4 2 2 0 000 4zm2-10h-3V4H5v10h13V7z"
                  ></path>
                </svg>
                {t("contact.airportPickup")}
              </h4>
              <p
                class="text-xs text-text-secondary-light dark:text-purple-pastel/90 leading-relaxed"
              >
                {t("contact.airportPickupDesc")}
              </p>
            </div>

            <!-- Altitude Safety Warning -->
            <div
              class="p-5 rounded-2xl bg-secondary/10 dark:bg-secondary/15 border border-secondary/20 space-y-2"
            >
              <h4
                class="font-semibold text-sm text-secondary-dark dark:text-secondary flex items-center gap-2"
              >
                <svg
                  class="w-4 h-4 text-secondary-dark dark:text-secondary flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"
                  ></path>
                </svg>
                {t("contact.altitudeTitle")}
              </h4>
              <p
                class="text-xs text-text-secondary-light dark:text-purple-pastel/90 leading-relaxed"
              >
                {t("contact.altitudeDesc")}
              </p>
            </div>
          </div>

          <!-- Reception Hours & Luggage Notice -->
          <div
            class="p-4 rounded-2xl bg-tertiary/5 dark:bg-tertiary-light/10 border border-tertiary/10 dark:border-tertiary-light/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs"
          >
            <div
              class="flex items-center gap-2 text-tertiary dark:text-mint font-semibold"
            >
              <svg
                class="w-4 h-4 flex-shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
              <span>{t("contact.receptionDesc")}</span>
            </div>
            <span
              class="font-mono text-[11px] text-text-secondary-light dark:text-purple-pastel font-medium bg-white/50 dark:bg-stone-900/50 px-2.5 py-1 rounded-md"
            >
              {t("contact.checkinHours")}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Contact FAQ Accordion Section -->
