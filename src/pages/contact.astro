---
import Layout from "../layouts/Layout.astro";
import LocationMap from "../components/LocationMap.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import ContactChannels from "../components/contact/ContactChannels.astro";
import ContactTravelGuide from "../components/contact/ContactTravelGuide.astro";
import { useTranslations, type Locale } from "../i18n/utils";
import { siteSettings } from "../data/settings";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `${t("contact.title")} - USGAR Hotels`,
  description: t("contact.subtitle"),
  url: `https://usgarhoteles.com/${lang !== "en" ? lang + "/" : ""}contact`,
  mainEntity: {
    "@type": "Hotel",
    name: siteSettings.hotelName,
    telephone: `+${siteSettings.phoneRaw}`,
    email: siteSettings.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: siteSettings.streetAddress,
      addressLocality: siteSettings.city,
      addressRegion: siteSettings.region,
      postalCode: siteSettings.postalCode,
      addressCountry: siteSettings.country,
    },
  },
};
---

<Layout
  title={`${t("contact.title")} - USGAR Hotels`}
  lang={lang}
  schema={contactSchema}
>
  <!-- Hero Section with Ambient Light & Micro-Badges -->
  <section
    class="relative pt-32 pb-16 md:pt-40 md:pb-24 px-4 bg-surface-light dark:bg-surface-dark transition-colors duration-500 overflow-hidden"
  >
    <!-- Ambient Light Glow Spheres -->
    <div
      class="absolute -top-32 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-primary/15 dark:bg-primary-light/10 rounded-full blur-[100px] opacity-20 pointer-events-none"
    >
    </div>

    <div class="max-w-4xl mx-auto text-center relative z-10 animate-fade-in">
      <span class="tag-architectural mb-4 inline-flex">
        <svg
          class="w-3.5 h-3.5 text-secondary"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {t("contact.sectionTag")}
      </span>

      <h1
        class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-text-primary-light dark:text-white leading-[1.1] mb-6"
      >
        {t("contact.title")}
      </h1>

      <p
        class="text-base sm:text-lg md:text-xl text-text-secondary-light dark:text-text-secondary-dark max-w-2xl mx-auto font-body font-light leading-relaxed mb-8"
      >
        {t("contact.subtitle")}
      </p>

      <!-- Quick Action Chips -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href={`https://wa.me/${siteSettings.whatsappNumber}?text=${encodeURIComponent(t("contact.whatsappQuery"))}`}
          target="_blank"
          rel="noopener noreferrer"
          class="glass px-4 py-2.5 rounded-full text-xs font-semibold flex items-center gap-2 text-text-primary-light dark:text-white hover:border-teal-brand/40 transition-[border-color,transform,box-shadow] duration-300 group shadow-sm lg:hover:scale-105"
        >
          <span class="w-2 h-2 rounded-full bg-teal-brand animate-pulse"></span>
          <span>{t("contact.whatsappDirect")}</span>
          <svg
            class="w-3.5 h-3.5 text-teal-brand group-hover:translate-x-0.5 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href={`tel:+${siteSettings.phoneRaw}`}
          class="glass px-4 py-2.5 rounded-full text-xs font-semibold flex items-center gap-2 text-text-primary-light dark:text-white hover:border-secondary/40 transition-[border-color,transform,box-shadow] duration-300 group shadow-sm lg:hover:scale-105"
        >
          <svg
            class="w-3.5 h-3.5 text-secondary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span>{t("contact.receptionTitle")}</span>
        </a>

        <div
          class="glass px-4 py-2.5 rounded-full text-xs font-semibold text-text-secondary-light dark:text-purple-pastel flex items-center gap-1.5 shadow-sm"
        >
          <svg
            class="w-3.5 h-3.5 text-primary-light dark:text-purple-pastel"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>{t("contact.checkinCheckoutTitle")}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Interactive Glass Grid -->
  <section class="pb-24 px-4 max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <ContactForm />

      <!-- Right Column: Direct Channels & Cusco Travel Hub (7 cols) -->
      <div class="lg:col-span-7 space-y-8">
        <ContactChannels />
        <ContactTravelGuide />
      </div>
    </div>
  </section>

  <!-- Interactive Contact FAQ Accordion Section -->
  <section class="pb-24 px-4 max-w-4xl mx-auto relative z-10 animate-on-scroll">
    <div class="text-center mb-10">
      <span class="tag-dash-title block mb-2">{t("contact.faqTitle")}</span>
      <h2
        class="font-display text-3xl sm:text-4xl text-text-primary-light dark:text-white font-bold"
      >
        {t("contact.faqTitle")}
      </h2>
    </div>

    <div class="space-y-4">
      <details
        class="group glass rounded-2xl p-5 border border-black/5 dark:border-white/10 transition-[border-color,background-color] duration-300 cursor-pointer"
      >
        <summary
          class="flex justify-between items-center font-bold text-sm sm:text-base text-text-primary-light dark:text-white list-none select-none"
        >
          <span>{t("contact.faqLuggageQ")}</span>
          <svg
            class="w-5 h-5 text-secondary group-open:rotate-180 transition-transform duration-300 flex-shrink-0 ml-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p
          class="mt-3 text-xs sm:text-sm text-text-secondary-light dark:text-purple-pastel leading-relaxed font-body border-t border-black/5 dark:border-white/5 pt-3"
        >
          {t("contact.faqLuggageA")}
        </p>
      </details>

      <details
        class="group glass rounded-2xl p-5 border border-black/5 dark:border-white/10 transition-[border-color,background-color] duration-300 cursor-pointer"
      >
        <summary
          class="flex justify-between items-center font-bold text-sm sm:text-base text-text-primary-light dark:text-white list-none select-none"
        >
          <span>{t("contact.faqOxygenQ")}</span>
          <svg
            class="w-5 h-5 text-secondary group-open:rotate-180 transition-transform duration-300 flex-shrink-0 ml-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p
          class="mt-3 text-xs sm:text-sm text-text-secondary-light dark:text-purple-pastel leading-relaxed font-body border-t border-black/5 dark:border-white/5 pt-3"
        >
          {t("contact.faqOxygenA")}
        </p>
      </details>

      <details
        class="group glass rounded-2xl p-5 border border-black/5 dark:border-white/10 transition-[border-color,background-color] duration-300 cursor-pointer"
      >
        <summary
          class="flex justify-between items-center font-bold text-sm sm:text-base text-text-primary-light dark:text-white list-none select-none"
        >
          <span>{t("contact.faqTransferQ")}</span>
          <svg
            class="w-5 h-5 text-secondary group-open:rotate-180 transition-transform duration-300 flex-shrink-0 ml-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p
          class="mt-3 text-xs sm:text-sm text-text-secondary-light dark:text-purple-pastel leading-relaxed font-body border-t border-black/5 dark:border-white/5 pt-3"
        >
          {t("contact.faqTransferA")}
        </p>
      </details>
    </div>
  </section>

  <!-- Leaflet Map Section -->
  <LocationMap />
</Layout>
