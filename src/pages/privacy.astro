---
// src/pages/privacy.astro — Privacy Policy (Ley 29733 + GDPR), 4 locales
import Layout from "../layouts/Layout.astro";
import LegalDoc from "../components/LegalDoc.astro";
import { privacySections, legalMeta } from "../data/legal";
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { siteSettings } from "../data/settings";

const lang = (Astro.currentLocale || "en") as Locale;
const t = useTranslations(lang);
const meta = legalMeta.privacy[lang];
const sections = privacySections[lang];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: meta.title,
  isPartOf: { "@type": "WebSite", name: siteSettings.hotelName, url: "https://usgarhoteles.com" },
};
---

<Layout title={`${meta.title} | ${siteSettings.hotelName}`} lang={lang} description={t('meta.privacy')} schema={schema}>
  <LegalDoc
    lang={lang}
    title={meta.title}
    updatedLabel={meta.updatedLabel}
    updatedDate={meta.updatedDate}
    sections={sections}
  />
</Layout>
