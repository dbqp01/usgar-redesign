---
import Layout from '../layouts/Layout.astro';
import WizardProgress from '../components/booking/WizardProgress.astro';
import BookingCalendarStep from '../components/booking/BookingCalendarStep.astro';
import AllocationStep from '../components/booking/AllocationStep.astro';
import GuestStep from '../components/booking/GuestStep.astro';
import PaymentStep from '../components/booking/PaymentStep.astro';
import { rooms } from '../data/rooms';
import { getRoomInventory } from '../data/settings';
import { useTranslations, type Locale } from '../i18n/utils';

export const prerender = true;

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);
---

<Layout title={`${t('book.title')} - USGAR Hotels`} lang={lang}>
  <div class="pt-16 pb-12 px-4 max-w-[1380px] mx-auto flex-1 animate-fade-in">

    <!-- Compact Header Section -->
    <div class="text-center max-w-xl mx-auto mb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-secondary/10 border border-secondary/20 text-secondary-dark dark:text-secondary text-[11px] font-semibold uppercase tracking-wider mb-1.5">
        <span>USGAR HOTELS · SAN PEDRO, CUSCO</span>
      </div>
      <h1 class="font-display text-2xl sm:text-3xl text-text-primary-light dark:text-white font-bold tracking-tight">
        {t('book.title')}
      </h1>
      <p class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-0.5">
        {t('book.subtitle')}
      </p>
    </div>

    <!-- Error Banner -->
    <div id="error-banner" class="hidden max-w-3xl mx-auto mb-4 p-3 rounded-xl border border-rose-500/20 bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs font-medium flex items-center gap-2.5">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="error-message"></span>
    </div>

    <WizardProgress step={1} />

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

      <!-- Left Column: Sticky Summary & Included Hotel Services (4 cols on desktop) -->
      <div class="lg:col-span-4 lg:sticky lg:top-20 space-y-4">
        <!-- Booking Summary Card -->
        <div class="bg-surface-card-light dark:bg-surface-card-dark p-4 rounded-2xl border border-black/8 dark:border-white/10 shadow-sm space-y-3 text-text-primary-light dark:text-text-primary-dark">
          <div class="flex items-center justify-between pb-2 border-b border-black/6 dark:border-white/6">
            <h2 class="font-display text-xs font-bold text-text-primary-light dark:text-white uppercase tracking-wider">
              {t('book.tripSummary')}
            </h2>
            <span class="text-[9px] font-mono font-semibold px-2 py-0.5 rounded bg-secondary/15 text-secondary-dark dark:text-secondary uppercase">
              {t('book.directBooking')}
            </span>
          </div>

          <div class="space-y-2.5">
            <!-- Room Image Preview -->
            <div id="summary-room-img-container" class="hidden relative w-full h-28 rounded-xl overflow-hidden bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5">
              <img id="summary-room-img" src="" alt="Room Preview" class="w-full h-full object-cover transition-opacity duration-300" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-2">
                <span id="summary-room-badge" class="text-[9px] font-body font-bold uppercase tracking-wider text-white bg-secondary/90 backdrop-blur-md px-1.5 py-0.5 rounded"></span>
              </div>
            </div>

            <!-- Room Name -->
            <div>
              <h3 id="summary-room-name" class="font-display text-sm font-bold text-primary dark:text-primary-soft leading-tight"></h3>
              <p id="summary-room-beds" class="text-[10px] text-text-secondary-light dark:text-text-secondary-dark mt-0.5">
                <span id="summary-room-beds-text"></span>
              </p>
            </div>

            <!-- Dates & Details -->
            <div class="border-t border-b border-black/6 dark:border-white/6 py-2 space-y-1.5 text-xs">
              <div class="flex justify-between">
                <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('book.checkinDate')}</span>
                <span id="summary-checkin" class="font-semibold text-text-primary-light dark:text-white">--</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('book.checkoutDate')}</span>
                <span id="summary-checkout" class="font-semibold text-text-primary-light dark:text-white">--</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('book.duration')}</span>
                <span id="summary-nights" class="font-semibold text-text-primary-light dark:text-white">--</span>
              </div>
              <div class="flex justify-between">
                <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('booking.guests')}</span>
                <span id="summary-guests" class="font-semibold text-text-primary-light dark:text-white">--</span>
              </div>
            </div>

            <!-- Total Price -->
            <div class="flex items-center justify-between pt-0.5">
              <div>
                <span class="text-xs font-bold text-text-primary-light dark:text-white">{t('book.totalPrice')}</span>
                <p class="text-[9px] text-text-secondary-light dark:text-text-secondary-dark">
                  {t('book.priceNote')}
                </p>
              </div>
              <div class="text-right">
                <div class="flex items-baseline gap-0.5 justify-end">
                  <span class="text-xl font-bold font-display text-primary dark:text-primary-soft">$</span>
                  <span id="summary-total-price" class="text-xl font-bold font-display text-primary dark:text-primary-soft">0</span>
                </div>
                <span class="text-[9px] text-text-secondary-light dark:text-text-secondary-dark">
                  $<span id="summary-price-per-night">0</span> {t('rooms.perNight')}
                </span>
                <span id="summary-rate-type" class="hidden block text-[9px] font-bold uppercase tracking-wider text-secondary-dark dark:text-secondary mt-0.5"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hotel Included Services Highlights -->
        <div class="bg-surface-card-light dark:bg-surface-card-dark p-4 rounded-2xl border border-black/8 dark:border-white/10 shadow-sm space-y-2.5">
          <h3 class="text-[11px] font-bold uppercase tracking-wider text-text-primary-light dark:text-white flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-teal-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            {t('book.includedServices')}
          </h3>

          <ul class="space-y-1.5 text-xs text-text-secondary-light dark:text-text-secondary-dark">
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-brand mt-1.5 flex-shrink-0"></span>
              <span>{t('book.perkBreakfast')}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-brand mt-1.5 flex-shrink-0"></span>
              <span>{t('book.perkOxygen')}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-brand mt-1.5 flex-shrink-0"></span>
              <span>{t('book.perkHotDrinks')}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-brand mt-1.5 flex-shrink-0"></span>
              <span>{t('book.perkWifi')}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-brand mt-1.5 flex-shrink-0"></span>
              <span>{t('book.perkReception')}</span>
            </li>
            <li class="flex items-start gap-2 text-[10px] text-text-secondary-light/70 dark:text-text-secondary-dark/70 pt-1 border-t border-black/4 dark:border-white/4">
              <span>{t('book.checkinOutTimes')}</span>
            </li>
          </ul>
        </div>

        <!-- Garantía de Reserva -->
        <div class="p-3.5 rounded-xl bg-teal-brand/10 dark:bg-teal-brand/15 border border-teal-brand/15 space-y-1.5">
          <h4 class="font-semibold text-[11px] text-teal-deep dark:text-teal-light flex items-center gap-1.5 uppercase tracking-wider">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            {t('book.guaranteedTitle')}
          </h4>
          <p class="text-[11px] text-text-primary-light/80 dark:text-text-primary-dark/80 leading-relaxed">
            {t('book.guaranteedText')}
          </p>
        </div>

        <!-- Video Tour de la Habitación -->
        <div id="summary-video-container" class="hidden p-3.5 rounded-2xl border border-black/8 dark:border-white/10 space-y-2 bg-surface-card-light dark:bg-surface-card-dark">
          <h4 class="font-semibold text-[11px] text-text-secondary-light dark:text-text-secondary-dark uppercase tracking-wider flex items-center gap-1.5">
            <svg class="w-4 h-4 text-text-secondary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            {t('book.videoTour')}
          </h4>
          <div class="relative rounded-lg overflow-hidden aspect-video bg-black">
            <video
              id="summary-room-video"
              src=""
              preload="none"
              controls
              muted
              playsinline
              class="w-full h-full object-cover"
            ></video>
          </div>
        </div>
      </div>

      <!-- Right Column: Wizard Main Content (8 cols on desktop) -->
      <div class="lg:col-span-8 space-y-5">

        <!-- Step 1 Panel: Dates + Room Selection -->
        <section data-step-panel="1" data-wizard-step class="space-y-5">
          <BookingCalendarStep />
          <AllocationStep />
        </section>

        <!-- Step 2 Panel: Guest Details -->
        <section data-step-panel="2" data-wizard-step class="hidden" aria-hidden="true" inert>
          <GuestStep />
        </section>

        <!-- Step 3 Panel: Payment -->
        <section data-step-panel="3" data-wizard-step class="hidden" aria-hidden="true" inert>
          <div data-payment-wrap>
            <PaymentStep />
          </div>
        </section>
      </div>

    </div>
  </div>

  <!-- MercadoPago SDK -->
  <script is:inline src="https://www.mercadopago.com/v2/security.js" {...{ view: 'checkout' }}></script>
</Layout>

<script is:inline define:vars={{
  serializedRooms: JSON.stringify(rooms.map(r => ({
    slug: r.slug,
    name: r.name,
    description: r.description,
    pricePerNight: r.pricePerNight,
    beds: r.beds,
    baseOccupancy: r.baseOccupancy,
    extraGuestCharge: r.extraGuestCharge,
    maxGuests: r.maxGuests,
    amenities: r.amenities,
    amenityLabels: r.amenityLabels,
    images: r.images,
  }))),
  serializedInventory: JSON.stringify(getRoomInventory()),
  serializedLabels: JSON.stringify({
    nights: t('book.nights'),
    night: t('book.night'),
    guest: t('booking.guest'),
    guests: t('booking.guests_plural'),
    selected: t('book.selected'),
    select: t('book.select'),
    fillAllFields: t('book.fillAllFields'),
    invalidEmail: t('book.invalidEmail'),
    processing: t('book.processing'),
    confirmAndPay: t('book.confirmAndPay'),
    noPaymentUrl: t('book.noPaymentUrl'),
    unexpectedError: t('book.unexpectedError'),
    cardError: t('book.cardError'),
    available: t('book.available'),
    availabilityDegraded: t('wizard.availabilityDegraded'),
    rangeUnavailable: t('wizard.rangeUnavailable'),
    soldOut: t('wizard.soldOut'),
    availableOn: t('wizard.availableOn'),
    extras: t('wizard.extras'),
    bestPrice: t('wizard.bestPrice'),
    roomsCount: t('wizard.roomsCount'),
    multiRoomNote: t('wizard.multiRoomNote'),
    perNight: t('wizard.perNight'),
    alternatives: t('wizard.alternatives'),
    onlyThisRoom: t('wizard.onlyThisRoom'),
    toastOptionsUpdated: t('wizard.toast.optionsUpdated'),
    toastBestPrice: t('wizard.toast.bestPrice'),
    stepOf: t('wizard.stepOf'),
    rateStandard: t('book.rateStandard'),
    rateNonRefundable: t('book.rateNonRefundable'),
    guestTransferValidation: t('book.guestTransferValidation'),
    guestArrivalNote: t('book.arrivalNoteShort'),
    allocationLastUnit: t('allocation.lastUnit'),
    allocationUnitsLeft: t('allocation.unitsLeft'),
    allocationUnitsAvailable: t('allocation.unitsAvailable'),
    allocationShowMulti: t('allocation.showMulti'),
    allocationHideMulti: t('allocation.hideMulti'),
    allocationOfferBadge: t('allocation.offerBadge'),
    allocationPhotoCount: t('allocation.photoCount'),
    allocationSelectRate: t('allocation.selectRate'),
    allocationStandardRate: t('allocation.standardRate'),
    allocationStandardRateDesc: t('allocation.standardRateDesc'),
    allocationNonRefundableRate: t('allocation.nonRefundableRate'),
    allocationNonRefundableRateDesc: t('allocation.nonRefundableRateDesc'),
    allocationTotalLabel: t('allocation.totalLabel'),
    availabilityChecking: t('wizard.availabilityChecking'),
    checkingAvailability: t('book.processing'),
    continueToPayment: t('book.continueToPayment'),
  }),
}}>
  window.__ROOMS_DATA = JSON.parse(serializedRooms);
  window.__ROOM_INVENTORY = JSON.parse(serializedInventory);
  window.__LABELS = JSON.parse(serializedLabels);
</script>

<script>
  import { gsap } from 'gsap';
  import { translateBeds } from '../utils/helpers';
  import { nightsBetween } from '../features/booking/calendar';
  import { wizardStore } from '../features/booking/wizardStore';
  import type { Locale } from '../i18n/utils';

  let abortController = new AbortController();

  function initWizardShell() {
    abortController.abort();
    abortController = new AbortController();

    const panels = {
      1: document.querySelector('[data-step-panel="1"]') as HTMLElement | null,
      2: document.querySelector('[data-step-panel="2"]') as HTMLElement | null,
      3: document.querySelector('[data-step-panel="3"]') as HTMLElement | null,
    };
    const dots = document.querySelectorAll<HTMLElement>('[data-wizard-step-dot]');
    const lines = document.querySelectorAll<HTMLElement>('[data-wizard-step-line]');
    const stepOf = document.querySelector('[data-wizard-stepof]');
    const summaryRoomName = document.getElementById('summary-room-name');
    const summaryRoomBedsText = document.getElementById('summary-room-beds-text');
    const summaryCheckin = document.getElementById('summary-checkin');
    const summaryCheckout = document.getElementById('summary-checkout');
    const summaryNights = document.getElementById('summary-nights');
    const summaryGuests = document.getElementById('summary-guests');
    const summaryTotalPrice = document.getElementById('summary-total-price');
    const summaryPricePerNight = document.getElementById('summary-price-per-night');
    const summaryVideoContainer = document.getElementById('summary-video-container');
    const summaryRoomVideo = document.getElementById('summary-room-video') as HTMLVideoElement | null;
    const errorBanner = document.getElementById('error-banner');
    const lang = (document.documentElement.lang || 'en') as Locale;
    const L = (window as any).__LABELS || {};
    const ROOMS = (window as any).__ROOMS_DATA || [];

    let lastTotal: number | null = null;
    let lastStep: number | null = null;

    function applyState() {
      const s = wizardStore.getState();
      const step = s.step;

      // AUTO-SCROLL TO TOP ON STEP CHANGE (Fixes user complaint: "cada vez te quedas donde estas, tienes que subir con la ruedita")
      if (lastStep !== null && lastStep !== step) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
      lastStep = step;

      (Object.keys(panels) as unknown as number[]).forEach((n) => {
        const panel = panels[n as keyof typeof panels];
        if (!panel) return;
        const isActive = Number(n) === step;
        if (isActive && panel.classList.contains('hidden')) {
          panel.classList.remove('hidden');
          panel.removeAttribute('aria-hidden');
          panel.removeAttribute('inert');
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduceMotion) {
            gsap.fromTo(panel, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'power2.out', overwrite: true });
          }
        } else if (!isActive && !panel.classList.contains('hidden')) {
          panel.classList.add('hidden');
          panel.setAttribute('aria-hidden', 'true');
          panel.setAttribute('inert', '');
        }
      });

      dots.forEach((dot, i) => {
        const n = i + 1;
        if (n === step) dot.setAttribute('data-state', 'active');
        else if (n < step) dot.setAttribute('data-state', 'done');
        else dot.removeAttribute('data-state');
      });
      lines.forEach((line, i) => {
        if (i + 1 < step) line.classList.add('done-line');
        else line.classList.remove('done-line');
      });
      if (stepOf) stepOf.textContent = (L.stepOf || 'Step {n} of 3').replace('{n}', String(step));

      // Tarifa elegida: el ratio no reembolsable viene del backend (rate_plans
      // por habitación, resueltos desde Catalog Price Rules de QloApps). Sin
      // datos => ambas tarifas al mismo precio (honesto).
      const rateSlug = s.allocation?.rooms[0]?.room?.slug;
      const ratePlan = rateSlug && s.ratePlans ? s.ratePlans[rateSlug] : null;
      const rateRatio = s.rateType === 'non_refundable'
        && ratePlan && ratePlan.standard > 0 && ratePlan.non_refundable < ratePlan.standard
        ? ratePlan.non_refundable / ratePlan.standard
        : 1;
      const rateTotal = (t: number): number => rateRatio < 1 ? Math.round(t * rateRatio) : t;

      const rateBadge = document.getElementById('summary-rate-type');
      if (rateBadge) {
        const label = s.rateType === 'non_refundable' ? (L.rateNonRefundable || 'Non-refundable') : (L.rateStandard || 'Standard');
        rateBadge.textContent = label;
        rateBadge.classList.toggle('hidden', !s.allocation);
      }

      if (summaryRoomName && s.allocation) {
        const names = s.allocation.rooms.map((e) => e.room.displayName).join(' + ');
        summaryRoomName.textContent = names;
        const first = ROOMS.find((r: any) => r.slug === s.allocation!.rooms[0].room.slug);

        const imgContainer = document.getElementById('summary-room-img-container');
        const imgEl = document.getElementById('summary-room-img') as HTMLImageElement | null;
        const badgeEl = document.getElementById('summary-room-badge');

        if (imgContainer && imgEl && first && first.images?.[0]) {
          imgContainer.classList.remove('hidden');
          if (imgEl.src !== first.images[0]) {
            imgEl.src = first.images[0];
          }
          if (badgeEl) {
            badgeEl.textContent = first.name?.[lang] || first.name?.es || names;
          }
        }

        if (summaryRoomBedsText) {
          summaryRoomBedsText.textContent = first ? translateBeds(first.beds, lang) : '';
        }
        const nights = nightsBetween(s.checkIn, s.checkOut);
        if (summaryCheckin) summaryCheckin.textContent = s.checkIn;
        if (summaryCheckout) summaryCheckout.textContent = s.checkOut;
        if (summaryNights) summaryNights.textContent = `${nights} ${nights === 1 ? L.night : L.nights}`;
        if (summaryGuests) summaryGuests.textContent = `${s.guests} ${s.guests === 1 ? L.guest : L.guests}`;
        if (summaryTotalPrice) {
          const displayTotal = rateTotal(s.allocation.total);
          summaryTotalPrice.textContent = String(displayTotal);
          if (lastTotal !== null && lastTotal !== displayTotal) {
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduceMotion) {
              gsap.fromTo(
                summaryTotalPrice,
                { scale: 1.08, color: 'var(--color-secondary)' },
                { scale: 1, color: 'inherit', duration: 0.4, ease: 'power2.out', overwrite: true }
              );
            }
          }
          lastTotal = displayTotal;
        }
        const perNight = s.allocation.roomTotal / nights;
        if (summaryPricePerNight) summaryPricePerNight.textContent = String(Math.round(rateTotal(perNight)));
        if (summaryVideoContainer && summaryRoomVideo && first?.hasVideoTour) {
          summaryVideoContainer.classList.remove('hidden');
          const vid = `/videos/rooms/${s.allocation.rooms[0].room.slug}.mp4`;
          if (summaryRoomVideo.src !== vid) {
            summaryRoomVideo.src = vid;
            summaryRoomVideo.load();
          }
        }
      }

      if (errorBanner && step === 1) errorBanner.classList.add('hidden');
    }

    const unsub = wizardStore.subscribe(() => applyState());
    abortController.signal.addEventListener('abort', () => unsub());

    const params = new URLSearchParams(window.location.search);
    const checkIn = params.get('checkin') || params.get('checkIn') || '';
    const checkOut = params.get('checkout') || params.get('checkOut') || '';
    if (checkIn && summaryCheckin) summaryCheckin.textContent = checkIn;
    if (checkOut && summaryCheckout) summaryCheckout.textContent = checkOut;

    applyState();
  }

  document.addEventListener('astro:page-load', initWizardShell);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
  });
</script>
