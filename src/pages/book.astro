---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import WizardProgress from '../components/booking/WizardProgress.astro';
import BookingCalendarStep from '../components/booking/BookingCalendarStep.astro';
import AllocationStep from '../components/booking/AllocationStep.astro';
import GuestStep from '../components/booking/GuestStep.astro';
import PaymentStep from '../components/booking/PaymentStep.astro';
import { rooms } from '../data/rooms';
import { getRoomInventory } from '../data/settings';
import { useTranslations, type Locale } from '../i18n/utils';
import { translateBeds, daysBetween } from '../utils/helpers';

export const prerender = true;

const lang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(lang);

const url = new URL(Astro.url);
const checkInParam = url.searchParams.get('checkin') || url.searchParams.get('checkIn') || '';
const checkOutParam = url.searchParams.get('checkout') || url.searchParams.get('checkOut') || '';
const roomTypeParam = url.searchParams.get('roomType') || url.searchParams.get('room_type') || '';
const guestsParam = Number(url.searchParams.get('guests')) || 2;
---

<Layout title={`${t('book.title')} - USGAR Hotels`} lang={lang}>
  <main class="py-12 sm:py-24 px-4 max-w-[1400px] mx-auto flex-1 animate-fade-in">
    <section class="pb-10">
      <SectionHeader
        number="04"
        eyebrow={t('booking.title')}
        title={t('book.title')}
        subtitle={t('book.subtitle')}
      />
    </section>

    <!-- Error Banner -->
    <div id="error-banner" class="hidden max-w-4xl mx-auto mb-8 p-4 rounded-xl border border-red-500/20 bg-red-500/10 text-red-600 dark:text-red-400 text-sm font-medium flex items-center gap-3">
      <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span id="error-message"></span>
    </div>

    <WizardProgress step={1} />

    <!-- Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Column: Wizard Steps (8 cols) -->
      <div class="lg:col-span-7 space-y-8">
        <section data-step-panel="1" data-wizard-step>
          <BookingCalendarStep />
        </section>

        <section data-step-panel="2" data-wizard-step class="hidden">
          <AllocationStep />
        </section>

        <section data-step-panel="3" data-wizard-step class="hidden">
          <GuestStep />
          <div class="mt-8" data-payment-wrap>
            <PaymentStep />
          </div>
        </section>
      </div>

      <!-- Right Column: Booking Summary Card (5 cols) -->
      <div class="lg:col-span-5 lg:sticky lg:top-24 bg-surface-card-light dark:bg-surface-card-dark p-8 rounded-2xl border border-black/5 dark:border-white/5 shadow-lg space-y-6">
        <h2 class="font-display text-2xl border-b border-black/5 dark:border-white/5 pb-3">
          {t('book.tripSummary')}
        </h2>

        <div class="space-y-4">
          <div>
            <h3 id="summary-room-name" class="font-display text-xl text-primary font-bold"></h3>
            <p id="summary-room-beds" class="text-xs text-text-secondary-light dark:text-text-secondary-dark mt-1 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 4v16M2 20h20M22 20V12a4 4 0 0 0-4-4H4" />
                <path d="M6 12h4a2 2 0 0 0 2-2V8H6v4Z" />
              </svg>
              <span id="summary-room-beds-text"></span>
            </p>
          </div>

          <div class="border-t border-b border-black/5 dark:border-white/5 py-4 space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('book.checkinDate')}</span>
              <span id="summary-checkin" class="font-semibold"></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('book.checkoutDate')}</span>
              <span id="summary-checkout" class="font-semibold"></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('book.duration')}</span>
              <span id="summary-nights" class="font-semibold"></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-text-secondary-light dark:text-text-secondary-dark">{t('booking.guests')}</span>
              <span id="summary-guests" class="font-semibold"></span>
            </div>
          </div>

          <div class="flex items-center justify-between py-2">
            <div>
              <span class="text-sm font-semibold">{t('book.totalPrice')}</span>
              <p class="text-[11px] text-text-secondary-light dark:text-text-secondary-dark mt-0.5">
                {t('book.priceNote')}
              </p>
            </div>
            <div class="text-right">
              <div class="flex items-baseline gap-1 justify-end">
                <span class="text-3xl font-bold font-display text-primary">$</span>
                <span id="summary-total-price" class="text-3xl font-bold font-display text-primary">0</span>
              </div>
              <span class="text-xs text-text-secondary-light dark:text-text-secondary-dark">
                $<span id="summary-price-per-night">0</span> {t('rooms.perNight')}
              </span>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#2DB5A0]/10 dark:bg-[#2DB5A0]/15 border border-[#2DB5A0]/15 space-y-2">
            <h4 class="font-semibold text-xs text-[#1F9484] dark:text-[#4ECBB8] flex items-center gap-1.5 uppercase tracking-wider">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              {t('book.guaranteedTitle')}
            </h4>
            <p class="text-xs text-text-primary-light/80 dark:text-text-primary-dark/80 leading-relaxed">
              {t('book.guaranteedText')}
            </p>
          </div>

          <div id="summary-video-container" class="hidden p-4 rounded-xl border border-black/10 dark:border-white/10 space-y-2">
            <h4 class="font-semibold text-xs text-text-secondary-light dark:text-text-secondary-dark uppercase tracking-wider flex items-center gap-1.5">
              <svg class="w-4 h-4 text-text-secondary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              {t('book.videoTour')}
            </h4>
            <div class="relative rounded-lg overflow-hidden aspect-video bg-black">
              <video
                id="summary-room-video"
                src=""
                preload="none"
                controls
                muted
                playsinline
                class="w-full h-full object-cover"
              ></video>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script src="https://sdk.mercadopago.com/js/v2" is:inline></script>

<script is:inline define:vars={{
  serializedRooms: JSON.stringify(rooms.map(r => ({
    slug: r.slug,
    name: r.name,
    pricePerNight: r.pricePerNight,
    beds: r.beds,
    baseOccupancy: r.baseOccupancy,
    extraGuestCharge: r.extraGuestCharge,
    maxGuests: r.maxGuests,
  }))),
  serializedInventory: JSON.stringify(getRoomInventory()),
  serializedLabels: JSON.stringify({
    nights: t('book.nights'),
    night: t('book.night'),
    guest: t('booking.guest'),
    guests: t('booking.guests_plural'),
    selected: t('book.selected'),
    select: t('book.select'),
    fillAllFields: t('book.fillAllFields'),
    invalidEmail: t('book.invalidEmail'),
    processing: t('book.processing'),
    confirmAndPay: t('book.confirmAndPay'),
    noPaymentUrl: t('book.noPaymentUrl'),
    unexpectedError: t('book.unexpectedError'),
    available: t('book.available'),
    availabilityDegraded: t('wizard.availabilityDegraded'),
    rangeUnavailable: t('wizard.rangeUnavailable'),
    extras: t('wizard.extras'),
    bestPrice: t('wizard.bestPrice'),
    roomsCount: t('wizard.roomsCount'),
    multiRoomNote: t('wizard.multiRoomNote'),
    perNight: t('wizard.perNight'),
    alternatives: t('wizard.alternatives'),
    onlyThisRoom: t('wizard.onlyThisRoom'),
    toastOptionsUpdated: t('wizard.toast.optionsUpdated'),
    toastBestPrice: t('wizard.toast.bestPrice'),
  }),
}}>
  window.__ROOMS_DATA = JSON.parse(serializedRooms);
  window.__ROOM_INVENTORY = JSON.parse(serializedInventory);
  window.__LABELS = JSON.parse(serializedLabels);
</script>

<script>
  import { gsap } from 'gsap';
  import { translateBeds, daysBetween } from '../utils/helpers';
  import { wizardStore } from '../features/booking/wizardStore';

  let abortController = new AbortController();

  function initWizardShell() {
    abortController.abort();
    abortController = new AbortController();

    const panels = {
      1: document.querySelector('[data-step-panel="1"]') as HTMLElement | null,
      2: document.querySelector('[data-step-panel="2"]') as HTMLElement | null,
      3: document.querySelector('[data-step-panel="3"]') as HTMLElement | null,
    };
    const dots = document.querySelectorAll<HTMLElement>('[data-wizard-step-dot]');
    const lines = document.querySelectorAll<HTMLElement>('[data-wizard-step-line]');
    const stepOf = document.querySelector('[data-wizard-stepof]');
    const summaryRoomName = document.getElementById('summary-room-name');
    const summaryRoomBedsText = document.getElementById('summary-room-beds-text');
    const summaryCheckin = document.getElementById('summary-checkin');
    const summaryCheckout = document.getElementById('summary-checkout');
    const summaryNights = document.getElementById('summary-nights');
    const summaryGuests = document.getElementById('summary-guests');
    const summaryTotalPrice = document.getElementById('summary-total-price');
    const summaryPricePerNight = document.getElementById('summary-price-per-night');
    const summaryVideoContainer = document.getElementById('summary-video-container');
    const summaryRoomVideo = document.getElementById('summary-room-video') as HTMLVideoElement | null;
    const errorBanner = document.getElementById('error-banner');
    const lang = (document.documentElement.lang || 'en') as string;
    const L = (window as any).__LABELS || {};
    const ROOMS = (window as any).__ROOMS_DATA || [];

    let currentStep = 1;
    let lastTotal: number | null = null;

    function applyState() {
      const s = wizardStore.getState();
      const step = s.step;

      (Object.keys(panels) as unknown as number[]).forEach((n) => {
        const panel = panels[n as keyof typeof panels];
        if (!panel) return;
        const isActive = Number(n) === step;
        if (isActive && panel.classList.contains('hidden')) {
          panel.classList.remove('hidden');
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduceMotion) {
            gsap.fromTo(panel, { autoAlpha: 0, x: 24 }, { autoAlpha: 1, x: 0, duration: 0.5, ease: 'power3.out', overwrite: true });
          }
        } else if (!isActive && !panel.classList.contains('hidden')) {
          panel.classList.add('hidden');
        }
      });

      dots.forEach((dot, i) => {
        const n = i + 1;
        if (n === step) dot.setAttribute('data-state', 'active');
        else if (n < step) dot.setAttribute('data-state', 'done');
        else dot.removeAttribute('data-state');
      });
      lines.forEach((line, i) => {
        if (i + 1 < step) line.classList.add('bg-primary/50');
        else line.classList.remove('bg-primary/50');
      });
      if (stepOf) stepOf.textContent = (L.stepOf || 'Step {n} of 3').replace('{n}', String(step));

      if (summaryRoomName && s.allocation) {
        const names = s.allocation.rooms.map((e) => e.room.displayName).join(' + ');
        summaryRoomName.textContent = names;
        if (summaryRoomBedsText) {
          const first = ROOMS.find((r: any) => r.slug === s.allocation!.rooms[0].room.slug);
          summaryRoomBedsText.textContent = first ? translateBeds(first.beds, lang) : '';
        }
        const nights = daysBetween(s.checkIn, s.checkOut);
        if (summaryCheckin) summaryCheckin.textContent = s.checkIn;
        if (summaryCheckout) summaryCheckout.textContent = s.checkOut;
        if (summaryNights) summaryNights.textContent = `${nights} ${nights === 1 ? L.night : L.nights}`;
        if (summaryGuests) summaryGuests.textContent = `${s.guests} ${s.guests === 1 ? L.guest : L.guests}`;
        if (summaryTotalPrice) {
          summaryTotalPrice.textContent = String(s.allocation.total);
          if (lastTotal !== null && lastTotal !== s.allocation.total) {
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduceMotion) {
              gsap.fromTo(
                summaryTotalPrice,
                { scale: 1.08, color: '#d4af37' },
                { scale: 1, color: 'inherit', duration: 0.6, ease: 'power2.out', overwrite: true }
              );
            }
          }
          lastTotal = s.allocation.total;
        }
        const perNight = s.allocation.roomTotal / nights;
        if (summaryPricePerNight) summaryPricePerNight.textContent = String(Math.round(perNight));
        if (summaryVideoContainer && summaryRoomVideo) {
          summaryVideoContainer.classList.remove('hidden');
          const vid = `/videos/rooms/${s.allocation.rooms[0].room.slug}.mp4`;
          if (summaryRoomVideo.src !== vid) {
            summaryRoomVideo.src = vid;
            summaryRoomVideo.load();
          }
        }
      }

      if (errorBanner && step === 1) errorBanner.classList.add('hidden');
    }

    const unsub = wizardStore.subscribe(() => applyState());
    abortController.signal.addEventListener('abort', () => unsub());

    // Semilla del resumen desde query params (antes del primer notify del calendario)
    const params = new URLSearchParams(window.location.search);
    const checkIn = params.get('checkin') || params.get('checkIn') || '';
    const checkOut = params.get('checkout') || params.get('checkOut') || '';
    if (checkIn && summaryCheckin) summaryCheckin.textContent = checkIn;
    if (checkOut && summaryCheckout) summaryCheckout.textContent = checkOut;

    applyState();
  }

  document.addEventListener('astro:page-load', initWizardShell);
  document.addEventListener('astro:before-preparation', () => {
    abortController.abort();
  });
</script>
