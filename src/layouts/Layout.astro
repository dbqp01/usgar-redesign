---
import { ClientRouter, fade } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MobileBookingBar from '../components/MobileBookingBar.astro';
import { siteSettings } from '../data/settings';
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import StatusBanner from '../components/ui/StatusBanner.astro';
import SmoothScroll from '../components/common/SmoothScroll.astro';
import Preloader from '../components/common/Preloader.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import NoiseOverlay from '../components/common/NoiseOverlay.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  schema?: Record<string, any> | Record<string, any>[];
  preloadImage?: string;
}

const currentLang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(currentLang);
const {
  title,
  description = (siteSettings.siteDescription as Record<string, string>)[currentLang] || siteSettings.siteDescription.en,
  lang = currentLang,
  ogImage = '/og-image.jpg',
  schema,
  preloadImage
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://usgarhoteles.com');
const canonicalURL = new URL(Astro.url.pathname, siteBase);

// Build correct hreflang alternate URLs for all 4 supported locales
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(es|fr|pt)(\/|$)/, '/');
const cleanPath = pathWithoutLocale.startsWith('/') ? pathWithoutLocale : `/${pathWithoutLocale}`;

const enURL = new URL(cleanPath, siteBase);
const esURL = new URL(`/es${cleanPath === '/' ? '' : cleanPath}`, siteBase);
const frURL = new URL(`/fr${cleanPath === '/' ? '' : cleanPath}`, siteBase);
const ptURL = new URL(`/pt${cleanPath === '/' ? '' : cleanPath}`, siteBase);

const localeMap: Record<Locale, string> = {
  en: 'en_US',
  es: 'es_PE',
  fr: 'fr_FR',
  pt: 'pt_PT'
};
---

<!doctype html>
<html lang={lang} data-cursor={siteSettings.customCursor ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMap[currentLang] || 'en_US'} />
    <meta property="og:site_name" content="USGAR Hotels" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Hreflang Tags (4 Locales) -->
    <link rel="alternate" hreflang="en" href={enURL.href} />
    <link rel="alternate" hreflang="es" href={esURL.href} />
    <link rel="alternate" hreflang="fr" href={frURL.href} />
    <link rel="alternate" hreflang="pt" href={ptURL.href} />
    <link rel="alternate" hreflang="x-default" href={enURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- LCP Image Preload -->
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" type="image/webp" />
    )}

    <!-- Fonts self-hosted (variable woff2, mismo origin — sin 3rd-party ni font-swap tardío) -->
    <link rel="preload" href="/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Schema.org JSON-LD -->
    {schema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Anti-Flash Theme Persistence Script (in Head) -->
    <script is:inline>
      (function() {
        function applyTheme(doc) {
          const target = doc || document.documentElement;
          const savedTheme = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
            target.classList.add('dark');
          } else {
            target.classList.remove('dark');
          }
        }

        applyTheme(document.documentElement);

        document.addEventListener('astro:before-swap', function(event) {
          applyTheme(event.newDocument.documentElement);
        });

        document.addEventListener('astro:after-swap', function() {
          applyTheme(document.documentElement);
        });
      })();
    </script>

    <!-- Preloader fallback (persistent is:inline: independent of GSAP/bundled modules) -->
    <script is:inline>
      (function () {
        // First-load flag lives in this head-script closure. The inline script is not
        // re-executed after the first SPA visit (scriptsAlreadyRan marks its textContent),
        // so this closure persists across navigations.
        var firstLoad = true;

        function preloaderDone() {
          if (window.__preloaderDone) return;
          window.__preloaderDone = true;
          sessionStorage.setItem('usgar_loaded', 'true');
          window.dispatchEvent(new CustomEvent('usgar:preloader-done'));
        }

        function forceHide() {
          var preloader = document.getElementById('cinematic-preloader');
          if (preloader) preloader.style.display = 'none';
          preloaderDone();
        }

        // Bind latch: the script may re-execute once on the first SPA visit - keep a
        // single timeout + a single page-load listener registered from the first run.
        if (!window.__preloaderFallbackBound) {
          window.__preloaderFallbackBound = true;
          // Belt-and-suspenders: hide even if GSAP or the bundled module never run.
          window.setTimeout(forceHide, 2500);
          document.addEventListener('astro:page-load', function () {
            // The initial astro:page-load is the first load: the cinematic must survive.
            if (firstLoad) {
              firstLoad = false;
              return;
            }
            // Later navigations re-create the preloader in the swapped body: force-hide.
            forceHide();
          });
        }
      })();
    </script>

    <!-- No-JS: hide the preloader entirely (it is animated by JS only) -->
    <noscript>
      <style>#cinematic-preloader{display:none}</style>
    </noscript>

    <!-- View Transitions -->
    <ClientRouter />

  </head>
  <body class="bg-surface-light dark:bg-surface-dark text-text-primary-light dark:text-text-primary-dark transition-colors duration-300 min-h-screen flex flex-col">
    <!-- Skip to content (accessibility) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">
      {t('global.skipToContent')}
    </a>

    <!-- Cinematic & Aesthetic Components -->
    <Preloader />
    <NoiseOverlay />
    <CustomCursor />

    <Navbar />

    <!-- Main content uses Astro's native fade view transition (250ms, imported from astro:transitions) -->
    <main id="main-content" class="flex-grow" transition:animate={fade({ duration: '0.25s' })}>
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
    <MobileBookingBar />
    <StatusBanner />
    <SmoothScroll />

    <!-- Slot para scripts de terceros que la doc manda cargar antes de </body> (ej. SDK MercadoPago.js) -->
    <slot name="end-body" />
  </body>
</html>
