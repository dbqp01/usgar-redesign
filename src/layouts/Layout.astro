---
import { ClientRouter, fade } from 'astro:transitions';
import { Font } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MobileBookingBar from '../components/MobileBookingBar.astro';
import { siteSettings } from '../data/settings';
import '../styles/global.css';
import 'lenis/dist/lenis.css';
import StatusBanner from '../components/ui/StatusBanner.astro';
import SmoothScroll from '../components/common/SmoothScroll.astro';
import Preloader from '../components/common/Preloader.astro';
import CustomCursor from '../components/common/CustomCursor.astro';
import NoiseOverlay from '../components/common/NoiseOverlay.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  schema?: Record<string, any> | Record<string, any>[];
  preloadImage?: string;
}

const currentLang = (Astro.currentLocale || 'en') as Locale;
const t = useTranslations(currentLang);
const {
  title,
  description = (siteSettings.siteDescription as Record<string, string>)[currentLang] || siteSettings.siteDescription.en,
  lang = currentLang,
  ogImage = new URL('/og-image.jpg', Astro.site).href,
  schema,
  preloadImage
} = Astro.props;

const siteBase = Astro.site;
const canonicalURL = new URL(Astro.url.pathname, siteBase);

// Hreflang alternate URLs for all 4 supported locales via the native astro:i18n
// helper (getRelativeLocaleUrl). Only the locale prefix is stripped by hand —
// there is no native "remove locale from path" helper; the URL building is native.
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(es|fr|pt)(\/|$)/, '/');

const enURL = new URL(getRelativeLocaleUrl('en', pathWithoutLocale), siteBase);
const esURL = new URL(getRelativeLocaleUrl('es', pathWithoutLocale), siteBase);
const frURL = new URL(getRelativeLocaleUrl('fr', pathWithoutLocale), siteBase);
const ptURL = new URL(getRelativeLocaleUrl('pt', pathWithoutLocale), siteBase);

const localeMap: Record<Locale, string> = {
  en: 'en_US',
  es: 'es_PE',
  fr: 'fr_FR',
  pt: 'pt_PT'
};
---

<!doctype html>
<html lang={lang} data-cursor={siteSettings.customCursor ? 'true' : 'false'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMap[currentLang] || 'en_US'} />
    <meta property="og:site_name" content="USGAR Hotels" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Hreflang Tags (4 Locales) -->
    <link rel="alternate" hreflang="en" href={enURL.href} />
    <link rel="alternate" hreflang="es" href={esURL.href} />
    <link rel="alternate" hreflang="fr" href={frURL.href} />
    <link rel="alternate" hreflang="pt" href={ptURL.href} />
    <link rel="alternate" hreflang="x-default" href={enURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- LCP Image Preload -->
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" type="image/avif" />
    )}

    <!-- Fonts self-hosted (variable woff2, mismo origin — sin 3rd-party ni font-swap tardío) -->
    <!-- Preload las familias críticas usadas above-the-fold; Astro recomienda hacerlo de forma selectiva. -->
    <Font cssVariable="--font-ak" preload />
    <Font cssVariable="--font-montserrat" preload />
    <Font cssVariable="--font-playfair" preload />

    <!-- Schema.org JSON-LD -->
    {schema && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Anti-Flash Theme Persistence Script (in Head) -->
    <script is:inline>
      (function() {
        function applyTheme(doc) {
          const target = doc || document.documentElement;
          let savedTheme = null;
          try {
            savedTheme = localStorage.getItem('theme');
          } catch (_) {
            // Brave Shields / Privacy mode fallback
          }
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && systemDark)) {
            target.classList.add('dark');
          } else {
            target.classList.remove('dark');
          }
        }

        applyTheme(document.documentElement);

        document.addEventListener('astro:before-swap', function(event) {
          applyTheme(event.newDocument.documentElement);
          // Desactivar scroll-behavior smooth durante la preparación para cambio SPA instantáneo en móviles (Astro Docs)
          document.documentElement.style.scrollBehavior = 'auto';
        });

        document.addEventListener('astro:after-swap', function() {
          applyTheme(document.documentElement);
          requestAnimationFrame(function() {
            document.documentElement.style.scrollBehavior = '';
          });
        });
      })();
    </script>

    <!-- Preloader fallback (persistent is:inline: independent of GSAP/bundled modules) -->
    <script is:inline>
      (function () {
        var firstLoad = true;

        function preloaderDone() {
          if (window.__preloaderDone) return;
          window.__preloaderDone = true;
          try {
            sessionStorage.setItem('usgar_loaded', 'true');
          } catch (_) {}
          window.dispatchEvent(new CustomEvent('usgar:preloader-done'));
        }

        function forceHide() {
          var preloader = document.getElementById('cinematic-preloader');
          if (preloader) preloader.style.display = 'none';
          preloaderDone();
        }

        if (!window.__preloaderFallbackBound) {
          window.__preloaderFallbackBound = true;
          window.setTimeout(forceHide, 2500);
          document.addEventListener('astro:before-swap', function (event) {
            var incomingPreloader = event.newDocument.getElementById('cinematic-preloader');
            if (incomingPreloader) incomingPreloader.style.display = 'none';
          });
          document.addEventListener('astro:page-load', function () {
            if (firstLoad) {
              firstLoad = false;
              return;
            }
            forceHide();
          });
        }
      })();
    </script>

    <!-- No-JS: hide the preloader entirely (it is animated by JS only) -->
    <noscript>
      <style>#cinematic-preloader{display:none}</style>
    </noscript>

    <!-- Progressive enhancement: `.animate-on-scroll` is hidden only when html.js is
         present, so content is born visible without JS. The router's swapRootAttributes
         copies the INCOMING root's attributes and wipes the current one, so the class is
         re-added on the incoming root in astro:before-swap (mirror of the theme script). -->
    <script is:inline data-astro-rerun>
      (function () {
        document.documentElement.classList.add('js');
        if (!window.__jsClassBound) {
          window.__jsClassBound = true;
          document.addEventListener('astro:before-swap', function (event) {
            event.newDocument.documentElement.classList.add('js');
          });
        }
      })();
    </script>

    <!-- View Transitions -->
    <ClientRouter />

  </head>
  <body class="bg-surface-light dark:bg-surface-dark text-text-primary-light dark:text-text-primary-dark transition-colors duration-300 min-h-screen flex flex-col">
    <!-- Skip to content (accessibility) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold">
      {t('global.skipToContent')}
    </a>

    <!-- Cinematic & Aesthetic Components -->
    <Preloader />
    <NoiseOverlay />
    <CustomCursor />

    <Navbar />

    <!-- Main content uses Astro's native fade view transition (250ms, imported from astro:transitions) -->
    <main id="main-content" class="flex-grow" transition:animate={fade({ duration: '0.25s' })}>
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
    <MobileBookingBar />
    <StatusBanner />
    <SmoothScroll />

    <!-- Slot para scripts de terceros que la doc manda cargar antes de </body> (ej. SDK MercadoPago.js) -->
    <slot name="end-body" />
  </body>
</html>
