DirectoryIndex index.html index.php

# 404 propia: sin esta linea el servidor sirve su pagina de error por defecto
# (hPanel), que pierde el diseno, carga trackers de terceros fuera del CMP de
# cookies y filtra rutas internas del host. La pagina la genera
# src/pages/404.astro en el build.
ErrorDocument 404 /404.html

RewriteEngine On

# MIME de .avif: LiteSpeed/Apache no lo reconocen por defecto y lo sirven como
# text/plain (verificado en produccion). El bloque ExpiresByType de mas abajo
# ya asume image/avif, asi que el Content-Type correcto es el que se fija aqui.
<IfModule mod_mime.c>
    AddType image/avif .avif
</IfModule>

# The build copies the PHP runtime and cron entry points into the published
# directory so Hostinger's CLI jobs can execute them. They are application
# internals, not public assets: deny direct HTTP access before any rewrite or
# PHP handler can expose source/configuration details. The CLI cron jobs are
# unaffected because this rule is evaluated only by Apache/LiteSpeed.
RewriteRule ^(?:app|vendor|cron|logs|storage|runtime)(?:/|$) - [F,L,NC]

# Canonical domain: redirect www -> apex (301). Survives deploys (lives in repo).
RewriteCond %{HTTP_HOST} ^www\.usgarhoteles\.com$ [NC]
RewriteRule ^(.*)$ https://usgarhoteles.com/$1 [L,R=301]

# Handle CORS preflight (OPTIONS) at server level
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^api/ index.php [L,QSA]

# Route ALL /api/* requests through the centralized PHP router (index.php)
# The Core\Router dispatches to the appropriate Controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ index.php [L,QSA]

# Fix para Hostinger/FastCGI: Preservar cabeceras personalizadas que Apache suele omitir
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIf X-Signature "(.*)" HTTP_X_SIGNATURE=$1
    SetEnvIf X-Request-Id "(.*)" HTTP_X_REQUEST_ID=$1
</IfModule>

<IfModule mod_headers.c>
    # PHP expose_php puede permanecer activo en FastCGI/LiteSpeed; retirar la
    # cabecera en el servidor cubre tambien respuestas estaticas de Astro.
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Security: Block access to hidden files (e.g. .env, .git)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# =============================================================================
# HTTP caching headers (mod_expires + mod_headers) — Apache 2.4 / Hostinger (LiteSpeed)
#  * Hashed Astro assets under /_astro/ carry content hashes -> 1 year, immutable
#  * og-image.jpg, favicon, images and videos -> 30 days
#  * HTML -> never cached (prices/availability change); also required for
#    Astro prefetch in Firefox/Safari (astro docs: prefetch needs cache headers)
# NOTE: for /_astro/* raster images mod_expires emits a 30-day Expires while the
#       Cache-Control override below says 1 year — browsers MUST ignore Expires
#       when Cache-Control max-age is present (RFC 7234 sec 5.3), so Cache-Control wins.
# =============================================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Hashed build assets (css/js/woff2): 1 year
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # Images, favicon, videos: 30 days
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"

    # HTML: revalidate on every request
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <IfModule mod_setenvif.c>
        # Hashed /_astro/* assets: hard cache + immutable (SetEnvIf env= triggers
        # work on both Apache and LiteSpeed)
        SetEnvIf Request_URI "^/_astro/" USGAR_HASHED_ASSET=1
        # Videos: 30 days (Apache/LiteSpeed serve Accept-Ranges natively; set explicitly)
        SetEnvIf Request_URI "\.mp4$" USGAR_VIDEO=1
        # HTML pages (incl. homepage "/" resolved via DirectoryIndex): do not cache
        SetEnvIf Request_URI "(\.html?$|^/$)" USGAR_HTML=1
    </IfModule>

    Header set Cache-Control "public, max-age=31536000, immutable" env=USGAR_HASHED_ASSET
    Header set Cache-Control "public, max-age=2592000" env=USGAR_VIDEO
    Header set Accept-Ranges "bytes" env=USGAR_VIDEO
    Header set Cache-Control "public, max-age=0, must-revalidate" env=USGAR_HTML

    # /panel/ es un shell estatico que contiene la superficie autenticada del
    # dueño. Evitar almacenamiento en navegador, proxy o CDN; el estado real
    # siempre viene de la API protegida.
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "^/panel(?:/|$)" USGAR_PANEL=1
    </IfModule>
    Header unset Cache-Control env=USGAR_PANEL
    Header always unset Cache-Control env=USGAR_PANEL
    Header always set Cache-Control "private, no-store, max-age=0, must-revalidate" env=USGAR_PANEL
</IfModule>

# Static Astro HTML does not execute PHP middleware. Apply the defensive
# browser headers here as well, INCLUDING the Content-Security-Policy: the
# allowlist is byte-for-byte the one in app/Core/Middleware.php (PHP responses)
# so there is a single policy for the whole site. The two copies are checked
# against each other by `npm run audit:content` (error CSP-DRIFT), so they
# cannot diverge silently.
#
# The allowlist was derived from what the built site actually loads, not
# guessed: MercadoPago (SDK, API, imagenes) en /book/, los tiles de Carto
# (b.basemaps.cartocdn.com) en el mapa de Leaflet, y fuentes self-hosted.
# `npm run audit:csp` carga cada pagina en Chromium con esta cabecera y falla
# si hay una violacion.
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.html$">
        Header always set X-Frame-Options "DENY"
        Header always set Referrer-Policy "strict-origin-when-cross-origin"
        Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://sdk.mercadopago.com https://*.mercadopago.com https://http2.mlstatic.com https://*.mlstatic.com https://unpkg.com https://www.mercadolibre.com https://*.mercadolibre.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://http2.mlstatic.com https://*.mlstatic.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org https://*.mlstatic.com https://*.mercadopago.com https://*.mercadolibre.com https://*.mercadolivre.com; connect-src 'self' https://api.mercadopago.com https://*.mercadopago.com https://events.mercadopago.com https://*.mercadolibre.com https://*.mlstatic.com https://cms.usgarhoteles.com; frame-src 'self' https://www.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com https://*.mercadolibre.com.pe https://*.mercadopago.com.pe;"
    </FilesMatch>
</IfModule>
