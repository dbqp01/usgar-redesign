# =================================================================
# USGAR HOTELS - VARIABLES DE ENTORNO REQUERIDAS (.env.example)
# =================================================================
#
# UBICACION UNICA del .env (ver app/Core/Config.php::loadEnv):
#   - Desarrollo/CLI: raiz del proyecto (junto a app/) -> copiar este archivo a .env
#   - Produccion (Hostinger): UN nivel arriba de public_html
#     (ej. /home/<usuario>/.env, NO dentro de public_html ni de dist/).
#     El deploy Git no toca esa ruta y el servidor web no puede servir el archivo.
#     El build NO copia .env a dist/ (postbuild).

# -----------------------------------------------------------------
# 1. ENTORNO Y BASE DE DATOS
# -----------------------------------------------------------------
SITE_URL=http://localhost:4321
TIMEZONE=America/Lima
ALLOWED_ORIGINS=*       # En prod: https://cusco.usgarhoteles.com,https://usgarhoteles.com
TRUSTED_PROXIES=          # IPs de proxies confiables para X-Forwarded-For (vacío = ninguno)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# -----------------------------------------------------------------
# 2. SISTEMA Y SEGURIDAD INTERNA
# -----------------------------------------------------------------
CRON_SECRET=change_me_random_32_chars_please_change
BOOKING_TOKEN_SECRET=change_me_random_32_chars_please_change
AUTH_JWT_SECRET=change_me_random_32_chars_please_change

# Rate limiting global (por IP)
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=600

# -----------------------------------------------------------------
# 3. OAUTH (GOOGLE / MICROSOFT / FACEBOOK)
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# -----------------------------------------------------------------
# 4. QLOAPPS PMS
# -----------------------------------------------------------------
QLOAPP_API_URL=https://cms.usgarhoteles.com/api
QLOAPP_API_KEY=YOUR_QLOAPP_API_KEY

# -----------------------------------------------------------------
# 5. MERCADO PAGO
# -----------------------------------------------------------------
# El prefijo del token (APP_USR- / TEST-) NO define el entorno (doc MP).
# El entorno lo define la seccion del panel: Pruebas vs Produccion.
# Panel: https://www.mercadopago.com/developers/panel/app
PUBLIC_MERCADO_PAGO_PUBLIC_KEY=YOUR_MP_PUBLIC_KEY
MERCADO_PAGO_ACCESS_TOKEN=YOUR_MP_ACCESS_TOKEN
MERCADO_PAGO_CURRENCY=PEN
# Timeouts totales de las llamadas SDK (todo 5): 15s en create, 8s en get/webhook
MERCADO_PAGO_TIMEOUT_CREATE_MS=15000
MERCADO_PAGO_TIMEOUT_GET_MS=8000
EXCHANGE_RATE_USD_PEN=3.80
# Cargo por huesped adicional por noche (regla del negocio: +1 persona, pago completo)
EXTRA_GUEST_CHARGE_USD=30
HOTEL_BASE_CURRENCY=USD
DEFAULT_HOTEL_ID=1
DEFAULT_GUEST_EMAIL=reserva@usgarhoteles.com
DEFAULT_REPLY_EMAIL=no-reply@usgarhoteles.com
DEFAULT_GUEST_NAME=Guest
MERCADO_PAGO_WEBHOOK_SECRET=YOUR_MP_WEBHOOK_SECRET
MP_STATEMENT_DESCRIPTOR=USGAR HOTELES CUSCO
MP_BINARY_MODE=true

# TTL del hold de reserva (expresion strtotime)
BOOKING_HOLD_TTL=+15 minutes

# -----------------------------------------------------------------
# 6. CORREO TRANSACCIONAL (voucher de confirmacion al huesped)
# -----------------------------------------------------------------
# Enviado por SendBookingConfirmationEmailListener via PHPMailer + SMTP
# cuando el pago se confirma (outbox -> cron process_outbox).
# Si SMTP_HOST queda vacio el email se omite (fail-soft, sin reintentos).
# Hostinger compartido: smtp.hostinger.com / 587 STARTTLS / cuenta del dominio.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=tls          # tls (STARTTLS) | ssl
SMTP_USER=no-reply@usgarhoteles.com
SMTP_PASS=your_smtp_password
SMTP_TIMEOUT=15
MAIL_FROM=no-reply@usgarhoteles.com
MAIL_FROM_NAME=USGAR Hotels

# Defaults de huespedes OTA - EN USO hoy (QloAppAdapter / ConfirmQloAppsOrderListener)
OTA_DEFAULT_PHONE=000000000
QLOAPPS_DEFAULT_GUEST_NAME=Huésped USGAR

# Reservados para la sync del QloApps Channel Manager (aun sin consumo en codigo)
OTA_HOLD_TTL=+1 year
OTA_DEFAULT_EMAIL=guest@ota.com
OTA_DEFAULT_NAME=Huesped
OTA_DEFAULT_SURNAME=OTA
