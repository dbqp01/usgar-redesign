# =================================================================
# USGAR HOTELS - VARIABLES DE ENTORNO REQUERIDAS (.env.example)
# =================================================================

# -----------------------------------------------------------------
# 1. ENTORNO Y BASE DE DATOS
# -----------------------------------------------------------------
SITE_URL=http://localhost:4321
TIMEZONE=America/Lima
ALLOWED_ORIGINS=*       # En prod: https://cusco.usgarhoteles.com,https://usgarhoteles.com
TRUSTED_PROXIES=          # IPs de proxies confiables para X-Forwarded-For (vacío = ninguno)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# -----------------------------------------------------------------
# 2. SISTEMA Y SEGURIDAD INTERNA
# -----------------------------------------------------------------
CRON_SECRET=change_me_random_32_chars
BOOKING_TOKEN_SECRET=change_me_random_32_chars
AUTH_JWT_SECRET=change_me_random_32_chars

# Rate limiting global (por IP)
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=600

# -----------------------------------------------------------------
# 3. OAUTH (GOOGLE / MICROSOFT / FACEBOOK)
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# -----------------------------------------------------------------
# 4. QLOAPPS PMS
# -----------------------------------------------------------------
QLOAPP_API_URL=https://cms.usgarhoteles.com/api
QLOAPP_API_KEY=YOUR_QLOAPP_API_KEY

# -----------------------------------------------------------------
# 5. MERCADO PAGO
# -----------------------------------------------------------------
# Las credenciales de Mercado Pago determinan su propio entorno, pero el
# PREFIJO no lo define: los Access Tokens de prueba y de produccion pueden
# empezar ambos con APP_USR (doc MP — Checkout Pro/Orders crean la cuenta de
# prueba automaticamente con prefijo APP_USR) o variar segun la solucion.
# El entorno lo define la app/panel (Tus integraciones), no el prefijo.
# Obten tus credenciales en: https://www.mercadopago.com/developers/panel/app
#   - Pruebas:  app -> Pruebas -> Credenciales de prueba
#   - Produccion: app -> Produccion -> Credenciales de produccion (activar antes)
# En produccion, el guard de deploy (scripts/check-prod-env.php) exige que el
# token este en la allowlist por HASH: anade MERCADO_PAGO_PROD_TOKEN_SHA256
# (sha256 del Access Token) a .env.production (fuera de git, solo hashes).
PUBLIC_MERCADO_PAGO_PUBLIC_KEY=YOUR_MP_PUBLIC_KEY
MERCADO_PAGO_ACCESS_TOKEN=YOUR_MP_ACCESS_TOKEN
MERCADO_PAGO_CURRENCY=PEN
# Timeouts totales de las llamadas SDK (todo 5): 15s en create, 8s en get/webhook
MERCADO_PAGO_TIMEOUT_CREATE_MS=15000
MERCADO_PAGO_TIMEOUT_GET_MS=8000
EXCHANGE_RATE_USD_PEN=3.80
HOTEL_BASE_CURRENCY=USD
DEFAULT_HOTEL_ID=1
DEFAULT_GUEST_EMAIL=reserva@usgarhoteles.com
DEFAULT_REPLY_EMAIL=no-reply@usgarhoteles.com
DEFAULT_GUEST_NAME=Guest
MERCADO_PAGO_WEBHOOK_SECRET=YOUR_MP_WEBHOOK_SECRET
MP_STATEMENT_DESCRIPTOR=USGAR HOTELES CUSCO
MP_BINARY_MODE=true

# TTL del hold de reserva (expresion strtotime)
BOOKING_HOLD_TTL=+15 minutes

# Defaults de huespedes OTA - EN USO hoy (QloAppAdapter / ConfirmQloAppsOrderListener)
OTA_DEFAULT_PHONE=000000000
QLOAPPS_DEFAULT_GUEST_NAME=Huésped USGAR

# Reservados para la sync del QloApps Channel Manager (aun sin consumo en codigo)
OTA_HOLD_TTL=+1 year
OTA_DEFAULT_EMAIL=guest@ota.com
OTA_DEFAULT_NAME=Huesped
OTA_DEFAULT_SURNAME=OTA
