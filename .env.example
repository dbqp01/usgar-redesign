# -----------------------------------------------------------------
# 1. ENTORNO Y BASE DE DATOS
# -----------------------------------------------------------------
SITE_URL=http://localhost:4321
ENVIRONMENT=development # 'development' o 'production'
ALLOWED_ORIGINS=*       # En prod: https://cusco.hotelesusgar.com,https://hotelesusgar.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u941268346_usgar
DB_PASS=A123_123b
DB_NAME=u941268346_QloApp

# -----------------------------------------------------------------
# 2. SISTEMA Y SEGURIDAD INTERNA
# -----------------------------------------------------------------
CRON_SECRET=usgar_cron_secret_2026
BOOKING_TOKEN_SECRET=usgar_prod_secret_booking_token_2026
AUTH_JWT_SECRET=usgar_hotels_jwt_secret_key_change_in_production_32chars

# -----------------------------------------------------------------
# 3. OAUTH (GOOGLE)
# -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------
# 4. QLOAPPS PMS
# -----------------------------------------------------------------
QLOAPP_API_URL=https://cms.hotelesusgar.com/api
QLOAPP_API_KEY=YOUR_QLOAPP_API_KEY

# -----------------------------------------------------------------
# 5. MERCADO PAGO
# -----------------------------------------------------------------
MERCADO_PAGO_CURRENCY=PEN
EXCHANGE_RATE_USD_PEN=3.80
MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxx
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxx # Opcional si se usan PROD/TEST separados
MP_PROD_ACCESS_TOKEN=APP_USR-xxxx
MP_TEST_ACCESS_TOKEN=TEST-xxxx
MERCADO_PAGO_WEBHOOK_SECRET=YOUR_MP_WEBHOOK_SECRET

# -----------------------------------------------------------------
# 6. CHANNEX (CHANNEL MANAGER)
# -----------------------------------------------------------------
CHANNEX_API_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=YOUR_CHANNEX_API_KEY
CHANNEX_PROPERTY_ID=YOUR_CHANNEX_PROPERTY_ID
CHANNEX_RATE_PLAN_ID=YOUR_CHANNEX_RATE_PLAN_ID

# Mapeo de Habitaciones
CHANNEX_ROOM_DOBLE_SUPERIOR=
CHANNEX_ROOM_MATRIMONIAL=
CHANNEX_ROOM_FAMILIAR_SUPERIOR=
CHANNEX_ROOM_TRIPLE_STANDAR=

# Mapeo de Tarifas
CHANNEX_RATE_DOBLE_SUPERIOR=
CHANNEX_RATE_MATRIMONIAL=
CHANNEX_RATE_FAMILIAR_SUPERIOR=
CHANNEX_RATE_TRIPLE_STANDAR=
