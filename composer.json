{
    "require": {
        "hybridauth/hybridauth": "^3.13",
        "mercadopago/dx-php": "^3.12",
        "phpoffice/phpspreadsheet": "^3.9",
        "firebase/php-jwt": "^7.1",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "dg/bypass-finals": "^1.11",
        "cweagans/composer-patches": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "extra": {
        "patches": {
            "mercadopago/dx-php": {
                "Case-robust idempotency key + single idempotency header": "patches/dx-php-idempotency-case.patch",
                "Bounded total timeout on SDK HTTP calls (CURLOPT_TIMEOUT_MS)": "patches/dx-php-total-timeout.patch"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    }
}
