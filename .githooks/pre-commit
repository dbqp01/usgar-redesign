#!/bin/sh
# Wrapper POSIX del hook pre-commit: el hook real es PowerShell (Windows).
# Sin PowerShell (Linux/macOS) no hay nada que comprimir y el commit NO se bloquea.
if command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File "$(dirname "$0")/pre-commit.ps1"
fi
exit 0
